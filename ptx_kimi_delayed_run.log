import torch.nn as nn
from cutegen.ptx_runtime import PtxModule, i32, u32, i64, u64, f32, f64

PTX_SOURCE = r"""
.version 7.8
.target sm_89
.address_size 64

.visible .entry matvec_kernel(
    .param .u64 A_ptr,
    .param .u64 B_ptr,
    .param .u64 C_ptr,
    .param .s32 M,
    .param .s32 K
)
{
    .reg .pred %p1, %p2, %p3;
    .reg .b32 %r1, %r2, %r3, %r4, %r5, %r6, %r7, %r8, %r9, %r10;
    .reg .b64 %rd1, %rd2, %rd3, %rd4, %rd5, %rd6, %rd7, %rd8, %rd9, %rd10;
    .reg .f32 %f1, %f2, %f3;
    .shared .align 4 .b8 smem[1024];

    ld.param.u64 %rd1, [A_ptr];
    ld.param.u64 %rd2, [B_ptr];
    ld.param.u64 %rd3, [C_ptr];
    ld.param.s32 %r4, [M];
    ld.param.s32 %r5, [K];

    mov.u32 %r1, %tid.x;
    mov.u32 %r2, %ntid.x;
    mov.u32 %r3, %ctaid.x;

    setp.ge.s32 %p1, %r3, %r4;
    @%p1 bra DONE;

    cvt.u64.u32 %rd4, %r3;
    cvt.u64.u32 %rd5, %r5;
    mul.lo.u64 %rd6, %rd4, %rd5;
    shl.b64 %rd6, %rd6, 2;
    add.s64 %rd10, %rd1, %rd6;

    mov.f32 %f1, 0f00000000;
    mov.u32 %r6, %r1;

LOOP_K:
    setp.lt.s32 %p2, %r6, %r5;
    @!%p2 bra REDUCE_INIT;

    cvt.u64.u32 %rd7, %r6;
    shl.b64 %rd8, %rd7, 2;

    add.s64 %rd9, %rd10, %rd8;
    ld.global.f32 %f2, [%rd9];

    add.s64 %rd9, %rd2, %rd8;
    ld.global.f32 %f3, [%rd9];

    fma.rn.f32 %f1, %f2, %f3, %f1;

    add.s32 %r6, %r6, %r2;
    bra LOOP_K;

REDUCE_INIT:
    mov.u32 %r7, smem;
    mad.lo.u32 %r8, %r1, 4, %r7;
    st.shared.f32 [%r8], %f1;
    bar.sync 0;

    shr.u32 %r9, %r2, 1;

REDUCE_LOOP:
    setp.gt.s32 %p3, %r9, 0;
    @!%p3 bra WRITE_OUT;

    setp.lt.u32 %p1, %r1, %r9;
    @!%p1 bra REDUCE_SYNC;

    mov.u32 %r7, smem;
    mad.lo.u32 %r8, %r1, 4, %r7;
    ld.shared.f32 %f2, [%r8];

    mul.lo.u32 %r10, %r9, 4;
    add.u32 %r10, %r8, %r10;
    ld.shared.f32 %f3, [%r10];

    add.f32 %f2, %f2, %f3;
    st.shared.f32 [%r8], %f2;

REDUCE_SYNC:
    bar.sync 0;
    shr.u32 %r9, %r9, 1;
    bra REDUCE_LOOP;

WRITE_OUT:
    setp.eq.s32 %p1, %r1, 0;
    @!%p1 bra DONE;

    mov.u32 %r7, smem;
    ld.shared.f32 %f2, [%r7];

    cvt.u64.u32 %rd7, %r3;
    shl.b64 %rd8, %rd7, 2;
    add.s64 %rd9, %rd3, %rd8;
    st.global.f32 [%rd9], %f2;

DONE:
    ret;
}
"""

_ptx_module = None

def _get_ptx_module():
    global _ptx_module
    if _ptx_module is None:
        _ptx_module = PtxModule(PTX_SOURCE)
    return _ptx_module

def validate_generated_code():
    # Force PTX JIT assembly and entry-point lookup during compile validation.
    _get_ptx_module().function("matvec_kernel")

class ModelNew(nn.Module):
    def __init__(self):
        super().__init__()

    def forward(self, A: torch.Tensor, B: torch.Tensor) -> torch.Tensor:
        M, K = A.shape
        C = torch.empty((M, 1), device=A.device, dtype=A.dtype)
        module = _get_ptx_module()
        module.launch(
            "matvec_kernel",
            grid=(M, 1, 1),
            block=(256, 1, 1),
            arguments=[A, B, C, i32(M), i32(K)],
            shared_memory=0,
            stream=torch.cuda.current_stream(A.device),
        )
        return C
