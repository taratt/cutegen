    shr.u32 %m, %tlin, 2;
    and.b32 %kg, %tlin, 3;
    shl.b32 %aoff, %by, 6;
    add.u32 %aoff, %aoff, %m;
    mul.lo.u32 %aoff, %aoff, %n;
    shl.b32 %kg, %kg, 2;
