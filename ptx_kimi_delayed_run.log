import torch.nn as nn
from cutegen.ptx_runtime import PtxModule, i32, u32, i64, u64, f32, f64

PTX_SOURCE = r"""
.version 8.0
.target sm_89
.address_size 64

.visible .entry matmul_kernel(
    .param .u64 matmul_kernel_param_0,
    .param .u64 matmul_kernel_param_1,
    .param .u64 matmul_kernel_param_2,
    .param .u32 matmul_kernel_param_3
)
{
    .reg .pred %p1, %p2, %pt, %pk;
    .reg .u32 %tx, %ty, %bx, %by, %row, %col, %n, %t, %k, %sidx, %r1, %r2;
    .reg .u64 %ap, %bp, %cp, %off, %ga, %gb, %sa, %sb;
    .reg .f32 %acc, %av, %bv;
    .shared .align 4 .b8 As[1024];
    .shared .align 4 .b8 Bs[1024];

    ld.param.u64 %ap, [matmul_kernel_param_0];
    ld.param.u64 %bp, [matmul_kernel_param_1];
    ld.param.u64 %cp, [matmul_kernel_param_2];
    ld.param.u32 %n, [matmul_kernel_param_3];

    mov.u32 %tx, %tid.x;
    mov.u32 %ty, %tid.y;
    mov.u32 %bx, %ctaid.x;
    mov.u32 %by, %ctaid.y;

    // row = by * 16 + ty ; col = bx * 16 + tx
    shl.b32 %row, %by, 4;
    add.u32 %row, %row, %ty;
    shl.b32 %col, %bx, 4;
    add.u32 %col, %col, %tx;

    // sidx = ty * 16 + tx
    shl.b32 %sidx, %ty, 4;
    add.u32 %sidx, %sidx, %tx;

    mov.u64 %sa, As;
    mov.u64 %sb, Bs;

    // &As[sidx] and &Bs[sidx]
    cvt.u64.u32 %off, %sidx;
    shl.b64 %off, %off, 2;
    add.u64 %ga, %sa, %off;
    add.u64 %gb, %sb, %off;

    mov.f32 %acc, 0f00000000;
    mov.u32 %t, 0;

$L_loop_t:
    setp.lt.u32 %pt, %t, %n;
    @!%pt bra $L_done;

    // ---- stage A tile: As[sidx] = A[row][t + tx] (zero padded) ----
    add.u32 %r1, %t, %tx;
    setp.lt.u32 %p1, %row, %n;
    setp.lt.u32 %p2, %r1, %n;
    and.pred %p1, %p1, %p2;
    mov.f32 %av, 0f00000000;
    @!%p1 bra $L_skip_a;
    mul.lo.u32 %r2, %row, %n;
    add.u32 %r2, %r2, %r1;
    cvt.u64.u32 %off, %r2;
    shl.b64 %off, %off, 2;
    add.u64 %off, %ap, %off;
    ld.global.f32 %av, [%off];
$L_skip_a:
    st.shared.f32 [%ga], %av;

    // ---- stage B tile: Bs[sidx] = B[t + ty][col] (zero padded) ----
    add.u32 %r1, %t, %ty;
    setp.lt.u32 %p1, %r1, %n;
    setp.lt.u32 %p2, %col, %n;
    and.pred %p1, %p1, %p2;
    mov.f32 %bv, 0f00000000;
    @!%p1 bra $L_skip_b;
    mul.lo.u32 %r2, %r1, %n;
    add.u32 %r2, %r2, %col;
    cvt.u64.u32 %off, %r2;
    shl.b64 %off, %off, 2;
    add.u64 %off, %bp, %off;
    ld.global.f32 %bv, [%off];
$L_skip_b:
    st.shared.f32 [%gb], %bv;

    bar.sync 0;

    // ---- accumulate over the 16-wide tile ----
    mov.u32 %k, 0;
$L_loop_k:
    setp.lt.u32 %pk, %k, 16;
    @!%pk bra $L_k_done;

    // av = As[ty * 16 + k]
    shl.b32 %r1, %ty, 4;
    add.u32 %r1, %r1, %k;
    cvt.u64.u32 %off, %r1;
    shl.b64 %off, %off, 2;
    add.u64 %off, %sa, %off;
    ld.shared.f32 %av, [%off];

    // bv = Bs[k * 16 + tx]
    shl.b32 %r2, %k, 4;
    add.u32 %r2, %r2, %tx;
    cvt.u64.u32 %off, %r2;
    shl.b64 %off, %off, 2;
    add.u64 %off, %sb, %off;
    ld.shared.f32 %bv, [%off];

    fma.rn.f32 %acc, %av, %bv, %acc;

    add.u32 %k, %k, 1;
    bra $L_loop_k;

$L_k_done:
    bar.sync 0;
    add.u32 %t, %t, 16;
    bra $L_loop_t;

$L_done:
    // C[row][col] = acc (bounds checked)
    setp.lt.u32 %p1, %row, %n;
    setp.lt.u32 %p2, %col, %n;
    and.pred %p1, %p1, %p2;
    @!%p1 bra $L_ret;
    mul.lo.u32 %r1, %row, %n;
    add.u32 %r1, %r1, %col;
    cvt.u64.u32 %off, %r1;
    shl.b64 %off, %off, 2;
    add.u64 %off, %cp, %off;
    st.global.f32 [%off], %acc;
$L_ret:
    ret;
}
"""

_ptx_module = None

def _get_ptx_module():
    global _ptx_module
    if _ptx_module is None:
        _ptx_module = PtxModule(PTX_SOURCE)
    return _ptx_module

def validate_generated_code():
    # Force PTX JIT assembly and entry-point lookup during compile validation.
    _get_ptx_module().function("matmul_kernel")

class ModelNew(nn.Module):
    def __init__(self):
        super().__init__()

    def forward(self, A: torch.Tensor, B: torch.Tensor) -> torch.Tensor:
        n = A.shape[0]
        C = torch.empty((n, n), dtype=A.dtype, device=A.device)
        module = _get_ptx_module()
        tile = 16
        grid = ((n + tile - 1) // tile, (n + tile - 1) // tile, 1)
        module.launch(
            "matmul_kernel",
            grid=grid,
            block=(tile, tile, 1),
            arguments=[A, B, C, i32(n)],
            shared_memory=0,
            stream=torch.cuda.current_stream(A.device),
        )
        return C
