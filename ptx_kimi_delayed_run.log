        module = _get_ptx_module()
        tile = 16
        cta_tile = 64
        grid = ((n + cta_tile - 1) // cta_tile, (n + cta_tile - 1) // cta_tile, 1)
        module.launch(
            "matmul_kernel",
            grid=grid,
