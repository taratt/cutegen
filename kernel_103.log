cuda_src = r"""
#include <torch/extension.h>
#include <cuda_runtime.h>
#include <c10/cuda/CUDAStream.h>

#include <cute/tensor.hpp>

using namespace cute;

// Cooperative tiled Conv2d forward (stride>=1, symmetric padding, dilation=1).
// Each block handles CTile output channels x (Threads*PVec) output positions
// of one image. Weights are staged into shared memory in chunks via CuTe
// tensors, inputs are read through CuTe global tensors (heavy reuse via L1),
// and each loaded input value feeds CTile FMAs.
template <typename T>
__global__ void conv2d_tiled_kernel(
    const T* __restrict__ X,
    const T* __restrict__ W,
    const T* __restrict__ B,
    T* __restrict__ Y,
    int N, int Cin, int H, int Win,
    int Cout, int Kh, int Kw,
    int stride, int padding,
    int Hout, int Wout)
{
  constexpr int Threads    = 128;
  constexpr int PVec       = 4;
  constexpr int CTile      = 8;
  constexpr int KChunk     = 64;

  const int tid    = threadIdx.x;
  const int n      = blockIdx.z;
  const int c_base = blockIdx.y * CTile;

  const int P_total = Hout * Wout;
  const int PTile   = Threads * PVec;
  const int p_block = blockIdx.x * PTile;

  const int Ktot = Cin * Kh * Kw;   // flattened reduction dim (ic, kh, kw)
  const int Khw  = Kh * Kw;

  // Global memory strides
  const int64_t sXn = (int64_t)Cin * H * Win;
  const int64_t sXc = (int64_t)H * Win;
  const int64_t sXh = (int64_t)Win;

  const int64_t sYn = (int64_t)Cout * Hout * Wout;
  const int64_t sYc = (int64_t)Hout * Wout;
  const int64_t sYh = (int64_t)Wout;

  // CuTe tensors over global memory (per-image views)
  auto mX = make_tensor(
      make_gmem_ptr(X + (int64_t)n * sXn),
      make_shape(Cin, H, Win),
      make_stride(sXc, sXh, Int<1>{})
  );

  auto mY = make_tensor(
      make_gmem_ptr(Y + (int64_t)n * sYn),
      make_shape(Cout, Hout, Wout),
      make_stride(sYc, sYh, Int<1>{})
  );

  // Weight viewed as (Cout, Ktot) row-major
  auto mW = make_tensor(
      make_gmem_ptr(W),
      make_shape(Cout, Ktot),
      make_stride(Ktot, Int<1>{})
  );

  // Shared-memory weight chunk [CTile, KChunk]
  __shared__ T sW_raw[CTile * KChunk];
  auto sW = make_tensor(
      make_smem_ptr(sW_raw),
      make_shape(Int<CTile>{}, Int<KChunk>{}),
      make_stride(Int<KChunk>{}, Int<1>{})
  );

  // Per-thread output positions and precomputed base input coords
  int  p_idx[PVec];
  int  oh_arr[PVec];
  int  ow_arr[PVec];
  int  ih0_arr[PVec];
  int  iw0_arr[PVec];
  bool valid[PVec];

  #pragma unroll
  for (int i = 0; i < PVec; ++i) {
    int p = p_block + tid + i * Threads;
    p_idx[i] = p;
    if (p < P_total) {
      int oh = p / Wout;
      int ow = p - oh * Wout;
      oh_arr[i]  = oh;
      ow_arr[i]  = ow;
      ih0_arr[i] = oh * stride - padding;
      iw0_arr[i] = ow * stride - padding;
      valid[i]   = true;
    } else {
      oh_arr[i]  = 0;
      ow_arr[i]  = 0;
      ih0_arr[i] = 0;
      iw0_arr[i] = 0;
      valid[i]   = false;
    }
  }

  // Accumulators initialized with bias (or zero)
  float acc[CTile][PVec];
  #pragma unroll
  for (int cc = 0; cc < CTile; ++cc) {
    int c = c_base + cc;
    float bval = 0.0f;
    if (B != nullptr && c < Cout) {
      bval = (float)B[c];
    }
    #pragma unroll
    for (int i = 0; i < PVec; ++i) {
      acc[cc][i] = bval;
    }
  }

  // Main loop over reduction dimension in chunks of KChunk
  for (int k0 = 0; k0 < Ktot; k0 += KChunk) {
    const int kmax = min(KChunk, Ktot - k0);

    // Cooperatively stage the weight chunk into shared memory
    for (int kk = tid; kk < KChunk; kk += Threads) {
      int kg = k0 + kk;
      #pragma unroll
      for (int cc = 0; cc < CTile; ++cc) {
        int c = c_base + cc;
        T wv = T(0);
        if (c < Cout && kg < Ktot) {
          wv = mW(c, kg);
        }
        sW(cc, kk) = wv;
      }
    }
    __syncthreads();

    // Compute on this chunk
    for (int kk = 0; kk < kmax; ++kk) {
      int kg  = k0 + kk;
      int ic  = kg / Khw;
      int rem = kg - ic * Khw;
      int kh  = rem / Kw;
      int kw  = rem - kh * Kw;

      #pragma unroll
      for (int i = 0; i < PVec; ++i) {
        if (!valid[i]) continue;

        int ih = ih0_arr[i] + kh;
        int iw = iw0_arr[i] + kw;
        if ((unsigned)ih >= (unsigned)H) continue;
        if ((unsigned)iw >= (unsigned)Win) continue;

        float xv = (float)mX(ic, ih, iw);

        #pragma unroll
        for (int cc = 0; cc < CTile; ++cc) {
          acc[cc][i] += xv * (float)sW(cc, kk);
        }
      }
    }
    __syncthreads();
  }

  // Epilogue: write results
  #pragma unroll
  for (int cc = 0; cc < CTile; ++cc) {
    int c = c_base + cc;
    if (c >= Cout) continue;

    #pragma unroll
    for (int i = 0; i < PVec; ++i) {
      if (!valid[i]) continue;
      mY(c, oh_arr[i], ow_arr[i]) = static_cast<T>(acc[cc][i]);
    }
  }
}

torch::Tensor conv2d_forward(torch::Tensor x,
                             torch::Tensor w,
                             c10::optional<torch::Tensor> b,
                             int64_t stride,
                             int64_t padding) {
  TORCH_CHECK(x.is_cuda(), "x must be CUDA");
  TORCH_CHECK(w.is_cuda(), "w must be CUDA");
  if (b.has_value()) TORCH_CHECK(b.value().is_cuda(), "bias must be CUDA if provided");

  TORCH_CHECK(x.scalar_type() == at::kFloat, "x must be float32");
  TORCH_CHECK(w.scalar_type() == at::kFloat, "w must be float32");
  if (b.has_value()) {
    TORCH_CHECK(b.value().scalar_type() == at::kFloat, "bias must be float32");
  }

  TORCH_CHECK(x.dim() == 4, "x must be [N, Cin, H, W]");
  TORCH_CHECK(w.dim() == 4, "w must be [Cout, Cin, Kh, Kw]");
  TORCH_CHECK(stride > 0, "stride must be > 0");
  TORCH_CHECK(padding >= 0, "padding must be >= 0");

  const int64_t N    = x.size(0);
  const int64_t Cin  = x.size(1);
  const int64_t H    = x.size(2);
  const int64_t Win  = x.size(3);

  const int64_t Cout = w.size(0);
  const int64_t Kh   = w.size(2);
  const int64_t Kw   = w.size(3);

  TORCH_CHECK(w.size(1) == Cin, "w.size(1) must equal x.size(1)");

  const int64_t Hout = (H + 2 * padding - Kh) / stride + 1;
  const int64_t Wout = (Win + 2 * padding - Kw) / stride + 1;
  TORCH_CHECK(Hout > 0 && Wout > 0, "Invalid output size computed");

  auto x_c = x.contiguous();
  auto w_c = w.contiguous();

  torch::Tensor b_c;
  const float* b_ptr = nullptr;
  if (b.has_value()) {
    b_c = b.value().contiguous();
    TORCH_CHECK(b_c.dim() == 1 && b_c.size(0) == Cout, "bias must be [Cout]");
    b_ptr = b_c.data_ptr<float>();
  }

  auto y = torch::empty({N, Cout, Hout, Wout}, x.options());

  constexpr int Threads = 128;
  constexpr int PVec    = 4;
  constexpr int CTile   = 8;

  const int64_t P_total = Hout * Wout;
  const int64_t PTile   = Threads * PVec;

  dim3 block(Threads);
  dim3 grid(
      (unsigned)((P_total + PTile - 1) / PTile),
      (unsigned)((Cout + CTile - 1) / CTile),
      (unsigned)N
  );

  cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();

  conv2d_tiled_kernel<float><<<grid, block, 0, stream>>>(
      x_c.data_ptr<float>(),
      w_c.data_ptr<float>(),
      b_ptr,
      y.data_ptr<float>(),
      (int)N, (int)Cin, (int)H, (int)Win,
      (int)Cout, (int)Kh, (int)Kw,
      (int)stride, (int)padding,
      (int)Hout, (int)Wout
  );

  auto err = cudaGetLastError();
  TORCH_CHECK(err == cudaSuccess, "conv2d_tiled_kernel launch failed: ",
              cudaGetErrorString(err));

  return y;
}
"""

conv2d_ext = load_inline(
    name="cute_conv2d_k11s4_ext",
    cpp_sources=cpp_decl,
    cuda_sources=cuda_src,
    functions=["conv2d_forward"],
    extra_cflags=["-O3"],
    extra_cuda_cflags=["-O3"],
    extra_include_paths=[
        "/home/tarasaba/PycharmProjects/cutegen_test/cutegen/cutlass/include",
        "/home/tarasaba/PycharmProjects/cutegen_test/cutegen/cutlass/include/cute/",
    ],
    verbose=False,
)


class ModelNew(nn.Module):
    """
    Conv2d(3 -> 96, kernel_size=11, stride=4, padding=2) implemented with a
    single cooperative tiled CuTe/CUDA kernel.
    """
    def __init__(self, num_classes=1000):
        super(ModelNew, self).__init__()
        # Parameters stored in a standard Conv2d module (state_dict compatible),
        # but forward() runs entirely on the custom CuTe kernel.
        self.conv1 = nn.Conv2d(in_channels=3, out_channels=96, kernel_size=11,
                               stride=4, padding=2)
        self._ext = conv2d_ext

    def forward(self, x):
        return self._ext.conv2d_forward(
            x,
            self.conv1.weight,
            self.conv1.bias,
            int(self.conv1.stride[0]),
            int(self.conv1.padding[0]),
        )
