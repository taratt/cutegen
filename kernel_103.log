cuda_src = r"""
#include <torch/extension.h>
#include <cuda_runtime.h>
#include <c10/cuda/CUDAStream.h>

#include <cute/tensor.hpp>

using namespace cute;

// Cooperative tiled Conv2d forward (stride>=1, symmetric padding, dilation=1).
// Each block handles CTile output channels x (Threads*PVec) output positions
// of one image. OPTIMIZATION (shared-memory reuse + hot-loop restructure):
// the FULL weight tile [CTile, Ktot] is staged once into shared memory via
// CuTe tensors (Ktot = Cin*Kh*Kw is small), eliminating per-chunk staging
// and all __syncthreads from the main loop. The reduction is iterated
// directly as (ic, kh, kw) with per-position valid kernel ranges
// precomputed, so the hot loop is division-free and needs no per-element
// bounds checks: one coalesced gmem load feeds CTile FMAs with
// warp-broadcast shared-memory weights.
template <typename T>
__global__ void conv2d_tiled_kernel(
    const T* __restrict__ X,
    const T* __restrict__ W,
    const T* __restrict__ B,
    T* __restrict__ Y,
    int N, int Cin, int H, int Win,
    int Cout, int Kh, int Kw,
    int stride, int padding,
    int Hout, int Wout)
{
  constexpr int Threads    = 128;
  constexpr int PVec       = 4;
  constexpr int CTile      = 8;
  const int tid    = threadIdx.x;
  const int n      = blockIdx.z;
  const int c_base = blockIdx.y * CTile;
  const int P_total = Hout * Wout;
  const int PTile   = Threads * PVec;
  const int p_block = blockIdx.x * PTile;
  const int Ktot = Cin * Kh * Kw;   // flattened reduction dim (ic, kh, kw)
  const int Khw  = Kh * Kw;
  // Global memory strides
  const int64_t sXn = (int64_t)Cin * H * Win;
  const int64_t sXc = (int64_t)H * Win;
  const int64_t sXh = (int64_t)Win;
  const int64_t sYn = (int64_t)Cout * Hout * Wout;
  const int64_t sYc = (int64_t)Hout * Wout;
  const int64_t sYh = (int64_t)Wout;
  // CuTe tensor over global memory (per-image output view)
  auto mY = make_tensor(
      make_gmem_ptr(Y + (int64_t)n * sYn),
      make_shape(Cout, Hout, Wout),
      make_stride(sYc, sYh, Int<1>{})
  );
  // Weight viewed as (Cout, Ktot) row-major
  auto mW = make_tensor(
      make_gmem_ptr(W),
      make_shape(Cout, Ktot),
      make_stride(Ktot, Int<1>{})
  );
  // Dynamic shared memory holding the FULL weight tile [CTile, Ktot]
  extern __shared__ T sW_raw[];
  auto sW = make_tensor(
      make_smem_ptr(sW_raw),
      make_shape(Int<CTile>{}, Ktot),
      make_stride(Ktot, Int<1>{})
  );
  // Cooperatively stage the weight tile once (coalesced along k)
  #pragma unroll
  for (int cc = 0; cc < CTile; ++cc) {
    const int c = c_base + cc;
    for (int k = tid; k < Ktot; k += Threads) {
      sW(cc, k) = (c < Cout) ? mW(c, k) : T(0);
    }
  }
  __syncthreads();
  // Per-thread output positions, valid kernel ranges and base input
  // pointers (all per-element bounds checks hoisted out of the hot loop)
  int   oh_arr[PVec];
  int   ow_arr[PVec];
  int   kh_lo[PVec];
  int   kh_hi[PVec];
  int   kw_lo[PVec];
  int   kw_hi[PVec];
  const T* xbase[PVec];
  bool  valid[PVec];
  #pragma unroll
  for (int i = 0; i < PVec; ++i) {
    const int p = p_block + tid + i * Threads;
    if (p < P_total) {
      const int oh  = p / Wout;
      const int ow  = p - oh * Wout;
      const int ih0 = oh * stride - padding;
      const int iw0 = ow * stride - padding;
      oh_arr[i] = oh;
      ow_arr[i] = ow;
      kh_lo[i] = max(0, -ih0);
      kh_hi[i] = min(Kh, H - ih0);
      kw_lo[i] = max(0, -iw0);
      kw_hi[i] = min(Kw, Win - iw0);
      xbase[i] = X + (int64_t)n * sXn + (int64_t)ih0 * sXh + iw0;
      valid[i] = true;
    } else {
      oh_arr[i] = 0;
      ow_arr[i] = 0;
      kh_lo[i] = 0;
      kh_hi[i] = 0;
      kw_lo[i] = 0;
      kw_hi[i] = 0;
      xbase[i]  = X;
      valid[i]  = false;
    }
  }
  // Accumulators initialized with bias (or zero)
  float acc[CTile][PVec];
  #pragma unroll
  for (int cc = 0; cc < CTile; ++cc) {
    const int c = c_base + cc;
    float bval = 0.0f;
    if (B != nullptr && c < Cout) {
      bval = (float)B[c];
    }
    #pragma unroll
    for (int i = 0; i < PVec; ++i) {
      acc[cc][i] = bval;
    }
  }
  // Division-free main loop over (ic, kh, kw): one coalesced global load
  // feeds CTile FMAs with warp-broadcast shared-memory weights.
  for (int ic = 0; ic < Cin; ++ic) {
    const int64_t xoff_c = (int64_t)ic * sXc;
    const int     woff_c = ic * Khw;
    #pragma unroll
    for (int i = 0; i < PVec; ++i) {
      if (!valid[i]) continue;
      const T* __restrict__ xic = xbase[i] + xoff_c;
      for (int kh = kh_lo[i]; kh < kh_hi[i]; ++kh) {
        const T* __restrict__ xrow = xic + (int64_t)kh * sXh;
        const int woff_r = woff_c + kh * Kw;
        const int kw_end = kw_hi[i];
        const T* __restrict__ xp = xrow + kw_lo[i];
        for (int kw = kw_lo[i]; kw < kw_end; ++kw) {
          const float xv = (float)(*xp);
          ++xp;
          const int kk = woff_r + kw;
          #pragma unroll
          for (int cc = 0; cc < CTile; ++cc) {
            acc[cc][i] += xv * (float)sW(cc, kk);
          }
        }
      }
    }
  }
  // Epilogue: write results
  #pragma unroll
  for (int cc = 0; cc < CTile; ++cc) {
    const int c = c_base + cc;
    if (c >= Cout) continue;
    #pragma unroll
    for (int i = 0; i < PVec; ++i) {
      if (!valid[i]) continue;
      mY(c, oh_arr[i], ow_arr[i]) = static_cast<T>(acc[cc][i]);
    }
  }
}

torch::Tensor conv2d_forward(torch::Tensor x,
                             torch::Tensor w,
                             c10::optional<torch::Tensor> b,
                             int64_t stride,
                             int64_t padding) {
  TORCH_CHECK(x.is_cuda(), "x must be CUDA");
  TORCH_CHECK(w.is_cuda(), "w must be CUDA");
  if (b.has_value()) TORCH_CHECK(b.value().is_cuda(), "bias must be CUDA if provided");

  TORCH_CHECK(x.scalar_type() == at::kFloat, "x must be float32");
  TORCH_CHECK(w.scalar_type() == at::kFloat, "w must be float32");
  if (b.has_value()) {
    TORCH_CHECK(b.value().scalar_type() == at::kFloat, "bias must be float32");
  }

  TORCH_CHECK(x.dim() == 4, "x must be [N, Cin, H, W]");
  TORCH_CHECK(w.dim() == 4, "w must be [Cout, Cin, Kh, Kw]");
  TORCH_CHECK(stride > 0, "stride must be > 0");
  TORCH_CHECK(padding >= 0, "padding must be >= 0");

  const int64_t N    = x.size(0);
  const int64_t Cin  = x.size(1);
  const int64_t H    = x.size(2);
  const int64_t Win  = x.size(3);

  const int64_t Cout = w.size(0);
  const int64_t Kh   = w.size(2);
  const int64_t Kw   = w.size(3);

  TORCH_CHECK(w.size(1) == Cin, "w.size(1) must equal x.size(1)");

  const int64_t Hout = (H + 2 * padding - Kh) / stride + 1;
  const int64_t Wout = (Win + 2 * padding - Kw) / stride + 1;
  TORCH_CHECK(Hout > 0 && Wout > 0, "Invalid output size computed");

  auto x_c = x.contiguous();
  auto w_c = w.contiguous();

  torch::Tensor b_c;
  const float* b_ptr = nullptr;
  if (b.has_value()) {
    b_c = b.value().contiguous();
    TORCH_CHECK(b_c.dim() == 1 && b_c.size(0) == Cout, "bias must be [Cout]");
    b_ptr = b_c.data_ptr<float>();
  }

  auto y = torch::empty({N, Cout, Hout, Wout}, x.options());

  constexpr int Threads = 128;
  constexpr int PVec    = 4;
  constexpr int CTile   = 8;

  const int64_t P_total = Hout * Wout;
  const int64_t PTile   = Threads * PVec;
  const int64_t Ktot = Cin * Kh * Kw;
  const size_t smem_bytes = (size_t)CTile * (size_t)Ktot * sizeof(float);
  if (smem_bytes > 48 * 1024) {
    cudaFuncSetAttribute(conv2d_tiled_kernel<float>,
                         cudaFuncAttributeMaxDynamicSharedMemorySize,
                         (int)smem_bytes);
  }

  dim3 block(Threads);
  dim3 grid(
      (unsigned)((P_total + PTile - 1) / PTile),
      (unsigned)((Cout + CTile - 1) / CTile),
      (unsigned)N
  );

  cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();

  conv2d_tiled_kernel<float><<<grid, block, smem_bytes, stream>>>(
      x_c.data_ptr<float>(),
      w_c.data_ptr<float>(),
      b_ptr,
      y.data_ptr<float>(),
      (int)N, (int)Cin, (int)H, (int)Win,
      (int)Cout, (int)Kh, (int)Kw,
      (int)stride, (int)padding,
      (int)Hout, (int)Wout
  );

  auto err = cudaGetLastError();
  TORCH_CHECK(err == cudaSuccess, "conv2d_tiled_kernel launch failed: ",
              cudaGetErrorString(err));

  return y;
}
