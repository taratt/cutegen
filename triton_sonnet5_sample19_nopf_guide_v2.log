    x_flat = x.contiguous().view(-1)
    out_flat = out.view(-1)
    numel = x_flat.numel()
    grid = (triton.cdiv(numel, BLOCK_SIZE * UNROLL),)
    custom_kernel[grid](
        x_flat, out_flat,
