Src: import torch
import torch.nn as nn
import triton
import triton.language as tl


@triton.jit
def custom_kernel(
    x_ptr, w_ptr, bias_ptr, out_ptr,
    B, C_in, D, H, W,
    C_out,
    D_out, H_out, W_out,
    stride, padding, dilation,
    groups,
    stride_xb, stride_xc, stride_xd, stride_xh, stride_xw,
    stride_wo, stride_wc, stride_wd, stride_wh, stride_ww,
    stride_ob, stride_oc, stride_od, stride_oh, stride_ow,
    C_IN_PER_GROUP: tl.constexpr,
    C_OUT_PER_GROUP: tl.constexpr,
    KSIZE: tl.constexpr,
    HAS_BIAS: tl.constexpr,
    BLOCK_HW: tl.constexpr,
    BLOCK_CO: tl.constexpr,
):
    pid_bc = tl.program_id(0)  # combined b, group, co_block index
    pid_d = tl.program_id(1)   # d_out index
    pid_hw = tl.program_id(2)  # hw block index
    num_co_blocks_per_group = C_OUT_PER_GROUP // BLOCK_CO
    tmp = pid_bc
    co_block_idx = tmp % num_co_blocks_per_group
    tmp = tmp // num_co_blocks_per_group
    g = tmp % groups
    b = tmp // groups
    co_base = g * C_OUT_PER_GROUP + co_block_idx * BLOCK_CO
    co_offsets = co_base + tl.arange(0, BLOCK_CO)
    hw_offsets = pid_hw * BLOCK_HW + tl.arange(0, BLOCK_HW)
    hw_total = H_out * W_out
    hw_mask = hw_offsets < hw_total
    h_out = hw_offsets // W_out
    w_out = hw_offsets % W_out
    d_out = pid_d
    acc = tl.zeros((BLOCK_CO, BLOCK_HW), dtype=tl.float32)
    b64 = b.to(tl.int64)
    co64 = co_offsets.to(tl.int64)
    for ci in range(C_IN_PER_GROUP):
        c_in_idx = g * C_IN_PER_GROUP + ci
        c_in_idx64 = c_in_idx.to(tl.int64) if isinstance(c_in_idx, tl.tensor) else c_in_idx
        for kd in range(KSIZE):
            d_in = d_out * stride - padding + kd * dilation
            d_valid = (d_in >= 0) & (d_in < D)
            d_in64 = d_in.to(tl.int64)
            for kh in range(KSIZE):
                h_in = h_out * stride - padding + kh * dilation
                h_valid = (h_in >= 0) & (h_in < H)
                h_in64 = h_in.to(tl.int64)
                for kw in range(KSIZE):
                    w_in = w_out * stride - padding + kw * dilation
                    w_valid = (w_in >= 0) & (w_in < W)
                    w_in64 = w_in.to(tl.int64)
                    mask = hw_mask & d_valid & h_valid & w_valid
                    x_offset = (
                        b64 * stride_xb
                        + c_in_idx64 * stride_xc
                        + d_in64 * stride_xd
                        + h_in64 * stride_xh
                        + w_in64 * stride_xw
                    )
                    x_val = tl.load(x_ptr + x_offset, mask=mask, other=0.0)
                    w_offset = (
                        co64 * stride_wo
                        + ci * stride_wc
                        + kd * stride_wd
                        + kh * stride_wh
                        + kw * stride_ww
                    )
                    w_val = tl.load(w_ptr + w_offset)
                    acc += w_val[:, None] * x_val[None, :]
    if HAS_BIAS:
        bias_val = tl.load(bias_ptr + co_offsets)
        acc = acc + bias_val[:, None]
    out_offset = (
        b64 * stride_ob
        + co64[:, None] * stride_oc
        + d_out.to(tl.int64) * stride_od
        + h_out[None, :].to(tl.int64) * stride_oh
        + w_out[None, :].to(tl.int64) * stride_ow
    )
    tl.store(out_ptr + out_offset, acc, mask=hw_mask[None, :])
def _launch_conv3d(x, weight, bias, stride, padding, dilation, groups):
    B, C_in, D, H, W = x.shape
    C_out, C_in_per_group, K, _, _ = weight.shape
    D_out = (D + 2 * padding - dilation * (K - 1) - 1) // stride + 1
    H_out = (H + 2 * padding - dilation * (K - 1) - 1) // stride + 1
    W_out = (W + 2 * padding - dilation * (K - 1) - 1) // stride + 1
    out = torch.empty((B, C_out, D_out, H_out, W_out), device=x.device, dtype=x.dtype)
    x = x.contiguous()
    weight = weight.contiguous()
    if bias is not None:
        bias = bias.contiguous()
    C_out_per_group = C_out // groups
    def _pick_block_co(c_out_per_group):
        for cand in (32, 16, 8, 4, 2, 1):
            if c_out_per_group % cand == 0:
                return cand
        return 1
    BLOCK_CO = _pick_block_co(C_out_per_group)
    BLOCK_HW = 64
    num_co_blocks_per_group = C_out_per_group // BLOCK_CO
    grid = (
        B * groups * num_co_blocks_per_group,
        D_out,
        triton.cdiv(H_out * W_out, BLOCK_HW),
    )
    has_bias = bias is not None
    bias_arg = bias if has_bias else x  # dummy pointer, unused when HAS_BIAS is False
    custom_kernel[grid](
        x, weight, bias_arg, out,
        B, C_in, D, H, W,
        C_out,
        D_out, H_out, W_out,
        stride, padding, dilation,
        groups,
        x.stride(0), x.stride(1), x.stride(2), x.stride(3), x.stride(4),
        weight.stride(0), weight.stride(1), weight.stride(2), weight.stride(3), weight.stride(4),
