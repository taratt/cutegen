warps=4, num_stages=2,\n    )\n\n\nclass ModelNew(nn.Module):\n    """\n    Performs a depthwise 2D convolution with a square input and an asymmetric kernel,\n    computed via a single custom Triton kernel.\n    """\n\n    def __init__(self, in_channels: int, kernel_size: int, stride: int = 1,\n                 padding: int = 0, dilation: int = 1, bias: bool = False):\n        super(ModelNew, self).__init__()\n        # Keep exact reference module for parameter storage/initialization semantics.\n        self.conv2d = nn.Conv2d(\n            in_channels, in_channels, kernel_size=(kernel_size, 1),\n            stride=stride, padding=padding, dilation=dilation,\n            groups=in_channels, bias=bias\n        )\n\n        self.in_channels = in_channels\n        self.kernel_size = kernel_size\n        self.stride = stride\n        self.padding = padding\n        self.dilation = dilation\n        self.has_bias = bias\n\n        self.BLOCK = 1024\n\n    def forward(self, x: torch.Tensor) -> torch.Tensor:\n        assert x.is_cuda, "Input must be on CUDA device"\n        x = x.contiguous()\n\n        N, C, H, W = x.shape\n        KH = self.conv2d.kernel_size[0]\n        stride = self.conv2d.stride[0]\n        padding = self.conv2d.padding[0]\n        dilation = self.conv2d.dilation[0]\n\n        OH = _compute_output_size(H, padding, dilation, KH, stride)\n        OW = _compute_output_size(W, padding, dilation, 1, stride)\n\n        weight = self.conv2d.weight.contiguous()\n        bias = self.conv2d.bias\n        HAS_BIAS = bias is not None\n\n        out = torch.empty((N, C, OH, OW), device=x.device, dtype=x.dtype)\n\n        BLOCK = self.BLOCK\n        grid = (N * C, triton.cdiv(OH * OW, BLOCK))\n\n        bias_arg = bias if HAS_BIAS else x  # placeholder pointer, unused when HAS_BIAS is False\n\n        custom_kernel[grid](\n            x, weight, bias_arg, out,\n            N, C, H, W, OH, OW,\n            x.stride(0), x.stride(1), x.stride(2), x.stride(3),\n       