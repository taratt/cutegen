def _launch_conv2d(x, weight, bias, stride, padding, dilation, groups,
                    BLOCK_H=16, BLOCK_W=64):
    x = x.contiguous()
    weight = weight.contiguous()
    N, C_in, H, W = x.shape
    C_out, C_in_per_group, KH, KW = weight.shape
    stride_h, stride_w = stride
    pad_h, pad_w = padding
    dil_h, dil_w = dilation
    H_out = (H + 2 * pad_h - dil_h * (KH - 1) - 1) // stride_h + 1
    W_out = (W + 2 * pad_w - dil_w * (KW - 1) - 1) // stride_w + 1
    out = torch.empty((N, C_out, H_out, W_out), device=x.device, dtype=x.dtype)
    has_bias = bias is not None
