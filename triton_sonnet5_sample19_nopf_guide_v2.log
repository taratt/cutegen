import torch.nn as nn
import triton
import triton.language as tl


@triton.jit
def custom_kernel(
    x_ptr, w_ptr, b_ptr, out_ptr,
    B, IC, H, W, OC, OH, OW,
    KH: tl.constexpr, KW: tl.constexpr,
    stride_h, stride_w, pad_h, pad_w, dilation_h, dilation_w,
    stride_xb, stride_xc, stride_xh, stride_xw,
    stride_wo, stride_wi, stride_wh, stride_ww,
    stride_ob, stride_oc, stride_oh, stride_ow,
    HAS_BIAS: tl.constexpr,
    BLOCK_M: tl.constexpr, BLOCK_N: tl.constexpr, BLOCK_K: tl.constexpr,
):
    pid_b = tl.program_id(0)
    pid_m = tl.program_id(1)
    pid_n = tl.program_id(2)
    b = pid_b.to(tl.int64)
    offs_m = (pid_m * BLOCK_M + tl.arange(0, BLOCK_M)).to(tl.int64)
    offs_n = (pid_n * BLOCK_N + tl.arange(0, BLOCK_N)).to(tl.int64)
    offs_k = tl.arange(0, BLOCK_K).to(tl.int64)
    mask_m = offs_m < (OH * OW)
    mask_n = offs_n < OC
    mask_k = offs_k < IC
    oh = offs_m // OW
    ow = offs_m % OW
    acc = tl.zeros((BLOCK_M, BLOCK_N), dtype=tl.float32)
    for kh in range(KH):
        for kw in range(KW):
            ih = oh * stride_h - pad_h + kh * dilation_h
            iw = ow * stride_w - pad_w + kw * dilation_w
            mask_ih = (ih >= 0) & (ih < H)
            mask_iw = (iw >= 0) & (iw < W)
            x_ptrs = (
                x_ptr
                + b * stride_xb
                + offs_k[None, :] * stride_xc
                + ih[:, None] * stride_xh
                + iw[:, None] * stride_xw
            )
            x_mask = (
                mask_m[:, None]
                & mask_ih[:, None]
                & mask_iw[:, None]
                & mask_k[None, :]
            )
            x_val = tl.load(x_ptrs, mask=x_mask, other=0.0)
            w_ptrs = (
                w_ptr
                + offs_n[None, :] * stride_wo
                + offs_k[:, None] * stride_wi
                + kh * stride_wh
                + kw * stride_ww
            )
            w_mask = mask_k[:, None] & mask_n[None, :]
            w_val = tl.load(w_ptrs, mask=w_mask, other=0.0)
            acc += tl.dot(x_val, w_val, allow_tf32=False)
    if HAS_BIAS:
        bias_val = tl.load(b_ptr + offs_n, mask=mask_n, other=0.0)
        acc = acc + bias_val[None, :]
    out_ptrs = (
        out_ptr
        + b * stride_ob
        + offs_n[None, :] * stride_oc
        + oh[:, None] * stride_oh
        + ow[:, None] * stride_ow
    )
    out_mask = mask_m[:, None] & mask_n[None, :]
    tl.store(out_ptrs, acc, mask=out_mask)


def validate_generated_code():
    if not torch.cuda.is_available():
        return
    device = torch.device("cuda")

    B, IC, OC = 8, 32, 64
    KH, KW = 5, 9
    H = W = 512
    stride_h, stride_w = 1, 1
    pad_h, pad_w = 2, 4
    dilation_h, dilation_w = 2, 3

    OH = (H + 2 * pad_h - dilation_h * (KH - 1) - 1) // stride_h + 1
    OW = (W + 2 * pad_w - dilation_w * (KW - 1) - 1) // stride_w + 1

    x = torch.rand(B, IC, H, W, device=device, dtype=torch.float32)
    x_gemm = x.permute(0, 2, 3, 1).contiguous()
    weight = torch.rand(OC, IC, KH, KW, device=device, dtype=torch.float32)
    weight_gemm = weight.permute(2, 3, 1, 0).contiguous()
    bias = torch.zeros(1, device=device, dtype=torch.float32)
    out = torch.empty(B, OC, OH, OW, device=device, dtype=torch.float32)
    BLOCK_M = 128
