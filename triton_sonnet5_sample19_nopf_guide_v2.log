import torch.nn as nn
import triton
import triton.language as tl

# Fixed, reproducible launch configuration
BLOCK_M = 32
BLOCK_K = 4096
NUM_WARPS = 8
NUM_STAGES = 2


@triton.jit
def custom_kernel(
    a_ptr, b_ptr, c_ptr,
    M, K,
    stride_am, stride_ak,
    stride_bk,
    stride_cm,
    BLOCK_M: tl.constexpr,
    BLOCK_K: tl.constexpr,
):
    """
    Computes C = A @ B where A is (M, K) and B is (K, 1), producing C of shape (M, 1).
    Each program instance handles a block of BLOCK_M rows, looping over the K
    dimension in chunks of BLOCK_K, accumulating the dot product in float32.
    """
    pid = tl.program_id(0)

    rm = pid * BLOCK_M + tl.arange(0, BLOCK_M)
    mask_m = rm < M

    acc = tl.zeros((BLOCK_M,), dtype=tl.float32)

    for k0 in range(0, K, BLOCK_K):
        rk = k0 + tl.arange(0, BLOCK_K)
        mask_k = rk < K

        a_ptrs = a_ptr + rm[:, None].to(tl.int64) * stride_am + rk[None, :].to(tl.int64) * stride_ak
        a_mask = mask_m[:, None] & mask_k[None, :]
        a = tl.load(a_ptrs, mask=a_mask, other=0.0)

        b_ptrs = b_ptr + rk.to(tl.int64) * stride_bk
        b = tl.load(b_ptrs, mask=mask_k, other=0.0)

        acc += tl.sum(a * b[None, :], axis=1)

    c_ptrs = c_ptr + rm.to(tl.int64) * stride_cm
    tl.store(c_ptrs, acc, mask=mask_m)


def validate_generated_code():
    """
    Forces Triton JIT compilation with a small representative launch that
    exercises the loop and masking logic (non-divisible K and M) without
    allocating the full-size reference tensors.
    """
    if not torch.cuda.is_available():
        return
    device = torch.device("cuda")

    M_val = 37          # not a multiple of BLOCK_M -> exercises row mask
    K_val = BLOCK_K * 2 + 17  # not a multiple of BLOCK_K -> exercises col mask

    A = torch.rand(M_val, K_val, device=device, dtype=torch.float32)
    B = torch.rand(K_val, 1, device=device, dtype=torch.float32)
    C = torch.empty(M_val, 1, device=device, dtype=torch.float32)

    grid = (triton.cdiv(M_val, BLOCK_M),)
    custom_kernel[grid](
        A, B, C,
        M_val, K_val,
        A.stride(0), A.stride(1),
        B.stride(0),
        C.stride(0),
        BLOCK_M=BLOCK_M,
        BLOCK_K=BLOCK_K,
        num_warps=NUM_WARPS,
        num_stages=NUM_STAGES,
    )
    torch.cuda.synchronize()


class ModelNew(nn.Module):
    """
    Simple model that performs matrix-vector multiplication (C = A * B)
    using a single custom Triton kernel.
    """

    def __init__(self):
        super(ModelNew, self).__init__()

    def forward(self, A: torch.Tensor, B: torch.Tensor) -> torch.Tensor:
        assert A.is_cuda and B.is_cuda, "Inputs must be on CUDA device"
        assert A.dtype == torch.float32 and B.dtype == torch.float32

        M, K = A.shape
        K_b, N = B.shape
        assert K_b == K and N == 1

        C = torch.empty((M, 1), device=A.device, dtype=A.dtype)

        grid = (triton.cdiv(M, BLOCK_M),)
        custom_kernel[grid](
            A, B, C,
            M, K,
            A.stride(0), A.stride(1),
            B.stride(0),
            C.stride(0),
            BLOCK_M=BLOCK_M,
            BLOCK_K=BLOCK_K,
            num_warps=NUM_WARPS,
            num_stages=NUM_STAGES,
        )
        return C
