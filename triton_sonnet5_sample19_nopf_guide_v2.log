class ModelNew(nn.Module):
    """
    Simple model that performs a single matrix multiplication (C = A * B)
    using a custom Triton kernel, where one of the matrices is tall and
    skinny (M >> N or N >> M).
    """

    def __init__(self):
        super(ModelNew, self).__init__()

