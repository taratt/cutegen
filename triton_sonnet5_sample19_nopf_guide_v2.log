Src: import torch
import torch.nn as nn
import triton
import triton.language as tl
# Map torch dtypes to triton dtypes for explicit, precision-preserving stores.
_TORCH_TO_TRITON_DTYPE = {
    torch.float32: tl.float32,
    torch.float16: tl.float16,
    torch.bfloat16: tl.bfloat16,
}
@triton.jit(do_not_specialize=["N", "H", "W", "S", "stride_n", "stride_c", "stride_s"])
def custom_kernel(
    x_ptr, out_ptr,
    weight_ptr, bias_ptr,
    running_mean_ptr, running_var_ptr,
    sum_ptr, sumsq_ptr, mean_ptr, var_ptr,
    N, H, W, S,
    stride_n, stride_c, stride_s,
    eps, momentum,
    TRAINING: tl.constexpr,
    BLOCK_S: tl.constexpr,
    BLOCK_N: tl.constexpr,
    DTYPE: tl.constexpr,
    PHASE: tl.constexpr,
):
    # Program grid is (C, NBLOCKS_N, NBLOCKS_S) for PHASE 0 / PHASE 2, and (C,) for PHASE 1.
    c_idx = tl.program_id(0)
    c64 = c_idx.to(tl.int64)
    stride_n64 = stride_n.to(tl.int64)
    stride_c64 = stride_c.to(tl.int64)
    stride_s64 = stride_s.to(tl.int64)
    base_c = c64 * stride_c64
    if PHASE == 0:
        # ---- Parallel partial reduction over a chunk of the N and S dimensions ----
        n_block = tl.program_id(1)
        s_block = tl.program_id(2)
        n_start = n_block * BLOCK_N
        s_start = s_block * BLOCK_S
        offs_n = n_start + tl.arange(0, BLOCK_N)
        mask_n = offs_n < N
        base_n = offs_n.to(tl.int64) * stride_n64
        offs_s = s_start + tl.arange(0, BLOCK_S)
        offs_s = tl.max_contiguous(offs_s, BLOCK_S)
        mask_s = offs_s < S
        offs_s64 = offs_s.to(tl.int64)
        ptr_off = base_c + base_n[:, None] + offs_s64[None, :] * stride_s64
        mask = mask_n[:, None] & mask_s[None, :]
        xv = tl.load(x_ptr + ptr_off, mask=mask, other=0.0).to(tl.float32)
        acc_sum = tl.sum(xv)
        acc_sumsq = tl.sum(xv * xv)
        tl.atomic_add(sum_ptr + c_idx, acc_sum)
        tl.atomic_add(sumsq_ptr + c_idx, acc_sumsq)
    elif PHASE == 1:
        # ---- Finalize per-channel statistics (one program per channel) ----
        count_f = (N * S).to(tl.float32)
        s_total = tl.load(sum_ptr + c_idx)
        ssq_total = tl.load(sumsq_ptr + c_idx)
        mean = s_total / count_f
        var = ssq_total / count_f - mean * mean
        if TRAINING:
            denom = count_f - 1.0
            unbiased_var = var * (count_f / denom)
            old_mean = tl.load(running_mean_ptr + c_idx).to(tl.float32)
            old_var = tl.load(running_var_ptr + c_idx).to(tl.float32)
            new_mean = (1.0 - momentum) * old_mean + momentum * mean
            new_var = (1.0 - momentum) * old_var + momentum * unbiased_var
            tl.store(running_mean_ptr + c_idx, new_mean)
            tl.store(running_var_ptr + c_idx, new_var)
            tl.store(mean_ptr + c_idx, mean)
            tl.store(var_ptr + c_idx, var)
        else:
            use_mean = tl.load(running_mean_ptr + c_idx).to(tl.float32)
            use_var = tl.load(running_var_ptr + c_idx).to(tl.float32)
            tl.store(mean_ptr + c_idx, use_mean)
            tl.store(var_ptr + c_idx, use_var)
    else:
        # ---- PHASE 2: normalize and write output, parallel over N and S chunks ----
        n_block = tl.program_id(1)
        s_block = tl.program_id(2)
        n_start = n_block * BLOCK_N
        s_start = s_block * BLOCK_S
        use_mean = tl.load(mean_ptr + c_idx)
        use_var = tl.load(var_ptr + c_idx)
        w = tl.load(weight_ptr + c_idx).to(tl.float32)
        b = tl.load(bias_ptr + c_idx).to(tl.float32)
        inv_std = 1.0 / tl.sqrt(use_var + eps)
        offs_n = n_start + tl.arange(0, BLOCK_N)
        mask_n = offs_n < N
        base_n = offs_n.to(tl.int64) * stride_n64
        offs_s = s_start + tl.arange(0, BLOCK_S)
        offs_s = tl.max_contiguous(offs_s, BLOCK_S)
        mask_s = offs_s < S
        offs_s64 = offs_s.to(tl.int64)
        ptr_off = base_c + base_n[:, None] + offs_s64[None, :] * stride_s64
        mask = mask_n[:, None] & mask_s[None, :]
        xv = tl.load(x_ptr + ptr_off, mask=mask, other=0.0).to(tl.float32)
        y = (xv - use_mean) * inv_std * w + b
        tl.store(out_ptr + ptr_off, y.to(DTYPE), mask=mask)
def validate_generated_code():
    """Minimal launch to force Triton JIT compilation and catch compile errors."""
    if not torch.cuda.is_available():
        return
    device = "cuda"
    N, C, H, W = 2, 4, 8, 8
    S = H * W
    x = torch.randn(N, C, H, W, device=device, dtype=torch.float32)
    out = torch.empty_like(x)
    weight = torch.randn(C, device=device, dtype=torch.float32)
    bias = torch.randn(C, device=device, dtype=torch.float32)
    running_mean = torch.zeros(C, device=device, dtype=torch.float32)
    running_var = torch.ones(C, device=device, dtype=torch.float32)
    sum_buf = torch.zeros(C, device=device, dtype=torch.float32)
    sumsq_buf = torch.zeros(C, device=device, dtype=torch.float32)
    mean_buf = torch.empty(C, device=device, dtype=torch.float32)
    var_buf = torch.empty(C, device=device, dtype=torch.float32)
    stride_n = C * H * W
    stride_c = H * W
    stride_s = 1
    BLOCK_S = 1024
    BLOCK_N = 4
    NBLOCKS_N = (N + BLOCK_N - 1) // BLOCK_N
    NBLOCKS_S = (S + BLOCK_S - 1) // BLOCK_S
    common_args = (
        x, out,
        weight, bias,
        running_mean, running_var,
        sum_buf, sumsq_buf, mean_buf, var_buf,
        N, H, W, S,
        stride_n, stride_c, stride_s,
        1e-5, 0.1,
    )
    custom_kernel[(C, NBLOCKS_N, NBLOCKS_S)](
        *common_args,
        TRAINING=True,
        BLOCK_S=BLOCK_S,
        BLOCK_N=BLOCK_N,
        DTYPE=tl.float32,
        PHASE=0,
        num_warps=4,
    )
    custom_kernel[(C,)](
        *common_args,
        TRAINING=True,
        BLOCK_S=BLOCK_S,
        BLOCK_N=BLOCK_N,
        DTYPE=tl.float32,
        PHASE=1,
        num_warps=1,
    )
    custom_kernel[(C, NBLOCKS_N, NBLOCKS_S)](
        *common_args,
        TRAINING=True,
        BLOCK_S=BLOCK_S,
        BLOCK_N=BLOCK_N,
        DTYPE=tl.float32,
        PHASE=2,
        num_warps=8,
    )
class ModelNew(nn.Module):
    """
    Batch Normalization implemented with a single fused Triton kernel,
    split into three phases (parallel reduction, stats finalize, parallel
    normalize) launched over a larger grid for better GPU occupancy.
    """
    def __init__(self, num_features: int):
        super().__init__()
        # Reuse nn.BatchNorm2d purely as a parameter/buffer/config container.
        self.bn = nn.BatchNorm2d(num_features=num_features)
    def forward(self, x: torch.Tensor) -> torch.Tensor:
        assert x.dim() == 4, "Expected input of shape (N, C, H, W)"
        x = x.contiguous()
        N, C, H, W = x.shape
        S = H * W
        out = torch.empty_like(x)
        weight = self.bn.weight
        bias = self.bn.bias
        running_mean = self.bn.running_mean
        running_var = self.bn.running_var
        eps = float(self.bn.eps)
        training = bool(self.bn.training)
        if training and self.bn.track_running_stats:
            if self.bn.num_batches_tracked is not None:
                self.bn.num_batches_tracked += 1
            if self.bn.momentum is None:
                momentum = 1.0 / float(self.bn.num_batches_tracked.item())
            else:
                momentum = float(self.bn.momentum)
        else:
            momentum = float(self.bn.momentum) if self.bn.momentum is not None else 0.0
        stride_n = C * H * W
        stride_c = H * W
        stride_s = 1
        triton_dtype = _TORCH_TO_TRITON_DTYPE.get(x.dtype, tl.float32)
        BLOCK_S = 1024
        BLOCK_N = 32
        NBLOCKS_N = (N + BLOCK_N - 1) // BLOCK_N
        NBLOCKS_S = (S + BLOCK_S - 1) // BLOCK_S
        sum_buf = torch.zeros(C, device=x.device, dtype=torch.float32)
        sumsq_buf = torch.zeros(C, device=x.device, dtype=torch.float32)
        mean_buf = torch.empty(C, device=x.device, dtype=torch.float32)
        var_buf = torch.empty(C, device=x.device, dtype=torch.float32)
        common_args = (
            x, out,
            weight, bias,
            running_mean, running_var,
            sum_buf, sumsq_buf, mean_buf, var_buf,
            N, H, W, S,
            stride_n, stride_c, stride_s,
            eps, momentum,
        )
        # Phase 0: parallel reduction across (C, N-chunks) for sum / sum-of-squares.
        custom_kernel[(C, NBLOCKS_N, NBLOCKS_S)](
            *common_args,
            TRAINING=training,
            BLOCK_S=BLOCK_S,
            BLOCK_N=BLOCK_N,
            DTYPE=triton_dtype,
            PHASE=0,
            num_warps=4,
        )
        # Phase 1: finalize per-channel mean/var and update running stats.
        custom_kernel[(C,)](
            *common_args,
            TRAINING=training,
            BLOCK_S=BLOCK_S,
            BLOCK_N=BLOCK_N,
            DTYPE=triton_dtype,
            PHASE=1,
            num_warps=1,
        )
        # Phase 2: parallel normalize + write output across (C, N-chunks).
        custom_kernel[(C, NBLOCKS_N, NBLOCKS_S)](
            *common_args,
            TRAINING=training,
            BLOCK_S=BLOCK_S,
            BLOCK_N=BLOCK_N,
            DTYPE=triton_dtype,
            PHASE=2,
            num_warps=8,
        )
        return out
