Src: import torch
import torch.nn as nn
import triton
from triton.language.extra import libdevice
import triton.language as tl


@triton.jit
def custom_kernel(
    x_ptr,
    out_ptr,
    n_elements,
    x_stride,
    out_stride,
    BLOCK_SIZE: tl.constexpr,
):
    pid = tl.program_id(axis=0)
    num_programs = tl.num_programs(axis=0)
    block_start = pid.to(tl.int64) * BLOCK_SIZE
    step = num_programs.to(tl.int64) * BLOCK_SIZE
    while block_start < n_elements:
        offsets = block_start + tl.arange(0, BLOCK_SIZE).to(tl.int64)
        offsets = tl.multiple_of(offsets, BLOCK_SIZE)
        mask = offsets < n_elements
        # Input/output tensors are guaranteed contiguous (stride == 1) by the
        # calling code (flattened via reshape(-1)), so we skip the stride
        # multiplication entirely, avoiding extra integer arithmetic and
        # reducing register pressure per iteration.
        x = tl.load(x_ptr + offsets, mask=mask, other=0.0)
        y = libdevice.tanh(x)
        tl.store(out_ptr + offsets, y, mask=mask)
        block_start += step


def validate_generated_code():
    # Minimal representative launch to force JIT compilation and catch errors.
    device = "cuda" if torch.cuda.is_available() else "cpu"
    x = torch.rand((8, 16), device=device, dtype=torch.float32)
    out = torch.empty_like(x)

    x_flat = x.reshape(-1)
    out_flat = out.reshape(-1)
    n_elements = x_flat.numel()

    BLOCK_SIZE = 32768
    num_blocks = triton.cdiv(n_elements, BLOCK_SIZE)
    if device == "cuda":
        num_sms = torch.cuda.get_device_properties(x.device).multi_processor_count
        grid = (min(num_blocks, num_sms * 4),)
    else:
        grid = (num_blocks,)
    custom_kernel[grid](
        x_flat,
        out_flat,
        n_elements,
        x_flat.stride(0),
        out_flat.stride(0),
        BLOCK_SIZE=BLOCK_SIZE,
        num_warps=16,
        num_stages=2,
    )
    if device == "cuda":
        torch.cuda.synchronize()


class ModelNew(nn.Module):
    """
    Simple model that performs a Tanh activation using a custom Triton kernel.
    """

    def __init__(self):
        super(ModelNew, self).__init__()

    def forward(self, x: torch.Tensor) -> torch.Tensor:
        assert x.is_cuda, "Input tensor must be on CUDA device"

        out = torch.empty_like(x)

        x_flat = x.reshape(-1)
        out_flat = out.reshape(-1)
        n_elements = x_flat.numel()

        BLOCK_SIZE = 32768
        num_blocks = triton.cdiv(n_elements, BLOCK_SIZE)
        num_sms = torch.cuda.get_device_properties(x.device).multi_processor_count
        grid = (min(num_blocks, num_sms * 4),)
        custom_kernel[grid](
            x_flat,
            out_flat,
            n_elements,
            x_flat.stride(0),
            out_flat.stride(0),
            BLOCK_SIZE=BLOCK_SIZE,
            num_warps=16,
            num_stages=2,
        )

        return out
