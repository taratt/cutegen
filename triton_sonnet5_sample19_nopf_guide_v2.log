    padding = 0
    dilation = 1
    x = torch.rand(N, C, H, W, device=device, dtype=torch.float32)
    weight = torch.randn(C, 1, KH, 1, device=device, dtype=torch.float32)
    bias = torch.randn(C, device=device, dtype=torch.float32)
    OH = _compute_output_size(H, padding, dilation, KH, stride)
    OW = _compute_output_size(W, padding, dilation, 1, stride)
    out = torch.empty((N, C, OH, OW), device=device, dtype=torch.float32)
    BLOCK_OH = 32
    BLOCK_OW = 128
    BLOCK_KH = triton.next_power_of_2(KH)
