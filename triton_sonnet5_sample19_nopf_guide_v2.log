def _compute_output_size(size, pad, dilation, k, stride):
    return (size + 2 * pad - dilation * (k - 1) - 1) // stride + 1
def validate_generated_code():
    torch.manual_seed(0)
    device = "cuda" if torch.cuda.is_available() else "cpu"
    N, C, H, W = 64, 8, 512, 512
    KH = 3
    stride = 1
    padding = 0
    dilation = 1
