class ModelNew(nn.Module):
    """
    Batch Normalization implemented with a single fused Triton kernel,
    split into three phases (parallel reduction, stats finalize, parallel
    normalize) launched over a larger grid for better GPU occupancy.
    """
    def __init__(self, num_features: int):
        super().__init__()
        # Reuse nn.BatchNorm2d purely as a parameter/buffer/config container.
        self.bn = nn.BatchNorm2d(num_features=num_features)
    def forward(self, x: torch.Tensor) -> torch.Tensor:
        assert x.dim() == 4, "Expected input of shape (N, C, H, W)"
        x = x.contiguous()
        N, C, H, W = x.shape
        S = H * W
        out = torch.empty_like(x)
        weight = self.bn.weight
        bias = self.bn.bias
        running_mean = self.bn.running_mean
        running_var = self.bn.running_var
        eps = float(self.bn.eps)
        training = bool(self.bn.training)
        if training and self.bn.track_running_stats:
            if self.bn.num_batches_tracked is not None:
                self.bn.num_batches_tracked += 1
            if self.bn.momentum is None:
                momentum = 1.0 / float(self.bn.num_batches_tracked.item())
            else:
                momentum = float(self.bn.momentum)
        else:
            momentum = float(self.bn.momentum) if self.bn.momentum is not None else 0.0
        stride_n = C * H * W
        stride_c = H * W
        stride_s = 1
        triton_dtype = _TORCH_TO_TRITON_DTYPE.get(x.dtype, tl.float32)
        BLOCK_S = 1024
        BLOCK_N = 64
        NBLOCKS_N = (N + BLOCK_N - 1) // BLOCK_N
        NBLOCKS_S = (S + BLOCK_S - 1) // BLOCK_S
        # Group multiple S-chunks per reduction program so each program performs
        # a single atomic add, greatly reducing atomic contention on sum/sumsq.
        GROUP_S = min(8, NBLOCKS_S)
        NBLOCKS_S_REDUCE = (NBLOCKS_S + GROUP_S - 1) // GROUP_S
        sum_buf = torch.zeros(C, device=x.device, dtype=torch.float32)
        sumsq_buf = torch.zeros(C, device=x.device, dtype=torch.float32)
        mean_buf = torch.empty(C, device=x.device, dtype=torch.float32)
        var_buf = torch.empty(C, device=x.device, dtype=torch.float32)
        common_args = (
            x, out,
            weight, bias,
            running_mean, running_var,
            sum_buf, sumsq_buf, mean_buf, var_buf,
            N, H, W, S,
            stride_n, stride_c, stride_s,
            eps, momentum,
        )
        # Phase 0: parallel reduction across (C, N-chunks, grouped S-chunks) for sum / sum-of-squares.
        custom_kernel[(C, NBLOCKS_N, NBLOCKS_S_REDUCE)](
            *common_args,
            TRAINING=training,
            BLOCK_S=BLOCK_S,
            BLOCK_N=BLOCK_N,
            GROUP_S=GROUP_S,
            DTYPE=triton_dtype,
            PHASE=0,
            num_warps=4,
        )
        # Phase 1: finalize per-channel mean/var and update running stats.
        custom_kernel[(C,)](
            *common_args,
            TRAINING=training,
            BLOCK_S=BLOCK_S,
            BLOCK_N=BLOCK_N,
            GROUP_S=1,
            DTYPE=triton_dtype,
            PHASE=1,
            num_warps=1,
        )
        # Phase 2: parallel normalize + write output across (C, N-chunks).
        custom_kernel[(C, NBLOCKS_N, NBLOCKS_S)](
            *common_args,
            TRAINING=training,
            BLOCK_S=BLOCK_S,
            BLOCK_N=BLOCK_N,
            GROUP_S=1,
            DTYPE=triton_dtype,
            PHASE=2,
            num_warps=8,
        )
        return out
