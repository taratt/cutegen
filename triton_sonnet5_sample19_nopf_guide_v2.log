def _launch_conv3d(x, weight, bias, stride, padding, dilation, groups):
    B, C_in, D, H, W = x.shape
    C_out, C_in_per_group, K, _, _ = weight.shape
    D_out = (D + 2 * padding - dilation * (K - 1) - 1) // stride + 1
    H_out = (H + 2 * padding - dilation * (K - 1) - 1) // stride + 1
    W_out = (W + 2 * padding - dilation * (K - 1) - 1) // stride + 1
    out = torch.empty((B, C_out, D_out, H_out, W_out), device=x.device, dtype=x.dtype)
    x = x.contiguous()
