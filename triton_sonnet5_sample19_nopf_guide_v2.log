Src: import torch
import torch.nn as nn
import triton
import triton.language as tl
@triton.jit
def custom_kernel(
    anchor_ptr, positive_ptr, negative_ptr, out_ptr,
    batch_size, dim,
    stride_ab, stride_ad,
    stride_pb, stride_pd,
    stride_nb, stride_nd,
    margin, eps, inv_n,
    BLOCK_D: tl.constexpr,
    ROWS_PER_PROGRAM: tl.constexpr,
):
    pid = tl.program_id(0)
    offs_d = tl.arange(0, BLOCK_D)
    offs_r = tl.arange(0, ROWS_PER_PROGRAM)
    row_start = pid * ROWS_PER_PROGRAM
    rows = row_start + offs_r
    row_mask = rows < batch_size
    rows64 = rows.to(tl.int64)
    a_row = anchor_ptr + rows64[:, None] * stride_ab
    p_row = positive_ptr + rows64[:, None] * stride_pb
    n_row = negative_ptr + rows64[:, None] * stride_nb
    sum_pos = tl.zeros((ROWS_PER_PROGRAM,), dtype=tl.float32)
    sum_neg = tl.zeros((ROWS_PER_PROGRAM,), dtype=tl.float32)
    for d_start in range(0, dim, BLOCK_D):
        offs = d_start + offs_d
        col_mask = offs < dim
        elem_mask = row_mask[:, None] & col_mask[None, :]
        offs64 = offs.to(tl.int64)
        a = tl.load(a_row + offs64[None, :] * stride_ad, mask=elem_mask, other=0.0).to(tl.float32)
        p = tl.load(p_row + offs64[None, :] * stride_pd, mask=elem_mask, other=0.0).to(tl.float32)
        n = tl.load(n_row + offs64[None, :] * stride_nd, mask=elem_mask, other=0.0).to(tl.float32)
        diff_p = a - p + eps
        diff_n = a - n + eps
        diff_p = tl.where(elem_mask, diff_p, 0.0)
        diff_n = tl.where(elem_mask, diff_n, 0.0)
        sum_pos += tl.sum(diff_p * diff_p, axis=1)
        sum_neg += tl.sum(diff_n * diff_n, axis=1)
    dist_pos = tl.sqrt(sum_pos)
    dist_neg = tl.sqrt(sum_neg)
    loss = margin + dist_pos - dist_neg
    loss = tl.maximum(loss, 0.0)
    local_sum = tl.sum(tl.where(row_mask, loss * inv_n, 0.0), axis=0)
    tl.atomic_add(out_ptr, local_sum)
def validate_generated_code():
    # Minimal representative launch to force Triton JIT compilation.
    device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
