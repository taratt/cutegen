Src: import torch
import torch.nn as nn
import triton
import triton.language as tl
@triton.jit
def custom_kernel(
    x_ptr, w_ptr, b_ptr, out_ptr,
    N, C, H, W, OH, OW,
    stride_xn, stride_xc, stride_xh, stride_xw,
    stride_wc, stride_wkh, stride_wkw,
    stride_on, stride_oc, stride_oh, stride_ow,
    stride_val: tl.constexpr, pad_val, dilation_val: tl.constexpr,
    KH: tl.constexpr,
    HAS_BIAS: tl.constexpr,
    BLOCK_OH: tl.constexpr,
    BLOCK_OW: tl.constexpr,
    STAGE_H: tl.constexpr,
):
    pid_nc = tl.program_id(0)
    pid_oh = tl.program_id(1)
    pid_ow = tl.program_id(2)
    n = pid_nc // C
    c = pid_nc % C
    n64 = n.to(tl.int64)
    c64 = c.to(tl.int64)
    x_base = x_ptr + n64 * stride_xn + c64 * stride_xc
    w_base = w_ptr + c64 * stride_wc
    oh_start = pid_oh * BLOCK_OH
    ow_start = pid_ow * BLOCK_OW
    # Output spatial tile: rows (oh) x cols (ow). Tiling the 2D output
    # region (instead of a flat 1D chunk of the flattened OH*OW space)
    # keeps each program's memory accesses confined to a contiguous run
    # of columns per row, which improves coalescing of the loads/stores
    # along the innermost (W) dimension and avoids wrap-around across
    # row boundaries that the previous flat-block scheme suffered from.
    oh_offs = oh_start + tl.arange(0, BLOCK_OH)
    ow_offs = ow_start + tl.arange(0, BLOCK_OW)
    ow_offs = tl.max_contiguous(tl.multiple_of(ow_offs, BLOCK_OW), BLOCK_OW)
    oh_mask = oh_offs < OH
    ow_mask = ow_offs < OW
    iw = ow_offs * stride_val - pad_val
    if stride_val == 1:
        iw = tl.max_contiguous(iw, BLOCK_OW)
    valid_w = (iw >= 0) & (iw < W)
    iw64 = iw.to(tl.int64)
    base_mask = oh_mask[:, None] & ow_mask[None, :] & valid_w[None, :]
    # Loop over the (small, compile-time) kernel height instead of
    # materializing a redundant 3D (KH, OH, OW) tensor. This avoids the
    # wasted lanes from padding KH up to a power of 2 (BLOCK_KH) and keeps
    # per-iteration register usage down to a single 2D (BLOCK_OH, BLOCK_OW)
    # tile, reducing register pressure while still allowing the compiler to
    # fully unroll the accumulation since KH is a compile-time constant.
    #
    # When stride_val == 1, the KH taps read overlapping, contiguous input
    # rows: the rows needed by tap `kh` are the rows needed by tap `kh - 1`
    # shifted down by `dilation_val`. Rather than issuing KH separate
