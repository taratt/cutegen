import torch.nn as nn
import triton
import triton.language as tl
# Fixed, reproducible launch configuration
BLOCK_M = 32
BLOCK_K = 512
SPLIT_K = 64
NUM_WARPS = 8
NUM_STAGES = 4
@triton.jit
def custom_kernel(
    a_ptr, b_ptr, c_ptr,
    M, K,
    stride_am, stride_ak,
    stride_bk,
    stride_cm,
    BLOCK_M: tl.constexpr,
    BLOCK_K: tl.constexpr,
    SPLIT_K: tl.constexpr,
):
    """
    Computes C = A @ B where A is (M, K) and B is (K, 1), producing C of shape (M, 1).
    Since K is enormous relative to M, a single-pass row-tiled kernel launches
    far too few program instances (M / BLOCK_M) to saturate the GPU. This
    version applies a split-K decomposition: the grid is extended with a
