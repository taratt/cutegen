ton kernel.\n    """\n    def __init__(self, in_channels: int, out_channels: int, kernel_size: int, stride: int = 1,\n                 padding: int = 0, dilation: int = 1, groups: int = 1, bias: bool = False):\n        super(ModelNew, self).__init__()\n        self.conv3d = nn.Conv3d(in_channels, out_channels, (kernel_size, kernel_size, 1),\n                                 stride=stride, padding=padding, dilation=dilation,\n                                 groups=groups, bias=bias)\n    def forward(self, x: torch.Tensor) -> torch.Tensor:\n        weight = self.conv3d.weight\n        bias = self.conv3d.bias\n        assert x.is_cuda, "Input must be on CUDA device"\n        N, C_in, H_in, W_in, D_in = x.shape\n        OC, C_in_per_group, KH, KW, KD = weight.shape\n        stride = self.conv3d.stride[0]\n        padding = self.conv3d.padding[0]\n        dilation = self.conv3d.dilation[0]\n        groups = self.conv3d.groups\n        H_out = (H_in + 2 * padding - dilation * (KH - 1) - 1) // stride + 1\n        W_out = (W_in + 2 * padding - dilation * (KW - 1) - 1) // stride + 1\n        D_out = (D_in + 2 * padding - dilation * (KD - 1) - 1) // stride + 1\n        out = torch.empty((N, OC, H_out, W_out, D_out), device=x.device, dtype=x.dtype)\n        BLOCK_OH = 8\n        BLOCK_OW = 8\n        BLOCK_D = triton.next_power_of_2(max(D_out, 1))\n        out_ch_per_group = OC // groups\n        desired_block_oc = 4\n        BLOCK_OC = math.gcd(desired_block_oc, out_ch_per_group)\n        if BLOCK_OC == 0:\n            BLOCK_OC = 1\n        NUM_OC_BLOCKS = triton.cdiv(OC, BLOCK_OC)\n        has_bias = bias is not None\n        bias_arg = bias if has_bias else torch.empty(1, device=x.device, dtype=x.dtype)\n        grid = (N * NUM_OC_BLOCKS, triton.cdiv(H_out, BLOCK_OH), triton.cdiv(W_out, BLOCK_OW))\n        custom_kernel[grid](\n            x, weight, bias_arg, out,\n            N, C_in, H_in, W_in, D_in,\n            OC, C_in_per_group, KH, KW,\n            H_out, W_out, D