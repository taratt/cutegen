Src: import torch
import torch.nn as nn
import triton
import triton.language as tl


@triton.jit
def custom_kernel(
    x_ptr, out_ptr,
    OUTER, REDUCE, INNER,
    stride_outer, stride_reduce, stride_inner,
    out_stride_outer, out_stride_inner,
    BLOCK_D1: tl.constexpr, BLOCK_D2: tl.constexpr,
):
    # program ids
    pid_outer = tl.program_id(0)
    pid_inner = tl.program_id(1)

    offs_inner = pid_inner * BLOCK_D2 + tl.arange(0, BLOCK_D2)
    mask_inner = offs_inner < INNER

    acc = tl.full((BLOCK_D2,), value=float('inf'), dtype=tl.float32)

    pid_outer64 = pid_outer.to(tl.int64)
    base_outer_off = pid_outer64 * stride_outer

    for d1_start in range(0, REDUCE, BLOCK_D1):
        offs_d1 = d1_start + tl.arange(0, BLOCK_D1)
        mask_d1 = offs_d1 < REDUCE

        ptrs = (
            x_ptr
            + base_outer_off
            + offs_d1[:, None].to(tl.int64) * stride_reduce
            + offs_inner[None, :].to(tl.int64) * stride_inner
        )
        mask = mask_d1[:, None] & mask_inner[None, :]
        vals = tl.load(ptrs, mask=mask, other=float('inf'))
        vals = vals.to(tl.float32)

        tile_min = tl.min(vals, axis=0)
        acc = tl.minimum(acc, tile_min)

    out_ptrs = out_ptr + base_outer_off // stride_reduce * out_stride_outer + offs_inner.to(tl.int64) * out_stride_inner
    tl.store(out_ptrs, acc, mask=mask_inner)


def validate_generated_code():
    # Minimal representative launch that forces Triton JIT compilation.
    device = "cuda" if torch.cuda.is_available() else "cpu"
    if device != "cuda":
        return
    x = torch.rand(4, 8, 5, device=device, dtype=torch.float32)
    dim = 1
    shape = x.shape
    outer_size = 1
    for i in range(dim):
        outer_size *= shape[i]
    reduce_size = shape[dim]
    inner_size = 1
    for i in range(dim + 1, len(shape)):
        inner_size *= shape[i]

    out_shape = shape[:dim] + shape[dim + 1:]
    output = torch.empty(out_shape, dtype=x.dtype, device=x.device)

    stride_outer = reduce_size * inner_size
    stride_reduce = inner_size
    stride_inner = 1
    out_stride_outer = inner_size
    out_stride_inner = 1

    BLOCK_D1 = 32
    BLOCK_D2 = 32
    grid = (outer_size, triton.cdiv(inner_size, BLOCK_D2))

    custom_kernel[grid](
        x, output,
        outer_size, reduce_size, inner_size,
        stride_outer, stride_reduce, stride_inner,
        out_stride_outer, out_stride_inner,
        BLOCK_D1=BLOCK_D1, BLOCK_D2=BLOCK_D2,
        num_warps=4, num_stages=2,
    )
    torch.cuda.synchronize()


class ModelNew(nn.Module):
    """
    Triton-accelerated model that performs min reduction over a specific dimension.
    """

    def __init__(self, dim: int):
        super(ModelNew, self).__init__()
        self.dim = dim

    def forward(self, x: torch.Tensor) -> torch.Tensor:
        assert x.is_cuda, "Input must be a CUDA tensor"
        x = x.contiguous()

        dim = self.dim
        shape = x.shape
        ndim = len(shape)
        if dim < 0:
            dim += ndim

        outer_size = 1
        for i in range(dim):
            outer_size *= shape[i]
        reduce_size = shape[dim]
        inner_size = 1
        for i in range(dim + 1, ndim):
            inner_size *= shape[i]

        out_shape = shape[:dim] + shape[dim + 1:]
        output = torch.empty(out_shape, dtype=x.dtype, device=x.device)

        # Contiguous row-major strides expressed in element units.
        stride_outer = reduce_size * inner_size
        stride_reduce = inner_size
        stride_inner = 1
        out_stride_outer = inner_size
        out_stride_inner = 1

        BLOCK_D1 = 128
        BLOCK_D2 = 128

        grid = (outer_size, triton.cdiv(inner_size, BLOCK_D2))

        custom_kernel[grid](
            x, output,
            outer_size, reduce_size, inner_size,
            stride_outer, stride_reduce, stride_inner,
            out_stride_outer, out_stride_inner,
            BLOCK_D1=BLOCK_D1, BLOCK_D2=BLOCK_D2,
            num_warps=4, num_stages=2,
        )

        return output
