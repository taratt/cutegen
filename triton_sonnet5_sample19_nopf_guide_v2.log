    oc_block_i32 = pid_n_ocblock % NUM_OC_BLOCKS
    out_ch_per_group = OC // groups
    oc_start_i32 = oc_block_i32 * BLOCK_OC
    group_id = oc_start_i32 // out_ch_per_group
    n = n_i32.to(tl.int64)
    oc_offsets_i32 = oc_start_i32 + tl.arange(0, BLOCK_OC)
    oc_mask = oc_offsets_i32 < OC
    oc = oc_offsets_i32.to(tl.int64)
    oh_offsets = pid_h * BLOCK_OH + tl.arange(0, BLOCK_OH)
    ow_offsets = pid_w * BLOCK_OW + tl.arange(0, BLOCK_OW)
    od_offsets = tl.arange(0, BLOCK_D)
    oh_mask = oh_offsets < H_out
    ow_mask = ow_offsets < W_out
    od_mask = od_offsets < D_out
    oh3 = oh_offsets[:, None, None].to(tl.int64)
    ow3 = ow_offsets[None, :, None].to(tl.int64)
    od3 = od_offsets[None, None, :].to(tl.int64)
    base_mask = oh_mask[:, None, None] & ow_mask[None, :, None] & od_mask[None, None, :]
    oh4 = oh_offsets[:, None, None, None].to(tl.int64)
    ow4 = ow_offsets[None, :, None, None].to(tl.int64)
    oc4 = oc[None, None, :, None]
    od4 = od_offsets[None, None, None, :].to(tl.int64)
    full_mask = base_mask[:, :, None, :] & oc_mask[None, None, :, None]
    acc = tl.zeros((BLOCK_OH, BLOCK_OW, BLOCK_OC, BLOCK_D), dtype=tl.float32)
    stride64 = stride
    padding64 = padding
    dilation64 = dilation
    id_ = od3 * stride64 - padding64
    id_mask = (id_ >= 0) & (id_ < D_in)
    for ic in range(0, C_in_per_group):
        ic_global = (group_id.to(tl.int64) * C_in_per_group) + ic
        for kh in range(0, KH):
            ih = oh3 * stride64 - padding64 + kh * dilation64
            ih_mask = (ih >= 0) & (ih < H_in)
            for kw in range(0, KW):
                iw = ow3 * stride64 - padding64 + kw * dilation64
                iw_mask = (iw >= 0) & (iw < W_in)
                mask = base_mask & ih_mask & iw_mask & id_mask
                x_offset = (n * x_stride_n + ic_global * x_stride_c +
                            ih * x_stride_h + iw * x_stride_w + id_ * x_stride_d)
                x_vals = tl.load(x_ptr + x_offset, mask=mask, other=0.0)
                w_offset = (oc * w_stride_oc + ic * w_stride_ic +
