Src: import torch
import torch.nn as nn
import triton
from triton.language.extra import libdevice
import triton.language as tl
import math
# Constants for the GELU (tanh approximation) computation
SQRT_2_OVER_PI = math.sqrt(2.0 / math.pi)
GELU_COEF = 0.044715
BLOCK_SIZE = 8192
@triton.jit
def custom_kernel(
    x_ptr, out_ptr,
    numel,
    SQRT_2_OVER_PI: tl.constexpr,
    GELU_COEF: tl.constexpr,
    BLOCK_SIZE: tl.constexpr,
):
    pid = tl.program_id(0)
    offs = pid * BLOCK_SIZE + tl.arange(0, BLOCK_SIZE)
    mask = offs < numel
    x = tl.load(x_ptr + offs, mask=mask, other=0.0)
    x_f32 = x.to(tl.float32)
    x_cubed = x_f32 * x_f32 * x_f32
    inner = SQRT_2_OVER_PI * (x_f32 + GELU_COEF * x_cubed)
    tanh_inner = libdevice.tanh(inner)
    result_f32 = 0.5 * x_f32 * (1.0 + tanh_inner)
    result = result_f32.to(x.dtype)
    tl.store(out_ptr + offs, result, mask=mask)
def validate_generated_code():
    device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
    x = torch.rand((8, 8), device=device, dtype=torch.float32)
    out = torch.empty_like(x)
    x_flat = x.contiguous().view(-1)
    out_flat = out.view(-1)
    numel = x_flat.numel()
    grid = (triton.cdiv(numel, BLOCK_SIZE),)
    custom_kernel[grid](
        x_flat, out_flat,
        numel,
        SQRT_2_OVER_PI=SQRT_2_OVER_PI,
        GELU_COEF=GELU_COEF,
        BLOCK_SIZE=BLOCK_SIZE,
        num_warps=16,
    )
    if device.type == "cuda":
        torch.cuda.synchronize()
class ModelNew(nn.Module):
    """
    Triton-accelerated implementation of the GELU activation function
    (tanh approximation), matching the reference minGPT implementation.
    """
    def __init__(self):
        super(ModelNew, self).__init__()
    def forward(self, x):
        assert x.is_cuda, "Input must be on CUDA device"
        assert x.dim() == 2, "Expected a 2D input tensor"
        out = torch.empty_like(x)
        x_flat = x.contiguous().view(-1)
        out_flat = out.view(-1)
        numel = x_flat.numel()
        grid = (triton.cdiv(numel, BLOCK_SIZE),)
        custom_kernel[grid](
            x_flat, out_flat,
            numel,
            SQRT_2_OVER_PI=SQRT_2_OVER_PI,
            GELU_COEF=GELU_COEF,
            BLOCK_SIZE=BLOCK_SIZE,
            num_warps=16,
        )
        return out
