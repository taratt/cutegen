Src: import torch
import torch.nn as nn
import triton
import triton.language as tl


@triton.jit
def custom_kernel(
    x_ptr, w_ptr, b_ptr, out_ptr,
    B, C_in, H, W,
    C_out, OH, OW,
    KH: tl.constexpr, KW: tl.constexpr,
    STRIDE: tl.constexpr, PAD: tl.constexpr,
    stride_xb, stride_xc, stride_xh, stride_xw,
    stride_wo, stride_wc, stride_wh, stride_ww,
    stride_ob, stride_oc, stride_oh, stride_ow,
    BLOCK_SIZE: tl.constexpr,
    C_IN_CONST: tl.constexpr,
    OC_BLOCK: tl.constexpr,
    K_BLOCK: tl.constexpr,
):
    pid_b_oc = tl.program_id(0)
    pid_hw = tl.program_id(1)
    num_oc_blocks = tl.cdiv(C_out, OC_BLOCK)
    b = pid_b_oc // num_oc_blocks
    oc_block_id = pid_b_oc % num_oc_blocks
    oc_offs = oc_block_id * OC_BLOCK + tl.arange(0, OC_BLOCK)
    oc_mask = oc_offs < C_out
    offs = pid_hw * BLOCK_SIZE + tl.arange(0, BLOCK_SIZE)
    total = OH * OW
    hw_mask = offs < total
    oh = offs // OW
    ow = offs % OW
    acc = tl.zeros([OC_BLOCK, BLOCK_SIZE], dtype=tl.float32)
    b64 = b.to(tl.int64)
    oc64 = oc_offs.to(tl.int64)
    oh64 = oh.to(tl.int64)
    ow64 = ow.to(tl.int64)
