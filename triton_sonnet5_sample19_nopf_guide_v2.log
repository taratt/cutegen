import torch.nn as nn
import triton
import triton.language as tl


@triton.jit
def custom_kernel(
    a_ptr, b_ptr, c_ptr,
    M, N, K,
    stride_am, stride_ak,
    stride_bk, stride_bn,
    stride_cm, stride_cn,
