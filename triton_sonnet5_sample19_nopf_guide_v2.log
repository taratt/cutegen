import torch.nn as nn
import triton
import triton.language as tl
@triton.jit
def custom_kernel(
    x_ptr, w_ptr, bias_ptr, out_ptr,
    N, H, W, H_out, W_out,
    stride_h, stride_w, pad_h, pad_w, dil_h, dil_w,
    stride_xn, stride_xc, stride_xh, stride_xw,
    stride_wo, stride_wi, stride_wh, stride_ww,
    stride_on, stride_oc, stride_oh, stride_ow,
    C_in: tl.constexpr, C_out: tl.constexpr, KH: tl.constexpr, KW: tl.constexpr,
    GROUPS: tl.constexpr,
    BLOCK_OC: tl.constexpr, BLOCK_H: tl.constexpr, BLOCK_W: tl.constexpr,
    HAS_BIAS: tl.constexpr,
):
    NUM_OC_BLOCKS: tl.constexpr = (C_out + BLOCK_OC - 1) // BLOCK_OC
    BLOCK_HW: tl.constexpr = BLOCK_H * BLOCK_W
    pid_nc = tl.program_id(0)
    n = (pid_nc // NUM_OC_BLOCKS).to(tl.int64)
    oc_block = pid_nc % NUM_OC_BLOCKS
    pid_h = tl.program_id(1)
    pid_w = tl.program_id(2)
    oc_start = oc_block * BLOCK_OC
    oc = (oc_start + tl.arange(0, BLOCK_OC)).to(tl.int64)
    oc_mask = oc < C_out
    hw = tl.arange(0, BLOCK_HW)
    oh_local = hw // BLOCK_W
    ow_local = hw % BLOCK_W
    oh = pid_h * BLOCK_H + oh_local
    ow = pid_w * BLOCK_W + ow_local
    oh_mask = oh < H_out
    ow_mask = ow < W_out
    out_hw_mask = oh_mask & ow_mask
    oh64 = oh.to(tl.int64)
    ow64 = ow.to(tl.int64)
    C_in_per_group: tl.constexpr = C_in // GROUPS
    C_out_per_group: tl.constexpr = C_out // GROUPS
    # Assume BLOCK_OC does not straddle a group boundary.
    g = oc_start // C_out_per_group
    ic = tl.arange(0, C_in_per_group)
    ic_actual = (g * C_in_per_group + ic).to(tl.int64)
    ic_off = ic_actual * stride_xc
    n_off = n * stride_xn
    oc_w_off = oc * stride_wo
    n_out_off = n * stride_on
    oc_out_off = oc * stride_oc
    acc = tl.zeros((BLOCK_OC, BLOCK_HW), dtype=tl.float32)
    for kh in range(KH):
        ih = oh * stride_h - pad_h + kh * dil_h
        ih_mask = (ih >= 0) & (ih < H)
        ih64 = ih.to(tl.int64)
        for kw in range(KW):
            iw = ow * stride_w - pad_w + kw * dil_w
            iw_mask = (iw >= 0) & (iw < W)
            iw64 = iw.to(tl.int64)
            mask_hw = out_hw_mask & ih_mask & iw_mask
            x_ptrs = (x_ptr + n_off + ic_off[:, None] +
                      ih64[None, :] * stride_xh + iw64[None, :] * stride_xw)
            x_val = tl.load(x_ptrs, mask=mask_hw[None, :], other=0.0).to(tl.float32)
            w_ptrs = (w_ptr + oc_w_off[:, None] + (ic * stride_wi)[None, :] +
                      kh * stride_wh + kw * stride_ww)
            w_val = tl.load(w_ptrs, mask=oc_mask[:, None], other=0.0).to(tl.float32)
            acc += tl.dot(w_val, x_val, allow_tf32=False)
    if HAS_BIAS:
        b = tl.load(bias_ptr + oc, mask=oc_mask, other=0.0)
        acc += b.to(tl.float32)[:, None]
    out_ptrs = (out_ptr + n_out_off + oc_out_off[:, None] +
