Src: import torch
import torch.nn as nn
import triton
import triton.language as tl


@triton.jit
def custom_kernel(
    x_ptr,          # pointer to input,  shape (B, N) contiguous
    w_ptr,          # pointer to weight, shape (N,) contiguous
    b_ptr,          # pointer to bias,   shape (N,) contiguous
    out_ptr,        # pointer to output, shape (B, N) contiguous
    N,              # number of elements per row (product of normalized_shape)
    eps,            # epsilon for numerical stability
    BLOCK_SIZE: tl.constexpr,
):
    row = tl.program_id(0)
    row_start = row.to(tl.int64) * N

    # ---- Pass 1: compute mean and variance over the row ----
    sum_val = tl.zeros([1], dtype=tl.float32)
    sum_sq = tl.zeros([1], dtype=tl.float32)

    for start in range(0, N, BLOCK_SIZE):
        offs = start + tl.arange(0, BLOCK_SIZE)
        mask = offs < N
        offs = tl.multiple_of(offs, BLOCK_SIZE)
        offs = tl.max_contiguous(offs, BLOCK_SIZE)
        x = tl.load(x_ptr + row_start + offs, mask=mask, other=0.0, eviction_policy="evict_first").to(tl.float32)
        sum_val += tl.sum(x, axis=0)
        sum_sq += tl.sum(x * x, axis=0)
    mean = sum_val / N
    var = sum_sq / N - mean * mean
    rstd = 1.0 / tl.sqrt(var + eps)
    # ---- Pass 2: normalize, scale, shift, and store ----
    for start in range(0, N, BLOCK_SIZE):
        offs = start + tl.arange(0, BLOCK_SIZE)
        mask = offs < N
        offs = tl.multiple_of(offs, BLOCK_SIZE)
        offs = tl.max_contiguous(offs, BLOCK_SIZE)
        x = tl.load(x_ptr + row_start + offs, mask=mask, other=0.0, eviction_policy="evict_first").to(tl.float32)
        w = tl.load(w_ptr + offs, mask=mask, other=0.0, eviction_policy="evict_last").to(tl.float32)
        b = tl.load(b_ptr + offs, mask=mask, other=0.0, eviction_policy="evict_last").to(tl.float32)
        x_hat = (x - mean) * rstd
        y = x_hat * w + b
        tl.store(out_ptr + row_start + offs, y.to(out_ptr.dtype.element_ty), mask=mask)
def validate_generated_code():
    """
    Force Triton JIT compilation with one representative launch matching the
    proven reference configuration (batch_size=16, features=64, dim1=256, dim2=256).
    """
    device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
    if device.type != "cuda":
        return  # cannot validate a CUDA kernel without a GPU

    batch_size = 16
    features = 64
    dim1 = 256
    dim2 = 256
    normalized_shape = (features, dim1, dim2)
    N = features * dim1 * dim2
    B = batch_size

    x = torch.rand(B, *normalized_shape, device=device, dtype=torch.float32)
    weight = torch.ones(normalized_shape, device=device, dtype=torch.float32)
