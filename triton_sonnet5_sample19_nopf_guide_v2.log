                w_vals = tl.load(w_ptr + w_offset, mask=oc_mask, other=0.0)
                acc += x_vals[:, :, None, :].to(tl.float32) * w_vals[None, None, :, None].to(tl.float32)
    if HAS_BIAS:
        b = tl.load(bias_ptr + oc, mask=oc_mask, other=0.0)
        acc += b[None, None, :, None].to(tl.float32)
    out_offset = (n * o_stride_n + oc4 * o_stride_c +
