:], axis=1)\n    c_ptrs = c_ptr + rm.to(tl.int64) * stride_cm\n    tl.atomic_add(c_ptrs, acc, mask=mask_m)\ndef validate_generated_code():\n    """\n    Forces Triton JIT compilation with a small representative launch that\n    exercises the split-K row-tiled K-loop and masking logic (non-divisible\n    K and M, and K not evenly divisible by SPLIT_K) without allocating the\n    full-size reference tensors.\n    """\n    if not torch.cuda.is_available():\n        return\n    device = torch.device("cuda")\n    M_val = 37          # not a multiple of BLOCK_M -> exercises row mask\n    K_val = BLOCK_K * 2 + 17  # not a multiple of BLOCK_K -> exercises col mask\n    A = torch.rand(M_val, K_val, device=device, dtype=torch.float32)\n    B = torch.rand(K_val, 1, device=device, dtype=torch.float32)\n    C = torch.zeros(M_val, 1, device=device, dtype=torch.float32)\n    grid = (triton.cdiv(M_val, BLOCK_M), SPLIT_K)\n    custom_kernel[grid](\n        A, B, C,\n        M_val, K_val,\n        A.stride(0), A.stride(1),\n        B.stride(0),\n        C.stride(0),\n        BLOCK_M=BLOCK_M,\n        BLOCK_K=BLOCK_K,\n        SPLIT_K=SPLIT_K,\n        num_warps=NUM_WARPS,\n        num_stages=NUM_STAGES,\n    )\n    torch.cuda.synchronize()\nclass ModelNew(nn.Module):\n    """\n    Simple model that performs matrix-vector multiplication (C = A * B)\n    using a single custom Triton kernel that tiles over the large M\n    dimension and splits the huge K dimension across multiple program\n    instances (split-K) accumulated via atomics, to expose sufficient\n    parallelism for the GPU.\n    """\n    def __init__(self):\n        super(ModelNew, self).__init__()\n    def forward(self, A: torch.Tensor, B: torch.Tensor) -> torch.Tensor:\n        assert A.is_cuda and B.is_cuda, "Inputs must be on CUDA device"\n        assert A.dtype == torch.float32 and B.dtype == torch.float32\n        M, K = A.shape\n        K_b, N = B.shape\n        assert K_b == K and N == 1\n        # Split-K accumulat