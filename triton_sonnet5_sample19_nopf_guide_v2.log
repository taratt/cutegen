    tmp = tmp // num_co_blocks_per_group
    g = tmp % groups
    b = tmp // groups
    co_base = g * C_OUT_PER_GROUP + co_block_idx * BLOCK_CO
    co_offsets = co_base + tl.arange(0, BLOCK_CO)
    num_tiles_w = (W_out + BLOCK_W - 1) // BLOCK_W
    tile_h = pid_hw // num_tiles_w
    tile_w = pid_hw % num_tiles_w
    h_offsets = tile_h * BLOCK_H + tl.arange(0, BLOCK_H)
    w_offsets = tile_w * BLOCK_W + tl.arange(0, BLOCK_W)
    h_mask = h_offsets < H_out
    w_mask = w_offsets < W_out
    mask_hw = h_mask[:, None] & w_mask[None, :]
    d_out = pid_d
    acc = tl.zeros((BLOCK_CO, BLOCK_H, BLOCK_W), dtype=tl.float32)
    b64 = b.to(tl.int64)
    co64 = co_offsets.to(tl.int64)
    for ci in range(C_IN_PER_GROUP):
        c_in_idx = g * C_IN_PER_GROUP + ci
        c_in_idx64 = c_in_idx.to(tl.int64) if isinstance(c_in_idx, tl.tensor) else c_in_idx
        for kd in range(KSIZE):
            d_in = d_out * stride - padding + kd * dilation
            d_valid = (d_in >= 0) & (d_in < D)
            d_in64 = d_in.to(tl.int64)
            for kh in range(KSIZE):
                h_in = h_offsets * stride - padding + kh * dilation
                h_valid = (h_in >= 0) & (h_in < H)
