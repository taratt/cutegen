import torch.nn as nn
import triton
import triton.language as tl
@triton.jit
def custom_kernel(
    x_ptr, w_ptr, b_ptr, out_ptr,
    N, C_in, D_in, H_in, W_in,
    C_out, D_out, H_out, W_out,
    kD, kH, kW,
    stride_d, stride_h, stride_w,
    pad_d, pad_h, pad_w,
    groups, C_in_per_group, C_out_per_group,
    x_stride_n, x_stride_c, x_stride_d, x_stride_h, x_stride_w,
    w_stride_cin, w_stride_cout, w_stride_kd, w_stride_kh, w_stride_kw,
    out_stride_n, out_stride_c, out_stride_d, out_stride_h, out_stride_w,
    num_oc_tiles_per_group,
    HAS_BIAS: tl.constexpr,
    BLOCK_M: tl.constexpr,
    BLOCK_OC: tl.constexpr,
    BLOCK_C: tl.constexpr,
):
    # Implicit-GEMM style restructuring: each program computes a tile of
    # (BLOCK_M spatial locations) x (BLOCK_OC output channels), reusing the
    # loaded input patch across all output channels in the tile and reusing
    # the loaded weight tile across all spatial locations in the tile.
    pid_m = tl.program_id(0)
    pid_oc = tl.program_id(1)
    group = pid_oc // num_oc_tiles_per_group
    oc_tile_idx = pid_oc % num_oc_tiles_per_group
    m_offs = (pid_m * BLOCK_M + tl.arange(0, BLOCK_M)).to(tl.int64)
    total_spatial = N * D_out * H_out * W_out
    total_spatial = total_spatial.to(tl.int64)
    mask_m = m_offs < total_spatial
    ow = m_offs % W_out
    tmp = m_offs // W_out
    oh = tmp % H_out
    tmp = tmp // H_out
    od = tmp % D_out
    n = tmp // D_out
    oc_offs_in_group = (oc_tile_idx * BLOCK_OC + tl.arange(0, BLOCK_OC)).to(tl.int64)
    oc_mask = oc_offs_in_group < C_out_per_group
    oc = group * C_out_per_group + oc_offs_in_group
    acc = tl.zeros((BLOCK_M, BLOCK_OC), dtype=tl.float32)
    for kd in range(0, kD):
        id_num = od + pad_d - kd
        id_ = id_num // stride_d
        id_valid = (id_num % stride_d == 0) & (id_ >= 0) & (id_ < D_in)
        for kh in range(0, kH):
            ih_num = oh + pad_h - kh
            ih_ = ih_num // stride_h
            ih_valid = (ih_num % stride_h == 0) & (ih_ >= 0) & (ih_ < H_in)
            for kw in range(0, kW):
                iw_num = ow + pad_w - kw
                iw_ = iw_num // stride_w
                iw_valid = (iw_num % stride_w == 0) & (iw_ >= 0) & (iw_ < W_in)
                valid = mask_m & id_valid & ih_valid & iw_valid
                for ic_start in range(0, C_in_per_group, BLOCK_C):
                    ic_offs = (ic_start + tl.arange(0, BLOCK_C)).to(tl.int64)
                    ic_mask = ic_offs < C_in_per_group
                    ic = group * C_in_per_group + ic_offs
                    x_offset = (n[:, None] * x_stride_n + ic[None, :] * x_stride_c +
                                id_[:, None] * x_stride_d + ih_[:, None] * x_stride_h + iw_[:, None] * x_stride_w)
                    x_load_mask = valid[:, None] & ic_mask[None, :]
                    x_val = tl.load(x_ptr + x_offset, mask=x_load_mask, other=0.0)
                    w_offset = (ic[:, None] * w_stride_cin + oc_offs_in_group[None, :] * w_stride_cout +
                                kd * w_stride_kd + kh * w_stride_kh + kw * w_stride_kw)
                    w_load_mask = ic_mask[:, None] & oc_mask[None, :]
                    w_val = tl.load(w_ptr + w_offset, mask=w_load_mask, other=0.0)
                    acc += tl.dot(x_val, w_val, allow_tf32=False)
    if HAS_BIAS:
