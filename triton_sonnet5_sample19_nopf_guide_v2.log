def _launch_conv_transpose3d(x, weight, bias, stride, padding, output_padding, groups):
    x = x.contiguous()
    weight = weight.contiguous()
    N, C_in, D_in, H_in, W_in = x.shape
    C_in_w, C_out_per_group, kD, kH, kW = weight.shape
    C_out = C_out_per_group * groups
    C_in_per_group = C_in // groups
    stride_d, stride_h, stride_w = stride
    pad_d, pad_h, pad_w = padding
    opad_d, opad_h, opad_w = output_padding
    D_out = (D_in - 1) * stride_d - 2 * pad_d + kD + opad_d
    H_out = (H_in - 1) * stride_h - 2 * pad_h + kH + opad_h
    W_out = (W_in - 1) * stride_w - 2 * pad_w + kW + opad_w
    out = torch.empty((N, C_out, D_out, H_out, W_out), device=x.device, dtype=x.dtype)
    has_bias = bias is not None
    if has_bias:
        bias = bias.contiguous()
        b_ptr = bias
    else:
        b_ptr = out  # dummy, unused since HAS_BIAS=False
    # Shape-aware tiling: C_out_per_group is typically small relative to the
    # huge spatial (M) dimension, so keep the whole (small) output-channel
    # group inside a single tile (avoiding wasted/masked lanes in tl.dot)
    # and enlarge the spatial tile to compensate for the smaller OC tile.
