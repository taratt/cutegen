    device = "cuda"
    N, C, H, W = 2, 4, 8, 8
    S = H * W
    x = torch.randn(N, C, H, W, device=device, dtype=torch.float32)
    out = torch.empty_like(x)
    weight = torch.randn(C, device=device, dtype=torch.float32)
    bias = torch.randn(C, device=device, dtype=torch.float32)
    running_mean = torch.zeros(C, device=device, dtype=torch.float32)
    running_var = torch.ones(C, device=device, dtype=torch.float32)
    sum_buf = torch.zeros(C, device=device, dtype=torch.float32)
    sumsq_buf = torch.zeros(C, device=device, dtype=torch.float32)
    mean_buf = torch.empty(C, device=device, dtype=torch.float32)
    var_buf = torch.empty(C, device=device, dtype=torch.float32)
    stride_n = C * H * W
    stride_c = H * W
    stride_s = 1
    BLOCK_S = 8192
    BLOCK_N = 8
    NBLOCKS = (N + BLOCK_N - 1) // BLOCK_N
    common_args = (
        x, out,
        weight, bias,
        running_mean, running_var,
        sum_buf, sumsq_buf, mean_buf, var_buf,
        N, H, W, S,
        stride_n, stride_c, stride_s,
