        OW = (W + 2 * PAD - KW) // STRIDE + 1

        out = torch.empty((B, C_out, OH, OW), device=x.device, dtype=x.dtype)

        BLOCK_SIZE = 64
        OC_BLOCK = 128
        K_BLOCK = 32
        num_oc_blocks = triton.cdiv(C_out, OC_BLOCK)
        grid = (B * num_oc_blocks, triton.cdiv(OH * OW, BLOCK_SIZE))

        custom_kernel[grid](
            x, weight, bias, out,
            B, C_in, H, W,
            C_out, OH, OW,
            KH, KW,
            STRIDE, PAD,
