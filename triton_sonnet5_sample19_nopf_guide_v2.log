    BLOCK_OW = 128
    STAGE_H = triton.next_power_of_2(BLOCK_OH + (KH - 1) * dilation)
    grid = (N * C, triton.cdiv(OH, BLOCK_OH), triton.cdiv(OW, BLOCK_OW))
