Src: import torch
import torch.nn as nn
import triton
import triton.language as tl


@triton.jit
def custom_kernel(
    x_ptr, w_ptr, bias_ptr, out_ptr,
    B, C_in, D, H, W,
    C_out,
    D_out, H_out, W_out,
    stride, padding, dilation,
    groups,
    stride_xb, stride_xc, stride_xd, stride_xh, stride_xw,
    stride_wo, stride_wc, stride_wd, stride_wh, stride_ww,
    stride_ob, stride_oc, stride_od, stride_oh, stride_ow,
    C_IN_PER_GROUP: tl.constexpr,
    C_OUT_PER_GROUP: tl.constexpr,
    KSIZE: tl.constexpr,
    HAS_BIAS: tl.constexpr,
    BLOCK_H: tl.constexpr,
    BLOCK_W: tl.constexpr,
    BLOCK_CO: tl.constexpr,
):
    pid_bc = tl.program_id(0)  # combined b, group, co_block index
    pid_d = tl.program_id(1)   # d_out index
    pid_hw = tl.program_id(2)  # 2D spatial tile index over (H_out, W_out)
    num_co_blocks_per_group = C_OUT_PER_GROUP // BLOCK_CO
    tmp = pid_bc
    co_block_idx = tmp % num_co_blocks_per_group
    tmp = tmp // num_co_blocks_per_group
