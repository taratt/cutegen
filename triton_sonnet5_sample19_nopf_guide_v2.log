            B.stride(0), B.stride(1),
            C.stride(0), C.stride(1),
            BLOCK_M=_BLOCK_M, BLOCK_N=_BLOCK_N, BLOCK_K=_BLOCK_K,
            num_warps=8, num_stages=2,
        )
