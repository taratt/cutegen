import torch.nn as nn
import triton
import triton.language as tl


@triton.jit
def custom_kernel(
    x_ptr, w_ptr, b_ptr, out_ptr,
    B, IC, H, W, OC, OH, OW,
    KH: tl.constexpr, KW: tl.constexpr,
    stride_h, stride_w, pad_h, pad_w, dilation_h, dilation_w,
    stride_xb, stride_xc, stride_xh, stride_xw,
    stride_wo, stride_wi, stride_wh, stride_ww,
    stride_ob, stride_oc, stride_oh, stride_ow,
    HAS_BIAS: tl.constexpr,
    BLOCK_H: tl.constexpr, BLOCK_W: tl.constexpr, BLOCK_IC: tl.constexpr,
):
    pid_bo = tl.program_id(0)
    pid_h = tl.program_id(1)
    pid_w = tl.program_id(2)

    b = (pid_bo // OC).to(tl.int64)
    oc = (pid_bo % OC).to(tl.int64)

    offs_h = (pid_h * BLOCK_H + tl.arange(0, BLOCK_H)).to(tl.int64)
    offs_w = (pid_w * BLOCK_W + tl.arange(0, BLOCK_W)).to(tl.int64)
    offs_ic = tl.arange(0, BLOCK_IC).to(tl.int64)

    mask_h = offs_h < OH
    mask_w = offs_w < OW
    mask_ic = offs_ic < IC

    acc = tl.zeros((BLOCK_H, BLOCK_W), dtype=tl.float32)

    for kh in range(KH):
        for kw in range(KW):
            ih = offs_h * stride_h - pad_h + kh * dilation_h
            iw = offs_w * stride_w - pad_w + kw * dilation_w

            mask_ih = (ih >= 0) & (ih < H)
            mask_iw = (iw >= 0) & (iw < W)

            x_ptrs = (
                x_ptr
                + b * stride_xb
                + offs_ic[None, None, :] * stride_xc
                + ih[:, None, None] * stride_xh
                + iw[None, :, None] * stride_xw
            )
            x_mask = (
                mask_h[:, None, None]
                & mask_w[None, :, None]
                & mask_ih[:, None, None]
                & mask_iw[None, :, None]
                & mask_ic[None, None, :]
            )
            x_val = tl.load(x_ptrs, mask=x_mask, other=0.0)

            w_ptrs = (
                w_ptr
                + oc * stride_wo
                + offs_ic * stride_wi
                + kh * stride_wh
                + kw * stride_ww
            )
            w_val = tl.load(w_ptrs, mask=mask_ic, other=0.0)

            acc += tl.sum(x_val * w_val[None, None, :], axis=2)

    if HAS_BIAS:
        bias_val = tl.load(b_ptr + oc)
        acc = acc + bias_val

    out_ptrs = (
        out_ptr
        + b * stride_ob
        + oc * stride_oc
        + offs_h[:, None] * stride_oh
        + offs_w[None, :] * stride_ow
    )
    out_mask = mask_h[:, None] & mask_w[None, :]
    tl.store(out_ptrs, acc, mask=out_mask)


