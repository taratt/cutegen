        stride, padding, dilation,
        KH=KH, HAS_BIAS=True, BLOCK_OH=BLOCK_OH, BLOCK_OW=BLOCK_OW, BLOCK_KH=BLOCK_KH,
        num_warps=4, num_stages=2,
    )
class ModelNew(nn.Module):
    """
    Performs a depthwise 2D convolution with a square input and an asymmetric kernel,
    computed via a single custom Triton kernel.
    """
    def __init__(self, in_channels: int, kernel_size: int, stride: int = 1,
                 padding: int = 0, dilation: int = 1, bias: bool = False):
        super(ModelNew, self).__init__()
        # Keep exact reference module for parameter storage/initialization semantics.
        self.conv2d = nn.Conv2d(
            in_channels, in_channels, kernel_size=(kernel_size, 1),
            stride=stride, padding=padding, dilation=dilation,
            groups=in_channels, bias=bias
