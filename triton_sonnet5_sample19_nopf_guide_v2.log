import torch.nn as nn
import triton
import triton.language as tl


@triton.jit
def custom_kernel(
    x_ptr, w_ptr, b_ptr, out_ptr,
    N, C_in, D_in, H_in, W_in,
    C_out, D_out, H_out, W_out,
    kD, kH, kW,
    stride_d, stride_h, stride_w,
    pad_d, pad_h, pad_w,
    groups, C_in_per_group, C_out_per_group,
    x_stride_n, x_stride_c, x_stride_d, x_stride_h, x_stride_w,
    w_stride_cin, w_stride_cout, w_stride_kd, w_stride_kh, w_stride_kw,
    out_stride_n, out_stride_c, out_stride_d, out_stride_h, out_stride_w,
    HAS_BIAS: tl.constexpr,
    BLOCK_SIZE: tl.constexpr,
):
    pid = tl.program_id(0)
    offs = pid * BLOCK_SIZE + tl.arange(0, BLOCK_SIZE)
    offs = offs.to(tl.int64)

    total = N * C_out * D_out * H_out * W_out
    total = total.to(tl.int64)
    mask = offs < total

    ow = offs % W_out
    tmp = offs // W_out
    oh = tmp % H_out
    tmp = tmp // H_out
    od = tmp % D_out
    tmp = tmp // D_out
    oc = tmp % C_out
    n = tmp // C_out

    group = oc // C_out_per_group
    oc_in_group = oc % C_out_per_group

    acc = tl.zeros((BLOCK_SIZE,), dtype=tl.float32)

    for kd in range(0, kD):
        id_num = od + pad_d - kd
        id_ = id_num // stride_d
        id_valid = (id_num % stride_d == 0) & (id_ >= 0) & (id_ < D_in)
        for kh in range(0, kH):
            ih_num = oh + pad_h - kh
            ih_ = ih_num // stride_h
            ih_valid = (ih_num % stride_h == 0) & (ih_ >= 0) & (ih_ < H_in)
            for kw in range(0, kW):
                iw_num = ow + pad_w - kw
                iw_ = iw_num // stride_w
                iw_valid = (iw_num % stride_w == 0) & (iw_ >= 0) & (iw_ < W_in)

                valid = mask & id_valid & ih_valid & iw_valid

                for ic_local in range(0, C_in_per_group):
                    ic = group * C_in_per_group + ic_local

                    x_offset = (n * x_stride_n + ic * x_stride_c +
                                id_ * x_stride_d + ih_ * x_stride_h + iw_ * x_stride_w)
                    w_offset = (ic * w_stride_cin + oc_in_group * w_stride_cout +
                                kd * w_stride_kd + kh * w_stride_kh + kw * w_stride_kw)

                    x_val = tl.load(x_ptr + x_offset, mask=valid, other=0.0)
                    w_val = tl.load(w_ptr + w_offset, mask=valid, other=0.0)
                    acc += x_val * w_val

