    # single program reuse the loaded input tile (x_val) across more
    # output channels, avoiding redundant reloads of x across separate
    # co-block program instances. Shrink the spatial tile accordingly
    # so the (BLOCK_CO, BLOCK_H, BLOCK_W) accumulator size stays roughly
    # constant and avoids register spilling.
    if BLOCK_CO >= 32:
        BLOCK_H = 8
        BLOCK_W = 8
    elif BLOCK_CO >= 16:
        BLOCK_H = 16
        BLOCK_W = 8
    else:
        BLOCK_H = 16
        BLOCK_W = 16
    num_co_blocks_per_group = C_out_per_group // BLOCK_CO
    num_h_tiles = triton.cdiv(H_out, BLOCK_H)
    num_w_tiles = triton.cdiv(W_out, BLOCK_W)
    grid = (
        B * groups * num_co_blocks_per_group,
        D_out,
        num_h_tiles * num_w_tiles,
    )
