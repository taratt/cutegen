                mask=mask_n[:, None] & ((c * BLOCK_HD + tl.arange(0, BLOCK_HD)) < D)[None, :],
                other=0.0,
            )
            for c in range(NUM_HD_CHUNKS)
        ]
        acc_chunks = tuple(
            acc_chunks[c] * alpha[:, None] + tl.dot(p.to(v_chunks[c].dtype), v_chunks[c])
            for c in range(NUM_HD_CHUNKS)
        )
        m_i = m_new
    l_i_safe = tl.where(l_i > 0.0, l_i, 1.0)
    for c in range(NUM_HD_CHUNKS):
