al, device=device, dtype=torch.float32)\n    B = torch.rand(K_val, 1, device=device, dtype=torch.float32)\n    C = torch.empty(M_val, 1, device=device, dtype=torch.float32)\n\n    grid = (triton.cdiv(M_val, BLOCK_M),)\n    custom_kernel[grid](\n        A, B, C,\n        M_val, K_val,\n        A.stride(0), A.stride(1),\n        B.stride(0),\n        C.stride(0),\n        BLOCK_M=BLOCK_M,\n        BLOCK_K=BLOCK_K,\n        num_warps=NUM_WARPS,\n        num_stages=NUM_STAGES,\n    )\n    torch.cuda.synchronize()\n\n\nclass ModelNew(nn.Module):\n    """\n    Simple model that performs matrix-vector multiplication (C = A * B)\n    using a single custom Triton kernel.\n    """\n\n    def __init__(self):\n        super(ModelNew, self).__init__()\n\n    def forward(self, A: torch.Tensor, B: torch.Tensor) -> torch.Tensor:\n        assert A.is_cuda and B.is_cuda, "Inputs must be on CUDA device"\n        assert A.dtype == torch.float32 and B.dtype == torch.float32\n\n        M, K = A.shape\n        K_b, N = B.shape\n        assert K_b == K and N == 1\n\n        C = torch.empty((M, 1), device=A.device, dtype=A.dtype)\n\n        grid = (triton.cdiv(M, BLOCK_M),)\n        custom_kernel[grid](\n            A, B, C,\n            M, K,\n            A.stride(0), A.stride(1),\n            B.stride(0),\n            C.stride(0),\n            BLOCK_M=BLOCK_M,\n            BLOCK_K=BLOCK_K,\n            num_warps=NUM_WARPS,\n            num_stages=NUM_STAGES,\n        )\n        return C', 'last_passed_depth': 0, 'retries_by_depth': {}, 'previous_src_time': {'mean': 29.7, 'std': 0.0698, 'min': 29.6, 'max': 30.0, 'num_trials': 100}, 'best_passed_src': 'import torch\nimport torch.nn as nn\nimport triton\nimport triton.language as tl\n\n# Fixed, reproducible launch configuration\nBLOCK_M = 32\nBLOCK_K = 4096\nNUM_WARPS = 8\nNUM_STAGES = 2\n\n\n@triton.jit\ndef custom_kernel(\n    a_ptr, b_ptr, c_ptr,\n    M, K,\n    stride_am, stride_ak,\n    stride_bk,\n    stride_cm,\n    BLOCK_M: tl.conste