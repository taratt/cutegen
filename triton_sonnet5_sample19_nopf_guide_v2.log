    weight = torch.rand(OC, IC, KH, KW, device=device, dtype=torch.float32)
    bias = torch.zeros(1, device=device, dtype=torch.float32)
    out = torch.empty(B, OC, OH, OW, device=device, dtype=torch.float32)

