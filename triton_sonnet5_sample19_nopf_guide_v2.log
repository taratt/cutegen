import torch.nn as nn
import triton
import triton.language as tl
@triton.jit
def custom_kernel(
    x_ptr, w_ptr, bias_ptr, out_ptr,
    N, H, W, H_out, W_out,
    stride_h, stride_w, pad_h, pad_w, dil_h, dil_w,
    stride_xn, stride_xc, stride_xh, stride_xw,
    stride_wo, stride_wi, stride_wh, stride_ww,
    stride_on, stride_oc, stride_oh, stride_ow,
    C_in: tl.constexpr, C_out: tl.constexpr, KH: tl.constexpr, KW: tl.constexpr,
    GROUPS: tl.constexpr,
    BLOCK_H: tl.constexpr, BLOCK_W: tl.constexpr, BLOCK_OC: tl.constexpr,
    NUM_OC_BLOCKS: tl.constexpr,
    HAS_BIAS: tl.constexpr,
):
    pid_n_ocblk = tl.program_id(0)
    n = (pid_n_ocblk // NUM_OC_BLOCKS).to(tl.int64)
    oc_blk = pid_n_ocblk % NUM_OC_BLOCKS
    oc_start = oc_blk * BLOCK_OC
    pid_h = tl.program_id(1)
    pid_w = tl.program_id(2)
    oh = pid_h * BLOCK_H + tl.arange(0, BLOCK_H)
    ow = pid_w * BLOCK_W + tl.arange(0, BLOCK_W)
    oh_mask = oh < H_out
    ow_mask = ow < W_out
    C_in_per_group: tl.constexpr = C_in // GROUPS
    C_out_per_group: tl.constexpr = C_out // GROUPS
    g = (oc_start // C_out_per_group).to(tl.int64)
    n_off = n * stride_xn
    n_out_off = n * stride_on
    acc = [tl.zeros((BLOCK_H, BLOCK_W), dtype=tl.float32) for _ in range(BLOCK_OC)]
    for ic in range(C_in_per_group):
        ic_actual = (g * C_in_per_group + ic).to(tl.int64)
        ic_off = ic_actual * stride_xc
        ic_w_off = ic * stride_wi
        for kh in range(KH):
            ih = oh * stride_h - pad_h + kh * dil_h
            ih_mask = (ih >= 0) & (ih < H)
            ih64 = ih.to(tl.int64)
            for kw in range(KW):
                iw = ow * stride_w - pad_w + kw * dil_w
                iw_mask = (iw >= 0) & (iw < W)
                iw64 = iw.to(tl.int64)
                mask = (oh_mask[:, None] & ow_mask[None, :] &
                        ih_mask[:, None] & iw_mask[None, :])
                x_ptrs = (x_ptr + n_off + ic_off +
                          ih64[:, None] * stride_xh + iw64[None, :] * stride_xw)
                x_val = tl.load(x_ptrs, mask=mask, other=0.0).to(tl.float32)
                for oc_i in range(BLOCK_OC):
                    oc = oc_start + oc_i
                    oc_valid = oc < C_out
                    w_val = tl.load(w_ptr + oc.to(tl.int64) * stride_wo + ic_w_off +
                                     kh * stride_wh + kw * stride_ww,
                                     mask=oc_valid, other=0.0)
                    acc[oc_i] += x_val * w_val.to(tl.float32)
    out_mask_spatial = oh_mask[:, None] & ow_mask[None, :]
    for oc_i in range(BLOCK_OC):
        oc = oc_start + oc_i
        oc_valid = oc < C_out
        cur = acc[oc_i]
        if HAS_BIAS:
            b = tl.load(bias_ptr + oc, mask=oc_valid, other=0.0)
            cur = cur + b.to(tl.float32)
        out_ptrs = (out_ptr + n_out_off + oc.to(tl.int64) * stride_oc +
