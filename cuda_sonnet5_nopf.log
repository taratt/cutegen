import torch.nn as nn
from torch.utils.cpp_extension import load_inline

depthwise_conv_source = r"""
#include <torch/extension.h>
#include <cuda.h>
#include <cuda_runtime.h>

constexpr int TILE_H = 256;
__global__ void depthwise_conv2d_kh1_kernel(
    const float* __restrict__ input,
    const float* __restrict__ weight,
    const float* __restrict__ bias,
    float* __restrict__ output,
    const int N, const int C, const int H, const int W,
    const int K,
    const int H_out, const int W_out,
    const int stride, const int padding, const int dilation,
    const bool has_bias)
{
    extern __shared__ float smem[];
    // blockIdx.x encodes (n, c, ow) column index -> can be large, up to 2^31-1
    // blockIdx.y encodes the tile along the output-height dimension -> kept small
    int col_idx = blockIdx.x;
    int h_tile_idx = blockIdx.y;
    int ow = col_idx % W_out;
    int tmp = col_idx / W_out;
    int c = tmp % C;
    int n = tmp / C;
    int oh_start = h_tile_idx * TILE_H;
    int tid = threadIdx.x;
    int iw = ow * stride - padding;
    // Range of input rows needed to compute all outputs in [oh_start, oh_start + TILE_H)
    int ih_min = oh_start * stride - padding;
    int ih_max = (oh_start + TILE_H - 1) * stride - padding + (K - 1) * dilation;
    int smem_size = ih_max - ih_min + 1;
    const float* in_ptr = nullptr;
    if (iw >= 0 && iw < W) {
        in_ptr = input + ((n * C + c) * H) * W + iw;
    }
    // Cooperative load of the reusable input column strip into shared memory.
    for (int i = tid; i < smem_size; i += blockDim.x) {
        int ih = ih_min + i;
        float val = 0.0f;
        if (in_ptr != nullptr && ih >= 0 && ih < H) {
            val = in_ptr[ih * W];
        }
        smem[i] = val;
    }
    __syncthreads();
    int oh = oh_start + tid;
    if (tid < TILE_H && oh < H_out) {
        float acc = 0.0f;
        const float* w_ptr = weight + c * K;
        int ih_base_local = (oh * stride - padding) - ih_min;
        #pragma unroll
        for (int kh = 0; kh < K; ++kh) {
            acc += smem[ih_base_local + kh * dilation] * w_ptr[kh];
        }
        if (has_bias) {
            acc += bias[c];
        }
        output[((n * C + c) * H_out + oh) * W_out + ow] = acc;
    }
}
torch::Tensor depthwise_conv2d_kh1_cuda(
    torch::Tensor input,
    torch::Tensor weight,
    torch::Tensor bias,
    int stride,
    int padding,
    int dilation,
    bool has_bias)
{
    input = input.contiguous();
    weight = weight.contiguous();
    const int N = input.size(0);
    const int C = input.size(1);
    const int H = input.size(2);
    const int W = input.size(3);
    const int K = weight.size(2); // weight shape: (C, 1, K, 1)
    const int H_out = (H + 2 * padding - dilation * (K - 1) - 1) / stride + 1;
    const int W_out = (W + 2 * padding - dilation * (1 - 1) - 1) / stride + 1;
    auto output = torch::empty({N, C, H_out, W_out}, input.options());
    const float* bias_ptr = nullptr;
    if (has_bias) {
        bias = bias.contiguous();
        bias_ptr = bias.data_ptr<float>();
    }
    const int num_h_tiles = (H_out + TILE_H - 1) / TILE_H;
    const long long col_count = (long long)N * (long long)C * (long long)W_out;
    dim3 grid((unsigned int)col_count, (unsigned int)num_h_tiles);
    dim3 block(TILE_H);
    const int smem_elems = (TILE_H - 1) * stride + (K - 1) * dilation + 1;
    const size_t smem_bytes = (size_t)smem_elems * sizeof(float);
    depthwise_conv2d_kh1_kernel<<<grid, block, smem_bytes>>>(
        input.data_ptr<float>(),
        weight.data_ptr<float>(),
        bias_ptr,
        output.data_ptr<float>(),
        N, C, H, W,
        K,
        H_out, W_out,
        stride, padding, dilation,
        has_bias
    );
    return output;
}
"""

depthwise_conv_cpp_source = r"""
torch::Tensor depthwise_conv2d_kh1_cuda(
    torch::Tensor input,
    torch::Tensor weight,
    torch::Tensor bias,
    int stride,
    int padding,
    int dilation,
    bool has_bias);
"""

depthwise_conv_module = load_inline(
