import torch.nn as nn
from torch.utils.cpp_extension import load_inline

# CUDA source: fused tall-skinny x wide-skinny matmul kernel
# A: (M, K)  B: (K, M)  C: (M, M)
# K is small (e.g. 32), M is large (e.g. 32768)
cuda_source = r"""
#include <torch/extension.h>
#include <cuda.h>
#include <cuda_runtime.h>

#define BLOCK_ROWS 64
#define BLOCK_COLS 256
#define ROW_SPLIT 4
#define ROWS_PER_THREAD (BLOCK_ROWS / ROW_SPLIT)
#define COL_THREADS (BLOCK_COLS / 4)
#define THREADS_PER_BLOCK (COL_THREADS * ROW_SPLIT)
__global__ void matmul_tall_skinny_kernel(
    const float* __restrict__ A,
    const float* __restrict__ B,
    float* __restrict__ C,
    int M,
    int K)
{
    extern __shared__ float smem[];
    float* As = smem;                        // BLOCK_ROWS * K
    float* Bs = smem + BLOCK_ROWS * K;        // K * BLOCK_COLS
    int block_row0 = blockIdx.x * BLOCK_ROWS;
    int block_col0 = blockIdx.y * BLOCK_COLS;
    int tid = threadIdx.x;
    // Cooperatively load A tile: BLOCK_ROWS x K into shared memory (reused across BLOCK_COLS)
    // Vectorized float4 loads since K is a multiple of 4 for the target shapes
    int kCols4 = K / 4;
    int a_vec_elems = BLOCK_ROWS * kCols4;
    for (int idx = tid; idx < a_vec_elems; idx += THREADS_PER_BLOCK) {
        int r = idx / kCols4;
