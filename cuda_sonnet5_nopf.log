            int nextBuf = 1 - curBuf;
            As[nextBuf][c4A * 4 + 0][rAStorage] = valA.x;
            As[nextBuf][c4A * 4 + 1][rAStorage] = valA.y;
            As[nextBuf][c4A * 4 + 2][rAStorage] = valA.z;
            As[nextBuf][c4A * 4 + 3][rAStorage] = valA.w;
            Bs[nextBuf][rB][c4B * 4 + 0] = valB.x;
            Bs[nextBuf][rB][c4B * 4 + 1] = valB.y;
            Bs[nextBuf][rB][c4B * 4 + 2] = valB.z;
            Bs[nextBuf][rB][c4B * 4 + 3] = valB.w;
            __syncthreads();
            buf = nextBuf;
