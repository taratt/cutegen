}\n                output[((n * C_out + oc) * H_out + out_y) * W_out + out_x] = val;\n            }\n        }\n    }\n}\ntorch::Tensor conv2d_forward(\n    torch::Tensor input,\n    torch::Tensor weight,\n    torch::Tensor bias,\n    int stride,\n    int padding,\n    int dilation,\n    int groups)\n{\n    input = input.contiguous();\n    weight = weight.contiguous();\n    int N = input.size(0);\n    int C_in = input.size(1);\n    int H = input.size(2);\n    int W = input.size(3);\n    int C_out = weight.size(0);\n    int K = weight.size(2);\n    int H_out = (H + 2 * padding - dilation * (K - 1) - 1) / stride + 1;\n    int W_out = (W + 2 * padding - dilation * (K - 1) - 1) / stride + 1;\n    auto output = torch::zeros({N, C_out, H_out, W_out}, input.options());\n    dim3 block(TILE_W, TILE_H);\n    int out_tile_w = TILE_W * THREAD_TILE;\n    int out_tile_h = TILE_H * THREAD_TILE;\n    dim3 grid(\n        (W_out + out_tile_w - 1) / out_tile_w,\n        (H_out + out_tile_h - 1) / out_tile_h,\n        N * C_out\n    );\n    int in_tile_w = (out_tile_w - 1) * stride + (K - 1) * dilation + 1;\n    int in_tile_h = (out_tile_h - 1) * stride + (K - 1) * dilation + 1;\n    size_t smem_size = (size_t)(in_tile_h * in_tile_w + K * K) * sizeof(float);\n    const float* bias_ptr = nullptr;\n    if (bias.defined() && bias.numel() > 0) {\n        bias = bias.contiguous();\n        bias_ptr = bias.data_ptr<float>();\n    }\n    conv2d_kernel<<<grid, block, smem_size>>>(\n        input.data_ptr<float>(),\n        weight.data_ptr<float>(),\n        bias_ptr,\n        output.data_ptr<float>(),\n        N, C_in, H, W,\n        C_out, K,\n        stride, padding, dilation,\n        groups,\n        H_out, W_out,\n        in_tile_h, in_tile_w\n    );\n    return output;\n}\n"""\n\nconv2d_cpp_source = r"""\ntorch::Tensor conv2d_forward(\n    torch::Tensor input,\n    torch::Tensor weight,\n    torch::Tensor bias,\n    int stride,\n    int padding,\n    int dilation,\n    int groups);\n"""\n\nconv2d_module = load_inline(\n    name="custom_conv2d",\n    cpp_sources=conv2d_cpp_source,\n    cuda_sources=conv2d_source,\n    functions=["conv2d_forward"],\n    verbose=False,\n)\n\n\nclass ModelNew(nn.Module):\n    def __init__(self, in_channels: int, out_channels: int, kernel_size: int, stride: int = 1,\n                 padding: int = 0, dilation: int = 1, groups: int = 1, bias: bool = False):\n        super(ModelNew, self).__init__()\n        self.in_channels = in_channels\n        self.out_channels = out_channels\n        self.kernel_size = kernel_size\n        self.stride = stride\n        self.padding = padding\n        self.dilation = dilation\n        self.groups = groups\n        self.has_bias = bias\n\n        self.weight = nn.Parameter(\n            torch.empty(out_channels, in_channels // groups, kernel_size, kernel_size)\n        )\n        nn.init.kaiming_uniform_(self.weight, a=5 ** 0.5)\n\n        if bias:\n            self.bias = nn.Parameter(torch.empty(out_channels))\n            fan_in = (in_channels // groups) * kernel_size * kernel_size\n            bound = 1 / (fan_in ** 0.5)\n            nn.init.uniform_(self.bias, -bound, bound)\n        else:\n            self.register_parameter(\'bias\', None)\n\n        self.conv2d_forward = conv2d_module.conv2d_forward\n\n    def forward(self, x: torch.Tensor) -> torch.Tensor:\n        x = x.cuda().contiguous()\n        weight = self.weight.cuda().contiguous()\n        bias = self.bias.cuda() if self.bias is not None else torch.tensor([], device=x.device, dtype=x.dtype)\n\n        return self.conv2d_forward(\n            x, weight, bias,\n            self.stride, self.padding, self.dilation, self.groups\n        )\n\n\nbatch_size = 8\nheight = 512\nwidth = 1024\nin_channels = 64\nout_channels = 128\nkernel_size = 3\n\n\ndef get_inputs():\n    x = torch.rand(batch_size, in_channels, height, width)\n    return [x]\n\n\ndef get_init_inputs():\n    return [in_channels, out_channels, kernel_size]', '