nnels_per_group * kvol;\n    float* s_weight = s_mem;\n    float* s_input = s_mem + weight_slice_size;\n    for (int i = threadIdx.x; i < weight_slice_size; i += blockDim.x) {\n        int ic_offset = i / kvol;\n        int k_offset = i % kvol;\n        int ic = ic_start + ic_offset;\n        long long weight_idx = ((long long)ic * out_channels_per_group + oc_local) * kvol + k_offset;\n        s_weight[i] = weight[weight_idx];\n    }\n    __syncthreads();\n    int od = (int)(blockIdx.z / H_out);\n    int oh = (int)(blockIdx.z % H_out);\n    int ow_base = blockIdx.x * ow_tile_width;\n    int ow0 = ow_base + threadIdx.x * OW_COARSEN;\n    float acc[OW_COARSEN];\n#pragma unroll\n    for (int c = 0; c < OW_COARSEN; c++) acc[c] = 0.0f;\n    for (int kd = 0; kd < kD; kd++) {\n        int id_num = od + pad_d - kd;\n        if (id_num < 0 || id_num % stride_d != 0) continue;\n        int id = id_num / stride_d;\n        if (id < 0 || id >= D_in) continue;\n        for (int kh = 0; kh < kH; kh++) {\n            int ih_num = oh + pad_h - kh;\n            if (ih_num < 0 || ih_num % stride_h != 0) continue;\n            int ih = ih_num / stride_h;\n            if (ih < 0 || ih >= H_in) continue;\n            __syncthreads(); // ensure previous consumers of s_input finished\n            int iw_lo = floor_div(ow_base + pad_w - (kW - 1), stride_w);\n            int iw_hi = floor_div(ow_base + ow_tile_width - 1 + pad_w, stride_w);\n            if (iw_lo < 0) iw_lo = 0;\n            if (iw_hi > W_in - 1) iw_hi = W_in - 1;\n            int iw_tile_size = 0;\n            if (iw_lo <= iw_hi) {\n                iw_tile_size = iw_hi - iw_lo + 1;\n                if (iw_tile_size > max_iw_tile) iw_tile_size = max_iw_tile;\n                for (int i = threadIdx.x; i < in_channels_per_group * iw_tile_size; i += blockDim.x) {\n                    int ic_offset = i / iw_tile_size;\n                    int local_iw = i % iw_tile_size;\n                    int iw = iw_lo + local_iw;\n                    int ic = ic_start + ic_offset;\n                    long long idx = (((long long)b * in_channels + ic) * D_in + id) * H_in * W_in\n                                   + (long long)ih * W_in + iw;\n                    s_input[i] = input[idx];\n                }\n            }\n            __syncthreads();\n            if (iw_tile_size > 0) {\n                for (int kw = 0; kw < kW; kw++) {\n                    int k_offset = (kd * kH + kh) * kW + kw;\n                    int local_iw_arr[OW_COARSEN];\n                    bool valid_arr[OW_COARSEN];\n#pragma unroll\n                    for (int c = 0; c < OW_COARSEN; c++) {\n                        int ow = ow0 + c;\n                        valid_arr[c] = false;\n                        local_iw_arr[c] = -1;\n                        if (ow < W_out) {\n                            int iw_num = ow + pad_w - kw;\n                            if (iw_num >= 0 && iw_num % stride_w == 0) {\n                                int iw = iw_num / stride_w;\n                                if (iw >= 0 && iw < W_in) {\n                                    int local_iw = iw - iw_lo;\n                                    if (local_iw >= 0 && local_iw < iw_tile_size) {\n                                        local_iw_arr[c] = local_iw;\n                                        valid_arr[c] = true;\n                                    }\n                                }\n                            }\n                        }\n                    }\n                    for (int ic_offset = 0; ic_offset < in_channels_per_group; ic_offset++) {\n                        float wval = s_weight[ic_offset * kvol + k_offset];\n                        const float* s_input_row = s_input + ic_offset * iw_tile_size;\n#pragma unroll\n                        for (int c = 0; c < OW_COARSEN; c++) {\n                            if (valid_arr[c]) {\n                                acc[c] += s_input_row[local_iw_arr[c]] * wval;\n                  