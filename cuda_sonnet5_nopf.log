    if (lane == 0) red[warpId] = local_sum;
    __syncthreads();
    if (warpId == 0) {
        float v = (lane < numWarps) ? red[lane] : 0.0f;
        #pragma unroll
        for (int offset = 16; offset > 0; offset >>= 1) {
