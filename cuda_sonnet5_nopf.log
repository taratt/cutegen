conv3d_header = r"""
torch::Tensor conv3d_forward(
    torch::Tensor input,
    torch::Tensor weight,
    torch::Tensor bias,
    int stride,
    int padding,
    int dilation,
    int groups,
    bool has_bias);
"""

conv3d_module = load_inline(
