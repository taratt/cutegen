  TORCH_CHECK(x.is_cuda(), "x must be a CUDA tensor");\n    TORCH_CHECK(x.dim() == 4, "x must be 4D (N, C, H, W)");\n    x = x.contiguous();\n\n    int N = x.size(0);\n    int C = x.size(1);\n    int H = x.size(2);\n    int W = x.size(3);\n\n    auto y = torch::empty_like(x);\n\n    auto options = x.options();\n    auto mean = torch::empty({C}, options);\n    auto var = torch::empty({C}, options);\n\n    if (training) {\n        int threads = 256;\n        int blocks = C;\n        size_t shared_mem = 2 * threads * sizeof(float);\n\n        compute_stats_kernel<<<blocks, threads, shared_mem>>>(\n            x.data_ptr<float>(),\n            mean.data_ptr<float>(),\n            var.data_ptr<float>(),\n            running_mean.data_ptr<float>(),\n            running_var.data_ptr<float>(),\n            N, C, H, W,\n            (float)momentum, (float)eps, true\n        );\n    } else {\n        mean.copy_(running_mean);\n        var.copy_(running_var);\n    }\n\n    long total_elems = (long)N * C * H * W;\n    long HW = (long)H * W;\n    int threads2 = 256;\n    if ((HW % 4 == 0) && (total_elems % 4 == 0)) {\n        long total4 = total_elems / 4;\n        long HW4 = HW / 4;\n        int blocks2 = (int)((total4 + threads2 - 1) / threads2);\n        if (blocks2 > 65535) blocks2 = 65535;\n        if (blocks2 < 1) blocks2 = 1;\n        bn_normalize_kernel_vec4<<<blocks2, threads2>>>(\n            reinterpret_cast<const float4*>(x.data_ptr<float>()),\n            reinterpret_cast<float4*>(y.data_ptr<float>()),\n            mean.data_ptr<float>(),\n            var.data_ptr<float>(),\n            weight.data_ptr<float>(),\n            bias.data_ptr<float>(),\n            total4, C, HW4,\n            (float)eps\n        );\n    } else {\n        int blocks2 = (int)((total_elems + threads2 - 1) / threads2);\n        if (blocks2 > 65535) blocks2 = 65535;\n        bn_normalize_kernel<<<blocks2, threads2>>>(\n            x.data_ptr<float>(),\n            y.data_ptr<float>(),\n    