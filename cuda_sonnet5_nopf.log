#include <torch/extension.h>
#include <cuda_fp16.h>
#include <cuda_runtime.h>
#include <math.h>

#define THREADS 256

__global__ void sdpa_kernel(const half* __restrict__ Q,
                             const half* __restrict__ K,
                             const half* __restrict__ V,
                             half* __restrict__ O,
                             int batch, int heads, int seqlen, int dim,
                             float scale) {
    int idx = blockIdx.x; // over batch*heads*seqlen
    int i = idx % seqlen;
    int bh = idx / seqlen;
    int h = bh % heads;
    int b = bh / heads;

    const half* Qrow = Q + (((size_t)b*heads + h)*seqlen + i)*dim;
    const half* Kbase = K + (((size_t)b*heads + h)*seqlen)*dim;
    const half* Vbase = V + (((size_t)b*heads + h)*seqlen)*dim;
    half* Orow = O + (((size_t)b*heads + h)*seqlen + i)*dim;

    extern __shared__ char smem[];
    half* qs = (half*)smem;                     // dim halfs
    float* scores = (float*)(qs + dim);          // seqlen floats
    float* red = scores + seqlen;                // THREADS floats
    int dim8 = dim >> 3;
    float4* qs4 = (float4*)qs;
    const float4* Qrow4 = (const float4*)Qrow;
    // load Q row to shared mem (vectorized float4 loads = 8 halfs at a time)
    for (int d4 = threadIdx.x; d4 < dim8; d4 += blockDim.x) {
        qs4[d4] = Qrow4[d4];
    }
    __syncthreads();
    // compute scores = Q . K^T * scale (vectorized float4 dot product, 8 halfs per iter)
    for (int j = threadIdx.x; j < seqlen; j += blockDim.x) {
        const float4* Krow4 = (const float4*)(Kbase + (size_t)j*dim);
        float sum = 0.0f;
        #pragma unroll 4
        for (int d4 = 0; d4 < dim8; d4++) {
            float4 qv = qs4[d4];
            float4 kv = Krow4[d4];
            const half2* qh = (const half2*)&qv;
            const half2* kh = (const half2*)&kv;
            #pragma unroll
            for (int k = 0; k < 4; k++) {
                float2 qf = __half22float2(qh[k]);
                float2 kf = __half22float2(kh[k]);
                sum += qf.x * kf.x + qf.y * kf.y;
            }
        }
        scores[j] = sum * scale;
    }
    __syncthreads();
    // compute max for numerical stability (warp-shuffle reduction to cut sync overhead)
    float local_max = -1e30f;
    for (int j = threadIdx.x; j < seqlen; j += blockDim.x) {
        local_max = fmaxf(local_max, scores[j]);
    }
    #pragma unroll
    for (int offset = 16; offset > 0; offset >>= 1) {
        local_max = fmaxf(local_max, __shfl_down_sync(0xffffffff, local_max, offset));
    }
    int lane = threadIdx.x & 31;
    int warpId = threadIdx.x >> 5;
    int numWarps = (blockDim.x + 31) >> 5;
    if (lane == 0) red[warpId] = local_max;
    __syncthreads();
    if (warpId == 0) {
        float v = (lane < numWarps) ? red[lane] : -1e30f;
        #pragma unroll
        for (int offset = 16; offset > 0; offset >>= 1) {
            v = fmaxf(v, __shfl_down_sync(0xffffffff, v, offset));
