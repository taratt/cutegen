    int sh_size = in_channels * sh_h * sh_w;
    int weight_tile_size = OC_TILE * in_channels * kernel_size * kernel_size;
    float* sh_weight = shmem + sh_size;
    for (int i = tid; i < sh_size; i += num_threads) {
