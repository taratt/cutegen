l\n    for (int i = 0; i < TM; i++) {\n        #pragma unroll\n        for (int j = 0; j < TN; j++) {\n            threadResults[i][j] = 0.0f;\n        }\n    }\n    const int tid = threadIdx.x;\n    // Each thread loads exactly one float4 for A and one float4 for B per\n    // K-tile (BM*BK/4 == BK*BN/4 == numThreads == 256).\n    const int rA = tid / (BK / 4);\n    const int c4A = tid % (BK / 4);\n    const int rB = tid / (BN / 4);\n    const int c4B = tid % (BN / 4);\n    const int globalRowA = rowStart + rA;\n    const int globalColB = colStart + c4B * 4;\n    // Group-based padding for the A shared-memory tile: rows are stored in\n    // groups of TM elements with extra padding so that the TM/8 sub-tile\n    // rows accessed simultaneously by a warp map to distinct shared-memory\n    // banks, eliminating the 2-way bank conflicts that otherwise occur\n    // when BM (128) and TM (8) interact with the 32 shared-memory banks.\n    const int groupA = rA / TM;\n    const int offA = rA % TM;\n    const int rAStorage = groupA * A_GROUP_STRIDE + offA;\n    const int numTiles = (N + BK - 1) / BK;\n    float4 valA0, valB0;\n    loadTileGmem(A, B, N, globalRowA, c4A, globalColB, rB, 0, valA0, valB0);\n    As[0][c4A * 4 + 0][rAStorage] = valA0.x;\n    As[0][c4A * 4 + 1][rAStorage] = valA0.y;\n    As[0][c4A * 4 + 2][rAStorage] = valA0.z;\n    As[0][c4A * 4 + 3][rAStorage] = valA0.w;\n    *reinterpret_cast<float4*>(&Bs[0][rB][c4B * 4]) = valB0;\n    bool hasTile1 = numTiles > 1;\n    if (hasTile1) {\n        float4 valA1, valB1;\n        loadTileGmem(A, B, N, globalRowA, c4A, globalColB, rB, BK, valA1, valB1);\n        As[1][c4A * 4 + 0][rAStorage] = valA1.x;\n        As[1][c4A * 4 + 1][rAStorage] = valA1.y;\n        As[1][c4A * 4 + 2][rAStorage] = valA1.z;\n        As[1][c4A * 4 + 3][rAStorage] = valA1.w;\n        *reinterpret_cast<float4*>(&Bs[1][rB][c4B * 4]) = valB1;\n    }\n    __syncthreads();\n    // 3-stage software pipeline: while computing on tile t, prefetch tile