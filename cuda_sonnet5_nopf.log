import torch.nn as nn
import math
from torch.utils.cpp_extension import load_inline

conv2d_source = r"""
#include <torch/extension.h>
#include <cuda.h>
#include <cuda_runtime.h>
#define TILE_OH 16
#define TILE_OW 16
#define OC_TILE 4
__global__ void conv2d_forward_kernel(
    const float* __restrict__ input,
    const float* __restrict__ weight,
    float* __restrict__ output,
    int N, int C_in, int H, int W,
    int C_out, int KH, int KW,
    int stride, int padH, int padW,
    int dilH, int dilW,
    int H_out, int W_out,
    int in_tile_h, int in_tile_w,
    int oc_groups)
{
    extern __shared__ float smem[];
    float* s_in = smem;
    float* s_w = smem + (size_t)in_tile_h * in_tile_w;
    int tx = threadIdx.x;
    int ty = threadIdx.y;
    int ow0 = blockIdx.x * TILE_OW;
    int oh0 = blockIdx.y * TILE_OH;
    int ow = ow0 + tx;
    int oh = oh0 + ty;
    int nc = blockIdx.z;
    int n = nc / oc_groups;
    int oc_group = nc % oc_groups;
    int oc_base = oc_group * OC_TILE;
    int in_h0 = oh0 * stride - padH;
    int in_w0 = ow0 * stride - padW;
    float sum[OC_TILE];
    #pragma unroll
    for (int i = 0; i < OC_TILE; ++i) sum[i] = 0.0f;
    int total = in_tile_h * in_tile_w;
    int tid = ty * TILE_OW + tx;
    int nthreads = TILE_OH * TILE_OW;
    int wk_total = OC_TILE * KH * KW;
    const float* in_batch = input + (size_t)n * C_in * H * W;
    bool valid_out = (ow < W_out) && (oh < H_out);
    for (int c = 0; c < C_in; ++c) {
        const float* in_c = in_batch + (size_t)c * H * W;
        for (int idx = tid; idx < total; idx += nthreads) {
            int r = idx / in_tile_w;
            int cc = idx % in_tile_w;
            int ih = in_h0 + r;
            int iw = in_w0 + cc;
            float val = 0.0f;
            if (ih >= 0 && ih < H && iw >= 0 && iw < W) {
                val = in_c[(size_t)ih * W + iw];
            }
            s_in[idx] = val;
        }
        for (int idx = tid; idx < wk_total; idx += nthreads) {
            int i = idx / (KH * KW);
            int rem = idx % (KH * KW);
            int oc = oc_base + i;
            float wval = 0.0f;
            if (oc < C_out) {
                wval = weight[((size_t)oc * C_in + c) * KH * KW + rem];
            }
            s_w[idx] = wval;
        }
        __syncthreads();
        if (valid_out) {
            #pragma unroll
            for (int i = 0; i < OC_TILE; ++i) {
                int oc = oc_base + i;
                if (oc < C_out) {
                    const float* w_c = s_w + (size_t)i * KH * KW;
                    float acc = 0.0f;
                    for (int kh = 0; kh < KH; ++kh) {
                        int sh = ty * stride + kh * dilH;
                        const float* srow = s_in + (size_t)sh * in_tile_w;
                        const float* wrow = w_c + (size_t)kh * KW;
                        for (int kw = 0; kw < KW; ++kw) {
                            int sw = tx * stride + kw * dilW;
                            acc += srow[sw] * wrow[kw];
                        }
                    }
                    sum[i] += acc;
                }
            }
        }
        __syncthreads();
    }
    if (valid_out) {
        #pragma unroll
        for (int i = 0; i < OC_TILE; ++i) {
            int oc = oc_base + i;
            if (oc < C_out) {
                output[((size_t)(n * C_out + oc) * H_out + oh) * W_out + ow] = sum[i];
            }
        }
    }
}
torch::Tensor conv2d_forward_cuda(
    torch::Tensor input,
    torch::Tensor weight,
    int stride,
    int padH, int padW,
    int dilH, int dilW)
{
    input = input.contiguous();
    weight = weight.contiguous();
    int N = input.size(0);
    int C_in = input.size(1);
    int H = input.size(2);
    int W = input.size(3);
    int C_out = weight.size(0);
    int KH = weight.size(2);
    int KW = weight.size(3);
    int H_out = (H + 2 * padH - dilH * (KH - 1) - 1) / stride + 1;
    int W_out = (W + 2 * padW - dilW * (KW - 1) - 1) / stride + 1;
    auto output = torch::zeros({N, C_out, H_out, W_out}, input.options());
    int in_tile_h = (TILE_OH - 1) * stride + dilH * (KH - 1) + 1;
    int in_tile_w = (TILE_OW - 1) * stride + dilW * (KW - 1) + 1;
    size_t shmem_bytes = (size_t)in_tile_h * (size_t)in_tile_w * sizeof(float);
    int oc_groups = (C_out + OC_TILE - 1) / OC_TILE;
    dim3 block(TILE_OW, TILE_OH, 1);
    dim3 grid(
        (W_out + TILE_OW - 1) / TILE_OW,
        (H_out + TILE_OH - 1) / TILE_OH,
        N * oc_groups
    );
    if (shmem_bytes > 48 * 1024) {
    size_t shmem_bytes = (size_t)in_tile_h * (size_t)in_tile_w * sizeof(float) + (size_t)OC_TILE * KH * KW * sizeof(float);
    }
    conv2d_forward_kernel<<<grid, block, shmem_bytes>>>(
