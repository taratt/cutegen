import torch.nn as nn
from torch.utils.cpp_extension import load_inline
conv2d_source = r"""
#include <torch/extension.h>
#include <cuda.h>
#include <cuda_runtime.h>
#define TILE_H 8
#define TILE_W 8
#define REG_W 2
#define REG_H 2
__global__ void conv2d_forward_kernel(
    const float* __restrict__ input,
    const float* __restrict__ weight,
    const float* __restrict__ bias,
    float* __restrict__ output,
    int batch_size,
    int in_channels,
    int in_h,
    int in_w,
    int out_channels,
    int out_h,
    int out_w,
    int kernel_size,
    int stride,
    int padding,
    int sh_h,
    int sh_w)
{
    extern __shared__ float shmem[];
    int oc = blockIdx.z % out_channels;
    int n = blockIdx.z / out_channels;
    int out_tile_w_total = TILE_W * REG_W;
    int out_tile_h_total = TILE_H * REG_H;
    int out_tile_x = blockIdx.x * out_tile_w_total;
    int out_tile_y = blockIdx.y * out_tile_h_total;
    int tx = threadIdx.x;
    int ty = threadIdx.y;
    int ow_base = out_tile_x + tx * REG_W;
    int oh_base = out_tile_y + ty * REG_H;
    int in_h_start = out_tile_y * stride - padding;
    int in_w_start = out_tile_x * stride - padding;
    int tid = ty * TILE_W + tx;
    int num_threads = TILE_W * TILE_H;
    int sh_size = in_channels * sh_h * sh_w;
    for (int i = tid; i < sh_size; i += num_threads) {
        int c = i / (sh_h * sh_w);
        int rem = i % (sh_h * sh_w);
        int sh_y = rem / sh_w;
        int sh_x = rem % sh_w;
        int ih = in_h_start + sh_y;
        int iw = in_w_start + sh_x;
        float val = 0.0f;
        if (ih >= 0 && ih < in_h && iw >= 0 && iw < in_w) {
            val = input[((n * in_channels + c) * in_h + ih) * in_w + iw];
        }
        shmem[i] = val;
    }
    __syncthreads();
    float sum00 = bias[oc];
    float sum01 = bias[oc];
    float sum10 = bias[oc];
    float sum11 = bias[oc];
    int local_h0 = ty * REG_H * stride;
    int local_h1 = local_h0 + stride;
    int local_w0 = tx * REG_W * stride;
    int local_w1 = local_w0 + stride;
    for (int ic = 0; ic < in_channels; ++ic) {
        const float* weight_ptr = weight + ((oc * in_channels + ic) * kernel_size) * kernel_size;
        const float* sh_ptr = shmem + ic * sh_h * sh_w;
        for (int kh = 0; kh < kernel_size; ++kh) {
            const float* sh_row_h0 = sh_ptr + (local_h0 + kh) * sh_w;
            const float* sh_row_h1 = sh_ptr + (local_h1 + kh) * sh_w;
            const float* w_row = weight_ptr + kh * kernel_size;
            for (int kw = 0; kw < kernel_size; ++kw) {
                float wv = w_row[kw];
                sum00 += sh_row_h0[local_w0 + kw] * wv;
                sum01 += sh_row_h0[local_w1 + kw] * wv;
                sum10 += sh_row_h1[local_w0 + kw] * wv;
                sum11 += sh_row_h1[local_w1 + kw] * wv;
            }
        }
    }
    int oh0 = oh_base;
    int oh1 = oh_base + 1;
    int ow0 = ow_base;
    int ow1 = ow_base + 1;
    if (oh0 < out_h) {
        if (ow0 < out_w) {
            output[((n * out_channels + oc) * out_h + oh0) * out_w + ow0] = sum00;
        }
        if (ow1 < out_w) {
            output[((n * out_channels + oc) * out_h + oh0) * out_w + ow1] = sum01;
        }
    }
    if (oh1 < out_h) {
        if (ow0 < out_w) {
            output[((n * out_channels + oc) * out_h + oh1) * out_w + ow0] = sum10;
        }
        if (ow1 < out_w) {
            output[((n * out_channels + oc) * out_h + oh1) * out_w + ow1] = sum11;
        }
    }
}
torch::Tensor conv2d_forward(
    torch::Tensor input,
    torch::Tensor weight,
    torch::Tensor bias,
    int stride,
    int padding)
{
    input = input.contiguous();
    weight = weight.contiguous();
    bias = bias.contiguous();
    int batch_size = input.size(0);
    int in_channels = input.size(1);
    int in_h = input.size(2);
    int in_w = input.size(3);
    int out_channels = weight.size(0);
    int kernel_size = weight.size(2);
    int out_h = (in_h + 2 * padding - kernel_size) / stride + 1;
    int out_w = (in_w + 2 * padding - kernel_size) / stride + 1;
    auto output = torch::empty({batch_size, out_channels, out_h, out_w}, input.options());
    int out_tile_w_total = TILE_W * REG_W;
    int out_tile_h_total = TILE_H * REG_H;
    int sh_h = (out_tile_h_total - 1) * stride + kernel_size;
    int sh_w = (out_tile_w_total - 1) * stride + kernel_size;
    size_t shmem_size = (size_t)in_channels * sh_h * sh_w * sizeof(float);
    if (shmem_size > 48 * 1024) {
        cudaFuncSetAttribute(conv2d_forward_kernel, cudaFuncAttributeMaxDynamicSharedMemorySize, (int)shmem_size);
    }
    dim3 block(TILE_W, TILE_H);
    dim3 grid(
        (out_w + out_tile_w_total - 1) / out_tile_w_total,
        (out_h + out_tile_h_total - 1) / out_tile_h_total,
        batch_size * out_channels
    );
    conv2d_forward_kernel<<<grid, block, shmem_size>>>(
        input.data_ptr<float>(),
        weight.data_ptr<float>(),
        bias.data_ptr<float>(),
        output.data_ptr<float>(),
        batch_size,
        in_channels,
        in_h,
        in_w,
        out_channels,
        out_h,
        out_w,
        kernel_size,
        stride,
        padding,
        sh_h,
        sh_w
    );
    return output;
}
"""
conv2d_cpp_source = r"""
torch::Tensor conv2d_forward(
    torch::Tensor input,
    torch::Tensor weight,
    torch::Tensor bias,
    int stride,
    int padding);
"""
conv2d_module = load_inline(
    name="conv2d_module",
    cpp_sources=conv2d_cpp_source,
    cuda_sources=conv2d_source,
    functions=["conv2d_forward"],
    verbose=False,
)
class ModelNew(nn.Module):
    def __init__(self, num_classes=1000):
        super(ModelNew, self).__init__()
        self.stride = 4
        self.padding = 2
        self.kernel_size = 11
        self.in_channels = 3
        self.out_channels = 96
        self.weight = nn.Parameter(torch.empty(self.out_channels, self.in_channels, self.kernel_size, self.kernel_size))
        self.bias = nn.Parameter(torch.empty(self.out_channels))
        nn.init.kaiming_uniform_(self.weight, a=5 ** 0.5)
        fan_in = self.in_channels * self.kernel_size * self.kernel_size
        bound = 1 / (fan_in ** 0.5)
        nn.init.uniform_(self.bias, -bound, bound)
        self.conv2d_forward = conv2d_module.conv2d_forward
    def forward(self, x):
        x = x.cuda().contiguous()
        return self.conv2d_forward(x, self.weight, self.bias, self.stride, self.padding)
