import torch.nn as nn
from torch.utils.cpp_extension import load_inline

depthwise_conv_source = r"""
#include <torch/extension.h>
#include <cuda.h>
#include <cuda_runtime.h>

__global__ void depthwise_conv2d_kh1_kernel(
    const float* __restrict__ input,
    const float* __restrict__ weight,
    const float* __restrict__ bias,
    float* __restrict__ output,
    const int N, const int C, const int H, const int W,
    const int K,
    const int H_out, const int W_out,
    const int stride, const int padding, const int dilation,
    const bool has_bias)
{
    int idx = blockIdx.x * blockDim.x + threadIdx.x;
    int total = N * C * H_out * W_out;
    if (idx >= total) return;

    int ow = idx % W_out;
    int tmp = idx / W_out;
    int oh = tmp % H_out;
    tmp = tmp / H_out;
    int c = tmp % C;
    int n = tmp / C;

    int iw = ow * stride - padding;

    float acc = 0.0f;

    if (iw >= 0 && iw < W) {
        int ih_base = oh * stride - padding;
        const float* in_ptr = input + ((n * C + c) * H) * W;
        const float* w_ptr = weight + c * K;

        #pragma unroll
        for (int kh = 0; kh < K; ++kh) {
            int ih = ih_base + kh * dilation;
            if (ih >= 0 && ih < H) {
                acc += in_ptr[ih * W + iw] * w_ptr[kh];
            }
        }
    }

    if (has_bias) {
        acc += bias[c];
    }

    output[idx] = acc;
}

torch::Tensor depthwise_conv2d_kh1_cuda(
    torch::Tensor input,
    torch::Tensor weight,
    torch::Tensor bias,
    int stride,
    int padding,
    int dilation,
    bool has_bias)
{
    input = input.contiguous();
    weight = weight.contiguous();

    const int N = input.size(0);
    const int C = input.size(1);
    const int H = input.size(2);
    const int W = input.size(3);
    const int K = weight.size(2); // weight shape: (C, 1, K, 1)

    const int H_out = (H + 2 * padding - dilation * (K - 1) - 1) / stride + 1;
    const int W_out = (W + 2 * padding - dilation * (1 - 1) - 1) / stride + 1;

    auto output = torch::empty({N, C, H_out, W_out}, input.options());

    const int total = N * C * H_out * W_out;
    const int threads = 256;
    const int blocks = (total + threads - 1) / threads;

    const float* bias_ptr = nullptr;
    if (has_bias) {
        bias = bias.contiguous();
        bias_ptr = bias.data_ptr<float>();
    }

    depthwise_conv2d_kh1_kernel<<<blocks, threads>>>(
        input.data_ptr<float>(),
        weight.data_ptr<float>(),
        bias_ptr,
        output.data_ptr<float>(),
        N, C, H, W,
        K,
        H_out, W_out,
        stride, padding, dilation,
        has_bias
    );

    return output;
}
"""

