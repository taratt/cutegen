conv2d_cpp_source = r"""
torch::Tensor conv2d_forward(
    torch::Tensor input,
    torch::Tensor weight,
    torch::Tensor bias,
    int stride,
    int padding,
    int dilation,
    int groups);
"""

conv2d_module = load_inline(
