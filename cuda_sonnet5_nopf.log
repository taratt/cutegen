import torch.nn as nn
from torch.utils.cpp_extension import load_inline
conv2d_source = r"""
#include <torch/extension.h>
#include <cuda.h>
#include <cuda_runtime.h>
#define TILE_H 8
#define TILE_W 8
#define REG_W 2
#define REG_H 1
#define OC_TILE 4
__global__ void conv2d_forward_kernel(
    const float* __restrict__ input,
    const float* __restrict__ weight,
    const float* __restrict__ bias,
    float* __restrict__ output,
    int batch_size,
    int in_channels,
    int in_h,
    int in_w,
    int out_channels,
    int out_h,
    int out_w,
    int kernel_size,
    int stride,
    int padding,
    int sh_h,
    int sh_w)
{
    extern __shared__ float shmem[];
    int oc_tiles = out_channels / OC_TILE;
    int oc_group = blockIdx.z % oc_tiles;
    int n = blockIdx.z / oc_tiles;
    int oc_base = oc_group * OC_TILE;
    int out_tile_w_total = TILE_W * REG_W;
    int out_tile_h_total = TILE_H * REG_H;
    int out_tile_x = blockIdx.x * out_tile_w_total;
    int out_tile_y = blockIdx.y * out_tile_h_total;
    int tx = threadIdx.x;
    int ty = threadIdx.y;
    int ow_base = out_tile_x + tx * REG_W;
    int oh_base = out_tile_y + ty * REG_H;
    int in_h_start = out_tile_y * stride - padding;
    int in_w_start = out_tile_x * stride - padding;
    int tid = ty * TILE_W + tx;
    int num_threads = TILE_W * TILE_H;
    int sh_size = in_channels * sh_h * sh_w;
    for (int i = tid; i < sh_size; i += num_threads) {
        int c = i / (sh_h * sh_w);
        int rem = i % (sh_h * sh_w);
        int sh_y = rem / sh_w;
        int sh_x = rem % sh_w;
        int ih = in_h_start + sh_y;
        int iw = in_w_start + sh_x;
        float val = 0.0f;
        if (ih >= 0 && ih < in_h && iw >= 0 && iw < in_w) {
            val = input[((n * in_channels + c) * in_h + ih) * in_w + iw];
        }
        shmem[i] = val;
    }
    __syncthreads();
    float sum[OC_TILE][REG_H][REG_W];
    #pragma unroll
    for (int oi = 0; oi < OC_TILE; ++oi) {
        #pragma unroll
        for (int rh = 0; rh < REG_H; ++rh) {
            #pragma unroll
            for (int rw = 0; rw < REG_W; ++rw) {
                sum[oi][rh][rw] = bias[oc_base + oi];
            }
        }
    }
    int local_h[REG_H];
    #pragma unroll
    for (int rh = 0; rh < REG_H; ++rh) {
        local_h[rh] = (ty * REG_H + rh) * stride;
    }
    int local_w[REG_W];
    #pragma unroll
    for (int rw = 0; rw < REG_W; ++rw) {
        local_w[rw] = (tx * REG_W + rw) * stride;
    }
    for (int ic = 0; ic < in_channels; ++ic) {
        const float* sh_ptr = shmem + ic * sh_h * sh_w;
        #pragma unroll
        for (int oi = 0; oi < OC_TILE; ++oi) {
            int oc = oc_base + oi;
            const float* weight_ptr = weight + ((oc * in_channels + ic) * kernel_size) * kernel_size;
            for (int kh = 0; kh < kernel_size; ++kh) {
                const float* w_row = weight_ptr + kh * kernel_size;
                #pragma unroll
                for (int rh = 0; rh < REG_H; ++rh) {
                    const float* sh_row = sh_ptr + (local_h[rh] + kh) * sh_w;
                    for (int kw = 0; kw < kernel_size; ++kw) {
                        float wv = w_row[kw];
                        #pragma unroll
                        for (int rw = 0; rw < REG_W; ++rw) {
                            sum[oi][rh][rw] += sh_row[local_w[rw] + kw] * wv;
                        }
                    }
                }
            }
        }
    }
    #pragma unroll
    for (int oi = 0; oi < OC_TILE; ++oi) {
        int oc = oc_base + oi;
        #pragma unroll
        for (int rh = 0; rh < REG_H; ++rh) {
            int oh = oh_base + rh;
            if (oh < out_h) {
                #pragma unroll
                for (int rw = 0; rw < REG_W; ++rw) {
                    int ow = ow_base + rw;
                    if (ow < out_w) {
                        output[((n * out_channels + oc) * out_h + oh) * out_w + ow] = sum[oi][rh][rw];
                    }
                }
            }
        }
    }
}
torch::Tensor conv2d_forward(
    torch::Tensor input,
    torch::Tensor weight,
    torch::Tensor bias,
    int stride,
    int padding)
{
    input = input.contiguous();
    weight = weight.contiguous();
    bias = bias.contiguous();
    int batch_size = input.size(0);
    int in_channels = input.size(1);
    int in_h = input.size(2);
    int in_w = input.size(3);
    int out_channels = weight.size(0);
    int kernel_size = weight.size(2);
    int out_h = (in_h + 2 * padding - kernel_size) / stride + 1;
    int out_w = (in_w + 2 * padding - kernel_size) / stride + 1;
    auto output = torch::empty({batch_size, out_channels, out_h, out_w}, input.options());
    int out_tile_w_total = TILE_W * REG_W;
    int out_tile_h_total = TILE_H * REG_H;
    int sh_h = (out_tile_h_total - 1) * stride + kernel_size;
    int sh_w = (out_tile_w_total - 1) * stride + kernel_size;
    size_t shmem_size = (size_t)in_channels * sh_h * sh_w * sizeof(float);
    if (shmem_size > 48 * 1024) {
        cudaFuncSetAttribute(conv2d_forward_kernel, cudaFuncAttributeMaxDynamicSharedMemorySize, (int)shmem_size);
    }
    dim3 block(TILE_W, TILE_H);
    dim3 grid(
        (out_w + out_tile_w_total - 1) / out_tile_w_total,
        (out_h + out_tile_h_total - 1) / out_tile_h_total,
        batch_size * out_channels
    );
    conv2d_forward_kernel<<<grid, block, shmem_size>>>(
