ise_conv_cpp_source,\n    cuda_sources=depthwise_conv_source,\n    functions=["depthwise_conv2d_kh1_cuda"],\n    verbose=False,\n)\n\n\nclass ModelNew(nn.Module):\n    """\n    Performs a depthwise 2D convolution with a square input and an asymmetric\n    kernel (kernel_size, 1), implemented with a custom fused CUDA kernel.\n    """\n    def __init__(self, in_channels: int, kernel_size: int, stride: int = 1, padding: int = 0, dilation: int = 1, bias: bool = False):\n        super(ModelNew, self).__init__()\n        self.in_channels = in_channels\n        self.kernel_size = kernel_size\n        self.stride = stride\n        self.padding = padding\n        self.dilation = dilation\n        self.has_bias = bias\n\n        # Match parameter shapes of nn.Conv2d with groups=in_channels\n        self.weight = nn.Parameter(torch.empty(in_channels, 1, kernel_size, 1))\n        nn.init.kaiming_uniform_(self.weight, a=5 ** 0.5)\n\n        if bias:\n            self.bias = nn.Parameter(torch.empty(in_channels))\n            fan_in = kernel_size\n            bound = 1 / (fan_in ** 0.5)\n            nn.init.uniform_(self.bias, -bound, bound)\n        else:\n            self.register_parameter(\'bias\', None)\n\n        self.conv_op = depthwise_conv_module\n\n    def forward(self, x: torch.Tensor) -> torch.Tensor:\n        x = x.contiguous()\n        bias_tensor = self.bias if self.has_bias else torch.empty(0, device=x.device, dtype=x.dtype)\n        return self.conv_op.depthwise_conv2d_kh1_cuda(\n            x, self.weight, bias_tensor,\n            self.stride, self.padding, self.dilation, self.has_bias\n        )\n\n\nbatch_size = 64\nin_channels = 8\nkernel_size = 3\nwidth = 512\nheight = 512\nstride = 1\npadding = 0\ndilation = 1\n\n\ndef get_inputs():\n    x = torch.rand(batch_size, in_channels, height, width).cuda()\n    return [x]\n\n\ndef get_init_inputs():\n    return [in_channels, kernel_size, stride, padding, dilation]', 'best_passed_depth': 2, 'best_passed_time': {'me