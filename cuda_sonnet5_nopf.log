        int ic = rem / khkw;
        int rem2 = rem % khkw;
        int kh = rem2 / kernel_size;
        int kw = rem2 % kernel_size;
        int oc = oc_base + oi;
        sh_weight[i] = weight[((oc * in_channels + ic) * kernel_size + kh) * kernel_size + kw];
    }
