            float day = av.y - pv.y;
            float daz = av.z - pv.z;
            float daw = av.w - pv.w;
            float dnx = av.x - nv.x;
            float dny = av.y - nv.y;
            float dnz = av.z - nv.z;
            float dnw = av.w - nv.w;
            sum_pos += dax * dax + day * day + daz * daz + daw * daw;
            sum_neg += dnx * dnx + dny * dny + dnz * dnz + dnw * dnw;
        }
