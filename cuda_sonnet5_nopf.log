            int d8 = threadIdx.x % groupSize;
            int mPerGroup = (actualM + numGroups - 1) / numGroups;
            int mStart = group * mPerGroup;
            int mEnd = min(mStart + mPerGroup, actualM);
            if (mStart < mEnd) {
                float acc[BLOCK_M][8];
                #pragma unroll
                for (int m = 0; m < BLOCK_M; m++) {
                    #pragma unroll
                    for (int k = 0; k < 8; k++) acc[m][k] = 0.0f;
                }
