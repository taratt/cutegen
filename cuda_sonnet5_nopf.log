import torch.nn as nn
from torch.utils.cpp_extension import load_inline

cuda_source = r"""
#include <torch/extension.h>
#include <cuda.h>
#include <cuda_runtime.h>

#define BM 128
#define BN 128
#define BK 8
#define TM 8
#define TN 8

__global__ void sgemm_kernel(const float* __restrict__ A,
                              const float* __restrict__ B,
                              float* __restrict__ C,
                              int N) {
    __shared__ float As[BM][BK];
    __shared__ float Bs[BK][BN];

    const int blockRow = blockIdx.y;
    const int blockCol = blockIdx.x;

    const int threadsPerRow = BN / TN; // 16
    const int threadRow = threadIdx.x / threadsPerRow; // 0..(BM/TM -1)
    const int threadCol = threadIdx.x % threadsPerRow;  // 0..(BN/TN -1)

    const int numThreads = (BM / TM) * (BN / TN); // 256

    const int rowStart = blockRow * BM;
    const int colStart = blockCol * BN;

    float threadResults[TM][TN];
    #pragma unroll
    for (int i = 0; i < TM; i++) {
        #pragma unroll
        for (int j = 0; j < TN; j++) {
            threadResults[i][j] = 0.0f;
        }
    }

    const int tid = threadIdx.x;

    for (int k0 = 0; k0 < N; k0 += BK) {
        // Load A tile: BM*BK elements, vectorized with float4
        {
            const int totalA4 = (BM * BK) / 4;
            for (int idx = tid; idx < totalA4; idx += numThreads) {
                int r = idx / (BK / 4);
                int c4 = idx % (BK / 4);
                int globalRow = rowStart + r;
                int globalCol = k0 + c4 * 4;
                float4 val;
                if (globalRow < N && (globalCol + 3) < N) {
                    val = *reinterpret_cast<const float4*>(&A[(size_t)globalRow * N + globalCol]);
                } else {
                    val.x = (globalRow < N && globalCol     < N) ? A[(size_t)globalRow * N + globalCol]     : 0.0f;
                    val.y = (globalRow < N && globalCol + 1 < N) ? A[(size_t)globalRow * N + globalCol + 1] : 0.0f;
                    val.z = (globalRow < N && globalCol + 2 < N) ? A[(size_t)globalRow * N + globalCol + 2] : 0.0f;
