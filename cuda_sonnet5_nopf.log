 optimized kernel");\n    auto C = torch::empty({M, M}, A.options());\n    dim3 block(THREADS_PER_BLOCK);\n    dim3 grid((M + BLOCK_ROWS - 1) / BLOCK_ROWS, (M + BLOCK_COLS - 1) / BLOCK_COLS);\n    size_t shared_mem_size = (size_t)(BLOCK_ROWS * K + K * BLOCK_COLS) * sizeof(float);\n    if (shared_mem_size > 48 * 1024) {\n        cudaFuncSetAttribute(matmul_tall_skinny_kernel, cudaFuncAttributeMaxDynamicSharedMemorySize, (int)shared_mem_size);\n    }\n    matmul_tall_skinny_kernel<<<grid, block, shared_mem_size>>>(\n        A.data_ptr<float>(),\n        B.data_ptr<float>(),\n        C.data_ptr<float>(),\n        M,\n        K\n    );\n    return C;\n}\n"""\n\ncpp_source = r"""\ntorch::Tensor matmul_tall_skinny_cuda(torch::Tensor A, torch::Tensor B);\n"""\n\nmatmul_module = load_inline(\n    name="matmul_tall_skinny",\n    cpp_sources=cpp_source,\n    cuda_sources=cuda_source,\n    functions=["matmul_tall_skinny_cuda"],\n    verbose=False,\n)\n\n\nclass ModelNew(nn.Module):\n    """\n    Optimized model using a custom CUDA kernel for tall-skinny x wide-skinny matmul.\n    A: (M, K), B: (K, M) -> C: (M, M), where K is small compared to M.\n    """\n    def __init__(self):\n        super(ModelNew, self).__init__()\n\n    def forward(self, A, B):\n        A = A.cuda() if not A.is_cuda else A\n        B = B.cuda() if not B.is_cuda else B\n        return matmul_module.matmul_tall_skinny_cuda(A, B)\n\n\nM = 16384 * 2\nN = 16 * 2\n\ndef get_inputs():\n    A = torch.rand(M, N)\n    B = torch.rand(N, M)\n    return [A, B]\n\ndef get_init_inputs():\n    return []', 'best_passed_depth': 2, 'best_passed_time': {'mean': 4.92, 'std': 0.00752, 'min': 4.9, 'max': 4.95, 'num_trials': 100}, 'best_passed_nsight_metrics': {}, 'kernel_backend': 'cuda', 'compile': '', 'correct': ''}
