        out_channels,
        D_in, H_in, W_in,
        D_out, H_out, W_out,
        kD, kH, kW,
        stride_d, stride_h, stride_w,
        pad_d, pad_h, pad_w,
        groups,
        in_channels_per_group,
        out_channels_per_group,
        has_bias,
        max_iw_tile,
