            for (int rr = 0; rr < ROWS_PER_THREAD; ++rr) {
                int local_row = row_start_local + rr;
                float a = As[local_row * K + k];
                sums[rr].x += a * b.x;
                sums[rr].y += a * b.y;
                sums[rr].z += a * b.z;
                sums[rr].w += a * b.w;
            }
        }
        #pragma unroll
        for (int rr = 0; rr < ROWS_PER_THREAD; ++rr) {
