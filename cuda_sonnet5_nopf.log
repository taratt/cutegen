    long long blocks_y = (long long)batch_size * out_channels;
    long long blocks_z = ((long long)D_out * H_out + OD_OH_TILE - 1) / OD_OH_TILE;
    dim3 grid((unsigned int)blocks_x, (unsigned int)blocks_y, (unsigned int)blocks_z);
    int compute_threads = TILE_W / OW_COARSEN;
    int threads_per_block = ((compute_threads + 31) / 32) * 32;
    if (threads_per_block < 32) threads_per_block = 32;
    dim3 block(threads_per_block, 1, 1);
    int kvol = kD * kH * kW;
    int max_iw_tile = (TILE_W - 1 + kW - 1) / stride_w + 2;
