import torch.nn as nn
from torch.utils.cpp_extension import load_inline

cuda_source = r"""
#include <torch/extension.h>
#include <cuda.h>
#include <cuda_runtime.h>

#define BM 128
#define BN 128
#define BK 8
#define TM 8
#define TN 8

__global__ void sgemm_kernel(const float* __restrict__ A,
                              const float* __restrict__ B,
                              float* __restrict__ C,
                              int N) {
    // As is stored transposed (BK x BM) so that per-thread register loads
    // along the M dimension are contiguous in shared memory and can be
    // vectorized with float4 loads, just like the B tile.
    __shared__ float As[BK][BM];
    __shared__ float Bs[BK][BN];
    const int blockRow = blockIdx.y;
    const int blockCol = blockIdx.x;
    const int threadsPerRow = BN / TN; // 16
    const int threadRow = threadIdx.x / threadsPerRow; // 0..(BM/TM -1)
    const int threadCol = threadIdx.x % threadsPerRow;  // 0..(BN/TN -1)
    const int numThreads = (BM / TM) * (BN / TN); // 256
    const int rowStart = blockRow * BM;
    const int colStart = blockCol * BN;
    float threadResults[TM][TN];
    #pragma unroll
    for (int i = 0; i < TM; i++) {
        #pragma unroll
        for (int j = 0; j < TN; j++) {
            threadResults[i][j] = 0.0f;
        }
    }
    const int tid = threadIdx.x;
    for (int k0 = 0; k0 < N; k0 += BK) {
        // Load A tile: BM*BK elements, vectorized read with float4, transposed store
        {
            const int totalA4 = (BM * BK) / 4;
            for (int idx = tid; idx < totalA4; idx += numThreads) {
                int r = idx / (BK / 4);
                int c4 = idx % (BK / 4);
                int globalRow = rowStart + r;
                int globalCol = k0 + c4 * 4;
                float4 val;
                if (globalRow < N && (globalCol + 3) < N) {
                    val = *reinterpret_cast<const float4*>(&A[(size_t)globalRow * N + globalCol]);
                } else {
                    val.x = (globalRow < N && globalCol     < N) ? A[(size_t)globalRow * N + globalCol]     : 0.0f;
                    val.y = (globalRow < N && globalCol + 1 < N) ? A[(size_t)globalRow * N + globalCol + 1] : 0.0f;
                    val.z = (globalRow < N && globalCol + 2 < N) ? A[(size_t)globalRow * N + globalCol + 2] : 0.0f;
                    val.w = (globalRow < N && globalCol + 3 < N) ? A[(size_t)globalRow * N + globalCol + 3] : 0.0f;
                }
                As[c4 * 4 + 0][r] = val.x;
                As[c4 * 4 + 1][r] = val.y;
                As[c4 * 4 + 2][r] = val.z;
                As[c4 * 4 + 3][r] = val.w;
            }
        }
        // Load B tile: BK*BN elements, vectorized with float4
        {
            const int totalB4 = (BK * BN) / 4;
            for (int idx = tid; idx < totalB4; idx += numThreads) {
                int r = idx / (BN / 4);
                int c4 = idx % (BN / 4);
                int globalRow = k0 + r;
                int globalCol = colStart + c4 * 4;
                float4 val;
                if (globalRow < N && (globalCol + 3) < N) {
                    val = *reinterpret_cast<const float4*>(&B[(size_t)globalRow * N + globalCol]);
                } else {
                    val.x = (globalRow < N && globalCol     < N) ? B[(size_t)globalRow * N + globalCol]     : 0.0f;
                    val.y = (globalRow < N && globalCol + 1 < N) ? B[(size_t)globalRow * N + globalCol + 1] : 0.0f;
                    val.z = (globalRow < N && globalCol + 2 < N) ? B[(size_t)globalRow * N + globalCol + 2] : 0.0f;
                    val.w = (globalRow < N && globalCol + 3 < N) ? B[(size_t)globalRow * N + globalCol + 3] : 0.0f;
                }
                Bs[r][c4 * 4 + 0] = val.x;
                Bs[r][c4 * 4 + 1] = val.y;
                Bs[r][c4 * 4 + 2] = val.z;
                Bs[r][c4 * 4 + 3] = val.w;
            }
        }
        __syncthreads();
        #pragma unroll
        for (int kk = 0; kk < BK; kk++) {
            // Vectorized register loads from shared memory: both As (transposed)
            // and Bs are contiguous along the thread's tile dimension, enabling
            // float4 loads instead of 8 scalar loads per operand.
            float4 a0 = *reinterpret_cast<const float4*>(&As[kk][threadRow * TM]);
            float4 a1 = *reinterpret_cast<const float4*>(&As[kk][threadRow * TM + 4]);
            float4 b0 = *reinterpret_cast<const float4*>(&Bs[kk][threadCol * TN]);
            float4 b1 = *reinterpret_cast<const float4*>(&Bs[kk][threadCol * TN + 4]);
            float regA[TM] = {a0.x, a0.y, a0.z, a0.w, a1.x, a1.y, a1.z, a1.w};
            float regB[TN] = {b0.x, b0.y, b0.z, b0.w, b1.x, b1.y, b1.z, b1.w};
            #pragma unroll
            for (int i = 0; i < TM; i++) {
                #pragma unroll
                for (int j = 0; j < TN; j++) {
                    threadResults[i][j] += regA[i] * regB[j];
                }
            }
        }
        __syncthreads();
    }
    #pragma unroll
    for (int i = 0; i < TM; i++) {
        #pragma unroll
        for (int j = 0; j < TN; j++) {
            int globalRow = rowStart + threadRow * TM + i;
            int globalCol = colStart + threadCol * TN + j;
            if (globalRow < N && globalCol < N) {
                C[(size_t)globalRow * N + globalCol] = threadResults[i][j];
            }
        }
    }
}

torch::Tensor matmul_cuda(torch::Tensor A, torch::Tensor B) {
    TORCH_CHECK(A.is_cuda(), "A must be a CUDA tensor");
    TORCH_CHECK(B.is_cuda(), "B must be a CUDA tensor");
    TORCH_CHECK(A.dim() == 2 && B.dim() == 2, "A and B must be 2D");

    A = A.contiguous();
    B = B.contiguous();

    int N = A.size(0);
    TORCH_CHECK(A.size(1) == N, "A must be square");
    TORCH_CHECK(B.size(0) == N && B.size(1) == N, "B must be square with same N as A");

    auto C = torch::empty({N, N}, A.options());

    dim3 blockDim((BM / TM) * (BN / TN), 1, 1);
    dim3 gridDim((N + BN - 1) / BN, (N + BM - 1) / BM, 1);

    sgemm_kernel<<<gridDim, blockDim>>>(
        A.data_ptr<float>(),
        B.data_ptr<float>(),
        C.data_ptr<float>(),
        N
    );

    return C;
}
"""

cpp_source = r"""
torch::Tensor matmul_cuda(torch::Tensor A, torch::Tensor B);
"""

matmul_module = load_inline(
    name="matmul_module",
    cpp_sources=cpp_source,
    cuda_sources=cuda_source,
    functions=["matmul_cuda"],
    verbose=False,
)


class ModelNew(nn.Module):
    """
    Optimized model that performs a single square matrix multiplication (C = A * B)
    using a custom tiled CUDA kernel with shared memory and register blocking.
    """
    def __init__(self):
        super(ModelNew, self).__init__()
        self.matmul = matmul_module

    def forward(self, A: torch.Tensor, B: torch.Tensor) -> torch.Tensor:
        A = A.cuda().float()
        B = B.cuda().float()
        return self.matmul.matmul_cuda(A, B)


N = 2048 * 2


def get_inputs():
    A = torch.rand(N, N)
    B = torch.rand(N, N)
    return [A, B]


def get_init_inputs():
    return []
