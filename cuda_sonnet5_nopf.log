c0;\n        if (ic_count > IC_BLOCK) ic_count = IC_BLOCK;\n        for (int icb = 0; icb < ic_count; icb++) {\n            int in_c = g * channels_per_group_in + ic0 + icb;\n            float* smem_ic = smem_input + icb * total_smem_elems;\n            for (int idx = tid; idx < total_smem_elems; idx += num_threads) {\n                int sy = idx / in_tile_w;\n                int sx = idx % in_tile_w;\n                int gy = in_y0 + sy;\n                int gx = in_x0 + sx;\n                float val = 0.0f;\n                if (gy >= 0 && gy < H && gx >= 0 && gx < W) {\n                    val = input[((n * C_in + in_c) * H + gy) * W + gx];\n                }\n                smem_ic[idx] = val;\n            }\n            float* smem_w_ic = smem_w + icb * weight_elems;\n            int ic_global = ic0 + icb;\n            for (int idx = tid; idx < weight_elems; idx += num_threads) {\n                int o = idx / (K * K);\n                int kk = idx % (K * K);\n                int oc = oc_base + o;\n                float wv = 0.0f;\n                if (oc < C_out) {\n                    const float* w_ptr = weight + ((size_t)oc * channels_per_group_in + ic_global) * K * K;\n                    wv = w_ptr[kk];\n                }\n                smem_w_ic[idx] = wv;\n            }\n        }\n        __syncthreads();\n        for (int icb = 0; icb < ic_count; icb++) {\n            float* smem_ic = smem_input + icb * total_smem_elems;\n            float* smem_w_ic = smem_w + icb * weight_elems;\n            #pragma unroll\n            for (int ry = 0; ry < THREAD_TILE; ry++) {\n                int out_y = out_y0 + ty * THREAD_TILE + ry;\n                #pragma unroll\n                for (int rx = 0; rx < THREAD_TILE; rx++) {\n                    int out_x = out_x0 + tx * THREAD_TILE + rx;\n                    if (out_x < W_out && out_y < H_out) {\n                        for (int ky = 0; ky < K; ky++) {\n                            int sy = (ty * THREAD_TILE +