import torch.nn as nn
import math
from torch.utils.cpp_extension import load_inline

conv2d_source = r"""
#include <torch/extension.h>
#include <cuda.h>
#include <cuda_runtime.h>
#define TILE_OH 16
#define TILE_OW 16
__global__ void conv2d_forward_kernel(
    const float* __restrict__ input,
    const float* __restrict__ weight,
    float* __restrict__ output,
    int N, int C_in, int H, int W,
    int C_out, int KH, int KW,
    int stride, int padH, int padW,
    int dilH, int dilW,
    int H_out, int W_out,
    int in_tile_h, int in_tile_w)
{
    extern __shared__ float smem[];
    int tx = threadIdx.x;
    int ty = threadIdx.y;
    int ow0 = blockIdx.x * TILE_OW;
    int oh0 = blockIdx.y * TILE_OH;
    int ow = ow0 + tx;
    int oh = oh0 + ty;
    int nc = blockIdx.z;
    int n = nc / C_out;
    int oc = nc % C_out;
    int in_h0 = oh0 * stride - padH;
    int in_w0 = ow0 * stride - padW;
    float sum = 0.0f;
    int total = in_tile_h * in_tile_w;
    int tid = ty * TILE_OW + tx;
    int nthreads = TILE_OH * TILE_OW;
    const float* in_batch = input + (size_t)n * C_in * H * W;
    const float* w_oc = weight + (size_t)oc * C_in * KH * KW;
    bool valid_out = (ow < W_out) && (oh < H_out);
    for (int c = 0; c < C_in; ++c) {
        const float* in_c = in_batch + (size_t)c * H * W;
        const float* w_c = w_oc + (size_t)c * KH * KW;
        for (int idx = tid; idx < total; idx += nthreads) {
            int r = idx / in_tile_w;
            int cc = idx % in_tile_w;
            int ih = in_h0 + r;
            int iw = in_w0 + cc;
            float val = 0.0f;
            if (ih >= 0 && ih < H && iw >= 0 && iw < W) {
                val = in_c[(size_t)ih * W + iw];
            }
            smem[idx] = val;
        }
        __syncthreads();
        if (valid_out) {
            for (int kh = 0; kh < KH; ++kh) {
                int sh = ty * stride + kh * dilH;
                const float* srow = smem + (size_t)sh * in_tile_w;
                const float* wrow = w_c + (size_t)kh * KW;
                for (int kw = 0; kw < KW; ++kw) {
                    int sw = tx * stride + kw * dilW;
                    sum += srow[sw] * wrow[kw];
                }
            }
        }
        __syncthreads();
    }
    if (valid_out) {
        output[((size_t)(n * C_out + oc) * H_out + oh) * W_out + ow] = sum;
    }
}
torch::Tensor conv2d_forward_cuda(
    torch::Tensor input,
    torch::Tensor weight,
    int stride,
    int padH, int padW,
    int dilH, int dilW)
{
    input = input.contiguous();
    weight = weight.contiguous();
    int N = input.size(0);
    int C_in = input.size(1);
    int H = input.size(2);
    int W = input.size(3);
    int C_out = weight.size(0);
    int KH = weight.size(2);
    int KW = weight.size(3);
    int H_out = (H + 2 * padH - dilH * (KH - 1) - 1) / stride + 1;
    int W_out = (W + 2 * padW - dilW * (KW - 1) - 1) / stride + 1;
    auto output = torch::zeros({N, C_out, H_out, W_out}, input.options());
    int in_tile_h = (TILE_OH - 1) * stride + dilH * (KH - 1) + 1;
    int in_tile_w = (TILE_OW - 1) * stride + dilW * (KW - 1) + 1;
    size_t shmem_bytes = (size_t)in_tile_h * (size_t)in_tile_w * sizeof(float);
    dim3 block(TILE_OW, TILE_OH, 1);
    dim3 grid(
        (W_out + TILE_OW - 1) / TILE_OW,
        (H_out + TILE_OH - 1) / TILE_OH,
        N * C_out
    );
    if (shmem_bytes > 48 * 1024) {
        cudaFuncSetAttribute(conv2d_forward_kernel, cudaFuncAttributeMaxDynamicSharedMemorySize, (int)shmem_bytes);
    }
    conv2d_forward_kernel<<<grid, block, shmem_bytes>>>(
        input.data_ptr<float>(),
        weight.data_ptr<float>(),
        output.data_ptr<float>(),
        N, C_in, H, W,
        C_out, KH, KW,
        stride, padH, padW,
        dilH, dilW,
        H_out, W_out,
        in_tile_h, in_tile_w
    );
    return output;
}
"""
"""

conv2d_cpp_source = r"""
torch::Tensor conv2d_forward_cuda(
    torch::Tensor input,
    torch::Tensor weight,
    int stride,
    int padH, int padW,
    int dilH, int dilW);
"""

conv2d_module = load_inline(
    name="conv2d_module",
    cpp_sources=conv2d_cpp_source,
    cuda_sources=conv2d_source,
    functions=["conv2d_forward_cuda"],
    verbose=False,
)


class ModelNew(nn.Module):
    """
    Performs a standard 2D convolution operation with square input and asymmetric kernel,
    with dilation and padding, implemented via a custom CUDA kernel.
    """
    def __init__(self, in_channels: int, out_channels: int, kernel_size: tuple, stride: int = 1,
                 padding: tuple = (0, 0), dilation: tuple = (1, 1), bias: bool = False):
        super(ModelNew, self).__init__()

        self.in_channels = in_channels
        self.out_channels = out_channels
        self.kernel_size = kernel_size
        self.stride = stride
        self.padding = padding
        self.dilation = dilation
        self.has_bias = bias

        self.weight = nn.Parameter(torch.empty(out_channels, in_channels, kernel_size[0], kernel_size[1]))

        # Match nn.Conv2d default initialization
        nn.init.kaiming_uniform_(self.weight, a=math.sqrt(5))

        if bias:
            self.bias = nn.Parameter(torch.empty(out_channels))
            fan_in = in_channels * kernel_size[0] * kernel_size[1]
            bound = 1 / math.sqrt(fan_in) if fan_in > 0 else 0
            nn.init.uniform_(self.bias, -bound, bound)
        else:
            self.register_parameter('bias', None)

    def forward(self, x: torch.Tensor) -> torch.Tensor:
        x = x.cuda().contiguous()
        weight = self.weight.cuda().contiguous()

        out = conv2d_module.conv2d_forward_cuda(
            x, weight,
            self.stride,
            self.padding[0], self.padding[1],
            self.dilation[0], self.dilation[1]
        )

        if self.has_bias:
            out = out + self.bias.view(1, -1, 1, 1)

        return out


