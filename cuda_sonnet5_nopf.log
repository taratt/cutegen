import torch.nn as nn
from torch.utils.cpp_extension import load_inline

depthwise_conv_source = r"""
#include <torch/extension.h>
#include <cuda.h>
#include <cuda_runtime.h>

constexpr int BLOCK_W = 256;
constexpr int OH_TILE = 4;
constexpr int MAX_ROWS = 35; // supports K up to 32 with OH_TILE=4
__global__ void depthwise_conv2d_kh1_kernel(
    const float* __restrict__ input,
    const float* __restrict__ weight,
    const float* __restrict__ bias,
    float* __restrict__ output,
    const int N, const int C, const int H, const int W,
    const int K,
    const int H_out, const int W_out,
    const int stride, const int padding, const int dilation,
    const bool has_bias)
{
    // blockIdx.z encodes the combined (n, c) index -> keeps grid small
    // blockIdx.y encodes the output row (oh)
    // blockIdx.x * blockDim.x + threadIdx.x encodes the output column (ow),
    // giving fully coalesced global memory accesses across threads since
    // consecutive threads read consecutive elements along the W dimension.
    int nc = blockIdx.z;
    int c = nc % C;
    int n = nc / C;
    int oh = blockIdx.y;
    int ow = blockIdx.x * blockDim.x + threadIdx.x;
    if (ow >= W_out) return;
    int iw = ow * stride - padding;
    float acc = 0.0f;
    if (iw >= 0 && iw < W) {
        const float* in_base = input + ((n * C + c) * H) * W + iw;
        const float* w_ptr = weight + c * K;
        int ih_base = oh * stride - padding;
        #pragma unroll
        for (int kh = 0; kh < K; ++kh) {
            int ih = ih_base + kh * dilation;
            if (ih >= 0 && ih < H) {
                acc += in_base[ih * W] * w_ptr[kh];
            }
        }
    }
    if (has_bias) {
        acc += bias[c];
    }
    output[((n * C + c) * H_out + oh) * W_out + ow] = acc;
}
// Register-blocked kernel: each thread computes OH_TILE consecutive output rows.
// Reusable input rows are staged into registers once (sliding window over the
// H dimension) instead of being reloaded from global memory for every output,
// which is the dominant source of redundant traffic in the naive kernel above.
// Only valid for stride == 1 && dilation == 1 (checked by the host launcher).
__global__ void depthwise_conv2d_kh1_tiled_kernel(
    const float* __restrict__ input,
    const float* __restrict__ weight,
    const float* __restrict__ bias,
    float* __restrict__ output,
    const int N, const int C, const int H, const int W,
    const int K,
    const int H_out, const int W_out,
    const int padding,
    const bool has_bias)
{
    int nc = blockIdx.z;
    int c = nc % C;
    int n = nc / C;
    int oh_start = blockIdx.y * OH_TILE;
    int ow = blockIdx.x * blockDim.x + threadIdx.x;
    if (ow >= W_out) return;
    int iw = ow - padding;
    bool iw_valid = (iw >= 0 && iw < W);
    const float* in_base = input + ((n * C + c) * H) * W + iw;
    const float* w_ptr = weight + c * K;
    int total_rows = K + OH_TILE - 1;
    float rows[MAX_ROWS];
    #pragma unroll
    for (int s = 0; s < MAX_ROWS; ++s) {
        if (s < total_rows) {
            int ih = oh_start - padding + s;
            if (iw_valid && ih >= 0 && ih < H) {
                rows[s] = in_base[ih * W];
            } else {
                rows[s] = 0.0f;
            }
        }
    }
    float acc[OH_TILE];
    #pragma unroll
    for (int t = 0; t < OH_TILE; ++t) acc[t] = 0.0f;
    for (int kh = 0; kh < K; ++kh) {
        float wv = w_ptr[kh];
        #pragma unroll
        for (int t = 0; t < OH_TILE; ++t) {
            acc[t] += rows[t + kh] * wv;
        }
    }
    if (has_bias) {
        float b = bias[c];
        #pragma unroll
        for (int t = 0; t < OH_TILE; ++t) acc[t] += b;
    }
    #pragma unroll
    for (int t = 0; t < OH_TILE; ++t) {
        int oh = oh_start + t;
        if (oh < H_out) {
            output[((n * C + c) * H_out + oh) * W_out + ow] = acc[t];
        }
    }
}
torch::Tensor depthwise_conv2d_kh1_cuda(
    torch::Tensor input,
    torch::Tensor weight,
    torch::Tensor bias,
    int stride,
    int padding,
    int dilation,
    bool has_bias)
{
    input = input.contiguous();
    weight = weight.contiguous();
    const int N = input.size(0);
    const int C = input.size(1);
    const int H = input.size(2);
    const int W = input.size(3);
    const int K = weight.size(2); // weight shape: (C, 1, K, 1)
    const int H_out = (H + 2 * padding - dilation * (K - 1) - 1) / stride + 1;
    const int W_out = (W + 2 * padding - dilation * (1 - 1) - 1) / stride + 1;
    auto output = torch::empty({N, C, H_out, W_out}, input.options());
    const float* bias_ptr = nullptr;
    if (has_bias) {
        bias = bias.contiguous();
        bias_ptr = bias.data_ptr<float>();
    }
    dim3 block(BLOCK_W);
    bool can_tile = (stride == 1 && dilation == 1 && (K + OH_TILE - 1) <= MAX_ROWS);
    if (can_tile) {
        dim3 grid((unsigned int)((W_out + BLOCK_W - 1) / BLOCK_W),
                  (unsigned int)((H_out + OH_TILE - 1) / OH_TILE),
                  (unsigned int)(N * C));
        depthwise_conv2d_kh1_tiled_kernel<<<grid, block>>>(
            input.data_ptr<float>(),
            weight.data_ptr<float>(),
            bias_ptr,
            output.data_ptr<float>(),
            N, C, H, W,
            K,
            H_out, W_out,
            padding,
            has_bias
        );
    } else {
        dim3 grid((unsigned int)((W_out + BLOCK_W - 1) / BLOCK_W),
                  (unsigned int)H_out,
                  (unsigned int)(N * C));
        depthwise_conv2d_kh1_kernel<<<grid, block>>>(
            input.data_ptr<float>(),
            weight.data_ptr<float>(),
            bias_ptr,
            output.data_ptr<float>(),
            N, C, H, W,
            K,
            H_out, W_out,
            stride, padding, dilation,
            has_bias
        );
    }
    return output;
}
"""

depthwise_conv_cpp_source = r"""
torch::Tensor depthwise_conv2d_kh1_cuda(
    torch::Tensor input,
    torch::Tensor weight,
    torch::Tensor bias,
    int stride,
    int padding,
    int dilation,
    bool has_bias);
"""

depthwise_conv_module = load_inline(
    name="depthwise_conv2d_kh1",
    cpp_sources=depthwise_conv_cpp_source,
    cuda_sources=depthwise_conv_source,
    functions=["depthwise_conv2d_kh1_cuda"],
    verbose=False,
)


class ModelNew(nn.Module):
    """
    Performs a depthwise 2D convolution with a square input and an asymmetric
    kernel (kernel_size, 1), implemented with a custom fused CUDA kernel.
    """
    def __init__(self, in_channels: int, kernel_size: int, stride: int = 1, padding: int = 0, dilation: int = 1, bias: bool = False):
        super(ModelNew, self).__init__()
        self.in_channels = in_channels
        self.kernel_size = kernel_size
        self.stride = stride
        self.padding = padding
        self.dilation = dilation
        self.has_bias = bias

        # Match parameter shapes of nn.Conv2d with groups=in_channels
        self.weight = nn.Parameter(torch.empty(in_channels, 1, kernel_size, 1))
        nn.init.kaiming_uniform_(self.weight, a=5 ** 0.5)

        if bias:
            self.bias = nn.Parameter(torch.empty(in_channels))
            fan_in = kernel_size
            bound = 1 / (fan_in ** 0.5)
            nn.init.uniform_(self.bias, -bound, bound)
        else:
            self.register_parameter('bias', None)

        self.conv_op = depthwise_conv_module

    def forward(self, x: torch.Tensor) -> torch.Tensor:
        x = x.contiguous()
        bias_tensor = self.bias if self.has_bias else torch.empty(0, device=x.device, dtype=x.dtype)
        return self.conv_op.depthwise_conv2d_kh1_cuda(
            x, self.weight, bias_tensor,
            self.stride, self.padding, self.dilation, self.has_bias
        )


