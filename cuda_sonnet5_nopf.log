class ModelNew(nn.Module):
    """
    Optimized model that performs Batch Normalization using a custom fused CUDA kernel.
    """
    def __init__(self, num_features: int):
        super(ModelNew, self).__init__()
        self.num_features = num_features
        self.eps = 1e-5
        self.momentum = 0.1

        self.weight = nn.Parameter(torch.ones(num_features))
        self.bias = nn.Parameter(torch.zeros(num_features))

        self.register_buffer('running_mean', torch.zeros(num_features))
        self.register_buffer('running_var', torch.ones(num_features))
        self.register_buffer('num_batches_tracked', torch.tensor(0, dtype=torch.long))

        self.bn_fn = batch_norm_module.batch_norm_forward

    def forward(self, x: torch.Tensor) -> torch.Tensor:
        x = x.contiguous().float()
        weight = self.weight.contiguous().float()
        bias = self.bias.contiguous().float()
        running_mean = self.running_mean.contiguous().float()
        running_var = self.running_var.contiguous().float()

        out = self.bn_fn(
            x, weight, bias, running_mean, running_var,
            self.training, self.momentum, self.eps
        )
        return out


