import torch.nn as nn
from torch.utils.cpp_extension import load_inline

max_reduce_source = r"""
#include <torch/extension.h>
#include <cuda.h>
#include <cuda_runtime.h>
#include <vector>
#include <float.h>

__global__ void max_reduce_kernel(
    const float* __restrict__ input,
    float* __restrict__ output,
    int64_t outer_size,
    int64_t reduce_size,
    int64_t inner_size)
{
    int64_t inner_stride = (int64_t)gridDim.x * blockDim.x;
    for (int64_t outer_idx = blockIdx.y; outer_idx < outer_size; outer_idx += gridDim.y) {
        int64_t base_outer = outer_idx * reduce_size * inner_size;
        int64_t out_base = outer_idx * inner_size;
        for (int64_t inner_idx = blockIdx.x * (int64_t)blockDim.x + threadIdx.x;
             inner_idx < inner_size;
             inner_idx += inner_stride) {
            const float* base = input + base_outer + inner_idx;
            float max_val = -FLT_MAX;
            #pragma unroll 4
            for (int64_t k = 0; k < reduce_size; ++k) {
                float val = __ldg(&base[k * inner_size]);
                max_val = fmaxf(max_val, val);
            }
            output[out_base + inner_idx] = max_val;
        }
    }
}
torch::Tensor max_reduce_cuda(torch::Tensor input, int64_t dim) {
    TORCH_CHECK(input.is_cuda(), "input must be a CUDA tensor");
    TORCH_CHECK(input.scalar_type() == torch::kFloat32, "input must be float32");
    TORCH_CHECK(input.is_contiguous(), "input must be contiguous");
    int64_t ndim = input.dim();
    if (dim < 0) dim += ndim;
    TORCH_CHECK(dim >= 0 && dim < ndim, "dim out of range");
    auto sizes = input.sizes();
    int64_t outer_size = 1;
    for (int64_t i = 0; i < dim; ++i) outer_size *= sizes[i];
    int64_t reduce_size = sizes[dim];
    int64_t inner_size = 1;
    for (int64_t i = dim + 1; i < ndim; ++i) inner_size *= sizes[i];
    std::vector<int64_t> out_sizes;
    for (int64_t i = 0; i < ndim; ++i) {
        if (i != dim) out_sizes.push_back(sizes[i]);
    }
    auto output = torch::empty(out_sizes, input.options());
    int threads = 512;
    const int64_t max_blocks_x = 65535;
    const int64_t max_blocks_y = 65535;
    int64_t blocks_x = (inner_size + threads - 1) / threads;
    if (blocks_x > max_blocks_x) blocks_x = max_blocks_x;
    if (blocks_x < 1) blocks_x = 1;
    int64_t blocks_y = outer_size;
    if (blocks_y > max_blocks_y) blocks_y = max_blocks_y;
    if (blocks_y < 1) blocks_y = 1;
    dim3 grid((unsigned int)blocks_x, (unsigned int)blocks_y);
    max_reduce_kernel<<<grid, threads>>>(
        input.data_ptr<float>(),
        output.data_ptr<float>(),
        outer_size,
        reduce_size,
        inner_size
    );
    return output;
}
"""

max_reduce_header = r"""
torch::Tensor max_reduce_cuda(torch::Tensor input, int64_t dim);
"""

max_reduce_module = load_inline(
    name="max_reduce_module",
    cpp_sources=max_reduce_header,
    cuda_sources=max_reduce_source,
    functions=["max_reduce_cuda"],
    verbose=False,
)


class ModelNew(nn.Module):
    """
    Optimized model that performs Max reduction over a specific dimension
    using a custom CUDA kernel.
    """
    def __init__(self, dim: int):
        super(ModelNew, self).__init__()
        self.dim = dim

    def forward(self, x: torch.Tensor) -> torch.Tensor:
        x = x.contiguous().cuda()
        return max_reduce_module.max_reduce_cuda(x, self.dim)
