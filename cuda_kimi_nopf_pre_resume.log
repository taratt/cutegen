        for (int k = 0; k < BK; ++k) {
            if (k < kmax) {
                float ra[TM];
                float rb[TN];
                #pragma unroll
                for (int i = 0; i < TM; ++i) ra[i] = As[thread_row + i][k];
                #pragma unroll
                for (int j0 = 0; j0 < TN; j0 += 4) {
