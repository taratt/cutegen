#include <torch/extension.h>
#include <ATen/cuda/CUDAContext.h>
#include <cuda_runtime.h>

#define THREADS 512
#define WARPS_PER_BLOCK (THREADS / 32)
// One warp now owns two adjacent output rows, so each staged B tile is reused
// across 32 rows instead of 16. A is still streamed once; the extra work is
// register accumulation and shared-memory reads, while global B traffic and
// row-group launches are halved.
#define ROWS_PER_BLOCK (2 * WARPS_PER_BLOCK)
#define TILE_K 4096

__device__ __forceinline__ float warpReduceSum(float val) {
    #pragma unroll
    for (int offset = 16; offset > 0; offset >>= 1)
        val += __shfl_down_sync(0xffffffffu, val, offset);
    return val;
}

// C = A * B, with A of shape (M, K) and B of shape (K, 1).
__global__ void matvec_kernel(const float* __restrict__ A,
                              const float* __restrict__ B,
                              float* __restrict__ C,
                              long M,
                              long K,
                              int vec4) {
    __shared__ __align__(16) float smemB[TILE_K];
    const long row0 = (long)blockIdx.x * ROWS_PER_BLOCK;
    const int lane = threadIdx.x & 31;
    const int wid  = threadIdx.x >> 5;
    const long rowA = row0 + wid;
    const long rowB = rowA + WARPS_PER_BLOCK;
    const bool okA = rowA < M;
    const bool okB = rowB < M;
    const float* aRowA = okA ? (A + rowA * K) : nullptr;
    const float* aRowB = okB ? (A + rowB * K) : nullptr;
    float accA = 0.0f;
    float accB = 0.0f;

    const long num_tiles = (K + TILE_K - 1) / TILE_K;
    const long tile0 = (num_tiles * blockIdx.y) / gridDim.y;
    const long tile1 = (num_tiles * (blockIdx.y + 1)) / gridDim.y;
    if (tile0 >= tile1) return;
    const long k_begin = tile0 * TILE_K;
    const long k_end = ((tile1 * TILE_K) < K) ? (tile1 * TILE_K) : K;

    for (long k0 = k_begin; k0 < k_end; k0 += TILE_K) {
        const int len = (int)(((k0 + TILE_K) < k_end) ? TILE_K : (k_end - k0));
        if (vec4) {
            const int len4 = len >> 2;
            const float4* b4 = reinterpret_cast<const float4*>(B + k0);
            float4* s4 = reinterpret_cast<float4*>(smemB);
            for (int i = threadIdx.x; i < len4; i += THREADS) {
                s4[i] = b4[i];
            }
        } else {
            for (int i = threadIdx.x; i < len; i += THREADS) {
                smemB[i] = B[k0 + i];
            }
        }
        __syncthreads();

        if (okA || okB) {
            float sA = 0.0f;
            float sB = 0.0f;
            if (vec4) {
                const int len4 = len >> 2;
                const float4* sb4 = reinterpret_cast<const float4*>(smemB);
                const float4* a4A = okA ? reinterpret_cast<const float4*>(aRowA + k0) : nullptr;
                const float4* a4B = okB ? reinterpret_cast<const float4*>(aRowB + k0) : nullptr;
                for (int i = lane; i < len4; i += 32) {
                    const float4 b = sb4[i];
                    if (okA) {
                        const float4 a = a4A[i];
                        sA += a.x * b.x + a.y * b.y + a.z * b.z + a.w * b.w;
                    }
                    if (okB) {
                        const float4 a = a4B[i];
                        sB += a.x * b.x + a.y * b.y + a.z * b.z + a.w * b.w;
                    }
                }
            } else {
                for (int i = lane; i < len; i += 32) {
                    const float b = smemB[i];
                    if (okA) sA += aRowA[k0 + i] * b;
                    if (okB) sB += aRowB[k0 + i] * b;
