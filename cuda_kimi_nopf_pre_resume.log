        }\n        __syncthreads();\n    }\n\n    if ((N & 3) == 0) {\n        // vectorized 16B streaming stores (bypass L2 write-allocate; C is huge and never re-read)\n        #pragma unroll\n        for (int i = 0; i < TM; ++i) {\n            int gr = block_row + thread_row + (i << 4);\n            if (gr < M) {\n                int gc0 = block_col + thread_col;\n                if (gc0 + 3 < N) {\n                    float4 out0 = make_float4(acc[i][0], acc[i][1], acc[i][2], acc[i][3]);\n                    __stcs(reinterpret_cast<float4*>(C + (int64_t)gr * N + gc0), out0);\n                } else {\n                    #pragma unroll\n                    for (int j = 0; j < 4; ++j)\n                        if (gc0 + j < N) C[(int64_t)gr * N + gc0 + j] = acc[i][j];\n                }\n                int gc1 = gc0 + 64;\n                if (gc1 + 3 < N) {\n                    float4 out1 = make_float4(acc[i][4], acc[i][5], acc[i][6], acc[i][7]);\n                    __stcs(reinterpret_cast<float4*>(C + (int64_t)gr * N + gc1), out1);\n                } else {\n                    #pragma unroll\n                    for (int j = 4; j < TN; ++j)\n                        if (gc1 + (j - 4) < N) C[(int64_t)gr * N + gc1 + (j - 4)] = acc[i][j];\n                }\n            }\n        }\n    } else {\n        #pragma unroll\n        for (int i = 0; i < TM; ++i) {\n            int gr = block_row + thread_row + (i << 4);\n            if (gr < M) {\n                #pragma unroll\n                for (int j = 0; j < TN; ++j) {\n                    int gc = block_col + thread_col + (j < 4 ? j : 64 + (j - 4));\n                    if (gc < N) C[(int64_t)gr * N + gc] = acc[i][j];\n                }\n            }\n        }\n    }\n}\n\ntorch::Tensor matmul_cuda(torch::Tensor A, torch::Tensor B) {\n    TORCH_CHECK(A.dim() == 2 && B.dim() == 2, "A and B must be 2D");\n    TORCH_CHECK(A.scalar_type() == torch::kFloat32 &&\n                B.scalar_type() == torch::kFloat32, "float32 expected");\n    TORCH_CHECK(A.is_cuda() && B.is_cuda(), "CUDA tensors expected");\n\n    auto Ac = A.contiguous();\n    auto Bc = B.contiguous();\n\n    const int M = (int)Ac.size(0);\n    const int K = (int)Ac.size(1);\n    TORCH_CHECK((int)Bc.size(0) == K, "inner dimensions must match");\n    const int N = (int)Bc.size(1);\n\n    auto C = torch::empty({M, N}, Ac.options());\n    if (M == 0 || N == 0) return C;\n    if (K == 0) { C.zero_(); return C; }\n\n    dim3 threads(BN / TN, BM / TM);              // 16 x 16 = 256 threads\n    dim3 blocks((N + BN - 1) / BN, (M + BM - 1) / BM);\n\n    auto stream = at::cuda::getCurrentCUDAStream();\n    matmul_tall_skinny_kernel<<<blocks, threads, 0, stream>>>(\n        Ac.data_ptr<float>(), Bc.data_ptr<float>(), C.data_ptr<float>(),\n        M, N, K);\n    return C;\n}\n"""\n\ncpp_src = "torch::Tensor matmul_cuda(torch::Tensor A, torch::Tensor B);"\n\n_mod = load_inline(\n    name="tall_skinny_matmul_ext",\n    cpp_sources=cpp_src,\n    cuda_sources=cuda_src,\n    functions=["matmul_cuda"],\n    extra_cuda_cflags=["-O3"],\n    verbose=False,\n)\n\n\nclass ModelNew(nn.Module):\n    """\n    Model with a custom CUDA kernel for the tall-and-skinny matmul C = A @ B\n    (e.g. A: (32768, 32), B: (32, 32768)). The kernel exploits the tiny\n    reduction dimension (K=32) with a single-pass tiled kernel using shared\n    memory tiling, register blocking (4x4 per thread) and vectorized I/O.\n    """\n    def __init__(self):\n        super(ModelNew, self).__init__()\n        self._matmul = _mod.matmul_cuda\n\n    def forward(self, A, B):\n        if A.is_cuda and B.is_cuda:\n            return self._matmul(A, B)\n        # fallback so the module is still correct with CPU inputs\n        return self._matmul(A.cuda(), B.cuda()).to(A.device)', 'best_passed_depth': 4, 'best_passed_time': {'mean': 4.52, 'std': 0.00552, 'min': 4.51, 'max': 4.54, 'num_trials': 100}, 'best_passed_nsight_metrics': {}, 'kernel_backend': 'cuda', 'compil