x - r * BK;\n            int gr = row0 + r;\n            float v = 0.0f;\n            if (gr < M && c < K) v = A[(int64_t)gr * K + c];\n            As[0][r][c] = v;\n        }\n    }\n    #pragma unroll 1\n    for (int t = 0; t < MTILES; ++t) {\n        const int block_row = (blockIdx.y * MTILES + t) * BM;\n        if (block_row >= M) break;                       // uniform across the CTA\n        const int row_next  = (blockIdx.y * MTILES + t + 1) * BM;\n        const bool next_ok  = (t + 1 < MTILES) && (row_next < M);\n        const int cur = t & 1;\n        if (t > 0) __syncthreads();   // all reads of As[cur^1] (FMA of t-1) finished\n        // Issue the async stage for subtile t+1 into the other A buffer; it\n        // overlaps the FMA loop and streaming C stores of subtile t below.\n        if (next_ok) {\n            if (alignedA) {\n                stage_a_tile_async(A, As[cur ^ 1], row_next, M, K, tid, nthreads);\n                cp_async_commit();\n            } else {\n                #pragma unroll\n                for (int idx = tid; idx < BM * BK; idx += nthreads) {\n                    int r = idx / BK;\n                    int c = idx - r * BK;\n                    int gr = row_next + r;\n                    float v = 0.0f;\n                    if (gr < M && c < K) v = A[(int64_t)gr * K + c];\n                    As[cur ^ 1][r][c] = v;\n                }\n            }\n        }\n        if (alignedA) {\n            if (next_ok) cp_async_wait<1>(); else cp_async_wait<0>();\n        }\n        __syncthreads();   // publishes Bs (t == 0) and As(cur) to all threads\n        float acc[TM][TN];\n        #pragma unroll\n        for (int i = 0; i < TM; ++i)\n            #pragma unroll\n            for (int j = 0; j < TN; ++j)\n                acc[i][j] = 0.0f;\n        #pragma unroll\n        for (int k = 0; k < BK; ++k) {\n            if (k < kmax) {\n                float ra[TM];\n                float rb[TN];\n                #pragma unroll\n          