        // processed in blocks of 4 so each row of the staged A tile is fetched
        // with one 16B load (36-float padded rows keep 16B alignment for k4
        // multiples of 4). Staging zero-pads As/Bs to the BK boundary, so no
        // per-k bounds test is needed and the loop is fully unrolled.
        #pragma unroll
        for (int k4 = 0; k4 < BK; k4 += 4) {
