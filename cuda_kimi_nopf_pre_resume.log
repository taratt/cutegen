    // ty + i*16 (i in [0,TM)) and columns tx*4+{0..3} and 64+tx*4+{0..3}.
    // The two half-warps then hit distinct banks on As column reads (delta
    // of one padded row = 36 floats = 4 banks) and consecutive threads read
    // consecutive float4 chunks of Bs (all 32 banks covered exactly once).
    const int thread_row = threadIdx.y;                 // rows: thread_row + i*16
    const int thread_col = threadIdx.x * 4;             // cols: thread_col+{0..3}, +64

