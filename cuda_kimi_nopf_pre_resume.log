            #pragma unroll
            for (int idx = tid; idx < BM * BK; idx += nthreads) {
                int r  = idx / BK;
                int c  = idx - r * BK;
                int gr = block_row + r;
                int gc = k0 + c;
                float v = 0.0f;
                if (gr < M && gc < K) v = A[(int64_t)gr * K + gc];
                As[r][c] = v;
