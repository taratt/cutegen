ds) {\n    const int kquads = BK >> 2;\n    #pragma unroll\n    for (int idx = tid; idx < BM * kquads; idx += nthreads) {\n        int r  = idx / kquads;\n        int cq = idx - r * kquads;\n        int gr = row_base + r;\n        int gc = cq << 2;\n        const bool ok = (gr < M) && (gc < K);\n        cp_async16(&dst[r][cq << 2], A + (ok ? ((int64_t)gr * K + gc) : (int64_t)0),\n                   ok ? 16 : 0);\n    }\n}\n// Strip-mined variant for the single-K-tile case (K <= BK).\n// Threadblock-level tiling optimization: instead of one 128x128 output\n// tile per CTA, each CTA owns a tall strip of MTILES consecutive BM-row\n// subtiles. The B tile (the operand reused by every subtile) is staged\n// into shared memory exactly once, so the B-tile global/shared-memory\n// traffic, tile-load latency, and block launch/drain overhead are\n// amortized over 16x more FMA work per block while the small reduction\n// dimension stays fully inside the CTA (no split-K, no square tiling).\n//\n// Optimization (asynchronous multi-stage pipeline): the per-subtile A\n// tiles are staged with cp.async 16-byte global->shared copies into a\n// double-buffered As. The copy for subtile t+1 is issued before the\n// FMA loop of subtile t, so global-load latency overlaps the 32-step\n// FMA block and the streaming C stores, without an LDG->register->STS\n// round trip and without register-cache pressure. Unaligned-K inputs\n// fall back to blocking scalar staging into the same double buffer.\n__global__ void __launch_bounds__((BN / TN) * (BM / TM))\nmatmul_tall_skinny_strip_kernel(const float* __restrict__ A,\n                                const float* __restrict__ B,\n                                float* __restrict__ C,\n                                int M, int N, int K) {\n    // Dynamic shared memory: double-buffered A stage + single B tile.\n    extern __shared__ __align__(16) float smem[];\n    typedef float AsTile[BM][BK + 4];\n    AsTile* As = reinterpret_cast<AsTile*>(smem