torch::Tensor matmul_cuda(torch::Tensor A, torch::Tensor B) {
    TORCH_CHECK(A.dim() == 2 && B.dim() == 2, "A and B must be 2D");
    TORCH_CHECK(A.scalar_type() == torch::kFloat32 &&
                B.scalar_type() == torch::kFloat32, "float32 expected");
    TORCH_CHECK(A.is_cuda() && B.is_cuda(), "CUDA tensors expected");

    auto Ac = A.contiguous();
    auto Bc = B.contiguous();

    const int M = (int)Ac.size(0);
    const int K = (int)Ac.size(1);
    TORCH_CHECK((int)Bc.size(0) == K, "inner dimensions must match");
    const int N = (int)Bc.size(1);

    auto C = torch::empty({M, N}, Ac.options());
    if (M == 0 || N == 0) return C;
    if (K == 0) { C.zero_(); return C; }

    dim3 threads(BN / TN, BM / TM);              // 16 x 16 = 256 threads
    auto stream = at::cuda::getCurrentCUDAStream();
    if (K <= BK) {
        // Fast path (single K tile): each CTA sweeps a tall strip of
        // MTILES consecutive BM-row output subtiles with B staged once and
        // a cp.async double-buffered A pipeline (async global->shared loads
        // overlap the FMA loop without an LDG->register->STS round trip).
        constexpr int STRIP_SMEM = (2 * BM * (BK + 4) + BK * BN) * (int)sizeof(float);
        static bool smem_configured = false;
        if (!smem_configured) {
            cudaError_t err = cudaFuncSetAttribute(
                matmul_tall_skinny_strip_kernel,
                cudaFuncAttributeMaxDynamicSharedMemorySize,
                STRIP_SMEM);
            TORCH_CHECK(err == cudaSuccess, "cudaFuncSetAttribute failed: ",
                        cudaGetErrorString(err));
            smem_configured = true;
        }
        dim3 strip_blocks((N + BN - 1) / BN, (M + BM * MTILES - 1) / (BM * MTILES));
        matmul_tall_skinny_strip_kernel<<<strip_blocks, threads, STRIP_SMEM, stream>>>(
            Ac.data_ptr<float>(), Bc.data_ptr<float>(), C.data_ptr<float>(),
            M, N, K);
    } else {
        constexpr int TILED_SMEM = (BM * (BK + 4) + BK * BN) * (int)sizeof(float);
        static bool tiled_smem_configured = false;
        if (!tiled_smem_configured) {
            cudaError_t err = cudaFuncSetAttribute(
                matmul_tall_skinny_kernel,
                cudaFuncAttributeMaxDynamicSharedMemorySize,
                TILED_SMEM);
            TORCH_CHECK(err == cudaSuccess, "cudaFuncSetAttribute failed: ",
                        cudaGetErrorString(err));
            tiled_smem_configured = true;
        }
        dim3 blocks((N + BN - 1) / BN, (M + BM - 1) / BM);
        matmul_tall_skinny_kernel<<<blocks, threads, TILED_SMEM, stream>>>(
            Ac.data_ptr<float>(), Bc.data_ptr<float>(), C.data_ptr<float>(),
            M, N, K);
    }
    return C;
}
