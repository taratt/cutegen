ensor matmul_cuda(torch::Tensor A, torch::Tensor B) {\n    TORCH_CHECK(A.dim() == 2 && B.dim() == 2, "A and B must be 2D");\n    TORCH_CHECK(A.scalar_type() == torch::kFloat32 &&\n                B.scalar_type() == torch::kFloat32, "float32 expected");\n    TORCH_CHECK(A.is_cuda() && B.is_cuda(), "CUDA tensors expected");\n\n    auto Ac = A.contiguous();\n    auto Bc = B.contiguous();\n\n    const int M = (int)Ac.size(0);\n    const int K = (int)Ac.size(1);\n    TORCH_CHECK((int)Bc.size(0) == K, "inner dimensions must match");\n    const int N = (int)Bc.size(1);\n\n    auto C = torch::empty({M, N}, Ac.options());\n    if (M == 0 || N == 0) return C;\n    if (K == 0) { C.zero_(); return C; }\n\n    dim3 threads(BN / TN, BM / TM);              // 16 x 16 = 256 threads\n    auto stream = at::cuda::getCurrentCUDAStream();\n    if (K <= BK) {\n        // Fast path (single K tile): each CTA sweeps a tall strip of\n        // MTILES consecutive BM-row output subtiles with B staged once.\n        dim3 strip_blocks((N + BN - 1) / BN, (M + BM * MTILES - 1) / (BM * MTILES));\n        matmul_tall_skinny_strip_kernel<<<strip_blocks, threads, 0, stream>>>(\n            Ac.data_ptr<float>(), Bc.data_ptr<float>(), C.data_ptr<float>(),\n            M, N, K);\n    } else {\n        dim3 blocks((N + BN - 1) / BN, (M + BM - 1) / BM);\n        matmul_tall_skinny_kernel<<<blocks, threads, 0, stream>>>(\n            Ac.data_ptr<float>(), Bc.data_ptr<float>(), C.data_ptr<float>(),\n            M, N, K);\n    }\n    return C;\n}\n"""\n\ncpp_src = "torch::Tensor matmul_cuda(torch::Tensor A, torch::Tensor B);"\n\n_mod = load_inline(\n    name="tall_skinny_matmul_ext",\n    cpp_sources=cpp_src,\n    cuda_sources=cuda_src,\n    functions=["matmul_cuda"],\n    extra_cuda_cflags=["-O3"],\n    verbose=False,\n)\n\n\nclass ModelNew(nn.Module):\n    """\n    Model with a custom CUDA kernel for the tall-and-skinny matmul C = A @ B\n    (e.g. A: (32768, 32), B: (32, 32768)). The kernel exploits the ti