}\n}\n\n// Strip-mined variant for the single-K-tile case (K <= BK).\n// Threadblock-level tiling optimization: instead of one 128x128 output\n// tile per CTA, each CTA owns a tall strip of MTILES consecutive BM-row\n// subtiles. The B tile (the operand reused by every subtile) is staged\n// into shared memory exactly once, so the B-tile global/shared-memory\n// traffic, tile-load latency, and block launch/drain overhead are\n// amortized over 8x more FMA work per block while the small reduction\n// dimension stays fully inside the CTA (no split-K, no square tiling).\n__global__ void __launch_bounds__((BN / TN) * (BM / TM))\nmatmul_tall_skinny_strip_kernel(const float* __restrict__ A,\n                                const float* __restrict__ B,\n                                float* __restrict__ C,\n                                int M, int N, int K) {\n    __shared__ float As[BM][BK + 4];\n    __shared__ float Bs[BK][BN];\n    const int block_col = blockIdx.x * BN;\n    const int tid        = threadIdx.y * blockDim.x + threadIdx.x;\n    const int nthreads   = blockDim.x * blockDim.y;      // 256\n    const int thread_row = threadIdx.y;                  // rows: thread_row + i*16\n    const int thread_col = threadIdx.x * 4;              // cols: thread_col+{0..3}, +64\n    const int kmax = min(BK, K);                         // single K tile\n    // Stage the B tile (BK x BN) once; reused by every subtile of the strip.\n    if ((N & 3) == 0) {\n        const int nquads = BN >> 2;\n        #pragma unroll\n        for (int idx = tid; idx < BK * nquads; idx += nthreads) {\n            int r  = idx / nquads;\n            int cq = idx - r * nquads;\n            int gc = block_col + (cq << 2);\n            if (r < K) {\n                if (gc + 3 < N) {\n                    float4 v = *reinterpret_cast<const float4*>(B + (int64_t)r * N + gc);\n                    *reinterpret_cast<float4*>(&Bs[r][cq << 2]) = v;\n                } else {\n                    #pragma unr