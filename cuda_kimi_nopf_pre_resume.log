import torch.nn as nn
from torch.utils.cpp_extension import load_inline

_cuda_src = r"""
#include <torch/extension.h>
#include <ATen/cuda/CUDAContext.h>
#include <c10/cuda/CUDAGuard.h>
#include <cuda_runtime.h>

constexpr int BM = 128;
constexpr int BN = 128;
constexpr int BK = 16;
constexpr int TM = 8;
constexpr int TN = 8;
constexpr int THREADS = 256;
constexpr int LDA = BM + 8;
constexpr int LDB = BN + 8;
__device__ __forceinline__ void load_a_frag(const float* __restrict__ A,
                                             int N,
                                             int block_m,
                                             int k0,
                                             int a_m,
                                             int a_k4,
                                             float4& avec) {
    avec = *reinterpret_cast<const float4*>(
        A + (long long)(block_m + a_m) * N + k0 + (a_k4 << 2));
}
__device__ __forceinline__ void load_b_frag(const float* __restrict__ B,
                                             int N,
                                             int block_n,
                                             int k0,
                                             int b_k,
                                             int b_n4,
                                             float4& bvec) {
    bvec = *reinterpret_cast<const float4*>(
        B + (long long)(k0 + b_k) * N + block_n + (b_n4 << 2));
}
__device__ __forceinline__ void store_a_frag(float As[2][BK][LDA],
                                               int buf,
                                               int a_m,
                                               int a_k4,
                                               const float4& avec) {
    const int am = (((a_m >> 3) ^ a_k4) << 3) | (a_m & 7);
    As[buf][(a_k4 << 2) + 0][am] = avec.x;
    As[buf][(a_k4 << 2) + 1][am] = avec.y;
    As[buf][(a_k4 << 2) + 2][am] = avec.z;
    As[buf][(a_k4 << 2) + 3][am] = avec.w;
}
__device__ __forceinline__ void store_b_frag(float Bs[2][BK][LDB],
                                               int buf,
                                               int b_k,
                                               int b_n4,
                                               const float4& bvec) {
    const int phys_n4 = (((b_n4 >> 1) ^ (b_k & 3)) << 1) | (b_n4 & 1);
    *reinterpret_cast<float4*>(&Bs[buf][b_k][phys_n4 << 2]) = bvec;
}
__device__ __forceinline__ void load_tile(const float* __restrict__ A,
                                          const float* __restrict__ B,
                                          int N,
                                          int block_m,
                                          int block_n,
                                          int k0,
                                          int tid,
                                          float4 avec[2],
                                          float4 bvec[2]) {
    #pragma unroll
    for (int it = 0; it < 2; ++it) {
        const int idx = tid + (it << 8);
        const int a_m = idx >> 2;
        const int a_k4 = idx & 3;
        const int b_k = idx >> 5;
        const int b_n4 = idx & 31;
        load_a_frag(A, N, block_m, k0, a_m, a_k4, avec[it]);
        load_b_frag(B, N, block_n, k0, b_k, b_n4, bvec[it]);
    }
}
__device__ __forceinline__ void store_tile(float As[2][BK][LDA],
                                           float Bs[2][BK][LDB],
                                           int buf,
                                           int tid,
                                           const float4 avec[2],
                                           const float4 bvec[2]) {
    #pragma unroll
    for (int it = 0; it < 2; ++it) {
        const int idx = tid + (it << 8);
        const int a_m = idx >> 2;
        const int a_k4 = idx & 3;
        const int b_k = idx >> 5;
        const int b_n4 = idx & 31;
        store_a_frag(As, buf, a_m, a_k4, avec[it]);
        store_b_frag(Bs, buf, b_k, b_n4, bvec[it]);
    }
}
__global__ __launch_bounds__(THREADS)
void square_matmul_kernel(const float* __restrict__ A,
                          const float* __restrict__ B,
                          float* __restrict__ C,
                          int N) {
    __shared__ float As[2][BK][LDA];
    __shared__ float Bs[2][BK][LDB];
    const int tx = threadIdx.x;
    const int ty = threadIdx.y;
    const int tid = (ty << 4) + tx;
    const int block_m = blockIdx.y * BM;
    const int block_n = blockIdx.x * BN;
    const int row0 = block_m + ty * TM;
    const int col0 = block_n + tx * TN;
    float acc[TM][TN];
    #pragma unroll
    for (int i = 0; i < TM; ++i) {
        #pragma unroll
        for (int j = 0; j < TN; ++j) {
            acc[i][j] = 0.0f;
        }
    }
    {
        float4 avec[2], bvec[2];
        load_tile(A, B, N, block_m, block_n, 0, tid, avec, bvec);
        store_tile(As, Bs, 0, tid, avec, bvec);
    }
    __syncthreads();
    for (int k0 = 0, tile = 0; k0 < N; k0 += BK, ++tile) {
        const int curr = tile & 1;
        const int next = curr ^ 1;
        const int knext = k0 + BK;
        float4 avec[2], bvec[2];
        if (knext < N) {
            load_tile(A, B, N, block_m, block_n, knext, tid, avec, bvec);
        }
        #pragma unroll
        for (int kk = 0; kk < BK; ++kk) {
            const int a_col = ((ty ^ (kk >> 2)) << 3);
            const float4 av0 = *reinterpret_cast<const float4*>(&As[curr][kk][a_col]);
            const float4 av1 = *reinterpret_cast<const float4*>(&As[curr][kk][a_col + 4]);
            const int b_group = (tx ^ (kk & 3)) << 1;
            const float4 bv0 = *reinterpret_cast<const float4*>(&Bs[curr][kk][b_group << 2]);
            const float4 bv1 = *reinterpret_cast<const float4*>(&Bs[curr][kk][(b_group + 1) << 2]);
            const float af[TM] = {av0.x, av0.y, av0.z, av0.w, av1.x, av1.y, av1.z, av1.w};
            const float bf[TN] = {bv0.x, bv0.y, bv0.z, bv0.w, bv1.x, bv1.y, bv1.z, bv1.w};
            #pragma unroll
            for (int i = 0; i < TM; ++i) {
                #pragma unroll
                for (int j = 0; j < TN; ++j) {
                    acc[i][j] += af[i] * bf[j];
                }
            }
        }
        if (knext < N) {
            store_tile(As, Bs, next, tid, avec, bvec);
        }
        __syncthreads();
    }
    #pragma unroll
    for (int i = 0; i < TM; ++i) {
        const float4 out0 = make_float4(acc[i][0], acc[i][1], acc[i][2], acc[i][3]);
        const float4 out1 = make_float4(acc[i][4], acc[i][5], acc[i][6], acc[i][7]);
        *reinterpret_cast<float4*>(C + (long long)(row0 + i) * N + col0) = out0;
        *reinterpret_cast<float4*>(C + (long long)(row0 + i) * N + col0 + 4) = out1;
    }
}

torch::Tensor matmul_cuda(torch::Tensor A, torch::Tensor B) {
    TORCH_CHECK(A.is_cuda() && B.is_cuda(), "A and B must be CUDA tensors");
    TORCH_CHECK(A.scalar_type() == torch::kFloat32 &&
                B.scalar_type() == torch::kFloat32,
                "A and B must be float32");
    TORCH_CHECK(A.dim() == 2 && B.dim() == 2, "A and B must be 2D");
    TORCH_CHECK(A.is_contiguous() && B.is_contiguous(),
                "A and B must be contiguous");

    const int64_t N64 = A.size(0);
    TORCH_CHECK(A.size(1) == N64 && B.size(0) == N64 && B.size(1) == N64,
                "A and B must be square matrices with matching N");
    TORCH_CHECK(N64 <= INT32_MAX, "N is too large");
    TORCH_CHECK(N64 % BM == 0, "This kernel expects N to be divisible by 64");

    const c10::cuda::CUDAGuard device_guard(A.device());
    torch::Tensor C = torch::empty_like(A);

    const int N = static_cast<int>(N64);
    dim3 block(16, 16);
    dim3 grid(N / BN, N / BM);

    square_matmul_kernel<<<grid, block, 0, at::cuda::getCurrentCUDAStream()>>>(
        A.data_ptr<float>(), B.data_ptr<float>(), C.data_ptr<float>(), N);

    cudaError_t err = cudaGetLastError();
    TORCH_CHECK(err == cudaSuccess, cudaGetErrorString(err));
    return C;
}
"""

_cpp_src = "torch::Tensor matmul_cuda(torch::Tensor A, torch::Tensor B);"

_ext = load_inline(
    name="square_matmul_cuda_ext",
    cpp_sources=_cpp_src,
    cuda_sources=_cuda_src,
    functions=["matmul_cuda"],
    extra_cuda_cflags=["-O3"],
    verbose=False,
)


class ModelNew(nn.Module):
    def __init__(self):
        super().__init__()

    def forward(self, A: torch.Tensor, B: torch.Tensor) -> torch.Tensor:
        return _ext.matmul_cuda(A, B)
