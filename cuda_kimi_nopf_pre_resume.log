        #pragma unroll
        for (int idx = tid; idx < BK * BN; idx += nthreads) {
            int r  = idx / BN;
            int c  = idx - r * BN;
            int gc = block_col + c;
            float v = 0.0f;
            if (r < K && gc < N) v = B[(int64_t)r * N + gc];
            Bs[r][c] = v;
        }
