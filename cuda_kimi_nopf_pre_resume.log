import torch.nn as nn
from torch.utils.cpp_extension import load_inline

cuda_src = r"""
#include <torch/extension.h>
#include <ATen/cuda/CUDAContext.h>
#include <cuda_runtime.h>
#include <cstdint>

// Tiled matmul for the tall/skinny operand case.
// A: (M, K) row-major, B: (K, N) row-major, C: (M, N) row-major.
// Here M, N are huge (32768) while K is tiny (32), so one K-tile (BK=32)
// covers the whole reduction and each block does a single pass.
#define BM 128
#define BN 128
#define BK 32
#define TM 8
#define TN 8

__global__ void __launch_bounds__((BN / TN) * (BM / TM))
matmul_tall_skinny_kernel(const float* __restrict__ A,
                          const float* __restrict__ B,
                          float* __restrict__ C,
                          int M, int N, int K) {
    // As rows padded to 36 floats (16B aligned, conflict-free column reads)
    __shared__ float As[BM][BK + 4];
    __shared__ float Bs[BK][BN];

    const int block_row = blockIdx.y * BM;
    const int block_col = blockIdx.x * BN;

    const int tid       = threadIdx.y * blockDim.x + threadIdx.x;
    const int nthreads  = blockDim.x * blockDim.y;      // 256
    // Bank-conflict-free ownership swizzle: thread (tx,ty) owns rows
    // ty + i*16 (i in [0,TM)) and columns tx*4+{0..3} and 64+tx*4+{0..3}.
    // The two half-warps then hit distinct banks on As column reads (delta
    // of one padded row = 36 floats = 4 banks) and consecutive threads read
    // consecutive float4 chunks of Bs (all 32 banks covered exactly once).
    const int thread_row = threadIdx.y;                 // rows: thread_row + i*16
    const int thread_col = threadIdx.x * 4;             // cols: thread_col+{0..3}, +64

    float acc[TM][TN];
    #pragma unroll
    for (int i = 0; i < TM; ++i)
        #pragma unroll
        for (int j = 0; j < TN; ++j)
            acc[i][j] = 0.0f;

    for (int k0 = 0; k0 < K; k0 += BK) {
        // Load A tile (BM x BK), coalesced
        #pragma unroll
        for (int idx = tid; idx < BM * BK; idx += nthreads) {
            int r  = idx / BK;
            int c  = idx - r * BK;
            int gr = block_row + r;
            int gc = k0 + c;
            float v = 0.0f;
            if (gr < M && gc < K) v = A[(int64_t)gr * K + gc];
            As[r][c] = v;
        }
        // Load B tile (BK x BN), coalesced
        #pragma unroll
        for (int idx = tid; idx < BK * BN; idx += nthreads) {
            int r  = idx / BN;
            int c  = idx - r * BN;
            int gr = k0 + r;
            int gc = block_col + c;
            float v = 0.0f;
            if (gr < K && gc < N) v = B[(int64_t)gr * N + gc];
            Bs[r][c] = v;
        }
        __syncthreads();

        const int kmax = min(BK, K - k0);
        #pragma unroll
        for (int k = 0; k < BK; ++k) {
            if (k < kmax) {
                float ra[TM];
                float rb[TN];
                #pragma unroll
                for (int i = 0; i < TM; ++i) ra[i] = As[thread_row + (i << 4)][k];
                float4 bv0 = *reinterpret_cast<const float4*>(&Bs[k][thread_col]);
                float4 bv1 = *reinterpret_cast<const float4*>(&Bs[k][thread_col + 64]);
                rb[0] = bv0.x;
                rb[1] = bv0.y;
                rb[2] = bv0.z;
                rb[3] = bv0.w;
                rb[4] = bv1.x;
                rb[5] = bv1.y;
                rb[6] = bv1.z;
                rb[7] = bv1.w;
                #pragma unroll
                for (int i = 0; i < TM; ++i) {
                    #pragma unroll
                    for (int j = 0; j < TN; ++j)
                        acc[i][j] += ra[i] * rb[j];
                }
            }
        }
        __syncthreads();
    }

    if ((N & 3) == 0) {
        // vectorized 16B streaming stores (bypass L2 write-allocate; C is huge and never re-read)
        #pragma unroll
        for (int i = 0; i < TM; ++i) {
            int gr = block_row + thread_row + (i << 4);
            if (gr < M) {
                int gc0 = block_col + thread_col;
                if (gc0 + 3 < N) {
                    float4 out0 = make_float4(acc[i][0], acc[i][1], acc[i][2], acc[i][3]);
                    __stcs(reinterpret_cast<float4*>(C + (int64_t)gr * N + gc0), out0);
                } else {
                    #pragma unroll
                    for (int j = 0; j < 4; ++j)
                        if (gc0 + j < N) C[(int64_t)gr * N + gc0 + j] = acc[i][j];
                }
                int gc1 = gc0 + 64;
                if (gc1 + 3 < N) {
                    float4 out1 = make_float4(acc[i][4], acc[i][5], acc[i][6], acc[i][7]);
                    __stcs(reinterpret_cast<float4*>(C + (int64_t)gr * N + gc1), out1);
                } else {
                    #pragma unroll
                    for (int j = 4; j < TN; ++j)
                        if (gc1 + (j - 4) < N) C[(int64_t)gr * N + gc1 + (j - 4)] = acc[i][j];
                }
            }
        }
    } else {
        #pragma unroll
        for (int i = 0; i < TM; ++i) {
            int gr = block_row + thread_row + (i << 4);
            if (gr < M) {
                #pragma unroll
                for (int j = 0; j < TN; ++j) {
                    int gc = block_col + thread_col + (j < 4 ? j : 64 + (j - 4));
                    if (gc < N) C[(int64_t)gr * N + gc] = acc[i][j];
                }
            }
        }
    }
}

torch::Tensor matmul_cuda(torch::Tensor A, torch::Tensor B) {
    TORCH_CHECK(A.dim() == 2 && B.dim() == 2, "A and B must be 2D");
    TORCH_CHECK(A.scalar_type() == torch::kFloat32 &&
                B.scalar_type() == torch::kFloat32, "float32 expected");
    TORCH_CHECK(A.is_cuda() && B.is_cuda(), "CUDA tensors expected");

    auto Ac = A.contiguous();
    auto Bc = B.contiguous();

    const int M = (int)Ac.size(0);
    const int K = (int)Ac.size(1);
    TORCH_CHECK((int)Bc.size(0) == K, "inner dimensions must match");
    const int N = (int)Bc.size(1);

    auto C = torch::empty({M, N}, Ac.options());
    if (M == 0 || N == 0) return C;
    if (K == 0) { C.zero_(); return C; }

    dim3 threads(BN / TN, BM / TM);              // 16 x 16 = 256 threads
    dim3 blocks((N + BN - 1) / BN, (M + BM - 1) / BM);

    auto stream = at::cuda::getCurrentCUDAStream();
    matmul_tall_skinny_kernel<<<blocks, threads, 0, stream>>>(
        Ac.data_ptr<float>(), Bc.data_ptr<float>(), C.data_ptr<float>(),
        M, N, K);
    return C;
}
"""

cpp_src = "torch::Tensor matmul_cuda(torch::Tensor A, torch::Tensor B);"

_mod = load_inline(
    name="tall_skinny_matmul_ext",
    cpp_sources=cpp_src,
    cuda_sources=cuda_src,
    functions=["matmul_cuda"],
    extra_cuda_cflags=["-O3"],
    verbose=False,
)


class ModelNew(nn.Module):
    """
    Model with a custom CUDA kernel for the tall-and-skinny matmul C = A @ B
    (e.g. A: (32768, 32), B: (32, 32768)). The kernel exploits the tiny
    reduction dimension (K=32) with a single-pass tiled kernel using shared
    memory tiling, register blocking (4x4 per thread) and vectorized I/O.
    """
    def __init__(self):
        super(ModelNew, self).__init__()
        self._matmul = _mod.matmul_cuda

    def forward(self, A, B):
        if A.is_cuda and B.is_cuda:
            return self._matmul(A, B)
        # fallback so the module is still correct with CPU inputs
        return self._matmul(A.cuda(), B.cuda()).to(A.device)
