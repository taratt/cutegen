        for (int idx = tid; idx < BM * BK; idx += nthreads) {
            int r = idx / BK;
            int c = idx - r * BK;
            int gr = row0 + r;
            float v = 0.0f;
            if (gr < M && c < K) v = A[(int64_t)gr * K + c];
            As[0][r][c] = v;
