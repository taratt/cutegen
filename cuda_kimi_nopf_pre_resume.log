Src: import torch
import torch.nn as nn
from torch.utils.cpp_extension import load_inline

cuda_src = r"""
#include <torch/extension.h>
#include <ATen/cuda/CUDAContext.h>
#include <cuda.h>
#include <cuda_runtime.h>

__global__ void sigmoid_kernel(const float* __restrict__ x, float* __restrict__ y, long long n) {
    long long idx = (long long)blockIdx.x * blockDim.x + threadIdx.x;
    long long n4 = n >> 2;                 // number of full float4 chunks
    long long tail = n & 3LL;              // remaining elements (0..3)

    if (idx < n4) {
        const float4* x4 = reinterpret_cast<const float4*>(x);
        float4* y4 = reinterpret_cast<float4*>(y);
        float4 v = x4[idx];
        v.x = 1.0f / (1.0f + __expf(-v.x));
        v.y = 1.0f / (1.0f + __expf(-v.y));
        v.z = 1.0f / (1.0f + __expf(-v.z));
        v.w = 1.0f / (1.0f + __expf(-v.w));
        y4[idx] = v;
    } else if (idx < n4 + tail) {
        long long i = (n4 << 2) + (idx - n4);
        float v = x[i];
        y[i] = 1.0f / (1.0f + __expf(-v));
    }
}

torch::Tensor sigmoid_forward(torch::Tensor x) {
    TORCH_CHECK(x.is_cuda(), "input must be a CUDA tensor");
    x = x.contiguous();
    auto y = torch::empty_like(x);
    long long n = (long long)x.numel();
    if (n == 0) return y;

    long long n4 = n >> 2;
    long long tail = n & 3LL;
    long long threads_needed = n4 + tail;

    const int block = 256;
    long long blocks_ll = (threads_needed + block - 1) / block;
    TORCH_CHECK(blocks_ll <= 2147483647LL, "grid too large");
    dim3 grid((unsigned int)blocks_ll);

    cudaStream_t stream = at::cuda::getCurrentCUDAStream();
    sigmoid_kernel<<<grid, block, 0, stream>>>(
        x.data_ptr<float>(), y.data_ptr<float>(), n);
    return y;
}
"""

cpp_src = "torch::Tensor sigmoid_forward(torch::Tensor x);"

mod = load_inline(
    name="sigmoid_ext",
    cpp_sources=cpp_src,
    cuda_sources=cuda_src,
    functions=["sigmoid_forward"],
    extra_cuda_cflags=["-O3"],
    verbose=False,
)


class ModelNew(nn.Module):
    def __init__(self):
        super(ModelNew, self).__init__()

    def forward(self, x: torch.Tensor) -> torch.Tensor:
        if not x.is_cuda:
            x = x.cuda()
        return mod.sigmoid_forward(x)
