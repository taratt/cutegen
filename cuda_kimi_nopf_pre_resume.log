 = idx - r * BK;\n            int gr = row0 + r;\n            float v = 0.0f;\n            if (gr < M && c < K) v = A[(int64_t)gr * K + c];\n            As[0][r][c] = v;\n        }\n    }\n    #pragma unroll 1\n    for (int t = 0; t < MTILES; ++t) {\n        const int block_row = (blockIdx.y * MTILES + t) * BM;\n        if (block_row >= M) break;                       // uniform across the CTA\n        const int row_next  = (blockIdx.y * MTILES + t + 1) * BM;\n        const bool next_ok  = (t + 1 < MTILES) && (row_next < M);\n        const int cur = t & 1;\n        if (t > 0) __syncthreads();   // all reads of As[cur^1] (FMA of t-1) finished\n        // Issue the async stage for subtile t+1 into the other A buffer; it\n        // overlaps the FMA loop and streaming C stores of subtile t below.\n        if (next_ok) {\n            if (alignedA) {\n                stage_a_tile_async(A, As[cur ^ 1], row_next, M, K, tid, nthreads);\n                cp_async_commit();\n            } else {\n                #pragma unroll\n                for (int idx = tid; idx < BM * BK; idx += nthreads) {\n                    int r = idx / BK;\n                    int c = idx - r * BK;\n                    int gr = row_next + r;\n                    float v = 0.0f;\n                    if (gr < M && c < K) v = A[(int64_t)gr * K + c];\n                    As[cur ^ 1][r][c] = v;\n                }\n            }\n        }\n        if (alignedA) {\n            if (next_ok) cp_async_wait<1>(); else cp_async_wait<0>();\n        }\n        __syncthreads();   // publishes Bs (t == 0) and As(cur) to all threads\n        float acc[TM][TN];\n        #pragma unroll\n        for (int i = 0; i < TM; ++i)\n            #pragma unroll\n            for (int j = 0; j < TN; ++j)\n                acc[i][j] = 0.0f;\n        #pragma unroll\n        for (int k = 0; k < BK; ++k) {\n            if (k < kmax) {\n                float ra[TM];\n                float rb[TN];\n                #pragma unroll\n                for (int i = 0; i < TM; ++i) ra[i] = As[cur][thread_row + (i << 4)][k];\n                float4 bv0 = *reinterpret_cast<const float4*>(&Bs[k][thread_col]);\n                float4 bv1 = *reinterpret_cast<const float4*>(&Bs[k][thread_col + 64]);\n                rb[0] = bv0.x;\n                rb[1] = bv0.y;\n                rb[2] = bv0.z;\n                rb[3] = bv0.w;\n                rb[4] = bv1.x;\n                rb[5] = bv1.y;\n                rb[6] = bv1.z;\n                rb[7] = bv1.w;\n                #pragma unroll\n                for (int i = 0; i < TM; ++i) {\n                    #pragma unroll\n                    for (int j = 0; j < TN; ++j)\n                        acc[i][j] += ra[i] * rb[j];\n                }\n            }\n        }\n        if ((N & 3) == 0) {\n            // vectorized 16B streaming stores (bypass L2 write-allocate)\n            #pragma unroll\n            for (int i = 0; i < TM; ++i) {\n                int gr = block_row + thread_row + (i << 4);\n                if (gr < M) {\n                    int gc0 = block_col + thread_col;\n                    if (gc0 + 3 < N) {\n                        float4 out0 = make_float4(acc[i][0], acc[i][1], acc[i][2], acc[i][3]);\n                        __stcs(reinterpret_cast<float4*>(C + (int64_t)gr * N + gc0), out0);\n                    } else {\n                        #pragma unroll\n                        for (int j = 0; j < 4; ++j)\n                            if (gc0 + j < N) C[(int64_t)gr * N + gc0 + j] = acc[i][j];\n                    }\n                    int gc1 = gc0 + 64;\n                    if (gc1 + 3 < N) {\n                        float4 out1 = make_float4(acc[i][4], acc[i][5], acc[i][6], acc[i][7]);\n                        __stcs(reinterpret_cast<float4*>(C + (int64_t)gr * N + gc1), out1);\n                    } else {\n                        #pragma unroll\n                        for (int j = 4; j < TN; ++j)\n                            if (gc1 + (j - 