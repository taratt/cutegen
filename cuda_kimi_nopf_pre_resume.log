            #pragma unroll
            for (int idx = tid; idx < BK * BN; idx += nthreads) {
                int r  = idx / BN;
                int c  = idx - r * BN;
                int gr = k0 + r;
                int gc = block_col + c;
                float v = 0.0f;
                if (gr < K && gc < N) v = B[(int64_t)gr * N + gc];
                Bs[r][c] = v;
            }
