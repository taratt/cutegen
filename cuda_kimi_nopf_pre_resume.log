Src: import torch
import torch.nn as nn
from torch.utils.cpp_extension import load_inline

_cuda_src = r"""
#include <torch/extension.h>
#include <ATen/cuda/CUDAContext.h>
#include <c10/cuda/CUDAGuard.h>
#include <cuda_runtime.h>

constexpr int BM = 64;
constexpr int BN = 64;
constexpr int BK = 16;
constexpr int TM = 4;
constexpr int TN = 4;
constexpr int THREADS = 256;
constexpr int LDA = BM + 4;
constexpr int LDB = BN + 4;

__global__ __launch_bounds__(THREADS)
void square_matmul_kernel(const float* __restrict__ A,
                          const float* __restrict__ B,
                          float* __restrict__ C,
                          int N) {
    __shared__ float As[BK][LDA];
    __shared__ float Bs[BK][LDB];

    const int tx = threadIdx.x;
    const int ty = threadIdx.y;
    const int tid = (ty << 4) + tx;

    const int block_m = blockIdx.y * BM;
    const int block_n = blockIdx.x * BN;

    const int row0 = block_m + ty * TM;
    const int col0 = block_n + tx * TN;

    float acc[TM][TN];
    #pragma unroll
    for (int i = 0; i < TM; ++i) {
        #pragma unroll
        for (int j = 0; j < TN; ++j) {
            acc[i][j] = 0.0f;
        }
    }

    for (int k0 = 0; k0 < N; k0 += BK) {
        const int a_m = tid >> 2;
        const int a_k4 = tid & 3;
        const float4 avec = *reinterpret_cast<const float4*>(
            A + (long long)(block_m + a_m) * N + k0 + (a_k4 << 2));
        As[(a_k4 << 2) + 0][a_m] = avec.x;
        As[(a_k4 << 2) + 1][a_m] = avec.y;
        As[(a_k4 << 2) + 2][a_m] = avec.z;
        As[(a_k4 << 2) + 3][a_m] = avec.w;

        const int b_k = tid >> 4;
        const int b_n4 = tid & 15;
        const float4 bvec = *reinterpret_cast<const float4*>(
            B + (long long)(k0 + b_k) * N + block_n + (b_n4 << 2));
        *reinterpret_cast<float4*>(&Bs[b_k][b_n4 << 2]) = bvec;

        __syncthreads();

        #pragma unroll
        for (int kk = 0; kk < BK; ++kk) {
            const float4 av = *reinterpret_cast<const float4*>(&As[kk][ty * TM]);
            const float4 bv = *reinterpret_cast<const float4*>(&Bs[kk][tx * TN]);

            const float af[TM] = {av.x, av.y, av.z, av.w};
            const float bf[TN] = {bv.x, bv.y, bv.z, bv.w};

            #pragma unroll
            for (int i = 0; i < TM; ++i) {
                #pragma unroll
                for (int j = 0; j < TN; ++j) {
                    acc[i][j] += af[i] * bf[j];
                }
            }
        }

        __syncthreads();
    }

    #pragma unroll
    for (int i = 0; i < TM; ++i) {
        const float4 out = make_float4(acc[i][0], acc[i][1], acc[i][2], acc[i][3]);
        *reinterpret_cast<float4*>(C + (long long)(row0 + i) * N + col0) = out;
    }
}

torch::Tensor matmul_cuda(torch::Tensor A, torch::Tensor B) {
    TORCH_CHECK(A.is_cuda() && B.is_cuda(), "A and B must be CUDA tensors");
    TORCH_CHECK(A.scalar_type() == torch::kFloat32 &&
                B.scalar_type() == torch::kFloat32,
                "A and B must be float32");
    TORCH_CHECK(A.dim() == 2 && B.dim() == 2, "A and B must be 2D");
    TORCH_CHECK(A.is_contiguous() && B.is_contiguous(),
                "A and B must be contiguous");

    const int64_t N64 = A.size(0);
    TORCH_CHECK(A.size(1) == N64 && B.size(0) == N64 && B.size(1) == N64,
                "A and B must be square matrices with matching N");
    TORCH_CHECK(N64 <= INT32_MAX, "N is too large");
    TORCH_CHECK(N64 % BM == 0, "This kernel expects N to be divisible by 64");

    const c10::cuda::CUDAGuard device_guard(A.device());
    torch::Tensor C = torch::empty_like(A);

    const int N = static_cast<int>(N64);
    dim3 block(16, 16);
    dim3 grid(N / BN, N / BM);

    square_matmul_kernel<<<grid, block, 0, at::cuda::getCurrentCUDAStream()>>>(
        A.data_ptr<float>(), B.data_ptr<float>(), C.data_ptr<float>(), N);

    cudaError_t err = cudaGetLastError();
    TORCH_CHECK(err == cudaSuccess, cudaGetErrorString(err));
    return C;
}
"""

_cpp_src = "torch::Tensor matmul_cuda(torch::Tensor A, torch::Tensor B);"

_ext = load_inline(
    name="square_matmul_cuda_ext",
    cpp_sources=_cpp_src,
    cuda_sources=_cuda_src,
    functions=["matmul_cuda"],
    extra_cuda_cflags=["-O3"],
    verbose=False,
)


class ModelNew(nn.Module):
    def __init__(self):
        super().__init__()

    def forward(self, A: torch.Tensor, B: torch.Tensor) -> torch.Tensor:
        return _ext.matmul_cuda(A, B)
