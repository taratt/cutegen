            for (; r + 4 <= reduce; r += 4) {
                T v0 = p[0 * (int64_t)inner];
                T v1 = p[1 * (int64_t)inner];
                T v2 = p[2 * (int64_t)inner];
                T v3 = p[3 * (int64_t)inner];
                m0 = v0 > m0 ? v0 : m0;
                m1 = v1 > m1 ? v1 : m1;
                m2 = v2 > m2 ? v2 : m2;
                m3 = v3 > m3 ? v3 : m3;
                p += 4 * (int64_t)inner;
            }
        } else {
            m0 = p[0];
            m1 = m0; m2 = m0; m3 = m0;
            p += inner;
            r = 1;
        }
        T m = m0;
        m = m1 > m ? m1 : m;
        m = m2 > m ? m2 : m;
        m = m3 > m ? m3 : m;
