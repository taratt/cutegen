ck * KChunk];\n  auto sW = make_tensor(\n      make_smem_ptr(sW_raw),\n      make_shape(Int<CcPerBlock>{}, Int<KChunk>{}),\n      make_stride(Int<KChunk>{}, Int<1>{})\n  );\n\n  // Precompute p indices and (oh, ow), as well as base input indices\n  int   p_idx[PVec];\n  int   oh_arr[PVec];\n  int   ow_arr[PVec];\n  int   base_ih0[PVec];\n  int   iw_arr[PVec];\n  bool  wv_arr[PVec];\n\n  #pragma unroll\n  for (int i = 0; i < PVec; ++i) {\n    int p = p_block + tid + i * Threads;\n    p_idx[i] = p;\n\n    int oh = 0, ow = 0;\n    int b_wv = 0;\n\n    if (p < P_total) {\n      oh = p / Wout;\n      ow = p - oh * Wout;\n      int iw = ow * stride - padding;\n      b_wv = (iw >= 0 && iw < Win);\n      oh_arr[i] = oh;\n      ow_arr[i] = ow;\n      iw_arr[i] = iw;\n      base_ih0[i] = oh * stride - padding;\n      wv_arr[i] = (b_wv != 0);\n    } else {\n      oh_arr[i] = 0;\n      ow_arr[i] = 0;\n      iw_arr[i] = -1;\n      base_ih0[i] = 0;\n      wv_arr[i] = false;\n    }\n  }\n\n  // Accumulators initialized with bias if present\n  float acc[CcPerBlock][PVec];\n  #pragma unroll\n  for (int cc = 0; cc < CcPerBlock; ++cc) {\n    int c = c_base + cc;\n    float bval = 0.0f;\n    if (B != nullptr && c < C) {\n      bval = (float)B[c];\n    }\n    #pragma unroll\n    for (int i = 0; i < PVec; ++i) {\n      acc[cc][i] = bval;\n    }\n  }\n\n  for (int k0 = 0; k0 < K; k0 += KChunk) {\n    // Load weight chunk for CcPerBlock channels\n    for (int kk = tid; kk < KChunk; kk += Threads) {\n      int k_global = k0 + kk;\n\n      #pragma unroll\n      for (int cc = 0; cc < CcPerBlock; ++cc) {\n        int c = c_base + cc;\n        T wval = T(0);\n        if (c < C && k_global < K) {\n          wval = mW(c, k_global);\n        }\n        sW(cc, kk) = wval;\n      }\n    }\n    __syncthreads();\n\n    // Compute on this chunk\n    #pragma unroll\n    for (int i = 0; i < PVec; ++i) {\n      int p = p_idx[i];\n      if (p >= P_total) continue;\n\n      int iw = iw_arr[i];\n      bool w