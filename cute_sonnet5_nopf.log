eads) {\n                    float4 v4 = row[j];\n                    sum   += v4.x + v4.y + v4.z + v4.w;\n                    sumsq += v4.x * v4.x + v4.y * v4.y + v4.z * v4.z + v4.w * v4.w;\n                }\n            }\n        } else {\n            for (int64_t idx = tid; idx < total; idx += nthreads) {\n                int n  = (int)(idx / HW);\n                int hw = (int)(idx % HW);\n                float v = static_cast<float>(gX(n, hw));\n                sum   += v;\n                sumsq += v * v;\n            }\n        }\n        sdata_sum[tid] = sum;\n        sdata_sq[tid]  = sumsq;\n        __syncthreads();\n        for (int s = nthreads / 2; s > 0; s >>= 1) {\n            if (tid < s) {\n                sdata_sum[tid] += sdata_sum[tid + s];\n                sdata_sq[tid]  += sdata_sq[tid + s];\n            }\n            __syncthreads();\n        }\n        if (tid == 0) {\n            float m = sdata_sum[0] / (float)total;\n            float v = sdata_sq[0] / (float)total - m * m;\n            if (v < 0.f) v = 0.f;\n            s_mean = m;\n            s_var  = v;\n            float unbiased_var = (total > 1) ? (v * (float)total / (float)(total - 1)) : v;\n            float old_rm = static_cast<float>(running_mean[c]);\n            float old_rv = static_cast<float>(running_var[c]);\n            running_mean[c] = static_cast<T>((1.f - momentum) * old_rm + momentum * m);\n            running_var[c]  = static_cast<T>((1.f - momentum) * old_rv + momentum * unbiased_var);\n        }\n        __syncthreads();\n        mean_f = s_mean;\n        var_f  = s_var;\n    } else {\n        mean_f = static_cast<float>(running_mean[c]);\n        var_f  = static_cast<float>(running_var[c]);\n    }\n    const float inv_std = rsqrtf(var_f + eps);\n    const float w = static_cast<float>(weight[c]);\n    const float b = static_cast<float>(bias[c]);\n    if (use_vec4) {\n        for (int n = 0; n < N; ++n) {\n            const float4* __restrict__ row_in =\n         