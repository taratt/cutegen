cuda_src = r"""
#include <torch/extension.h>
#include <cuda_runtime.h>
#include <c10/cuda/CUDAStream.h>
#include <cute/tensor.hpp>

using namespace cute;

template <typename T>
__global__ void max_reduce_kernel(
    const T* __restrict__ X,
    T* __restrict__ Y,
    int outer, int reduce, int inner)
{
    int o  = blockIdx.y;
    int i0 = blockIdx.x * blockDim.x + threadIdx.x;
    if (o >= outer || i0 >= inner) return;
    // Direct pointer arithmetic instead of CuTe tensor indexing to avoid
    // recomputing r*stride + offset multiplications on every loop
    // iteration; the pointer is strength-reduced with a simple add.
    const T* __restrict__ p = X + (int64_t)o * (int64_t)reduce * (int64_t)inner + i0;
    T m = *p;
    p += inner;
    #pragma unroll 8
