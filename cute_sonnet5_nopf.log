cuda_src = r"""
#include <torch/extension.h>
#include <cuda_runtime.h>
#include <c10/cuda/CUDAStream.h>
#include <cute/tensor.hpp>
#include <vector>

using namespace cute;

template <typename T, int BX, int BY>
__global__ void min_reduce_kernel(
    const T* __restrict__ X,
    T* __restrict__ Y,
    int outer, int reduce, int inner)
{
  __shared__ T sdata[BY][BX];
  int i = blockIdx.x * BX + threadIdx.x;
  int o = blockIdx.y;
  bool valid = (o < outer) && (i < inner);
  T minv = (T)3.402823466e+38f; // FLT_MAX
  if (o < outer) {
    const T* base_ptr = X + (int64_t)o * (int64_t)reduce * (int64_t)inner;
    auto mX = make_tensor(
        make_gmem_ptr(base_ptr),
        make_shape(reduce, inner),
        make_stride(inner, 1)
    );
    if (valid) {
      #pragma unroll 4
      for (int r = threadIdx.y; r < reduce; r += BY) {
        T v = __ldg(&mX(r, i));
        minv = (v < minv) ? v : minv;
      }
    }
  }
  sdata[threadIdx.y][threadIdx.x] = minv;
  __syncthreads();
  #pragma unroll
  for (int off = BY / 2; off > 0; off >>= 1) {
    if (threadIdx.y < off) {
      T other = sdata[threadIdx.y + off][threadIdx.x];
      T cur = sdata[threadIdx.y][threadIdx.x];
      sdata[threadIdx.y][threadIdx.x] = (other < cur) ? other : cur;
    }
    __syncthreads();
  }
  if (threadIdx.y == 0 && valid) {
    Y[(int64_t)o * (int64_t)inner + i] = sdata[0][threadIdx.x];
  }
}
torch::Tensor min_reduce_forward(torch::Tensor x, int64_t dim) {
  TORCH_CHECK(x.is_cuda(), "x must be a CUDA tensor");
  TORCH_CHECK(x.scalar_type() == at::kFloat, "x must be float32");
  auto x_c = x.contiguous();
  int64_t ndim = x_c.dim();
  if (dim < 0) dim += ndim;
  TORCH_CHECK(dim >= 0 && dim < ndim, "dim out of range");
  int64_t outer = 1;
  int64_t inner = 1;
  for (int64_t d = 0; d < dim; ++d) outer *= x_c.size(d);
  int64_t reduce = x_c.size(dim);
  for (int64_t d = dim + 1; d < ndim; ++d) inner *= x_c.size(d);
  std::vector<int64_t> out_shape;
  out_shape.reserve(ndim - 1);
  for (int64_t d = 0; d < ndim; ++d) {
    if (d != dim) out_shape.push_back(x_c.size(d));
  }
  auto y = torch::empty(out_shape, x_c.options());
  constexpr int BX = 32;
  constexpr int BY = 8;
  dim3 block(BX, BY);
  dim3 grid((unsigned)((inner + BX - 1) / BX), (unsigned)outer);
  cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
  min_reduce_kernel<float, BX, BY><<<grid, block, 0, stream>>>(
      x_c.data_ptr<float>(),
      y.data_ptr<float>(),
      (int)outer, (int)reduce, (int)inner
  );
  auto err = cudaGetLastError();
  TORCH_CHECK(err == cudaSuccess, "min_reduce_kernel launch failed: ", cudaGetErrorString(err));
  return y;
}
"""

