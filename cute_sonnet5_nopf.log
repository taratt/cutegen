rward"],\n    extra_cflags=["-O3"],\n    extra_cuda_cflags=["-O3"],\n    extra_include_paths=["/root/cutegen_test/cutegen/cutlass/include", "/root/cutegen_test/cutegen/cutlass/include/cute/"],\n    verbose=False,\n)\n\n\nclass ModelNew(nn.Module):\n    """\n    Simple model that performs a Sigmoid activation using a custom CUTE kernel.\n    """\n    def __init__(self):\n        super(ModelNew, self).__init__()\n        self._ext = cute_sigmoid_ext\n\n    def forward(self, x: torch.Tensor) -> torch.Tensor:\n        return self._ext.cute_sigmoid_forward(x)', 'best_passed_depth': 0, 'best_passed_time': {'mean': 4.68, 'std': 0.00269, 'min': 4.68, 'max': 4.7, 'num_trials': 100}, 'best_passed_nsight_metrics': {}, 'kernel_backend': 'cute', 'compile': 'Generated code compilation/loading error:\nError building extension \'cute_sigmoid_ext\'\n Here is the full command line of the program execution: W0821 16:39:31.954000 75959 venv/lib/python3.10/site-packages/torch/utils/cpp_extension.py:2425] TORCH_CUDA_ARCH_LIST is not set, all archs for visible cards are included for compilation. \nW0821 16:39:31.954000 75959 venv/lib/python3.10/site-packages/torch/utils/cpp_extension.py:2425] If this is not desired, please set os.environ[\'TORCH_CUDA_ARCH_LIST\'] to specific architectures.\n[1/3] /usr/local/cuda/bin/nvcc --generate-dependencies-with-compile --dependency-output cuda.cuda.o.d -DTORCH_EXTENSION_NAME=cute_sigmoid_ext -DTORCH_API_INCLUDE_EXTENSION_H -DPYBIND11_COMPILER_TYPE=\\"_gcc\\" -DPYBIND11_STDLIB=\\"_libstdcpp\\" -DPYBIND11_BUILD_ABI=\\"_cxxabi1018\\" -I/root/cutegen_test/cutegen/cutlass/include -I/root/cutegen_test/cutegen/cutlass/include/cute -isystem /root/cutegen_test/venv/lib/python3.10/site-packages/torch/include -isystem /root/cutegen_test/venv/lib/python3.10/site-packages/torch/include/torch/csrc/api/include -isystem /usr/local/cuda/include -isystem /usr/include/python3.10 -D__CUDA_NO_HALF_OPERATORS__ -D__CUDA_NO_HALF_CONVERSIONS__ -D__CUDA_NO_BFLOAT16_CONVERSION