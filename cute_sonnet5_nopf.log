        p += inner;
        #pragma unroll 4
        for (int r = 1; r < reduce; ++r) {
            float4 v = *reinterpret_cast<const float4*>(p);
            m.x = v.x > m.x ? v.x : m.x;
            m.y = v.y > m.y ? v.y : m.y;
            m.z = v.z > m.z ? v.z : m.z;
            m.w = v.w > m.w ? v.w : m.w;
            p += inner;
