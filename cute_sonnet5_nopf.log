stride;\n  const int64_t xsize = (int64_t)patch_h * patch_w * Cin * D;\n  for (int64_t idx = tid; idx < xsize; idx += num_threads) {\n    int d   = (int)(idx % D);\n    int64_t rem = idx / D;\n    int c   = (int)(rem % Cin);\n    rem     = rem / Cin;\n    int pw  = (int)(rem % patch_w);\n    int ph  = (int)(rem / patch_w);\n    int ih  = in_h_base + ph;\n    int iw  = in_w_base + pw;\n    T val = T(0);\n    if (ih >= 0 && ih < H && iw >= 0 && iw < W) {\n      int64_t off = (int64_t)n * sXn + (int64_t)c * sXc +\n                    (int64_t)ih * sXh + (int64_t)iw * sXw + d;\n      val = X[off];\n    }\n    sX_ptr[idx] = val;\n  }\n  __syncthreads();\n  for (int od = 0; od < Dout; ++od) {\n    const int id = od * stride - padding;\n    const bool id_valid = (id >= 0 && id < D);\n    if (valid_out) {\n      for (int oc = 0; oc < Cout; ++oc) {\n        float acc = (Bias != nullptr) ? (float)Bias[oc] : 0.0f;\n        for (int ic = 0; ic < Cin; ++ic) {\n          for (int kh = 0; kh < Kh; ++kh) {\n            int ph = ph0 + kh * dilation;\n            for (int kw = 0; kw < Kw; ++kw) {\n              int pw = pw0 + kw * dilation;\n              float xval = id_valid ? (float)sX(ph, pw, ic, id) : 0.0f;\n              float wval = (float)sW(oc, ic, kh, kw);\n              acc += xval * wval;\n            }\n          }\n        }\n        int64_t out_off = (int64_t)n * sYn + (int64_t)oc * sYc +\n                           (int64_t)oh * sYh + (int64_t)ow * sYw + od;\n        Y[out_off] = (T)acc;\n      }\n    }\n  }\n}\ntorch::Tensor conv_hw_forward(torch::Tensor x,\n                               torch::Tensor weight,\n                               c10::optional<torch::Tensor> bias,\n                               int stride, int padding, int dilation, int groups) {\n  TORCH_CHECK(x.is_cuda() && weight.is_cuda(), "tensors must be CUDA");\n  TORCH_CHECK(x.scalar_type() == at::kFloat && weight.scalar_type() == at::kFloat,\n              "only float32 supported");\n  TORCH_CHE