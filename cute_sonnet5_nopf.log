      "  // Cooperative shared-memory staging of the input tile: for each input channel, the",
      "  // whole CTA loads the (overlapping) input footprint needed by its output tile once,",
      "  // and every thread reuses it for all K*K taps and all OcPerBlock output channels,",
      "  // instead of re-reading global memory redundantly per output pixel.",
      "  for (int cin = 0; cin < Cin; ++cin) {",
      "    int total_x = SH * SW;",
      "    for (int idx = tid; idx < total_x; idx += Threads) {",
      "      int lr = idx / SW;",
      "      int lc = idx - lr * SW;",
      "      int ih = oh_base * stride - padding + lr;",
      "      int iw = ow_base * stride - padding + lc;",
      "      T val = T(0);",
      "      if ((unsigned)ih < (unsigned)H && (unsigned)iw < (unsigned)Win) {",
      "        val = mX(cin, ih, iw);",
      "      }",
      "      sX_ptr[idx] = val;",
      "    }",
