 // Prologue: load first tile into buffer 0\n  copy(tAgA(_,_,0), tAsA0);\n  copy(tBgB(_,_,0), tBsB0);\n  __syncthreads();\n  for (int k_tile = 0; k_tile < K_TILE_MAX; ++k_tile) {\n    int cur = k_tile & 1;\n    // Prefetch the next K-tile into the other buffer while we compute\n    // on the current tile, overlapping global memory latency with FMA work.\n    if (k_tile + 1 < K_TILE_MAX) {\n      if (cur == 0) {\n        copy(tAgA(_,_,k_tile+1), tAsA1);\n        copy(tBgB(_,_,k_tile+1), tBsB1);\n      } else {\n        copy(tAgA(_,_,k_tile+1), tAsA0);\n        copy(tBgB(_,_,k_tile+1), tBsB0);\n      }\n    }\n    if (cur == 0) {\n      gemm(tCsA0, tCsB0, tCrC);\n    } else {\n      gemm(tCsA1, tCsB1, tCrC);\n    }\n    __syncthreads();\n  }\n\n  // Epilogue\n  axpby(1.0f, tCrC, 0.0f, tCgC);\n}\n\n// Host wrapper\ntorch::Tensor cute_matmul(torch::Tensor A, torch::Tensor B) {\n  TORCH_CHECK(A.is_cuda() && B.is_cuda(), "A and B must be CUDA tensors");\n  TORCH_CHECK(A.dim()==2 && B.dim()==2,  "A and B must be 2D");\n  TORCH_CHECK(A.scalar_type()==at::kFloat && B.scalar_type()==at::kFloat,\n              "Expect float32 tensors");\n\n  // A:[M,K] row-major, B:[K,N] row-major -> C = A @ B\n  int M = (int)A.size(0);\n  int K = (int)A.size(1);\n  int N = (int)B.size(1);\n  TORCH_CHECK((int)B.size(0)==K, "B.size(0) must equal K");\n\n  TORCH_CHECK(M % 128 == 0 && N % 128 == 0 && K % 32 == 0,\n              "This simple CUTE kernel requires M,N divisible by 128 and K divisible by 32");\n\n  auto A_c = A.contiguous();\n  auto B_c = B.contiguous();\n  auto C   = torch::empty({M, N}, A.options());\n\n  auto ptrA = A_c.data_ptr<float>();\n  auto ptrB = B_c.data_ptr<float>();\n  auto ptrC = C.data_ptr<float>();\n\n  // A is (M,K) row-major -> stride (K,1) : direct access, no transpose trick needed.\n  auto dA = make_stride(K, Int<1>{});\n  // B is (K,N) row-major physically; viewed as mB shape (N,K) via stride (1,N)\n  // gives mB(n,k) = B(k,n) without moving data.\n  auto dB = make_stride(Int<1>{}, N);\n  // C is (M,N) row-major -> stride (N,1)\n  auto dC = make_stride(N, Int<1>{});\n\n  auto shape_MNK = make_shape(M, N, K);\n\n  dim3 dimBlock(256);\n  dim3 dimGrid((M+127)/128, (N+127)/128);\n\n  constexpr int kPad_launch = 4;\n  constexpr int kSmemAStride_launch = 32 + kPad_launch;\n  constexpr int kSmemBStride_launch = 32 + kPad_launch;\n  size_t smem_bytes = 2 * (size_t)128 * kSmemAStride_launch * sizeof(float)\n                     + 2 * (size_t)128 * kSmemBStride_launch * sizeof(float);\n  using KernelPtrT = void(*)(cute::Shape<int,int,int>,\n                              float const*, decltype(dA),\n                              float const*, decltype(dB),\n                              float*, decltype(dC));\n  KernelPtrT kernel_ptr = &gemm_device<float, float, float,\n                                       decltype(dA), decltype(dB), decltype(dC)>;\n  auto attr_err = cudaFuncSetAttribute(\n      kernel_ptr,\n      cudaFuncAttributeMaxDynamicSharedMemorySize,\n      (int)smem_bytes);\n  TORCH_CHECK(attr_err == cudaSuccess,\n              "cudaFuncSetAttribute failed: ", cudaGetErrorString(attr_err));\n  cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();\n  gemm_device<<<dimGrid, dimBlock, smem_bytes, stream>>>(shape_MNK, ptrA, dA, ptrB, dB, ptrC, dC);\n\n  return C;\n}\n"""\n\ncute_matmul_ext = load_inline(\n    name="cute_matmul_inline",\n    cpp_sources=cuda_decl,\n    cuda_sources=cuda_src,\n    functions=["cute_matmul"],\n    extra_cflags=["-O3"],\n    extra_cuda_cflags=["-O3"],\n    extra_include_paths=["/root/cutegen_test/cutegen/cutlass/include"],\n    verbose=False,\n)\n\n\nclass ModelNew(nn.Module):\n    """\n    Simple model that performs a single square matrix multiplication (C = A * B)\n    using a custom CUTE GEMM kernel.\n    """\n    def __init__(self):\n        super(ModelNew, self).__init__()\n        self._ext = cute_matmul_ext\n\n    def forward(self, A: torch.Tensor, B: torch.Tensor) -> torch.Tensor