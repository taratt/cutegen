  // that, together with the row tiling below, we launch enough CTAs to
  // keep the GPU busy even though M is comparatively small relative to K.
  int kStart = blockIdx.y * kChunk;
  if (kStart >= K) return;
  int kEnd = min(K, kStart + kChunk);
  extern __shared__ float Bs[];  // 2*TileK floats (double-buffered)
  float* Bs0 = Bs;
  float* Bs1 = Bs + TileK;
  int block_row_start = blockIdx.x * RowsPerBlock;
  int tid = threadIdx.x;
  constexpr int VecWidth = 4;
  constexpr int NumWarps = Threads / 32;
  constexpr int RowsPerWarp = RowsPerBlock / NumWarps;
  int lane = tid % 32;
  int warp_id = tid / 32;
  // Warp-level tiling: each warp owns a disjoint subset of the block's rows
  // and keeps its own small accumulator array, drastically cutting register
  // pressure versus a single thread accumulating across all RowsPerBlock
  // rows. All warps still share the same double-buffered B tile in shared
  // memory, preserving the reuse benefit across rows.
  int warp_row_start = block_row_start + warp_id * RowsPerWarp;
  float acc[RowsPerWarp];
  #pragma unroll
  for (int r = 0; r < RowsPerWarp; ++r) acc[r] = 0.0f;
  int localK = kEnd - kStart;
  int numTiles = (localK + TileK - 1) / TileK;
  const T* Bptr_local = Bptr + kStart;
