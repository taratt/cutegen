run_in_subprocess, result = True, success = True, new_meta = {'prev_nsight_metrics': {}, 'last_passed_src': 'import math\nimport torch\nimport torch.nn as nn\nimport torch.nn.init as init\nfrom torch.utils.cpp_extension import load_inline\n\ncuda_decl = r"""\n#include <torch/extension.h>\ntorch::Tensor conv_hw_forward(torch::Tensor x,\n                               torch::Tensor weight,\n                               c10::optional<torch::Tensor> bias,\n                               int stride, int padding, int dilation, int groups);\n"""\n\ncuda_src = r"""\n#include <torch/extension.h>\n#include <cuda_runtime.h>\n#include <c10/cuda/CUDAStream.h>\n#include <cute/tensor.hpp>\n\nusing namespace cute;\n\n// A cooperative tiled kernel that computes a 2D convolution (over the H,W\n// spatial dims) with kernel (Kh, Kw), applied independently for every\n// (batch, depth) slice, since the actual conv kernel has depth-extent 1.\n// This corresponds to nn.Conv3d(..., kernel_size=(K,K,1), ...) with\n// groups == 1.\ntemplate <typename T, int TILE_OH, int TILE_OW, int CIN, int KH, int KW>\n__global__ void conv_hw_tiled_kernel_cached(\n    const T* __restrict__ X,   // [N, Cin, H, W, D]\n    const T* __restrict__ Wt,  // [Cout, Cin, Kh, Kw]\n    const T* __restrict__ Bias,// [Cout] or nullptr\n    T* __restrict__ Y,         // [N, Cout, Hout, Wout, Dout]\n    int N, int H, int W, int D,\n    int Cout,\n    int Hout, int Wout, int Dout,\n    int stride, int padding, int dilation,\n    int patch_h, int patch_w)\n{\n  // CIN, KH, KW are compile-time template constants (specialized to the\n  // actual layer shape at dispatch time). This lets the per-thread\n  // register cache below be fully statically unrolled, so the compiler\n  // can map every cached input value to a physical register instead of\n  // spilling a dynamically-indexed array to slow local memory (which is\n  // what happens when Cin/Kh/Kw are only known at runtime).\n  extern __shared__ __align__(16) unsigned char