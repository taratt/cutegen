= (int)A_c.size(1);\n  int64_t Bnum = B_c.numel();\n  TORCH_CHECK(Bnum == K, "B must have K elements");\n  auto C = torch::empty({M, 1}, A.options());\n  const float* Aptr = A_c.data_ptr<float>();\n  const float* Bptr = B_c.data_ptr<float>();\n  float* Cptr = C.data_ptr<float>();\n  constexpr int Threads = 256;\n  constexpr int RowsPerBlock = 8;\n  constexpr int TileK = 1024;\n  dim3 block(Threads);\n  dim3 grid((unsigned)((M + RowsPerBlock - 1) / RowsPerBlock));\n  size_t smem_bytes = (size_t)TileK * sizeof(float);\n  cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();\n  matvec_kernel<float, Threads, RowsPerBlock, TileK><<<grid, block, smem_bytes, stream>>>(\n      Aptr, Bptr, Cptr, M, K);\n  auto err = cudaGetLastError();\n  TORCH_CHECK(err == cudaSuccess, "matvec_kernel launch failed: ", cudaGetErrorString(err));\n  return C;\n}\n"""\n\ncute_matvec_ext = load_inline(\n    name="cute_matvec_ext",\n    cpp_sources=cuda_decl,\n    cuda_sources=cuda_src,\n    functions=["cute_matvec_forward"],\n    extra_cflags=["-O3"],\n    extra_cuda_cflags=["-O3"],\n    extra_include_paths=[\n        "/root/cutegen_test/cutegen/cutlass/include",\n        "/root/cutegen_test/cutegen/cutlass/include/cute/",\n    ],\n    verbose=False,\n)\n\n\nclass ModelNew(nn.Module):\n    """\n    Matrix-vector multiplication (C = A * B) implemented with a custom CUTE kernel.\n    """\n    def __init__(self):\n        super(ModelNew, self).__init__()\n        self._ext = cute_matvec_ext\n\n    def forward(self, A: torch.Tensor, B: torch.Tensor) -> torch.Tensor:\n        return self._ext.cute_matvec_forward(A.contiguous(), B.contiguous())', 'best_passed_depth': 1, 'best_passed_time': {'mean': 8.99, 'std': 0.0123, 'min': 8.98, 'max': 9.06, 'num_trials': 100}, 'best_passed_nsight_metrics': {}, 'kernel_backend': 'cute', 'compile': '', 'correct': ''}
