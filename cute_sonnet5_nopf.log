  Tensor mB = make_tensor(make_gmem_ptr(B), make_shape(shape_MNK[1], shape_MNK[2]), dB); // (N,K)
  Tensor mC = make_tensor(make_gmem_ptr(C), make_shape(shape_MNK[0], shape_MNK[1]), dC); // (M,N)

