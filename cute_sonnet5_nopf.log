            m1 = p[1 * (int64_t)inner];
            m2 = p[2 * (int64_t)inner];
            m3 = p[3 * (int64_t)inner];
            m4 = p[4 * (int64_t)inner];
            m5 = p[5 * (int64_t)inner];
            m6 = p[6 * (int64_t)inner];
            m7 = p[7 * (int64_t)inner];
            p += 8 * (int64_t)inner;
            r = 8;
            #pragma unroll 2
            for (; r + 8 <= reduce; r += 8) {
                T v0 = p[0 * (int64_t)inner];
                T v1 = p[1 * (int64_t)inner];
                T v2 = p[2 * (int64_t)inner];
                T v3 = p[3 * (int64_t)inner];
                T v4 = p[4 * (int64_t)inner];
                T v5 = p[5 * (int64_t)inner];
                T v6 = p[6 * (int64_t)inner];
                T v7 = p[7 * (int64_t)inner];
                m0 = v0 > m0 ? v0 : m0;
                m1 = v1 > m1 ? v1 : m1;
                m2 = v2 > m2 ? v2 : m2;
                m3 = v3 > m3 ? v3 : m3;
                m4 = v4 > m4 ? v4 : m4;
                m5 = v5 > m5 ? v5 : m5;
                m6 = v6 > m6 ? v6 : m6;
                m7 = v7 > m7 ? v7 : m7;
                p += 8 * (int64_t)inner;
