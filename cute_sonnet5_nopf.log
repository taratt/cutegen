rch.ones(num_features))\n        self.register_buffer("num_batches_tracked", torch.tensor(0, dtype=torch.long))\n\n        self._ext = bn_ext\n\n    def forward(self, x: torch.Tensor) -> torch.Tensor:\n        if self.training:\n            self.num_batches_tracked += 1\n\n        return self._ext.batchnorm2d_forward(\n            x,\n            self.weight,\n            self.bias,\n            self.running_mean,\n            self.running_var,\n            self.training,\n            float(self.momentum),\n            float(self.eps),\n        )', 'last_passed_depth': 8, 'retries_by_depth': {}, 'previous_src_time': {'mean': 14.1, 'std': 0.0182, 'min': 14.1, 'max': 14.2, 'num_trials': 100}, 'best_passed_src': 'import torch\nimport torch.nn as nn\nfrom torch.utils.cpp_extension import load_inline\n\ncuda_decl = r"""\n#include <torch/extension.h>\ntorch::Tensor batchnorm2d_forward(torch::Tensor x,\n                                   torch::Tensor weight,\n                                   torch::Tensor bias,\n                                   torch::Tensor running_mean,\n                                   torch::Tensor running_var,\n                                   bool training,\n                                   double momentum,\n                                   double eps);\n"""\n\ncuda_src = r"""\n#include <torch/extension.h>\n#include <cuda_runtime.h>\n#include <c10/cuda/CUDAStream.h>\n#include <cute/tensor.hpp>\n\nusing namespace cute;\n\ntemplate <typename T, int BLOCK_THREADS>\n__global__ void batchnorm2d_kernel(\n    const T* __restrict__ X,\n    T* __restrict__ Y,\n    const T* __restrict__ weight,\n    const T* __restrict__ bias,\n    T* __restrict__ running_mean,\n    T* __restrict__ running_var,\n    int N, int C, int HW,\n    float eps, float momentum, bool training)\n{\n    const int c = blockIdx.x;\n    const int tid = threadIdx.x;\n    const int nthreads = BLOCK_THREADS;\n    const int64_t channel_stride = (int64_t)C * (int64_t)HW;\n    const T* __restrict__ Xc = X + (int64_t)c * HW;\n    T* __restrict__ Yc = Y + (int64_t)c * HW;\n    // CUTE tensors viewing (N, HW) slice for this channel with NCHW strides\n    auto gX = make_tensor(make_gmem_ptr(Xc),\n                           make_shape(N, HW),\n                           make_stride(channel_stride, Int<1>{}));\n    auto gY = make_tensor(make_gmem_ptr(Yc),\n                           make_shape(N, HW),\n                           make_stride(channel_stride, Int<1>{}));\n    const int64_t total = (int64_t)N * (int64_t)HW;\n    const bool use_vec4 = (sizeof(T) == 4) && (HW % 4 == 0);\n    const int64_t HW4 = HW / 4;\n    __shared__ float sdata_sum[BLOCK_THREADS];\n    __shared__ float sdata_sq[BLOCK_THREADS];\n    __shared__ float s_mean;\n    __shared__ float s_var;\n    float mean_f, var_f;\n    if (training) {\n        float sum = 0.f, sumsq = 0.f;\n        if (use_vec4) {\n            for (int n = 0; n < N; ++n) {\n                const float4* __restrict__ row =\n                    reinterpret_cast<const float4*>(Xc + (int64_t)n * channel_stride);\n                for (int64_t j = tid; j < HW4; j += nthreads) {\n                    float4 v4 = row[j];\n                    sum   += v4.x + v4.y + v4.z + v4.w;\n                    sumsq += v4.x * v4.x + v4.y * v4.y + v4.z * v4.z + v4.w * v4.w;\n                }\n            }\n        } else {\n            for (int64_t idx = tid; idx < total; idx += nthreads) {\n                int n  = (int)(idx / HW);\n                int hw = (int)(idx % HW);\n                float v = static_cast<float>(gX(n, hw));\n                sum   += v;\n                sumsq += v * v;\n            }\n        }\n        sdata_sum[tid] = sum;\n        sdata_sq[tid]  = sumsq;\n        __syncthreads();\n        for (int s = nthreads / 2; s > 0; s >>= 1) {\n            if (tid < s) {\n                sdata_sum[tid] += sdata_sum[tid + s];\n                sdata_sq[tid]  += sdata_sq[tid + s];\n            }\n            __syncth