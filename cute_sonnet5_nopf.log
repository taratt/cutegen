      x_c.data_ptr<float>(),
      w_c.data_ptr<float>(),
      b_ptr,
      y.data_ptr<float>(),
      (int)N, (int)C, (int)H, (int)Win,
      (int)K, (int)stride, (int)padding, (int)dilation,
      (int)Hout, (int)Wout,
