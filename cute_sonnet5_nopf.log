1;\n  int patch_w = (TILE_OW - 1) * stride + (Kw - 1) * dilation + 1;\n  size_t smem_bytes = (size_t)(Cout * Cin * Kh * Kw + (size_t)patch_h * patch_w * Cin * D) * sizeof(float);\n  size_t smem_bytes_cached = smem_bytes + (size_t)4 * TILE_OH * TILE_OW * Dout * sizeof(float);\n  dim3 block(TILE_OW, TILE_OH);\n  dim3 grid(\n      (unsigned)((Wout + TILE_OW - 1) / TILE_OW),\n      (unsigned)((Hout + TILE_OH - 1) / TILE_OH),\n      (unsigned)(N)\n  );\n  cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();\n  bool launched = false;\n  #define LAUNCH_CACHED(CIN_V, KH_V, KW_V)                                          \\\n    do {                                                                             \\\n      if (!launched && Cin == (CIN_V) && Kh == (KH_V) && Kw == (KW_V)) {             \\\n        auto kernel_fn = conv_hw_tiled_kernel_cached<float, TILE_OH, TILE_OW,        \\\n                                                      (CIN_V), (KH_V), (KW_V)>;      \\\n        if (smem_bytes_cached > 48 * 1024) {                                         \\\n          cudaFuncSetAttribute(kernel_fn,                                            \\\n              cudaFuncAttributeMaxDynamicSharedMemorySize, (int)smem_bytes_cached);   \\\n        }                                                                            \\\n        kernel_fn<<<grid, block, smem_bytes_cached, stream>>>(                        \\\n            x_c.data_ptr<float>(), w_c.data_ptr<float>(), b_ptr,                      \\\n            y.data_ptr<float>(), N, H, W, D, Cout, Hout, Wout, Dout,                  \\\n            stride, padding, dilation, patch_h, patch_w);                            \\\n        launched = true;                                                             \\\n      }                                                                              \\\n    } while (0)\n  LAUNCH_CACHED(3, 3, 3);\n  LAUNCH_CACHED(1, 1, 1);\n  LAUNCH_CACHED(3, 5, 5);\n  LAUNCH_CACHED(