            // more memory-level parallelism per thread, better hiding the
            // latency of the strided global loads along the (large) reduce
            // dimension. reduce == 4096 divides evenly by 16 for the target
            // workload, so no extra tail work is introduced.
            #pragma unroll 2
            for (; r + 16 <= reduce; r += 16) {
