  int64_t KK = Cin * K * K;
  int64_t SH = (TileOH - 1) * stride + K;
  int64_t SW = (TileOW - 1) * stride + K;
  size_t smem_bytes = (size_t)(OcPerBlock * KK + Cin * SH * SW) * sizeof(float);
