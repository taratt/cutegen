  int epl = D / 32; // elements-per-lane
  half  q_reg[MAX_EPL];
  float o_reg[MAX_EPL];
  #pragma unroll
  for (int i = 0; i < MAX_EPL; ++i) o_reg[i] = 0.0f;
  if (row_valid) {
    int i = 0;
    for (; i + 1 < epl; i += 2) {
      const half2* qptr2 = reinterpret_cast<const half2*>(&mQ(row, lane * epl + i));
      *reinterpret_cast<half2*>(&q_reg[i]) = *qptr2;
    }
    for (; i < epl; ++i) {
      q_reg[i] = mQ(row, lane * epl + i);
    }
