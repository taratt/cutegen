            m4 = m0; m5 = m0; m6 = m0; m7 = m0;
            m8 = m0; m9 = m0; m10 = m0; m11 = m0;
            m12 = m0; m13 = m0; m14 = m0; m15 = m0;
            p += inner;
            r = 1;
