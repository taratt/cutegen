        T v5 = __ldg(&mX(r + stride5, i));
        T v6 = __ldg(&mX(r + stride6, i));
        T v7 = __ldg(&mX(r + stride7, i));
        minv0 = (v0 < minv0) ? v0 : minv0;
        minv1 = (v1 < minv1) ? v1 : minv1;
        minv2 = (v2 < minv2) ? v2 : minv2;
        minv3 = (v3 < minv3) ? v3 : minv3;
        minv4 = (v4 < minv4) ? v4 : minv4;
        minv5 = (v5 < minv5) ? v5 : minv5;
