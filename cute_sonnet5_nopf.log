cuda_src = r"""
#include <torch/extension.h>
#include <cuda_runtime.h>
#include <c10/cuda/CUDAStream.h>
#include <cute/tensor.hpp>
using namespace cute;
constexpr int Threads    = 64;
constexpr int OcPerBlock = 16;
constexpr int TileOH     = 8;
constexpr int TileOW     = 8;
constexpr int OwReg      = 4;  // register blocking factor: each thread computes OwReg output columns (increased for greater weight reuse)
static_assert(TileOH * TileOW == Threads, "TileOH*TileOW must equal Threads");
template <typename T>
__global__ void conv2d_cute_kernel(
    const T* __restrict__ X,
    const T* __restrict__ Wt,
    const T* __restrict__ Bias,
    T* __restrict__ Y,
    int N, int Cin, int H, int Win,
    int Cout, int K, int stride, int padding,
    int Hout, int Wout, int ow_tiles)
{
  extern __shared__ unsigned char smem_raw[];
  const int KK = Cin * K * K;
  const int SH = (TileOH - 1) * stride + K;
  const int TileOWx = TileOW * OwReg;
  const int SW = (TileOWx - 1) * stride + K;
  T* sW_ptr = reinterpret_cast<T*>(smem_raw);
  T* sX_ptr = sW_ptr + (size_t)OcPerBlock * (size_t)KK;
  const int tid = threadIdx.x;
  const int n       = blockIdx.z;
  const int oc_tile = blockIdx.y;
  const int oc_base = oc_tile * OcPerBlock;
  const int tile_idx    = blockIdx.x;
  const int ow_tile_idx = tile_idx % ow_tiles;
  const int oh_tile_idx = tile_idx / ow_tiles;
  const int oh_base = oh_tile_idx * TileOH;
  const int ow_base = ow_tile_idx * TileOWx;
  const int r = tid / TileOW;
  const int c = tid - r * TileOW;
  const int oh = oh_base + r;
  const int ow0 = ow_base + c * OwReg;
  const int64_t sXn = (int64_t)Cin * H * Win;
  const int64_t sXc = (int64_t)H * Win;
  const int64_t sXh = (int64_t)Win;
  const int64_t sYn = (int64_t)Cout * Hout * Wout;
  const int64_t sYc = (int64_t)Hout * Wout;
  const int64_t sYh = (int64_t)Wout;
  auto mX = make_tensor(
      make_gmem_ptr(X + (int64_t)n * sXn),
      make_shape(Cin, H, Win),
      make_stride(sXc, sXh, Int<1>{})
  );
  auto mY = make_tensor(
      make_gmem_ptr(Y + (int64_t)n * sYn),
      make_shape(Cout, Hout, Wout),
      make_stride(sYc, sYh, Int<1>{})
  );
  // Weight flattened as (Cout, Cin*K*K)
  auto mW = make_tensor(
      make_gmem_ptr(Wt),
      make_shape(Cout, KK),
      make_stride(KK, Int<1>{})
  );
  auto sW = make_tensor(
      make_smem_ptr(sW_ptr),
      make_shape(Int<OcPerBlock>{}, KK),
      make_stride(KK, Int<1>{})
  );
  // Load weight tile for this oc-block into shared memory (reused across all cin/kh/kw iterations).
  // The weight tile is a contiguous region of global memory (row-major, stride KK), so it can be
  // staged with 128-bit (float4) vectorized loads/stores to cut the number of memory transactions
  // and improve coalescing versus the previous scalar-per-thread copy.
  int total_w = OcPerBlock * KK;
  int64_t base_flat = (int64_t)oc_base * KK;
  int64_t remaining = ((int64_t)Cout * KK) - base_flat;
  if (remaining < 0) remaining = 0;
  int total_w4 = total_w / 4;
  const float4* Wt4 = reinterpret_cast<const float4*>(Wt + base_flat);
  float4* sW4 = reinterpret_cast<float4*>(sW_ptr);
  for (int idx4 = tid; idx4 < total_w4; idx4 += Threads) {
    int64_t idx = (int64_t)idx4 * 4;
    float4 v;
    if (idx + 3 < remaining) {
      v = Wt4[idx4];
    } else {
      float* vp = reinterpret_cast<float*>(&v);
      #pragma unroll
      for (int e = 0; e < 4; ++e) {
        int64_t gi = idx + e;
        vp[e] = (gi < remaining) ? (float)Wt[base_flat + gi] : 0.0f;
      }
    }
    sW4[idx4] = v;
  }
  for (int idx = total_w4 * 4 + tid; idx < total_w; idx += Threads) {
    float val = ((int64_t)idx < remaining) ? (float)Wt[base_flat + idx] : 0.0f;
    sW_ptr[idx] = val;
  }
  __syncthreads();
  // Register-blocked accumulators: each thread computes OwReg adjacent output columns so
  // that each weight value loaded from shared memory is reused across OwReg output pixels,
  // reducing shared-memory read traffic and increasing arithmetic intensity per thread.
  float acc[OwReg][OcPerBlock];
  #pragma unroll
  for (int j = 0; j < OwReg; ++j) {
    #pragma unroll
    for (int oc_local = 0; oc_local < OcPerBlock; ++oc_local) {
      int oc = oc_base + oc_local;
      float bval = 0.0f;
      if (Bias != nullptr && oc < Cout) {
        bval = (float)Bias[oc];
      }
      acc[j][oc_local] = bval;
    }
  }
  // Cooperative shared-memory staging of the input tile: since Cin is very small for
  // this layer, the whole CTA stages the (overlapping) input footprint for ALL input
  // channels into shared memory in a single cooperative pass. This removes the
  // per-channel __syncthreads() barriers that would otherwise serialize the load and
  // compute phases Cin times, letting the compute loop below run uninterrupted once
  // the full multi-channel tile is resident in shared memory.
  const int SHW = SH * SW;
  const int total_x = Cin * SHW;
  for (int idx = tid; idx < total_x; idx += Threads) {
    int cin = idx / SHW;
    int rem = idx - cin * SHW;
    int lr = rem / SW;
    int lc = rem - lr * SW;
    int ih = oh_base * stride - padding + lr;
    int iw = ow_base * stride - padding + lc;
    T val = T(0);
    if ((unsigned)ih < (unsigned)H && (unsigned)iw < (unsigned)Win) {
      val = mX(cin, ih, iw);
    }
    sX_ptr[idx] = val;
  }
  __syncthreads();
  const bool valid_row = (oh < Hout);
  bool valid_col[OwReg];
  #pragma unroll
  for (int j = 0; j < OwReg; ++j) {
    valid_col[j] = ((ow0 + j) < Wout);
  }
  if (valid_row) {
    for (int cin = 0; cin < Cin; ++cin) {
      const T* sX_cin = sX_ptr + (size_t)cin * SHW;
      for (int kh = 0; kh < K; ++kh) {
        int sx_row = r * stride + kh;
        const T* row_ptr = sX_cin + (size_t)sx_row * SW;
        for (int kw = 0; kw < K; ++kw) {
          int kk = (cin * K + kh) * K + kw;
          float xvals[OwReg];
          #pragma unroll
          for (int j = 0; j < OwReg; ++j) {
            int sx_col = (c * OwReg + j) * stride + kw;
            xvals[j] = (float)row_ptr[sx_col];
          }
          #pragma unroll
          for (int oc_local = 0; oc_local < OcPerBlock; ++oc_local) {
            float wval = (float)sW(oc_local, kk);
            #pragma unroll
            for (int j = 0; j < OwReg; ++j) {
              acc[j][oc_local] += xvals[j] * wval;
            }
          }
        }
      }
    }
  }
  #pragma unroll
  for (int j = 0; j < OwReg; ++j) {
    if (!valid_row || !valid_col[j]) continue;
    int ow = ow0 + j;
    #pragma unroll
    for (int oc_local = 0; oc_local < OcPerBlock; ++oc_local) {
      int oc = oc_base + oc_local;
      if (oc >= Cout) continue;
      mY(oc, oh, ow) = static_cast<T>(acc[j][oc_local]);
    }
  }
}
torch::Tensor conv2d_cute_forward(torch::Tensor x,
                                   torch::Tensor w,
                                   c10::optional<torch::Tensor> b,
                                   int stride, int padding) {
  TORCH_CHECK(x.is_cuda(), "x must be CUDA");
  TORCH_CHECK(w.is_cuda(), "w must be CUDA");
  if (b.has_value()) TORCH_CHECK(b.value().is_cuda(), "bias must be CUDA if provided");
  TORCH_CHECK(x.scalar_type() == at::kFloat, "x must be float32");
  TORCH_CHECK(w.scalar_type() == at::kFloat, "w must be float32");
  if (b.has_value()) TORCH_CHECK(b.value().scalar_type() == at::kFloat, "bias must be float32");
  TORCH_CHECK(x.dim() == 4, "x must be [N, C, H, W]");
  TORCH_CHECK(w.dim() == 4, "w must be [Cout, Cin, K, K]");
  int64_t N   = x.size(0);
  int64_t Cin = x.size(1);
  int64_t H   = x.size(2);
  int64_t Win = x.size(3);
  int64_t Cout = w.size(0);
  TORCH_CHECK(w.size(1) == Cin, "w.size(1) must equal Cin");
  int64_t K = w.size(2);
  TORCH_CHECK(w.size(3) == K, "kernel must be square for this kernel implementation");
  TORCH_CHECK(stride > 0, "stride must be > 0");
  TORCH_CHECK(padding >= 0, "padding must be >= 0");
  int64_t Hout = (H + 2 * padding - K) / stride + 1;
  int64_t Wout = (Win + 2 * padding - K) / stride + 1;
  TORCH_CHECK(Hout > 0 && Wout > 0, "Invalid output size computed");
  auto x_c = x.contiguous();
  auto w_c = w.contiguous();
  torch::Tensor b_c;
  const float* b_ptr = nullptr;
  if (b.has_value()) {
    b_c = b.value().contiguous();
    TORCH_CHECK(b_c.dim() == 1 && b_c.size(0) == Cout, "bias must be [Cout]");
    b_ptr = b_c.data_ptr<float>();
  }
  auto y = torch::empty({N, Cout, Hout, Wout}, x.options());
  int64_t TileOWx = (int64_t)TileOW * OwReg;
  int64_t oh_tiles = (Hout + TileOH - 1) / TileOH;
  int64_t ow_tiles = (Wout + TileOWx - 1) / TileOWx;
  dim3 block(Threads);
  dim3 grid(
      (unsigned)(oh_tiles * ow_tiles),
      (unsigned)((Cout + OcPerBlock - 1) / OcPerBlock),
      (unsigned)N
  );
  int64_t KK = Cin * K * K;
  int64_t SH = (TileOH - 1) * stride + K;
  int64_t SW = (TileOWx - 1) * stride + K;
  size_t smem_bytes = (size_t)(OcPerBlock * KK + Cin * SH * SW) * sizeof(float);
  cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();
  if (smem_bytes > 48 * 1024) {
    auto attr_err = cudaFuncSetAttribute(conv2d_cute_kernel<float>,
                          cudaFuncAttributeMaxDynamicSharedMemorySize,
                          (int)smem_bytes);
    TORCH_CHECK(attr_err == cudaSuccess,
        "cudaFuncSetAttribute failed: ", cudaGetErrorString(attr_err));
  }
  conv2d_cute_kernel<float><<<grid, block, smem_bytes, stream>>>(
      x_c.data_ptr<float>(),
      w_c.data_ptr<float>(),
      b_ptr,
      y.data_ptr<float>(),
      (int)N, (int)Cin, (int)H, (int)Win,
      (int)Cout, (int)K, (int)stride, (int)padding,
      (int)Hout, (int)Wout, (int)ow_tiles
  );
  auto err = cudaGetLastError();
  TORCH_CHECK(err == cudaSuccess, "conv2d_cute_kernel launch failed: ", cudaGetErrorString(err));
  return y;
}
