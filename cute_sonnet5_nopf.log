e(kernel_fn,                                            \\\n              cudaFuncAttributeMaxDynamicSharedMemorySize, (int)smem_bytes_cached);   \\\n        }                                                                            \\\n        kernel_fn<<<grid, block, smem_bytes_cached, stream>>>(                        \\\n            x_c.data_ptr<float>(), w_c.data_ptr<float>(), b_ptr,                      \\\n            y.data_ptr<float>(), N, H, W, D, Cout, Hout, Wout, Dout,                  \\\n            stride, padding, dilation, patch_h, patch_w);                            \\\n        launched = true;                                                             \\\n      }                                                                              \\\n    } while (0)\n  LAUNCH_CACHED(3, 3, 3);\n  LAUNCH_CACHED(1, 1, 1);\n  LAUNCH_CACHED(3, 5, 5);\n  LAUNCH_CACHED(3, 7, 7);\n  LAUNCH_CACHED(3, 1, 1);\n  #undef LAUNCH_CACHED\n  if (!launched) {\n    auto kernel_fn = conv_hw_tiled_kernel_generic<float, TILE_OH, TILE_OW>;\n    if (smem_bytes > 48 * 1024) {\n      cudaFuncSetAttribute(kernel_fn, cudaFuncAttributeMaxDynamicSharedMemorySize, (int)smem_bytes);\n    }\n    kernel_fn<<<grid, block, smem_bytes, stream>>>(\n        x_c.data_ptr<float>(),\n        w_c.data_ptr<float>(),\n        b_ptr,\n        y.data_ptr<float>(),\n        N, Cin, H, W, D,\n        Cout, Kh, Kw,\n        Hout, Wout, Dout,\n        stride, padding, dilation,\n        patch_h, patch_w\n    );\n  }\n  auto err = cudaGetLastError();\n  TORCH_CHECK(err == cudaSuccess, "conv_hw_tiled_kernel launch failed: ", cudaGetErrorString(err));\n  return y;\n}\n"""\n\nconv_ext = load_inline(\n    name="cute_conv_hw_ext",\n    cpp_sources=cuda_decl,\n    cuda_sources=cuda_src,\n    functions=["conv_hw_forward"],\n    extra_cflags=["-O3"],\n    extra_cuda_cflags=["-O3"],\n    extra_include_paths=["/root/cutegen_test/cutegen/cutlass/include"],\n    verbose=False,\n)\n\n\nclass ModelNew(nn.Module):\n 