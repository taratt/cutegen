Src: import torch
import torch.nn as nn
from torch.utils.cpp_extension import load_inline

cuda_decl = r"""
#include <torch/extension.h>
torch::Tensor gelu_cute_forward(torch::Tensor x);
"""

cuda_src = r"""
#include <torch/extension.h>
#include <cuda_runtime.h>
#include <c10/cuda/CUDAStream.h>
#include <math.h>

#include <cute/tensor.hpp>

using namespace cute;

template <typename T, int Vec>
__global__ void gelu_kernel(const T* __restrict__ X,
                             T* __restrict__ Y,
                             int64_t N)
{
  const int64_t idx  = (int64_t)(blockIdx.x * blockDim.x + threadIdx.x);
  const int64_t base = idx * Vec;
  if (base >= N) return;
  const int64_t remaining = N - base;
  const int n_valid = (int)(remaining < Vec ? remaining : (int64_t)Vec);
  float vals[Vec];
  if (n_valid == Vec) {
    // Fully aligned & contiguous: single vectorized 16B load (float4)
    float4 v = *reinterpret_cast<const float4*>(X + base);
    vals[0] = v.x; vals[1] = v.y; vals[2] = v.z; vals[3] = v.w;
  } else {
    #pragma unroll
    for (int i = 0; i < Vec; ++i) {
      vals[i] = (i < n_valid) ? (float)X[base + i] : 0.0f;
    }
  }
  const float c0 = 0.5f;
  const float c1 = 0.7978845608028654f; // sqrt(2/pi)
  const float c2 = 0.044715f;
  #pragma unroll
  for (int i = 0; i < Vec; ++i) {
    float x  = vals[i];
    float x3 = x * x * x;
    float inner = c1 * (x + c2 * x3);
    float t = tanhf(inner);
    vals[i] = c0 * x * (1.0f + t);
  }
  if (n_valid == Vec) {
    // Fully aligned & contiguous: single vectorized 16B store (float4)
    float4 out;
    out.x = vals[0]; out.y = vals[1]; out.z = vals[2]; out.w = vals[3];
    *reinterpret_cast<float4*>(Y + base) = out;
  } else {
    #pragma unroll
    for (int i = 0; i < Vec; ++i) {
      if (i < n_valid) {
        Y[base + i] = (T)vals[i];
      }
    }
  }
}

torch::Tensor gelu_cute_forward(torch::Tensor x) {
