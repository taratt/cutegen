f (p < P_total) {\n      oh = p / Wout;\n      ow = p - oh * Wout;\n      int iw = ow * stride - padding;\n      b_wv = (iw >= 0 && iw < Win);\n      oh_arr[i] = oh;\n      ow_arr[i] = ow;\n      iw_arr[i] = iw;\n      base_ih0[i] = oh * stride - padding;\n      wv_arr[i] = (b_wv != 0);\n    } else {\n      oh_arr[i] = 0;\n      ow_arr[i] = 0;\n      iw_arr[i] = -1;\n      base_ih0[i] = 0;\n      wv_arr[i] = false;\n    }\n  }\n\n  // Accumulators initialized with bias if present\n  float acc[CcPerBlock][PVec];\n  #pragma unroll\n  for (int cc = 0; cc < CcPerBlock; ++cc) {\n    int c = c_base + cc;\n    float bval = 0.0f;\n    if (B != nullptr && c < C) {\n      bval = (float)B[c];\n    }\n    #pragma unroll\n    for (int i = 0; i < PVec; ++i) {\n      acc[cc][i] = bval;\n    }\n  }\n\n  for (int k0 = 0; k0 < K; k0 += KChunk) {\n    // Load weight chunk for CcPerBlock channels\n    for (int kk = tid; kk < KChunk; kk += Threads) {\n      int k_global = k0 + kk;\n\n      #pragma unroll\n      for (int cc = 0; cc < CcPerBlock; ++cc) {\n        int c = c_base + cc;\n        T wval = T(0);\n        if (c < C && k_global < K) {\n          wval = mW(c, k_global);\n        }\n        sW(cc, kk) = wval;\n      }\n    }\n    __syncthreads();\n\n    // Compute on this chunk\n    #pragma unroll\n    for (int i = 0; i < PVec; ++i) {\n      int p = p_idx[i];\n      if (p >= P_total) continue;\n\n      int iw = iw_arr[i];\n      bool wv = wv_arr[i];\n      if (!wv) continue;\n\n      int ih0 = base_ih0[i];\n\n      #pragma unroll\n      for (int kk = 0; kk < KChunk; ++kk) {\n        int k_global = k0 + kk;\n        if (k_global >= K) break;\n\n        int ih = ih0 + k_global * dilation;\n        if ((unsigned)ih >= (unsigned)H) continue;\n\n        #pragma unroll\n        for (int cc = 0; cc < CcPerBlock; ++cc) {\n          int c = c_base + cc;\n          if (c >= C) continue;\n\n          float xval = (float)mX(c, ih, iw);\n          float wval = (float)sW(cc, kk);\n          acc