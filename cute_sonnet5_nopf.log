 torch.nn as nn\nfrom torch.utils.cpp_extension import load_inline\n\ncuda_decl = r"""\n#include <torch/extension.h>\ntorch::Tensor flash_attention_forward(torch::Tensor Q, torch::Tensor K, torch::Tensor V);\n"""\n\ncuda_src = r"""\n#include <torch/extension.h>\n#include <cuda_runtime.h>\n#include <cuda_fp16.h>\n#include <c10/cuda/CUDAStream.h>\n#include <math.h>\n\n#include <cute/tensor.hpp>\n\nusing namespace cute;\n\nconstexpr int BLOCK_N        = 8;\nconstexpr int ROWS_PER_BLOCK = 4;\nconstexpr int THREADS        = ROWS_PER_BLOCK * 32;\nconstexpr int MAX_EPL        = 64; // supports head_dim up to 2048 (2048/32=64)\n\n__global__ void flash_attn_kernel(\n    const half* __restrict__ Qg,\n    const half* __restrict__ Kg,\n    const half* __restrict__ Vg,\n    half* __restrict__ Og,\n    int B, int H, int N, int D, float scale)\n{\n  extern __shared__ unsigned char smem_raw[];\n  half* sK_ptr = reinterpret_cast<half*>(smem_raw);\n  half* sV_ptr = sK_ptr + (size_t)BLOCK_N * D;\n\n  // CuTe shared-memory tensors for the K/V tile: shape (BLOCK_N, D)\n  auto sK_t = make_tensor(make_smem_ptr(sK_ptr), make_shape(Int<BLOCK_N>{}, D), make_stride(D, Int<1>{}));\n  auto sV_t = make_tensor(make_smem_ptr(sV_ptr), make_shape(Int<BLOCK_N>{}, D), make_stride(D, Int<1>{}));\n\n  int bh = blockIdx.y;      // combined batch*head index\n  int b  = bh / H;\n  int h  = bh % H;\n\n  const int64_t head_stride = (int64_t)N * D;\n  const half* Qptr = Qg + ((int64_t)b * H + h) * head_stride;\n  const half* Kptr = Kg + ((int64_t)b * H + h) * head_stride;\n  const half* Vptr = Vg + ((int64_t)b * H + h) * head_stride;\n  half*       Optr = Og + ((int64_t)b * H + h) * head_stride;\n\n  // CuTe global-memory tensors: shape (N, D)\n  auto mQ = make_tensor(make_gmem_ptr(Qptr), make_shape(N, D), make_stride(D, 1));\n  auto mK = make_tensor(make_gmem_ptr(Kptr), make_shape(N, D), make_stride(D, 1));\n  auto mV = make_tensor(make_gmem_ptr(Vptr), make_shape(N, D), make_stride(D, 1));\n  auto mO = make_tensor(make_gmem_ptr(Optr), make_shape(N, D), make_stride(D, 1));\n\n  int tid     = threadIdx.x;\n  int warp_id = tid / 32;\n  int lane    = tid % 32;\n  int row     = blockIdx.x * ROWS_PER_BLOCK + warp_id;\n  bool row_valid = row < N;\n\n  int epl = D / 32; // elements-per-lane\n  half  q_reg[MAX_EPL];\n  float o_reg[MAX_EPL];\n  #pragma unroll\n  for (int i = 0; i < MAX_EPL; ++i) o_reg[i] = 0.0f;\n  if (row_valid) {\n    int i = 0;\n    for (; i + 1 < epl; i += 2) {\n      const half2* qptr2 = reinterpret_cast<const half2*>(&mQ(row, lane * epl + i));\n      *reinterpret_cast<half2*>(&q_reg[i]) = *qptr2;\n    }\n    for (; i < epl; ++i) {\n      q_reg[i] = mQ(row, lane * epl + i);\n    }\n  }\n  float m_i = -INFINITY;\n  float l_i = 0.0f;\n  for (int n0 = 0; n0 < N; n0 += BLOCK_N) {\n    int tile_n = min(BLOCK_N, N - n0);\n    // Cooperative load of K/V tile into shared memory (shared by all warps in block)\n    // D is guaranteed even (D % 32 == 0), so vectorize the copy using half2.\n    int total_elems = tile_n * D;\n    int total_pairs = total_elems / 2;\n    for (int idx = tid; idx < total_pairs; idx += THREADS) {\n      int idx2 = idx * 2;\n      int nn = idx2 / D;\n      int dd = idx2 - nn * D;\n      const half2* kptr2 = reinterpret_cast<const half2*>(&mK(n0 + nn, dd));\n      const half2* vptr2 = reinterpret_cast<const half2*>(&mV(n0 + nn, dd));\n      *reinterpret_cast<half2*>(&sK_t(nn, dd)) = *kptr2;\n      *reinterpret_cast<half2*>(&sV_t(nn, dd)) = *vptr2;\n    }\n    __syncthreads();\n    if (row_valid) {\n      float s[BLOCK_N];\n      #pragma unroll\n      for (int nn = 0; nn < BLOCK_N; ++nn) {\n        if (nn >= tile_n) { s[nn] = -INFINITY; continue; }\n        float partial = 0.0f;\n        int i = 0;\n        for (; i + 1 < epl; i += 2) {\n          half2 kv = *reinterpret_cast<const half2*>(&sK_t(nn, lane * epl + i));\n          half2 qv = *reinterpret_cast<const half2*>(&q_reg[i]);\n          float2 kf = __half22float2(kv);\n          float2 qf