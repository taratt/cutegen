* sizeof(float);\n\n    cudaFuncSetAttribute(\n        convtranspose3d_kernel<float>,\n        cudaFuncAttributeMaxDynamicSharedMemorySize,\n        (int)smem_bytes\n    );\n\n    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();\n\n    convtranspose3d_kernel<float><<<grid, block, smem_bytes, stream>>>(\n        x_c.data_ptr<float>(),\n        w_c.data_ptr<float>(),\n        b_ptr,\n        y.data_ptr<float>(),\n        (int)N, (int)Cin, (int)Din, (int)Hin, (int)Win,\n        (int)Cout, (int)KD, (int)KH, (int)KW,\n        strideD, strideH, strideW,\n        padD, padH, padW,\n        groups,\n        (int)Dout, (int)Hout, (int)Wout\n    );\n\n    auto err = cudaGetLastError();\n    TORCH_CHECK(err == cudaSuccess, "convtranspose3d_kernel launch failed: ", cudaGetErrorString(err));\n\n    return y;\n}\n"""\n\nconvtranspose3d_ext = load_inline(\n    name="cute_convtranspose3d_ext",\n    cpp_sources=cuda_decl,\n    cuda_sources=cuda_src,\n    functions=["convtranspose3d_forward"],\n    extra_cflags=["-O3"],\n    extra_cuda_cflags=["-O3"],\n    extra_include_paths=["/root/cutegen_test/cutegen/cutlass/include"],\n    verbose=False,\n)\n\n\nclass ModelNew(nn.Module):\n    """\n    Transposed 3D convolution implemented with a custom CUDA kernel using CuTe\n    tensors for indexing, with shared-memory weight caching per output channel.\n    """\n    def __init__(self, in_channels: int, out_channels: int, kernel_size: tuple,\n                 stride: tuple = (1, 1, 1), padding: tuple = (0, 0, 0),\n                 output_padding: tuple = (0, 0, 0), groups: int = 1, bias: bool = False):\n        super().__init__()\n        self.in_channels = in_channels\n        self.out_channels = out_channels\n        self.kernel_size = tuple(kernel_size)\n        self.stride = tuple(stride)\n        self.padding = tuple(padding)\n        self.output_padding = tuple(output_padding)\n        self.groups = groups\n\n        # Use a reference ConvTranspose3d purely to obtain cor