import torch.nn as nn
from torch.utils.cpp_extension import load_inline

cuda_decl = r"""
#include <torch/extension.h>
torch::Tensor cute_layernorm_forward(torch::Tensor x,
                                      torch::Tensor weight,
                                      torch::Tensor bias,
