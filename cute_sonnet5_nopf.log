            int total_vec = weight_count4 * COTILE;
            for (int idx = tid; idx < total_vec; idx += Threads) {
                int t = idx / weight_count4;
                int wrem4 = idx - t * weight_count4;
                int ci_local = wrem4 / K4;
                int krem4 = wrem4 - ci_local * K4;
                int ci_global = ci_base + ci_local;
                int co_local = co_local_base + t;
