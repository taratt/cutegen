                T v1 = p[1 * (int64_t)inner];
                T v2 = p[2 * (int64_t)inner];
                T v3 = p[3 * (int64_t)inner];
                T v4 = p[4 * (int64_t)inner];
                T v5 = p[5 * (int64_t)inner];
                T v6 = p[6 * (int64_t)inner];
                T v7 = p[7 * (int64_t)inner];
                T v8 = p[8 * (int64_t)inner];
                T v9 = p[9 * (int64_t)inner];
                T v10 = p[10 * (int64_t)inner];
                T v11 = p[11 * (int64_t)inner];
                T v12 = p[12 * (int64_t)inner];
                T v13 = p[13 * (int64_t)inner];
                T v14 = p[14 * (int64_t)inner];
                T v15 = p[15 * (int64_t)inner];
                m0 = v0 > m0 ? v0 : m0;
                m1 = v1 > m1 ? v1 : m1;
                m2 = v2 > m2 ? v2 : m2;
                m3 = v3 > m3 ? v3 : m3;
                m4 = v4 > m4 ? v4 : m4;
                m5 = v5 > m5 ? v5 : m5;
                m6 = v6 > m6 ? v6 : m6;
                m7 = v7 > m7 ? v7 : m7;
                m8 = v8 > m8 ? v8 : m8;
                m9 = v9 > m9 ? v9 : m9;
                m10 = v10 > m10 ? v10 : m10;
                m11 = v11 > m11 ? v11 : m11;
                m12 = v12 > m12 ? v12 : m12;
                m13 = v13 > m13 ? v13 : m13;
