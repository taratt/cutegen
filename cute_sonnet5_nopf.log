        for (int64_t idx = tid; idx < buf_elems; idx += num_threads) {
          int od2 = (int)(idx % Dout);
          int64_t rem = idx / Dout;
          int local_ow = (int)(rem % TILE_OW);
          int local_oh = (int)(rem / TILE_OW);
