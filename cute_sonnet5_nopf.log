ock(256);\n  dim3 dimGrid((M + 127) / 128, (N + 127) / 128);\n\n  cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();\n  gemm_device<<<dimGrid, dimBlock, 0, stream>>>(shape_MNK, ptrA, dA, ptrB, dB, ptrC, dC);\n\n  auto err = cudaGetLastError();\n  TORCH_CHECK(err == cudaSuccess, "CUTE gemm launch failed: ", cudaGetErrorString(err));\n\n  return C;\n}\n"""\n\ncute_matmul_ext = load_inline(\n    name="cute_matmul_ext",\n    cpp_sources=cuda_decl,\n    cuda_sources=cuda_src,\n    functions=["cute_matmul"],\n    extra_cflags=["-O3"],\n    extra_cuda_cflags=["-O3"],\n    extra_include_paths=["/root/cutegen_test/cutegen/cutlass/include",\n                          "/root/cutegen_test/cutegen/cutlass/include/cute/"],\n    verbose=False,\n)\n\n\nclass ModelNew(nn.Module):\n    """\n    Simple model that performs a single matrix multiplication (C = A * B)\n    using a custom tiled CUTE GEMM kernel, optimized for the tall/skinny\n    case where the contraction dimension K is small relative to M and N.\n    """\n    def __init__(self) -> None:\n        super().__init__()\n        self._ext = cute_matmul_ext\n\n    def forward(self, A: torch.Tensor, B: torch.Tensor) -> torch.Tensor:\n        A_c = A.contiguous().cuda().float() if not (A.is_cuda and A.dtype == torch.float32) else A\n        B_c = B.contiguous().cuda().float() if not (B.is_cuda and B.dtype == torch.float32) else B\n        return self._ext.cute_matmul(A_c, B_c)', 'last_passed_depth': 4, 'retries_by_depth': {}, 'previous_src_time': {'mean': 27.7, 'std': 0.0584, 'min': 27.6, 'max': 27.7, 'num_trials': 100}, 'best_passed_src': 'import torch\nimport torch.nn as nn\nfrom torch.utils.cpp_extension import load_inline\n\ncuda_decl = r"""\n#include <torch/extension.h>\ntorch::Tensor cute_matmul(torch::Tensor A, torch::Tensor B);\n"""\n\ncuda_src = r"""\n#include <torch/extension.h>\n#include <cuda_runtime.h>\n#include <c10/cuda/CUDAStream.h>\n\n#include <cute/tensor.hpp>\n\nusing namespace cute;\n\n// Generi