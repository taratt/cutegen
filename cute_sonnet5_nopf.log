m();\n\n  conv3d_kernel<<<grid, block, smem_bytes, stream>>>(\n      x_c.data_ptr<float>(),\n      w_c.data_ptr<float>(),\n      b_ptr,\n      y.data_ptr<float>(),\n      (int)N, (int)Cin, (int)D, (int)H, (int)Win,\n      (int)Cout, (int)K, stride, padding, dilation,\n      (int)Dout, (int)Hout, (int)Wout\n  );\n\n  auto err = cudaGetLastError();\n  TORCH_CHECK(err == cudaSuccess, "conv3d_kernel launch failed: ", cudaGetErrorString(err));\n\n  return y;\n}\n"""\n\nconv3d_ext = load_inline(\n    name="cute_conv3d_ext",\n    cpp_sources=cuda_decl,\n    cuda_sources=cuda_src,\n    functions=["conv3d_forward"],\n    extra_cflags=["-O3"],\n    extra_cuda_cflags=["-O3"],\n    extra_include_paths=["/root/cutegen_test/cutegen/cutlass/include"],\n    verbose=False,\n)\n\n\nclass ModelNew(nn.Module):\n    """\n    Standard 3D convolution (square kernel, groups=1) implemented with a\n    single custom CUDA kernel using CuTe tensors for cooperative tiled\n    computation.\n    """\n    def __init__(self, in_channels: int, out_channels: int, kernel_size: int,\n                 stride: int = 1, padding: int = 0, dilation: int = 1,\n                 groups: int = 1, bias: bool = False) -> None:\n        super().__init__()\n        assert groups == 1, "This custom kernel only supports groups=1"\n\n        self.in_channels = int(in_channels)\n        self.out_channels = int(out_channels)\n        self.kernel_size = int(kernel_size)\n        self.stride = int(stride)\n        self.padding = int(padding)\n        self.dilation = int(dilation)\n        self.groups = int(groups)\n\n        K = self.kernel_size\n        self.weight = nn.Parameter(torch.empty(out_channels, in_channels // groups, K, K, K))\n        if bias:\n            self.bias = nn.Parameter(torch.empty(out_channels))\n        else:\n            self.register_parameter("bias", None)\n\n        self.reset_parameters()\n        self._ext = conv3d_ext\n\n    def reset_parameters(self):\n        init.kaiming_uniform_(self.w