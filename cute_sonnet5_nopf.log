* unbiased_var);\n        }\n        __syncthreads();\n        mean_f = s_mean;\n        var_f  = s_var;\n    } else {\n        mean_f = static_cast<float>(running_mean[c]);\n        var_f  = static_cast<float>(running_var[c]);\n    }\n    const float inv_std = rsqrtf(var_f + eps);\n    const float w = static_cast<float>(weight[c]);\n    const float b = static_cast<float>(bias[c]);\n    if (use_vec4) {\n        for (int n = 0; n < N; ++n) {\n            const float4* __restrict__ row_in =\n                reinterpret_cast<const float4*>(Xc + (int64_t)n * channel_stride);\n            float4* __restrict__ row_out =\n                reinterpret_cast<float4*>(Yc + (int64_t)n * channel_stride);\n            for (int64_t j = tid; j < HW4; j += nthreads) {\n                float4 v4 = row_in[j];\n                float4 y4;\n                y4.x = (v4.x - mean_f) * inv_std * w + b;\n                y4.y = (v4.y - mean_f) * inv_std * w + b;\n                y4.z = (v4.z - mean_f) * inv_std * w + b;\n                y4.w = (v4.w - mean_f) * inv_std * w + b;\n                row_out[j] = y4;\n            }\n        }\n    } else {\n        for (int64_t idx = tid; idx < total; idx += nthreads) {\n            int n  = (int)(idx / HW);\n            int hw = (int)(idx % HW);\n            float v = static_cast<float>(gX(n, hw));\n            float y = (v - mean_f) * inv_std * w + b;\n            gY(n, hw) = static_cast<T>(y);\n        }\n    }\n}\n\ntorch::Tensor batchnorm2d_forward(torch::Tensor x,\n                                   torch::Tensor weight,\n                                   torch::Tensor bias,\n                                   torch::Tensor running_mean,\n                                   torch::Tensor running_var,\n                                   bool training,\n                                   double momentum,\n                                   double eps) {\n    TORCH_CHECK(x.is_cuda(), "x must be CUDA");\n    TORCH_CHECK(x.dim() == 4, "x must be 4D (N,C,H,W)");\n    TORCH_CHECK(x.scalar_type() == at::kFloat, "x must be float32");\n\n    auto x_c = x.contiguous();\n    auto w_c = weight.contiguous();\n    auto b_c = bias.contiguous();\n    auto rm_c = running_mean.contiguous();\n    auto rv_c = running_var.contiguous();\n\n    int N = (int)x_c.size(0);\n    int C = (int)x_c.size(1);\n    int H = (int)x_c.size(2);\n    int W = (int)x_c.size(3);\n    int HW = H * W;\n\n    auto y = torch::empty_like(x_c);\n\n    constexpr int BLOCK_THREADS = 512;\n    dim3 grid((unsigned)C);\n    dim3 block(BLOCK_THREADS);\n\n    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();\n\n    batchnorm2d_kernel<float, BLOCK_THREADS><<<grid, block, 0, stream>>>(\n        x_c.data_ptr<float>(),\n        y.data_ptr<float>(),\n        w_c.data_ptr<float>(),\n        b_c.data_ptr<float>(),\n        rm_c.data_ptr<float>(),\n        rv_c.data_ptr<float>(),\n        N, C, HW,\n        (float)eps, (float)momentum, training\n    );\n\n    auto err = cudaGetLastError();\n    TORCH_CHECK(err == cudaSuccess, "batchnorm2d_kernel launch failed: ", cudaGetErrorString(err));\n\n    // write back updated running stats (rm_c / rv_c may be new contiguous copies)\n    if (training) {\n        running_mean.copy_(rm_c);\n        running_var.copy_(rv_c);\n    }\n\n    return y;\n}\n"""\n\nbn_ext = load_inline(\n    name="cute_batchnorm2d_ext",\n    cpp_sources=cuda_decl,\n    cuda_sources=cuda_src,\n    functions=["batchnorm2d_forward"],\n    extra_cflags=["-O3"],\n    extra_cuda_cflags=["-O3"],\n    extra_include_paths=["/root/cutegen_test/cutegen/cutlass/include"],\n    verbose=False,\n)\n\n\nclass ModelNew(nn.Module):\n    """\n    Batch Normalization implemented with a single custom CUTE/CUDA kernel.\n    """\n    def __init__(self, num_features: int):\n        super().__init__()\n        self.num_features = num_features\n        self.eps = 1e-5\n        self.momentum = 0.1\n\n        self.weight = nn.Parameter(torch.ones(num_features))\n        self.bias = nn.Parameter(torch.zeros(num_features))\n\n        self.register_buffer("running_mean", torch.zeros(num_features))\n        self.register_buffer("running_var", torch.ones(num_features))\n        self.register_buffer("num_batches_tracked", torch.tensor(0, dtype=torch.long))\n\n        self._ext = bn_ext\n\n    def forward(self, x: torch.Tensor) -> torch.Tensor:\n        if self.training:\n            self.num_batches_tracked += 1\n\n        return self._ext.batchnorm2d_forward(\n            x,\n            self.weight,\n            self.bias,\n            self.running_mean,\n            self.running_var,\n            self.training,\n            float(self.momentum),\n            float(self.eps),\n        )', 'best_passed_depth': 1, 'best_passed_time': {'mean': 14.1, 'std': 0.0107, 'min': 14.1, 'max': 14.1, 'num_trials': 100}, 'best_passed_nsight_metrics': {}, 'kernel_backend': 'cute', 'compile': '', 'correct': ''}
