0 && ih < H && iw >= 0 && iw < W) {\n      int64_t off = (int64_t)n * sXn + (int64_t)c * sXc +\n                    (int64_t)ih * sXh + (int64_t)iw * sXw + d;\n      val = X[off];\n    }\n    sX_ptr[idx] = val;\n  }\n  __syncthreads();\n  constexpr int PATCH_ELEMS = CIN * KH * KW;\n  for (int od = 0; od < Dout; ++od) {\n    const int id = od * stride - padding;\n    const bool id_valid = (id >= 0 && id < D);\n    if (valid_out) {\n      float xreg[PATCH_ELEMS];\n      int ridx = 0;\n      #pragma unroll\n      for (int ic = 0; ic < CIN; ++ic) {\n        #pragma unroll\n        for (int kh = 0; kh < KH; ++kh) {\n          int ph = ph0 + kh * dilation;\n          #pragma unroll\n          for (int kw = 0; kw < KW; ++kw) {\n            int pw = pw0 + kw * dilation;\n            xreg[ridx++] = id_valid ? (float)sX(ph, pw, ic, id) : 0.0f;\n          }\n        }\n      }\n      for (int oc = 0; oc < Cout; ++oc) {\n        float acc = (Bias != nullptr) ? (float)Bias[oc] : 0.0f;\n        int r2 = 0;\n        #pragma unroll\n        for (int ic = 0; ic < CIN; ++ic) {\n          #pragma unroll\n          for (int kh = 0; kh < KH; ++kh) {\n            #pragma unroll\n            for (int kw = 0; kw < KW; ++kw) {\n              float wval = (float)sW(oc, ic, kh, kw);\n              acc += xreg[r2++] * wval;\n            }\n          }\n        }\n        int64_t out_off = (int64_t)n * sYn + (int64_t)oc * sYc +\n                           (int64_t)oh * sYh + (int64_t)ow * sYw + od;\n        Y[out_off] = (T)acc;\n      }\n    }\n  }\n}\n// Generic fallback kernel for arbitrary (Cin, Kh, Kw) shapes not covered by\n// the statically-specialized kernel above. It recomputes the shared-memory\n// resident input values directly inside the Cout loop instead of caching\n// them in a dynamically-indexed register array, since the compiler cannot\n// map a runtime-bounded array to physical registers (that would otherwise\n// silently spill to slow local memory).\ntemplate <typename T, int 