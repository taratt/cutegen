            p += inner;
            r = 1;
        }
        T m = m0;
        m = m1 > m ? m1 : m;
        m = m2 > m ? m2 : m;
        m = m3 > m ? m3 : m;
        m = m4 > m ? m4 : m;
        m = m5 > m ? m5 : m;
        m = m6 > m ? m6 : m;
        m = m7 > m ? m7 : m;
