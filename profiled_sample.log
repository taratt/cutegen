The example new arch with custom convolution CUTE kernels looks like this:
```
import math
import torch
import torch.nn as nn
import torch.nn.init as init
from torch.utils.cpp_extension import load_inline

cuda_decl = r"""
#include <torch/extension.h>
torch::Tensor dwconv2d_depthwise_k1_forward(torch::Tensor x,
                                            torch::Tensor w,
                                            c10::optional<torch::Tensor> b,
                                            int stride, int padding, int dilation);
"""

cuda_src = r"""
#include <torch/extension.h>
#include <cuda_runtime.h>
#include <c10/cuda/CUDAStream.h>
#include <cute/tensor.hpp>

using namespace cute;

template <typename T>
__global__ void dwconv2d_k1_kernel(
    const T* __restrict__ X,
    const T* __restrict__ W,
    const T* __restrict__ B,
    T* __restrict__ Y,
    int N, int C, int H, int Win,
    int K, int stride, int padding, int dilation,
    int Hout, int Wout)
{
  constexpr int Threads     = 128;
  constexpr int PVec        = 2;
  constexpr int CcPerBlock  = 4;
  constexpr int KChunk      = 64;

  const int tid = threadIdx.x;

  // Block coordinates
  const int n         = blockIdx.z;
  const int c_tile    = blockIdx.y;
  const int c_base    = c_tile * CcPerBlock;

  const int P_total   = Hout * Wout;
  const int PTile     = Threads * PVec;
  const int p_block   = blockIdx.x * PTile;

  // Memory strides
  const int64_t sXn = (int64_t)C * H * Win;
  const int64_t sXc = (int64_t)H * Win;
  const int64_t sXh = (int64_t)Win;

  const int64_t sYn = (int64_t)C * Hout * Wout;
  const int64_t sYc = (int64_t)Hout * Wout;
  const int64_t sYh = (int64_t)Wout;

  // Global tensors using Cute
  auto mX = make_tensor(
      make_gmem_ptr(X + (int64_t)n * sXn),
      make_shape(C, H, Win),
      make_stride(sXc, sXh, Int<1>{})
  );

  auto mY = make_tensor(
      make_gmem_ptr(Y + (int64_t)n * sYn),
      make_shape(C, Hout, Wout),
      make_stride(sYc, sYh, Int<1>{})
  );

  auto mW = make_tensor(
      make_gmem_ptr(W),
      make_shape(C, K),
      make_stride(K, Int<1>{})
  );

  // Shared memory for weight chunks
  __shared__ T sW_raw[CcPerBlock * KChunk];
  auto sW = make_tensor(
      make_smem_ptr(sW_raw),
      make_shape(Int<CcPerBlock>{}, Int<KChunk>{}),
      make_stride(Int<KChunk>{}, Int<1>{})
  );

  // Precompute p indices and (oh, ow), as well as base input indices
  int   p_idx[PVec];
  int   oh_arr[PVec];
  int   ow_arr[PVec];
  int   base_ih0[PVec];
  int   iw_arr[PVec];
  bool  wv_arr[PVec];

  #pragma unroll
  for (int i = 0; i < PVec; ++i) {
    int p = p_block + tid + i * Threads;
    p_idx[i] = p;

    int oh = 0, ow = 0;
    int b_wv = 0;

    if (p < P_total) {
      oh = p / Wout;
      ow = p - oh * Wout;
      int iw = ow * stride - padding;
      b_wv = (iw >= 0 && iw < Win);
      oh_arr[i] = oh;
      ow_arr[i] = ow;
      iw_arr[i] = iw;
      base_ih0[i] = oh * stride - padding;
      wv_arr[i] = (b_wv != 0);
    } else {
      oh_arr[i] = 0;
      ow_arr[i] = 0;
      iw_arr[i] = -1;
      base_ih0[i] = 0;
      wv_arr[i] = false;
    }
  }

  // Accumulators initialized with bias if present
  float acc[CcPerBlock][PVec];
  #pragma unroll
  for (int cc = 0; cc < CcPerBlock; ++cc) {
    int c = c_base + cc;
    float bval = 0.0f;
    if (B != nullptr && c < C) {
      bval = (float)B[c];
    }
    #pragma unroll
    for (int i = 0; i < PVec; ++i) {
      acc[cc][i] = bval;
    }
  }

  for (int k0 = 0; k0 < K; k0 += KChunk) {
    // Load weight chunk for CcPerBlock channels
    for (int kk = tid; kk < KChunk; kk += Threads) {
      int k_global = k0 + kk;

      #pragma unroll
      for (int cc = 0; cc < CcPerBlock; ++cc) {
        int c = c_base + cc;
        T wval = T(0);
        if (c < C && k_global < K) {
          wval = mW(c, k_global);
        }
        sW(cc, kk) = wval;
      }
    }
    __syncthreads();

    // Compute on this chunk
    #pragma unroll
    for (int i = 0; i < PVec; ++i) {
      int p = p_idx[i];
      if (p >= P_total) continue;

      int iw = iw_arr[i];
      bool wv = wv_arr[i];
      if (!wv) continue;

      int ih0 = base_ih0[i];

      #pragma unroll
      for (int kk = 0; kk < KChunk; ++kk) {
        int k_global = k0 + kk;
        if (k_global >= K) break;

        int ih = ih0 + k_global * dilation;
        if ((unsigned)ih >= (unsigned)H) continue;

        #pragma unroll
        for (int cc = 0; cc < CcPerBlock; ++cc) {
          int c = c_base + cc;
          if (c >= C) continue;

          float xval = (float)mX(c, ih, iw);
          float wval = (float)sW(cc, kk);
          acc[cc][i] += xval * wval;
        }
      }
    }
    __syncthreads();
  }

  // Store results
  #pragma unroll
  for (int cc = 0; cc < CcPerBlock; ++cc) {
    int c = c_base + cc;
    if (c >= C) continue;

    #pragma unroll
    for (int i = 0; i < PVec; ++i) {
      int p = p_idx[i];
      if (p >= P_total) continue;
      int oh = oh_arr[i];
      int ow = ow_arr[i];
      mY(c, oh, ow) = static_cast<T>(acc[cc][i]);
    }
  }
}

torch::Tensor dwconv2d_depthwise_k1_forward(torch::Tensor x,
                                            torch::Tensor w,
                                            c10::optional<torch::Tensor> b,
                                            int stride, int padding, int dilation) {
  TORCH_CHECK(x.is_cuda(), "x must be CUDA");
  TORCH_CHECK(w.is_cuda(), "w must be CUDA");
  if (b.has_value()) TORCH_CHECK(b.value().is_cuda(), "bias must be CUDA if provided");

  TORCH_CHECK(x.scalar_type() == at::kFloat, "x must be float32");
  TORCH_CHECK(w.scalar_type() == at::kFloat, "w must be float32");
  if (b.has_value()) TORCH_CHECK(b.value().scalar_type() == at::kFloat, "bias must be float32");

  TORCH_CHECK(x.dim() == 4, "x must be [N, C, H, W]");
  TORCH_CHECK(w.dim() == 4, "w must be [C, 1, K, 1] for depthwise conv (groups=C)");

  int64_t N   = x.size(0);
  int64_t C   = x.size(1);
  int64_t H   = x.size(2);
  int64_t Win = x.size(3);

  TORCH_CHECK(w.size(0) == C, "w.size(0) must equal C");
  TORCH_CHECK(w.size(1) == 1, "w.size(1) must be 1 for depthwise");
  TORCH_CHECK(w.size(3) == 1, "w.size(3) must be 1 for (kernel_width=1)");
  int64_t K = w.size(2);

  TORCH_CHECK(stride > 0 && dilation > 0, "stride and dilation must be > 0");
  TORCH_CHECK(padding >= 0, "padding must be >= 0");

  int64_t Hout = (H + 2 * padding - dilation * (K - 1) - 1) / stride + 1;
  int64_t Wout = (Win + 2 * padding - dilation * (1 - 1) - 1) / stride + 1; // kw=1
  TORCH_CHECK(Hout > 0 && Wout > 0, "Invalid output size computed");

  auto x_c = x.contiguous();
  auto w_c = w.contiguous();

  torch::Tensor b_c;
  const float* b_ptr = nullptr;
  if (b.has_value()) {
    b_c = b.value().contiguous();
    TORCH_CHECK(b_c.dim() == 1 && b_c.size(0) == C, "bias must be [C]");
    b_ptr = b_c.data_ptr<float>();
  }

  auto y = torch::empty({N, C, Hout, Wout}, x.options());

  constexpr int Threads = 128;
  constexpr int PVec = 2;
  constexpr int CcPerBlock = 4;
  const int64_t P_total = Hout * Wout;
  const int64_t PTile = Threads * PVec;

  dim3 block(Threads);
  dim3 grid(
      (unsigned)((P_total + PTile - 1) / PTile),
      (unsigned)((C + CcPerBlock - 1) / CcPerBlock),
      (unsigned)N
  );

  cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();

  dwconv2d_k1_kernel<float><<<grid, block, 0, stream>>>(
      x_c.data_ptr<float>(),
      w_c.data_ptr<float>(),
      b_ptr,
      y.data_ptr<float>(),
      (int)N, (int)C, (int)H, (int)Win,
      (int)K, (int)stride, (int)padding, (int)dilation,
      (int)Hout, (int)Wout
  );

  auto err = cudaGetLastError();
  TORCH_CHECK(err == cudaSuccess, "dwconv2d_k1_kernel launch failed: ", cudaGetErrorString(err));

  return y;
}
"""

dwconv2d_ext = load_inline(
    name="cute_dwconv2d_k1_ext",
    cpp_sources=cuda_decl,
    cuda_sources=cuda_src,
    functions=["dwconv2d_depthwise_k1_forward"],
    extra_cflags=["-O3"],
    extra_cuda_cflags=["-O3"],
    extra_include_paths=["/home/tarasaba/cutlass/include", "/home/tarasaba/cutlass/include/cute/"],
    verbose=False,
)

class ModelNew(nn.Module):
    """
    Depthwise 2D convolution with vertical asymmetric kernel (kernel_size x 1),
    implemented with a single custom CUDA kernel using CuTe.
    """
    def __init__(self,
                 in_channels: int,
                 kernel_size: int,
                 stride: int = 1,
                 padding: int = 0,
                 dilation: int = 1,
                 bias: bool = False) -> None:
        super().__init__()
        assert isinstance(kernel_size, int) and kernel_size >= 1
        assert isinstance(stride, int) and stride >= 1
        assert isinstance(padding, int) and padding >= 0
        assert isinstance(dilation, int) and dilation >= 1

        self.in_channels = int(in_channels)
        self.kernel_size = int(kernel_size)
        self.stride = int(stride)
        self.padding = int(padding)
        self.dilation = int(dilation)

        # Depthwise: groups = in_channels, out_channels = in_channels
        C = self.in_channels
        K = self.kernel_size
        # Weight shape matches PyTorch depthwise layout: [C_out, C_in/groups, Kh, Kw] with groups=C => [C,1,K,1]
        self.weight = nn.Parameter(torch.empty(C, 1, K, 1))
        if bias:
            self.bias = nn.Parameter(torch.empty(C))
        else:
            self.register_parameter("bias", None)

        self.reset_parameters()
        self._ext = dwconv2d_ext

    def reset_parameters(self):
        init.kaiming_uniform_(self.weight, a=math.sqrt(5))
        if self.bias is not None:
            fan_in = self.kernel_size  # depthwise per-channel fan_in equals kernel_size along H (Kw=1)
            bound = 1.0 / math.sqrt(fan_in) if fan_in > 0 else 0.0
            init.uniform_(self.bias, -bound, bound)

    def forward(self, x: torch.Tensor) -> torch.Tensor:
        return self._ext.dwconv2d_depthwise_k1_forward(
            x.contiguous(),
            self.weight.contiguous(),
            self.bias if self.bias is not None else None,
            int(self.stride),
            int(self.padding),
            int(self.dilation),
        )
