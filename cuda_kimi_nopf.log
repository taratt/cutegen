        bn_norm_kernel<<<grid, block, 0, stream>>>(
            xc.data_ptr<float>(),
            y.data_ptr<float>(),
            g.data_ptr<float>(),
            b.data_ptr<float>(),
            mean.data_ptr<float>(),
            inv.data_ptr<float>(),
            rm.data_ptr<float>(),
            rv.data_ptr<float>(),
            N, C, H, W,
            true,
            (float)eps
