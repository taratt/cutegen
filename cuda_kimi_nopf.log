 = blockDim.x * blockDim.y;\n    const int in_y0 = ty0 * STRIDE - PAD;\n    const int in_x0 = tx0 * STRIDE - PAD;\n    for (int idx = tid; idx < OC_BLOCK * 3 * KSIZE * KSIZE; idx += nthreads) {\n        const int ocb  = idx / (3 * KSIZE * KSIZE);\n        const int rem  = idx % (3 * KSIZE * KSIZE);\n        const int c    = rem / (KSIZE * KSIZE);\n        const int rem2 = rem % (KSIZE * KSIZE);\n        const int ky   = rem2 / KSIZE;\n        const int kx   = rem2 % KSIZE;\n        const int oc   = oc0 + ocb;\n        float v = 0.0f;\n        if (oc < C_out)\n            v = weight[((oc * 3 + c) * KSIZE + ky) * KSIZE + kx];\n        S_W(ocb, c, ky, kx) = v;\n    }\n    if (tid < OC_BLOCK) {\n        const int oc = oc0 + tid;\n        S_BIAS(tid) = (oc < C_out) ? bias[oc] : 0.0f;\n    }\n    for (int idx = tid; idx < PATCH * PATCH; idx += nthreads) {\n        const int r   = idx / PATCH;\n        const int col = idx % PATCH;\n        const int iy = in_y0 + r;\n        const int ix = in_x0 + col;\n        float v = 0.0f;\n        if (iy >= 0 && iy < H && ix >= 0 && ix < W)\n            v = input[((n * C_in + 0) * H + iy) * W + ix];\n        s_in_base[r * PATCH + col] = v;\n    }\n    __syncthreads();\n    const int oh0 = ty0 + threadIdx.y;\n    const int oh1 = oh0 + TILE / 4;\n    const int oh2 = oh1 + TILE / 4;\n    const int oh3 = oh2 + TILE / 4;\n    const int ow  = tx0 + threadIdx.x;\n    const bool valid0 = (oh0 < H_out) && (ow < W_out);\n    const bool valid1 = (oh1 < H_out) && (ow < W_out);\n    const bool valid2 = (oh2 < H_out) && (ow < W_out);\n    const bool valid3 = (oh3 < H_out) && (ow < W_out);\n    float acc0[OC_BLOCK];\n    float acc1[OC_BLOCK];\n    float acc2[OC_BLOCK];\n    float acc3[OC_BLOCK];\n    #pragma unroll\n    for (int ocb = 0; ocb < OC_BLOCK; ++ocb) {\n        acc0[ocb] = S_BIAS(ocb);\n        acc1[ocb] = S_BIAS(ocb);\n        acc2[ocb] = S_BIAS(ocb);\n        acc3[ocb] = S_BIAS(ocb);\n    }\n    const int by0 = threadIdx.y * STRIDE;\n    const int by1 = by0 + (TILE / 4) * STRIDE;\n    const int by2 = by1 + (TILE / 4) * STRIDE;\n    const int by3 = by2 + (TILE / 4) * STRIDE;\n    const int bx  = threadIdx.x * STRIDE;\n    for (int c = 0; c < 3; ++c) {\n        const int cur = c & 1;\n        const int nxt = cur ^ 1;\n        float* s_in_nxt = s_in_base + nxt * PATCH * PATCH;\n        const float* s_in_cur = s_in_base + cur * PATCH * PATCH;\n        if (c + 1 < 3) {\n            for (int idx = tid; idx < PATCH * PATCH; idx += nthreads) {\n                const int r   = idx / PATCH;\n                const int col = idx % PATCH;\n                const int iy = in_y0 + r;\n                const int ix = in_x0 + col;\n                float v = 0.0f;\n                if (iy >= 0 && iy < H && ix >= 0 && ix < W)\n                    v = input[((n * C_in + (c + 1)) * H + iy) * W + ix];\n                s_in_nxt[r * PATCH + col] = v;\n            }\n        }\n        if (valid0 || valid1 || valid2 || valid3) {\n            #pragma unroll\n            for (int ky = 0; ky < KSIZE; ++ky) {\n                #pragma unroll\n                for (int kx = 0; kx < KSIZE; ++kx) {\n                    const float iv0 = s_in_cur[(by0 + ky) * PATCH + (bx + kx)];\n                    const float iv1 = s_in_cur[(by1 + ky) * PATCH + (bx + kx)];\n                    const float iv2 = s_in_cur[(by2 + ky) * PATCH + (bx + kx)];\n                    const float iv3 = s_in_cur[(by3 + ky) * PATCH + (bx + kx)];\n                    #pragma unroll\n                    for (int ocb = 0; ocb < OC_BLOCK; ++ocb) {\n                        const float w = S_W(ocb, c, ky, kx);\n                        acc0[ocb] += iv0 * w;\n                        acc1[ocb] += iv1 * w;\n                        acc2[ocb] += iv2 * w;\n                        acc3[ocb] += iv3 * w;\n                    }\n                }\n            }\n        }\n        __syncthreads();\n    }\n    #pragma unroll\n    for (int ocb = 0; ocb < OC_BLOCK; ++ocb) {\n        c