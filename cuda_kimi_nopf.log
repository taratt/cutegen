            y.data_ptr<float>(),
            g.data_ptr<float>(),
            b.data_ptr<float>(),
            rm.data_ptr<float>(),
            rv.data_ptr<float>(),
            rm.data_ptr<float>(),
            rv.data_ptr<float>(),
            N, C, H, W,
            false,
            (float)eps
        );
    }
    return y;
}
