            const int W = BK >> 3;
            const uint4* qg = reinterpret_cast<const uint4*>(q) + (size_t)row0 * (size_t)(D >> 3) + (d0 >> 3);
            for (int idx = tid; idx < BR * W; idx += THREADS) {
                const int rr = idx / W;
                const int cc = idx - rr * W;
                reinterpret_cast<uint4*>(sQ)[rr * (LDK >> 3) + cc] = qg[(size_t)rr * (size_t)(D >> 3) + cc];
            }
        }
        {
            const int W = BK >> 3;
            const uint4* kg = reinterpret_cast<const uint4*>(k) + (d0 >> 3);
            for (int idx = tid; idx < S * W; idx += THREADS) {
                const int rr = idx / W;
                const int cc = idx - rr * W;
                reinterpret_cast<uint4*>(sK)[rr * (LDK >> 3) + cc] = kg[(size_t)rr * (size_t)(D >> 3) + cc];
            }
