#include <float.h>
#include <stdint.h>
__global__ void min_dim1_kernel(const float* __restrict__ x,
                                float* __restrict__ out,
                                int B, int M, int N,
                                long long total) {
    // Split-M cooperative reduction: each 256-thread block is arranged
    // as 64 columns x 4 row chunks, so four threads cooperate on every
    // output element. Each thread reduces a contiguous chunk of rows
    // (keeping 8 independent strided loads in flight), then the four
    // partial minima are combined through shared memory. Splitting the
    // reduction dimension quadruples the number of warps issuing loads
    // versus one thread per output, while threads within a warp still
    // read consecutive columns so every global load stays coalesced.
    (void)total;
    const int c = (int)(threadIdx.x & 63u);
    const int s = (int)(threadIdx.x >> 6);
    const long long j = (long long)blockIdx.x * 64LL + (long long)c;
    const int len = (M + 3) >> 2;
    __shared__ float red[4][64];
    for (int b = (int)blockIdx.y; b < B; b += (int)gridDim.y) {
        float mn0 = FLT_MAX, mn1 = FLT_MAX, mn2 = FLT_MAX, mn3 = FLT_MAX;
        float mn4 = FLT_MAX, mn5 = FLT_MAX, mn6 = FLT_MAX, mn7 = FLT_MAX;
        if (j < (long long)N) {
            const int i0raw = s * len;
            const int i0 = (i0raw < M) ? i0raw : M;
            const int i1 = (i0raw + len < M) ? (i0raw + len) : M;
            const int cnt = i1 - i0;
            const size_t step = (size_t)N;
            const float* p = x + ((size_t)b * (size_t)M + (size_t)i0) * step + (size_t)j;
            int i = 0;
            for (; i + 7 < cnt; i += 8) {
                mn0 = fminf(mn0, __ldg(p));
                mn1 = fminf(mn1, __ldg(p + step));
                mn2 = fminf(mn2, __ldg(p + 2 * step));
                mn3 = fminf(mn3, __ldg(p + 3 * step));
                mn4 = fminf(mn4, __ldg(p + 4 * step));
                mn5 = fminf(mn5, __ldg(p + 5 * step));
                mn6 = fminf(mn6, __ldg(p + 6 * step));
                mn7 = fminf(mn7, __ldg(p + 7 * step));
                p += 8 * step;
            }
            for (; i < cnt; ++i) {
                mn0 = fminf(mn0, __ldg(p));
                p += step;
            }
        }
        mn0 = fminf(fminf(mn0, mn1), fminf(mn2, mn3));
        mn4 = fminf(fminf(mn4, mn5), fminf(mn6, mn7));
        red[s][c] = fminf(mn0, mn4);
        __syncthreads();
        if (s == 0 && j < (long long)N) {
            const float m01 = fminf(red[0][c], red[1][c]);
            const float m23 = fminf(red[2][c], red[3][c]);
            out[(size_t)b * (size_t)N + (size_t)j] = fminf(m01, m23);
        }
        __syncthreads();
    }
}
torch::Tensor min_dim1_cuda(torch::Tensor x) {
    TORCH_CHECK(x.is_cuda(), "x must be CUDA");
    TORCH_CHECK(x.dim() == 3, "x must be 3D");
    TORCH_CHECK(x.scalar_type() == at::kFloat, "x must be float32");
    TORCH_CHECK(x.is_contiguous(), "x must be contiguous");
    const int B = (int)x.size(0);
    const int M = (int)x.size(1);
    const int N = (int)x.size(2);
    auto out = torch::empty({B, N}, x.options());
    const long long total = (long long)B * (long long)N;
    if (total == 0) return out;
