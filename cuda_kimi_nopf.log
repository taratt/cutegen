    (TILE_A * TILE_B * TILE_L + TILE_THREADS - 1) / TILE_THREADS;
extern "C" __global__ void conv3d_k331_s1_p0_d1_g1_kernel(
    const float* __restrict__ x,
    const float* __restrict__ w,
    const float* __restrict__ b,
    float* __restrict__ y,
    const int N,
    const int Cin,
    const int A,
    const int B,
    const int L,
    const int Cout,
    const int Aout,
    const int Bout,
    const bool has_bias
