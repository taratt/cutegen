Src: import torch
import torch.nn as nn
from torch.utils.cpp_extension import load_inline

_cuda_src = r"""
#include <torch/extension.h>
#include <ATen/cuda/CUDAContext.h>
#include <cuda_runtime.h>
#include <float.h>
#include <stdint.h>

__global__ void min_dim1_kernel(const float* __restrict__ x,
                                float* __restrict__ out,
                                int B, int M, int N) {
    const int b = blockIdx.y;
    const int tx = threadIdx.x;
    const int ty = threadIdx.y;
    // Thread-level tiling over columns: each thread reduces two columns
    // (j0 and j1 = j0 + blockDim.x) to double memory-level parallelism.
    // Loads stay coalesced: consecutive tx still touch consecutive addresses.
    const int j0 = blockIdx.x * (blockDim.x * 2) + tx;
    const int j1 = j0 + blockDim.x;
    if (b >= B) return;
    const size_t stride = (size_t)N;
    const float* base = x + (size_t)b * (size_t)M * (size_t)N;
    float mn0 = FLT_MAX;
    float mn1 = FLT_MAX;
    const bool c0 = (j0 < N);
    const bool c1 = (j1 < N);
    if (c0 && c1) {
        const float* p0 = base + j0;
        const float* p1 = base + j1;
        const int step = (int)blockDim.y;
        int i = ty;
        for (; i + 3 * step < M; i += 4 * step) {
            const float v00 = __ldg(p0 + (size_t)i * stride);
            const float v01 = __ldg(p0 + (size_t)(i + step) * stride);
            const float v02 = __ldg(p0 + (size_t)(i + 2 * step) * stride);
            const float v03 = __ldg(p0 + (size_t)(i + 3 * step) * stride);
            const float v10 = __ldg(p1 + (size_t)i * stride);
            const float v11 = __ldg(p1 + (size_t)(i + step) * stride);
            const float v12 = __ldg(p1 + (size_t)(i + 2 * step) * stride);
            const float v13 = __ldg(p1 + (size_t)(i + 3 * step) * stride);
            mn0 = fminf(mn0, fminf(fminf(v00, v01), fminf(v02, v03)));
            mn1 = fminf(mn1, fminf(fminf(v10, v11), fminf(v12, v13)));
        }
        for (; i < M; i += step) {
            mn0 = fminf(mn0, __ldg(p0 + (size_t)i * stride));
            mn1 = fminf(mn1, __ldg(p1 + (size_t)i * stride));
        }
    } else if (c0) {
        const float* p0 = base + j0;
        const int step = (int)blockDim.y;
        for (int i = ty; i < M; i += step) {
            mn0 = fminf(mn0, __ldg(p0 + (size_t)i * stride));
        }
    }
    // Reduce partial minima across the row-split threads via shared memory.
    __shared__ float smem[16][65];
    smem[ty][tx] = mn0;
    smem[ty][tx + 32] = mn1;
    __syncthreads();
    #pragma unroll
    for (int s = 8; s > 0; s >>= 1) {
        if (ty < s) {
            smem[ty][tx] = fminf(smem[ty][tx], smem[ty + s][tx]);
            smem[ty][tx + 32] = fminf(smem[ty][tx + 32], smem[ty + s][tx + 32]);
        }
        __syncthreads();
    }
    if (ty == 0) {
        if (c0) out[(size_t)b * (size_t)N + j0] = smem[0][tx];
        if (c1) out[(size_t)b * (size_t)N + j1] = smem[0][tx + 32];
    }
}

torch::Tensor min_dim1_cuda(torch::Tensor x) {
    TORCH_CHECK(x.is_cuda(), "x must be CUDA");
    TORCH_CHECK(x.dim() == 3, "x must be 3D");
    TORCH_CHECK(x.scalar_type() == at::kFloat, "x must be float32");
    TORCH_CHECK(x.is_contiguous(), "x must be contiguous");

    const int B = (int)x.size(0);
    const int M = (int)x.size(1);
    const int N = (int)x.size(2);

    auto out = torch::empty({B, N}, x.options());

    const dim3 block(32, 16);
    const dim3 grid((N + (int)block.x * 2 - 1) / ((int)block.x * 2), B);
    auto stream = at::cuda::getCurrentCUDAStream();

    min_dim1_kernel<<<grid, block, 0, stream>>>(
        x.data_ptr<float>(),
        out.data_ptr<float>(),
        B, M, N
    );
    return out;
}
"""

_cpp_src = "torch::Tensor min_dim1_cuda(torch::Tensor x);"

_min_mod = load_inline(
    name="min_dim1_ext",
    cpp_sources=_cpp_src,
    cuda_sources=_cuda_src,
    functions=["min_dim1_cuda"],
    extra_cuda_cflags=["-O3"],
    verbose=False,
)


class ModelNew(nn.Module):
    def __init__(self, dim: int):
        super().__init__()
        self.dim = dim

    def forward(self, x: torch.Tensor) -> torch.Tensor:
        d = self.dim if self.dim >= 0 else x.dim() + self.dim
        if x.dim() == 3 and d == 1 and x.dtype == torch.float32:
            x = x.contiguous()
            if not x.is_cuda:
                x = x.cuda()
            return _min_mod.min_dim1_cuda(x)
        return torch.min(x, dim=self.dim)[0]
