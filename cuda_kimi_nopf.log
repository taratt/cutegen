import torch
import torch.nn as nn
from torch.utils.cpp_extension import load_inline
_cpp_src = "torch::Tensor conv2d_forward(torch::Tensor input, torch::Tensor weight, torch::Tensor bias);"
_cuda_src = r"""
#include <torch/extension.h>
#include <cuda_runtime.h>
#define TILE_H 16
#define TILE_W 32
#define KSIZE 11
#define STRIDE 4
#define PAD 2
#define OC_BLOCK 12
#define PATCH_H ((TILE_H - 1) * STRIDE + KSIZE)
#define PATCH_W ((TILE_W - 1) * STRIDE + KSIZE)
#define S_IN_FLOATS (((PATCH_H * PATCH_W) + 3) & ~3)
// Direct convolution kernel specialized for: in_channels=3, kernel=11x11,
// stride=4, padding=2. Each block computes a 16x32 tile of the output for
// one batch and a group of OC_BLOCK output channels. The block uses 128
// threads (16x8); each thread produces a 2x2 spatial register block
// (2 rows x 2 cols) for all OC_BLOCK channels, so every weight loaded from
// shared memory is reused for 4 FMAs and every shared input value feeds
// OC_BLOCK FMAs. This doubles the arithmetic intensity of the inner loop
// versus the previous 2x1 mapping (48 FMAs per 16 shared loads instead of
// 24 per 14), while the single-buffered input patch keeps the shared
// memory footprint at ~56 KB so two blocks fit per SM for latency hiding.
__global__ void conv2d_kernel(const float* __restrict__ input,
                              const float* __restrict__ weight,
                              const float* __restrict__ bias,
                              float* __restrict__ output,
                              int C_in, int H, int W,
                              int C_out, int H_out, int W_out)
{
    extern __shared__ float smem[];
    float* s_in = smem;
    float* s_w = s_in + S_IN_FLOATS;
    float* s_bias = s_w + OC_BLOCK * 3 * KSIZE * KSIZE;
    #define S_W(ocb, c, ky, kx) s_w[((((ocb) * 3 + (c)) * KSIZE + (ky)) * KSIZE + (kx))]
    #define S_BIAS(ocb) s_bias[(ocb)]
    const int n  = blockIdx.z;
    const int oc0 = blockIdx.y * OC_BLOCK;
    const int tiles_w = (W_out + TILE_W - 1) / TILE_W;
    const int ty0 = (blockIdx.x / tiles_w) * TILE_H;
    const int tx0 = (blockIdx.x % tiles_w) * TILE_W;
    const int tid = threadIdx.y * blockDim.x + threadIdx.x;
    const int nthreads = blockDim.x * blockDim.y;
    const int in_y0 = ty0 * STRIDE - PAD;
    const int in_x0 = tx0 * STRIDE - PAD;
    if (C_out - oc0 >= OC_BLOCK) {
        constexpr int W_VEC_COUNT = (OC_BLOCK * 3 * KSIZE * KSIZE) / 4;
        const float4* w4 = reinterpret_cast<const float4*>(
            weight + (long long)oc0 * 3 * KSIZE * KSIZE);
        float4* sw4 = reinterpret_cast<float4*>(s_w);
        for (int idx = tid; idx < W_VEC_COUNT; idx += nthreads) {
            sw4[idx] = w4[idx];
        }
    } else {
        for (int idx = tid; idx < OC_BLOCK * 3 * KSIZE * KSIZE; idx += nthreads) {
            const int ocb  = idx / (3 * KSIZE * KSIZE);
            const int rem  = idx % (3 * KSIZE * KSIZE);
            const int c    = rem / (KSIZE * KSIZE);
            const int rem2 = rem % (KSIZE * KSIZE);
            const int ky   = rem2 / KSIZE;
            const int kx   = rem2 % KSIZE;
            const int oc   = oc0 + ocb;
            float v = 0.0f;
            if (oc < C_out)
                v = weight[((oc * 3 + c) * KSIZE + ky) * KSIZE + kx];
            S_W(ocb, c, ky, kx) = v;
        }
    }
    if (tid < OC_BLOCK) {
        const int oc = oc0 + tid;
        S_BIAS(tid) = (oc < C_out) ? bias[oc] : 0.0f;
    }
