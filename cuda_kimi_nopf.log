<2><<<grid, THREADS, shmem_bytes, stream>>>(qp, kp, vp, op, B, H, S, D, scale); break;\n        case 4: sdpa_kernel<4><<<grid, THREADS, shmem_bytes, stream>>>(qp, kp, vp, op, B, H, S, D, scale); break;\n        case 6: sdpa_kernel<6><<<grid, THREADS, shmem_bytes, stream>>>(qp, kp, vp, op, B, H, S, D, scale); break;\n        case 8: sdpa_kernel<8><<<grid, THREADS, shmem_bytes, stream>>>(qp, kp, vp, op, B, H, S, D, scale); break;\n        default: TORCH_CHECK(false, "unsupported sequence_length");\n    }\n    return O;\n}\n\'\'\'\ncpp_src = "torch::Tensor sdpa_forward(torch::Tensor Q, torch::Tensor K, torch::Tensor V);"\n_mod = load_inline(\n    name="custom_sdpa_single_kernel",\n    cpp_sources=cpp_src,\n    cuda_sources=cuda_src,\n    functions=["sdpa_forward"],\n    extra_cuda_cflags=["-O3", "--use_fast_math"],\n    verbose=False,\n)\nclass ModelNew(nn.Module):\n    def __init__(self):\n        super(ModelNew, self).__init__()\n    def forward(self, Q: torch.Tensor, K: torch.Tensor, V: torch.Tensor) -> torch.Tensor:\n        return _mod.sdpa_forward(Q, K, V)', 'best_passed_depth': 5, 'best_passed_time': {'mean': 0.186, 'std': 0.00858, 'min': 0.179, 'max': 0.212, 'num_trials': 100}, 'best_passed_nsight_metrics': {}, 'kernel_backend': 'cuda', 'compile': '', 'correct': ''}
