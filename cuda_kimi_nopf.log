    const int D2 = (int)xc.size(2);
    auto out = torch::empty({B, D2}, xc.options());
    const long long n = (long long)B * D2;
    if (n == 0) return out;
    auto stream = at::cuda::getCurrentCUDAStream();
    const int tpb = 256;
    const unsigned int nblk = (unsigned int)((n + tpb - 1) / tpb);
    init_out_kernel<<<nblk, tpb, 0, stream>>>(out.data_ptr<float>(), n);
    const int h = (D2 % 4 == 0) ? 4 : ((D2 % 2 == 0) ? 2 : 1);
    const long long T = D2 / h;
    dim3 grid((unsigned int)((T + tpb - 1) / tpb), (unsigned int)B);
    max_reduce_dim1_kernel<<<grid, tpb, 0, stream>>>(
        xc.data_ptr<float>(), out.data_ptr<float>(), D1, D2);
    unmap_out_kernel<<<nblk, tpb, 0, stream>>>(out.data_ptr<float>(), n);
    C10_CUDA_KERNEL_LAUNCH_CHECK();
