    const int n_end = (int)((1LL * N * (r + 1)) / SPLIT);
    double local_sum = 0.0;
    double local_sumsq = 0.0;
    if (vec4) {
        const long long HW4 = HW >> 2;
        const long long chan4 = 1LL * C * HW4;
        const float4* cbase = reinterpret_cast<const float4*>(x) + 1LL * c * HW4;
        for (int n = n_begin; n < n_end; ++n) {
            const float4* base = cbase + 1LL * n * chan4;
            long long v = tid;
            for (; v + 3LL * THREADS < HW4; v += 4LL * THREADS) {
                const float4 va = base[v];
                const float4 vb = base[v + THREADS];
                const float4 vc = base[v + 2LL * THREADS];
                const float4 vd = base[v + 3LL * THREADS];
                local_sum += (double)va.x + (double)va.y + (double)va.z + (double)va.w +
                             (double)vb.x + (double)vb.y + (double)vb.z + (double)vb.w +
                             (double)vc.x + (double)vc.y + (double)vc.z + (double)vc.w +
                             (double)vd.x + (double)vd.y + (double)vd.z + (double)vd.w;
                local_sumsq += (double)va.x * (double)va.x + (double)va.y * (double)va.y +
                               (double)va.z * (double)va.z + (double)va.w * (double)va.w +
                               (double)vb.x * (double)vb.x + (double)vb.y * (double)vb.y +
                               (double)vb.z * (double)vb.z + (double)vb.w * (double)vb.w +
                               (double)vc.x * (double)vc.x + (double)vc.y * (double)vc.y +
                               (double)vc.z * (double)vc.z + (double)vc.w * (double)vc.w +
                               (double)vd.x * (double)vd.x + (double)vd.y * (double)vd.y +
                               (double)vd.z * (double)vd.z + (double)vd.w * (double)vd.w;
            }
            for (; v < HW4; v += THREADS) {
                const float4 val = base[v];
                local_sum += (double)val.x + (double)val.y + (double)val.z + (double)val.w;
                local_sumsq += (double)val.x * (double)val.x +
                               (double)val.y * (double)val.y +
                               (double)val.z * (double)val.z +
                               (double)val.w * (double)val.w;
            }
        }
    } else {
        for (int n = n_begin; n < n_end; ++n) {
            const float* base = x + (1LL * n * C + c) * HW;
            long long s = tid;
            for (; s + 3LL * THREADS < HW; s += 4LL * THREADS) {
                const float va = base[s];
                const float vb = base[s + THREADS];
                const float vc = base[s + 2LL * THREADS];
                const float vd = base[s + 3LL * THREADS];
                local_sum += (double)va + (double)vb + (double)vc + (double)vd;
                local_sumsq += (double)va * (double)va + (double)vb * (double)vb +
                               (double)vc * (double)vc + (double)vd * (double)vd;
            }
