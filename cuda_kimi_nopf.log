#include <torch/extension.h>
#include <ATen/cuda/CUDAContext.h>
#include <cuda_runtime.h>

__global__ void conv3d_im2col_gemm_c3k3_kernel(
    const float* __restrict__ x,
    const float* __restrict__ w,
    const float* __restrict__ b,
    float* __restrict__ y,
    const int N, const int C, const int D, const int H, const int W,
    const int OC, const int OD, const int OH, const int OW,
    const int K, const int stride, const int pad, const int dilation,
    const int groups, const int has_bias)
{
    // Structural rewrite: implicit-GEMM tiling for the benchmarked
    // C==3, K==3, stride==1, pad==0, dilation==1, groups==1 case.
    // Rows are flattened (n, od, oh, ow); columns are output channels.
    // Warp lanes are mapped to consecutive spatial rows so NCDHW stores
    // coalesce, while the 81-deep reduction is fully staged in shared memory.
    constexpr int BM = 128;
    constexpr int BN = 16;
    constexpr int KK = 81;
    __shared__ float sA[BM][KK];
    __shared__ float sB[BN][KK];
    const int tx = threadIdx.x;
    const int ty = threadIdx.y;
    const int tid = ty * 32 + tx;
    const long long S = (long long)OD * OH * OW;
    const long long M = (long long)N * S;
    const long long row0 = (long long)blockIdx.x * BM;
    const int oc0 = blockIdx.y * BN;
    for (int e = tid; e < BN * KK; e += 256) {
        const int oc = e / KK;
        const int kk = e % KK;
        const int goc = oc0 + oc;
        sB[oc][kk] = (goc < OC) ? w[(long long)goc * KK + kk] : 0.0f;
    }
    const int HW = H * W;
    const int OHW = OH * OW;
    for (int e = tid; e < BM * KK; e += 256) {
        const int r = e / KK;
        const int kk = e % KK;
        const long long row = row0 + r;
        float v = 0.0f;
        if (row < M) {
            const long long n = row / S;
            const long long s = row - n * S;
            const int od = (int)(s / OHW);
            const int rem = (int)(s - (long long)od * OHW);
            const int oh = rem / OW;
            const int ow = rem - oh * OW;
            const int c = kk / 27;
            const int krem = kk - c * 27;
            const int kz = krem / 9;
            const int ky = (krem - kz * 9) / 3;
            const int kx = krem - kz * 9 - ky * 3;
            const long long xbase = (((long long)n * 3 + c) * D + (od + kz)) * HW;
            v = x[xbase + (long long)(oh + ky) * W + (ow + kx)];
        }
        sA[r][kk] = v;
    }
    __syncthreads();
    float acc[4][2];
    #pragma unroll
    for (int i = 0; i < 4; ++i) {
        acc[i][0] = has_bias ? b[oc0 + ty * 2] : 0.0f;
        acc[i][1] = (has_bias && oc0 + ty * 2 + 1 < OC) ? b[oc0 + ty * 2 + 1] : 0.0f;
    }
    const int c0 = ty * 2;
    const int c1 = c0 + 1;
    #pragma unroll 1
    for (int kk = 0; kk < KK; ++kk) {
        const float b0 = sB[c0][kk];
        const float b1 = sB[c1][kk];
        #pragma unroll
        for (int i = 0; i < 4; ++i) {
            const float a = sA[tx + 32 * i][kk];
            acc[i][0] += a * b0;
            acc[i][1] += a * b1;
        }
    }
    #pragma unroll
    for (int i = 0; i < 4; ++i) {
        const long long row = row0 + tx + 32 * i;
        if (row < M) {
            const long long n = row / S;
            const long long s = row - n * S;
            const long long out_base = (long long)n * OC * S + s;
            const int goc0 = oc0 + c0;
            const int goc1 = oc0 + c1;
            if (goc0 < OC) y[out_base + (long long)goc0 * S] = acc[i][0];
            if (goc1 < OC) y[out_base + (long long)goc1 * S] = acc[i][1];
        }
    }
}
__global__ void conv3d_forward_kernel(
    const float* __restrict__ x,
    const float* __restrict__ w,
    const float* __restrict__ b,
    float* __restrict__ y,
    const int N, const int C, const int D, const int H, const int W,
    const int OC, const int OD, const int OH, const int OW,
    const int K, const int stride, const int pad, const int dilation,
    const int groups, const int has_bias)
{
    const long long idx = (long long)blockIdx.x * blockDim.x + threadIdx.x;
    const long long total = (long long)N * OC * OD * OH * OW;
    if (idx >= total) return;
    long long t = idx;
    const int ow = (int)(t % OW); t /= OW;
    const int oh = (int)(t % OH); t /= OH;
    const int od = (int)(t % OD); t /= OD;
    const int oc = (int)(t % OC); t /= OC;
    const int n  = (int)t;
    float sum = has_bias ? b[oc] : 0.0f;
    const int cpg = C / groups;
    const int ocpg = OC / groups;
    const int g = oc / ocpg;
    const int c_start = g * cpg;
