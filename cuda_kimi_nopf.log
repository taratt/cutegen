nt sm_count = 0;\n    cudaDeviceGetAttribute(&sm_count, cudaDevAttrMultiProcessorCount, dev);\n\n    int max_blocks_per_sm = 0;\n    size_t shmem = (size_t)(BLOCK / 32) * sizeof(T);\n    cudaOccupancyMaxActiveBlocksPerMultiprocessor(\n        &max_blocks_per_sm, ln_persistent_kernel<T, BLOCK>, BLOCK, shmem);\n    if (max_blocks_per_sm < 1) max_blocks_per_sm = 1;\n    if (max_blocks_per_sm > 4) max_blocks_per_sm = 4;\n\n    int64_t want_blocks = (int64_t)sm_count * max_blocks_per_sm;\n    int num_blocks = (int)std::min<int64_t>(want_blocks, total_chunks);\n    if (num_blocks < 1) num_blocks = 1;\n\n    ln_persistent_kernel<T, BLOCK><<<num_blocks, BLOCK, shmem, stream.stream()>>>(\n        xc.data_ptr<T>(),\n        wc.data_ptr<T>(),\n        bc.data_ptr<T>(),\n        y.data_ptr<T>(),\n        acc.data_ptr<T>(),\n        bar.data_ptr<int>(),\n        outer,\n        N,\n        chunks_per_row,\n        total_chunks,\n        chunk_elems,\n        (T)eps,\n        vec_ok);\n\n    cudaError_t err = cudaGetLastError();\n    TORCH_CHECK(err == cudaSuccess, "CUDA kernel launch failed: ", cudaGetErrorString(err));\n    return y;\n}\n\nat::Tensor ln_forward(at::Tensor x, at::Tensor weight, at::Tensor bias, double eps) {\n    TORCH_CHECK(x.is_cuda() && weight.is_cuda() && bias.is_cuda(), "inputs must be CUDA tensors");\n    TORCH_CHECK(x.scalar_type() == weight.scalar_type() && x.scalar_type() == bias.scalar_type(),\n                "x, weight and bias must have the same dtype");\n    if (x.scalar_type() == at::kFloat) {\n        return ln_forward_t<float>(x, weight, bias, eps);\n    }\n    if (x.scalar_type() == at::kDouble) {\n        return ln_forward_t<double>(x, weight, bias, eps);\n    }\n    TORCH_CHECK(false, "only float and double are supported");\n}\n"""\n\n_C = load_inline(\n    name="custom_layernorm_persistent",\n    cpp_sources=_cpp_src,\n    cuda_sources=_cuda_src,\n    functions=["ln_forward"],\n    extra_cuda_cflags=["-O3"],\n    verbose=False,\n)\n\n\nclass