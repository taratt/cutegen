        float ev[NJ];
        float sum = 0.0f;
        #pragma unroll
        for (int i = 0; i < NJ; ++i) {
            ev[i] = __expf(__half2float(srow[lane + (i << 5)]) - mx);
            sum += ev[i];
        }
