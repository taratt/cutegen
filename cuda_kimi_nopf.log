        bn_norm_kernel<<<grid, block, 0, stream>>>(
            xc.data_ptr<float>(),
            y.data_ptr<float>(),
            g.data_ptr<float>(),
            b.data_ptr<float>(),
            psum.data_ptr<double>(),
            psq.data_ptr<double>(),
            rm.data_ptr<float>(),
            rv.data_ptr<float>(),
            N, C, H, W,
            true,
            (float)momentum,
            (float)eps
        );
    } else {
        bn_norm_kernel<<<grid, block, 0, stream>>>(
            xc.data_ptr<float>(),
            y.data_ptr<float>(),
            g.data_ptr<float>(),
            b.data_ptr<float>(),
            nullptr,
            nullptr,
            rm.data_ptr<float>(),
            rv.data_ptr<float>(),
            N, C, H, W,
            false,
            (float)momentum,
            (float)eps
        );
    }
    }
    return y;
}
