per block and reuse it across OC_BLOCK.\n    for (int idx = tid; idx < 3 * PATCH * PATCH; idx += nthreads) {\n        const int c   = idx / (PATCH * PATCH);\n        const int rem = idx % (PATCH * PATCH);\n        const int r   = rem / PATCH;\n        const int col = rem % PATCH;\n        const int iy = in_y0 + r;\n        const int ix = in_x0 + col;\n        float v = 0.0f;\n        if (iy >= 0 && iy < H && ix >= 0 && ix < W)\n            v = input[((n * C_in + c) * H + iy) * W + ix];\n        S_IN(c, r, col) = v;\n    }\n    // Cooperatively load this block\'s group of filters.\n    for (int idx = tid; idx < OC_BLOCK * 3 * KSIZE * KSIZE; idx += nthreads) {\n        const int ocb  = idx / (3 * KSIZE * KSIZE);\n        const int rem  = idx % (3 * KSIZE * KSIZE);\n        const int c    = rem / (KSIZE * KSIZE);\n        const int rem2 = rem % (KSIZE * KSIZE);\n        const int ky   = rem2 / KSIZE;\n        const int kx   = rem2 % KSIZE;\n        const int oc   = oc0 + ocb;\n        float v = 0.0f;\n        if (oc < C_out)\n            v = weight[((oc * 3 + c) * KSIZE + ky) * KSIZE + kx];\n        S_W(ocb, c, ky, kx) = v;\n    }\n    if (tid < OC_BLOCK) {\n        const int oc = oc0 + tid;\n        S_BIAS(tid) = (oc < C_out) ? bias[oc] : 0.0f;\n    }\n    __syncthreads();\n    const int oh = ty0 + threadIdx.y;\n    const int ow = tx0 + threadIdx.x;\n    if (oh < H_out && ow < W_out) {\n        float acc[OC_BLOCK];\n        #pragma unroll\n        for (int ocb = 0; ocb < OC_BLOCK; ++ocb) {\n            acc[ocb] = S_BIAS(ocb);\n        }\n        const int by = threadIdx.y * STRIDE;\n        const int bx = threadIdx.x * STRIDE;\n        #pragma unroll\n        for (int c = 0; c < 3; ++c) {\n            #pragma unroll\n            for (int ky = 0; ky < KSIZE; ++ky) {\n                #pragma unroll\n                for (int kx = 0; kx < KSIZE; ++kx) {\n                    const float iv = S_IN(c, by + ky, bx + kx);\n                    #pragma unroll\n                  