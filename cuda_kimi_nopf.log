 reinterpret_cast<__half2*>(sQ)[rr * (KSTR >> 1) + cc] = qg[(size_t)rr * (size_t)Dh2 + cc];\n            }\n        }\n        {\n            const int W = DK >> 1;\n            const int total = S * W;\n            const __half2* kg = reinterpret_cast<const __half2*>(k) + (d0 >> 1);\n            for (int idx = tid; idx < total; idx += THREADS) {\n                const int rr = idx / W;\n                const int cc = idx - rr * W;\n                reinterpret_cast<__half2*>(sK)[rr * (KSTR >> 1) + cc] = kg[(size_t)rr * (size_t)Dh2 + cc];\n            }\n        }\n        __syncthreads();\n        const __half2* q2 = reinterpret_cast<const __half2*>(sQ + r * KSTR);\n        #pragma unroll 4\n        for (int jj = 0; jj < NJ; ++jj) {\n            const __half2* k2 = reinterpret_cast<const __half2*>(sK + (jj * TPR + lane) * KSTR);\n            float dot = 0.0f;\n            #pragma unroll 8\n            for (int d2 = 0; d2 < (DK >> 1); ++d2) {\n                const float2 qf = __half22float2(q2[d2]);\n                const float2 kf = __half22float2(k2[d2]);\n                dot = fmaf(qf.x, kf.x, dot);\n                dot = fmaf(qf.y, kf.y, dot);\n            }\n            sacc[jj] += dot;\n        }\n        __syncthreads();\n    }\n    // Softmax: TPR lanes cooperate on one query row.\n    float mx = -INFINITY;\n    #pragma unroll\n    for (int jj = 0; jj < NJ; ++jj) mx = fmaxf(mx, sacc[jj]);\n    #pragma unroll\n    for (int off = 1; off < TPR; off <<= 1)\n        mx = fmaxf(mx, __shfl_xor_sync(0xffffffffu, mx, off));\n    float sum = 0.0f;\n    #pragma unroll\n    for (int jj = 0; jj < NJ; ++jj) {\n        const float e = expf((sacc[jj] - mx) * scale);\n        sacc[jj] = e;\n        sum += e;\n    }\n    #pragma unroll\n    for (int off = 1; off < TPR; off <<= 1)\n        sum += __shfl_xor_sync(0xffffffffu, sum, off);\n    const float inv_sum = 1.0f / sum;\n    const int PSTR = S + PADP;\n    #pragma unroll\n    for (int jj = 0; jj < NJ; ++jj)\n        sP[r *