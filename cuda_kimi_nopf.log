import torch
import torch.nn as nn
from torch.utils.cpp_extension import load_inline

_cpp_src = r"""
#include <torch/extension.h>
torch::Tensor conv3d_forward(torch::Tensor x, torch::Tensor weight, torch::Tensor bias,
                             int64_t stride, int64_t padding, int64_t dilation, int64_t groups);
"""

_cuda_src = r"""
#include <torch/extension.h>
#include <ATen/cuda/CUDAContext.h>
#include <cuda_runtime.h>

__global__ void conv3d_im2col_gemm_c3k3_kernel(
    const float* __restrict__ x,
    const float* __restrict__ w,
    const float* __restrict__ b,
    float* __restrict__ y,
    const int N, const int C, const int D, const int H, const int W,
    const int OC, const int OD, const int OH, const int OW,
    const int K, const int stride, const int pad, const int dilation,
    const int groups, const int has_bias)
{
    // Implicit-GEMM for the C==3, K==3, stride==1, pad==0, dilation==1,
    // groups==1 case. Rows are flattened (n, od, oh, ow); columns are
    // output channels. 128 threads compute a 128x64 output tile with an
    // 8x8 register-blocked fragment per thread, so each shared-memory
    // operand load feeds 8 FMAs. The 81-tap reduction is staged as three
    // 27-tap input-channel slices in shared memory; slice c+1 is
    // software-pipelined: it is prefetched into registers while slice c
    // is consumed by the FMA loop, then committed to a double-buffered
    // shared-memory stage, so global-load latency overlaps compute.
    constexpr int BM = 128;
    constexpr int BN = 64;
    constexpr int BK = 27;
    __shared__ float sA[2][BM][BK];
    __shared__ float sB[2][BN][BK];
    const int tx = threadIdx.x;
    const int ty = threadIdx.y;
    const int tid = ty * 16 + tx;
    const long long S = (long long)OD * OH * OW;
    const long long M = (long long)N * S;
    const long long row0 = (long long)blockIdx.x * BM;
    const int oc0 = blockIdx.y * BN;
    const int HW = H * W;
    const int OHW = OH * OW;
    float acc[8][8];
    #pragma unroll
    for (int i = 0; i < 8; ++i) {
        #pragma unroll
        for (int j = 0; j < 8; ++j) {
            acc[i][j] = 0.0f;
        }
    }
    // Cooperative staging: thread tid stages row tid of the A tile.
    const long long row = row0 + tid;
    const bool row_ok = row < M;
    long long rn = 0;
    int rod = 0;
    int roh = 0;
    int row_w = 0;
    if (row_ok) {
        rn = row / S;
        const long long rs = row - rn * S;
        rod = (int)(rs / OHW);
        const int rem = (int)(rs - (long long)rod * OHW);
        roh = rem / OW;
        row_w = rem - roh * OW;
    }
    // Register staging buffers for the software pipeline.
