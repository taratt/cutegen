            y.data_ptr<float>(),
            g.data_ptr<float>(),
            b.data_ptr<float>(),
            psum.data_ptr<double>(),
            psq.data_ptr<double>(),
            rm.data_ptr<float>(),
            rv.data_ptr<float>(),
            N, C, H, W,
            true,
            (float)momentum,
            (float)eps
        );
    } else {
