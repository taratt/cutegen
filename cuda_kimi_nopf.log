import torch.nn as nn
from torch.utils.cpp_extension import load_inline
_cuda_src = r"""
#include <torch/extension.h>
#include <ATen/cuda/CUDAContext.h>
#include <cuda_runtime.h>
#include <float.h>
#include <stdint.h>
__global__ void min_dim1_kernel(const float* __restrict__ x,
                                float* __restrict__ out,
                                int B, int M, int N,
                                long long total) {
    // Flatten the (B, N) output space into one 1D index space. This avoids
    // the pathological final 512-thread block that contained only a single
    // valid column when N == 4095, and gives one simple exact bounds check.
    const long long stride = (long long)N;
    const long long grid_stride = (long long)blockDim.x * (long long)gridDim.x;
    for (long long idx = (long long)blockIdx.x * blockDim.x + threadIdx.x;
         idx < total; idx += grid_stride) {
        const int b = (int)(idx / stride);
        const int j = (int)(idx - (long long)b * stride);
        const float* p = x + ((size_t)b * (size_t)M) * (size_t)stride + (size_t)j;
        float mn = FLT_MAX;
        int i = 0;
        for (; i + 7 < M; i += 8) {
            const float v0 = __ldg(p + (size_t)(i + 0) * (size_t)stride);
            const float v1 = __ldg(p + (size_t)(i + 1) * (size_t)stride);
            const float v2 = __ldg(p + (size_t)(i + 2) * (size_t)stride);
            const float v3 = __ldg(p + (size_t)(i + 3) * (size_t)stride);
            const float v4 = __ldg(p + (size_t)(i + 4) * (size_t)stride);
            const float v5 = __ldg(p + (size_t)(i + 5) * (size_t)stride);
            const float v6 = __ldg(p + (size_t)(i + 6) * (size_t)stride);
            const float v7 = __ldg(p + (size_t)(i + 7) * (size_t)stride);
            mn = fminf(mn, fminf(fminf(fminf(v0, v1), fminf(v2, v3)),
                                 fminf(fminf(v4, v5), fminf(v6, v7))));
        }
        for (; i < M; ++i) {
            mn = fminf(mn, __ldg(p + (size_t)i * (size_t)stride));
        }
        out[(size_t)idx] = mn;
    }
}
torch::Tensor min_dim1_cuda(torch::Tensor x) {
    TORCH_CHECK(x.is_cuda(), "x must be CUDA");
    TORCH_CHECK(x.dim() == 3, "x must be 3D");
    TORCH_CHECK(x.scalar_type() == at::kFloat, "x must be float32");
    TORCH_CHECK(x.is_contiguous(), "x must be contiguous");
    const int B = (int)x.size(0);
    const int M = (int)x.size(1);
    const int N = (int)x.size(2);
    auto out = torch::empty({B, N}, x.options());
    const long long total = (long long)B * (long long)N;
    if (total == 0) return out;
    const dim3 block(256);
    const dim3 grid((unsigned)((total + (long long)block.x - 1) / (long long)block.x));
    auto stream = at::cuda::getCurrentCUDAStream();
    min_dim1_kernel<<<grid, block, 0, stream>>>(
        x.data_ptr<float>(),
        out.data_ptr<float>(),
        B, M, N, total
    );
    return out;
}
"""
_cpp_src = "torch::Tensor min_dim1_cuda(torch::Tensor x);"
_min_mod = load_inline(
    name="min_dim1_ext",
    cpp_sources=_cpp_src,
    cuda_sources=_cuda_src,
    functions=["min_dim1_cuda"],
    extra_cuda_cflags=["-O3"],
    verbose=False,
)
class ModelNew(nn.Module):
    def __init__(self, dim: int):
        super().__init__()
        self.dim = dim
    def forward(self, x: torch.Tensor) -> torch.Tensor:
        d = self.dim if self.dim >= 0 else x.dim() + self.dim
        if x.dim() == 3 and d == 1 and x.dtype == torch.float32:
            x = x.contiguous()
            if not x.is_cuda:
                x = x.cuda()
            return _min_mod.min_dim1_cuda(x)
        return torch.min(x, dim=self.dim)[0]
