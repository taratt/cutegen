        out = _bn_ext.bn_forward_cuda(
            x,
            self.weight,
            self.bias,
            self.running_mean,
            self.running_var,
            self.training,
            self.momentum,
            self.eps,
        )
        if self.training:
            with torch.no_grad():
                self.num_batches_tracked += 1
        return out
