            const float b = S_BIAS(ocb);
            if (valid00)
                output[((n * C_out + oc) * H_out + oh0) * W_out + ow0] = acc00[ocb] + b;
            if (valid01)
                output[((n * C_out + oc) * H_out + oh0) * W_out + ow1] = acc01[ocb] + b;
            if (valid10)
                output[((n * C_out + oc) * H_out + oh1) * W_out + ow0] = acc10[ocb] + b;
            if (valid11)
