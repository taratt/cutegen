    const long long nv4_est = (((long long)D1 * D2) + 3) >> 2;
    const long long groups_per_col = (T > 0) ? (nv4_est / T) : 0;
    unsigned int zs = 1;
    if (groups_per_col < 1024) {
        zs = 4;
        while (zs > 1 && nv4_est / (long long)zs < 4LL * T) zs >>= 1;
    }
    dim3 grid((unsigned int)((T + tpb - 1) / tpb), (unsigned int)B, zs);
    max_reduce_dim1_kernel<<<grid, tpb, 0, stream>>>(
        xc.data_ptr<float>(), out.data_ptr<float>(), D1, D2);
    unmap_out_kernel<<<nblk, tpb, 0, stream>>>(out.data_ptr<float>(), n);
    C10_CUDA_KERNEL_LAUNCH_CHECK();
    return out;
}
"""
