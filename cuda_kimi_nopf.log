#include <torch/extension.h>
#include <ATen/cuda/CUDAContext.h>
#include <cuda_runtime.h>
#include <cstdint>
// Max reduction over dim=1 of a contiguous (B, D1, D2) float32 tensor.
// Optimization: vectorized 16-byte float4 streaming loads. Each batch's
// (D1, D2) plane is treated as one flat float4 array (a short scalar
// head/tail fixes pointer alignment and divisibility), so all loads are
// fully aligned and coalesced regardless of whether D2 is odd. A thread's
// float4-group stride T is a multiple of D2/gcd(4, D2), which keeps
// (head + 4*g) mod D2 invariant, so every thread owns a fixed set of 4
// output columns. Partial maxima are merged with a single round of
// order-preserving unsigned atomicMax per thread, bracketed by tiny
// init/unmap passes over the (B, D2) output.
__device__ __forceinline__ unsigned int f2u_ordered(float f) {
    unsigned int u = __float_as_uint(f);
    return (u & 0x80000000u) ? ~u : (u | 0x80000000u);
}
__device__ __forceinline__ float u2f_ordered(unsigned int u) {
    u = (u & 0x80000000u) ? (u & 0x7FFFFFFFu) : ~u;
    return __uint_as_float(u);
}
__global__ void init_out_kernel(float* __restrict__ out, long long n) {
    const long long i = (long long)blockIdx.x * blockDim.x + threadIdx.x;
    if (i < n) out[i] = __uint_as_float(0x007FFFFFu);  // ordered(-inf)
}
__global__ void unmap_out_kernel(float* __restrict__ out, long long n) {
    const long long i = (long long)blockIdx.x * blockDim.x + threadIdx.x;
    if (i < n) out[i] = u2f_ordered(__float_as_uint(out[i]));
}
__global__ void max_reduce_dim1_kernel(const float* __restrict__ x,
                                       float* __restrict__ out,
                                       int D1, int D2) {
    const int b = blockIdx.y;
    const long long L = (long long)D1 * D2;
    const float* base = x + (long long)b * L;
    const int mis = (int)(((uintptr_t)base >> 2) & 3);
    long long head = (4 - mis) & 3;
    if (head > L) head = L;
    const long long nv4 = (L - head) >> 2;
    const long long tail = (L - head) - 4 * nv4;
    const int h = (D2 % 4 == 0) ? 4 : ((D2 % 2 == 0) ? 2 : 1);
    const long long T = D2 / h;  // group stride preserving column phase
    const long long t0 = (long long)blockIdx.x * blockDim.x + threadIdx.x;
    float* ob = out + (long long)b * D2;
    if (t0 == 0 && blockIdx.z == 0) {
        for (long long e = 0; e < head; ++e) {
            const int col = (int)(e % D2);
            atomicMax((unsigned int*)(ob + col), f2u_ordered(__ldcs(base + e)));
        }
        for (long long e = 0; e < tail; ++e) {
            const long long pos = L - tail + e;
            const int col = (int)(pos % D2);
            atomicMax((unsigned int*)(ob + col), f2u_ordered(__ldcs(base + pos)));
        }
    }
    if (t0 >= T) return;
    const float4* base4 = reinterpret_cast<const float4*>(base + head);
    const long long chunk = (nv4 + (long long)gridDim.z - 1) / (long long)gridDim.z;
    const long long g0 = chunk * (long long)blockIdx.z + t0;
    long long gend = chunk * (long long)(blockIdx.z + 1);
    if (gend > nv4) gend = nv4;
    if (g0 >= gend) return;
    const int r = (int)((head + 4 * g0) % D2);
    int c1 = r + 1; while (c1 >= D2) c1 -= D2;
    int c2 = r + 2; while (c2 >= D2) c2 -= D2;
    int c3 = r + 3; while (c3 >= D2) c3 -= D2;
    float a0 = -INFINITY;
    float a1 = -INFINITY;
    float a2 = -INFINITY;
    float a3 = -INFINITY;
    long long g = g0;
    for (; g + 15 * T < gend; g += 16 * T) {
        float4 v[16];
        #pragma unroll
        for (int i = 0; i < 16; ++i) {
            v[i] = __ldcs(base4 + g + (long long)i * T);
        }
        #pragma unroll
        for (int i = 0; i < 16; ++i) {
            a0 = fmaxf(a0, v[i].x);
            a1 = fmaxf(a1, v[i].y);
            a2 = fmaxf(a2, v[i].z);
            a3 = fmaxf(a3, v[i].w);
        }
    }
    for (; g < gend; g += T) {
        const float4 v = __ldcs(base4 + g);
        a0 = fmaxf(a0, v.x);
        a1 = fmaxf(a1, v.y);
        a2 = fmaxf(a2, v.z);
        a3 = fmaxf(a3, v.w);
    }
    atomicMax((unsigned int*)(ob + r),  f2u_ordered(a0));
    atomicMax((unsigned int*)(ob + c1), f2u_ordered(a1));
    atomicMax((unsigned int*)(ob + c2), f2u_ordered(a2));
