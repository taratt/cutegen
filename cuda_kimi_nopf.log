import torch
import torch.nn as nn
from torch.utils.cpp_extension import load_inline

_cpp_src = r"""
#include <torch/extension.h>
torch::Tensor conv3d_forward(torch::Tensor x, torch::Tensor weight, torch::Tensor bias,
                             int64_t stride, int64_t padding, int64_t dilation, int64_t groups);
"""

_cuda_src = r"""
#include <torch/extension.h>
#include <ATen/cuda/CUDAContext.h>
#include <cuda_runtime.h>

__global__ void conv3d_im2col_gemm_c3k3_kernel(
    const float* __restrict__ x,
    const float* __restrict__ w,
    const float* __restrict__ b,
    float* __restrict__ y,
    const int N, const int C, const int D, const int H, const int W,
    const int OC, const int OD, const int OH, const int OW,
    const int K, const int stride, const int pad, const int dilation,
    const int groups, const int has_bias)
{
    // Implicit-GEMM for the C==3, K==3, stride==1, pad==0, dilation==1,
    // groups==1 case. Rows are flattened (n, od, oh, ow); columns are
    // output channels. 128 threads compute a 128x64 output tile with an
    // 8x8 register-blocked fragment per thread, so each shared-memory
    // operand load feeds 8 FMAs. The 81-tap reduction is staged as three
    // 27-tap input-channel slices in shared memory.
    constexpr int BM = 128;
    constexpr int BN = 64;
    constexpr int BK = 27;
    __shared__ float sA[BM][BK];
    __shared__ float sB[BN][BK];
    const int tx = threadIdx.x;
    const int ty = threadIdx.y;
    const int tid = ty * 16 + tx;
    const long long S = (long long)OD * OH * OW;
    const long long M = (long long)N * S;
    const long long row0 = (long long)blockIdx.x * BM;
    const int oc0 = blockIdx.y * BN;
    const int HW = H * W;
    const int OHW = OH * OW;
    float acc[8][8];
    #pragma unroll
    for (int i = 0; i < 8; ++i) {
        #pragma unroll
        for (int j = 0; j < 8; ++j) {
            acc[i][j] = 0.0f;
        }
    }
    // Cooperative staging: thread tid stages row tid of the A tile.
    const long long row = row0 + tid;
    const bool row_ok = row < M;
    long long rn = 0;
    int rod = 0;
    int roh = 0;
    int row_w = 0;
    if (row_ok) {
        rn = row / S;
        const long long rs = row - rn * S;
        rod = (int)(rs / OHW);
        const int rem = (int)(rs - (long long)rod * OHW);
        roh = rem / OW;
        row_w = rem - roh * OW;
    }
    for (int c = 0; c < 3; ++c) {
        // Stage one input-channel slice (27 taps) of B and A.
        if (tid < BN) {
            const int goc = oc0 + tid;
            const bool ok = goc < OC;
            const long long wbase = (long long)goc * 81 + c * BK;
            #pragma unroll
            for (int kk = 0; kk < BK; ++kk) {
                sB[tid][kk] = ok ? w[wbase + kk] : 0.0f;
            }
        }
        const long long xbase = (((long long)rn * 3 + c) * D + rod) * HW;
        #pragma unroll
        for (int kk = 0; kk < BK; ++kk) {
            float v = 0.0f;
            if (row_ok) {
                const int kz = kk / 9;
                const int ky = (kk - kz * 9) / 3;
                const int kx = kk - kz * 9 - ky * 3;
                v = x[xbase + (long long)kz * HW + (long long)(roh + ky) * W + (row_w + kx)];
            }
            sA[tid][kk] = v;
        }
        __syncthreads();
        #pragma unroll
        for (int kk = 0; kk < BK; ++kk) {
            float av[8];
            float bv[8];
            #pragma unroll
            for (int i = 0; i < 8; ++i) av[i] = sA[tx + 16 * i][kk];
            #pragma unroll
            for (int j = 0; j < 8; ++j) bv[j] = sB[ty + 8 * j][kk];
            #pragma unroll
            for (int i = 0; i < 8; ++i) {
                #pragma unroll
                for (int j = 0; j < 8; ++j) {
                    acc[i][j] += av[i] * bv[j];
                }
            }
        }
        __syncthreads();
    }
    #pragma unroll
    for (int i = 0; i < 8; ++i) {
        const long long r = row0 + tx + 16 * i;
        if (r < M) {
            const long long n = r / S;
            const long long s = r - n * S;
            const long long out_base = (long long)n * OC * S + s;
            #pragma unroll
            for (int j = 0; j < 8; ++j) {
                const int goc = oc0 + ty + 8 * j;
                if (goc < OC) {
                    float v = acc[i][j];
                    if (has_bias) v += b[goc];
                    y[out_base + (long long)goc * S] = v;
                }
            }
        }
    }
}
__global__ void conv3d_forward_kernel(
    const float* __restrict__ x,
    const float* __restrict__ w,
    const float* __restrict__ b,
    float* __restrict__ y,
    const int N, const int C, const int D, const int H, const int W,
    const int OC, const int OD, const int OH, const int OW,
    const int K, const int stride, const int pad, const int dilation,
    const int groups, const int has_bias)
{
    const long long idx = (long long)blockIdx.x * blockDim.x + threadIdx.x;
    const long long total = (long long)N * OC * OD * OH * OW;
    if (idx >= total) return;
    long long t = idx;
    const int ow = (int)(t % OW); t /= OW;
    const int oh = (int)(t % OH); t /= OH;
    const int od = (int)(t % OD); t /= OD;
    const int oc = (int)(t % OC); t /= OC;
    const int n  = (int)t;
    float sum = has_bias ? b[oc] : 0.0f;
    const int cpg = C / groups;
    const int ocpg = OC / groups;
    const int g = oc / ocpg;
    const int c_start = g * cpg;
    for (int c = 0; c < cpg; ++c) {
        const int ic = c_start + c;
        for (int kz = 0; kz < K; ++kz) {
            const int id = od * stride - pad + kz * dilation;
            if (id < 0 || id >= D) continue;
            for (int ky = 0; ky < K; ++ky) {
                const int ih = oh * stride - pad + ky * dilation;
                if (ih < 0 || ih >= H) continue;
                const long long x_base = ((((long long)n * C + ic) * D + id) * H + ih) * W;
                const long long w_base = ((((long long)oc * cpg + c) * K + kz) * K + ky) * K;
                for (int kx = 0; kx < K; ++kx) {
                    const int iw = ow * stride - pad + kx * dilation;
                    if (iw < 0 || iw >= W) continue;
                    sum += x[x_base + iw] * w[w_base + kx];
                }
            }
        }
    }
    y[idx] = sum;
}
torch::Tensor conv3d_forward(torch::Tensor x, torch::Tensor weight, torch::Tensor bias,
                             int64_t stride, int64_t padding, int64_t dilation, int64_t groups)
{
    TORCH_CHECK(x.is_cuda(), "input must be CUDA");
    TORCH_CHECK(weight.is_cuda(), "weight must be CUDA");
    TORCH_CHECK(x.scalar_type() == torch::kFloat32, "input must be float32");
    TORCH_CHECK(weight.scalar_type() == torch::kFloat32, "weight must be float32");
    TORCH_CHECK(x.dim() == 5, "input must be NCDHW");
    TORCH_CHECK(weight.dim() == 5, "weight must be [OC, C/groups, K, K, K]");
    TORCH_CHECK(groups > 0, "groups must be positive");
    const int64_t N = x.size(0), C = x.size(1), D = x.size(2), H = x.size(3), W = x.size(4);
    const int64_t OC = weight.size(0), CPG = weight.size(1), K = weight.size(2);
    TORCH_CHECK(weight.size(3) == K && weight.size(4) == K, "kernel must be cubic");
    TORCH_CHECK(C % groups == 0 && OC % groups == 0, "invalid groups");
    TORCH_CHECK(CPG == C / groups, "weight/input channel mismatch");
    const bool has_bias = bias.defined() && bias.numel() == OC;
    if (has_bias) {
        TORCH_CHECK(bias.is_cuda(), "bias must be CUDA");
        TORCH_CHECK(bias.scalar_type() == torch::kFloat32, "bias must be float32");
    }
    const int64_t OD = (D + 2 * padding - dilation * (K - 1) - 1) / stride + 1;
    const int64_t OH = (H + 2 * padding - dilation * (K - 1) - 1) / stride + 1;
    const int64_t OW = (W + 2 * padding - dilation * (K - 1) - 1) / stride + 1;
    TORCH_CHECK(OD > 0 && OH > 0 && OW > 0, "invalid output size");
    auto y = torch::empty({N, OC, OD, OH, OW}, x.options());
    const long long total = (long long)N * OC * OD * OH * OW;
    if (total == 0) return y;
    const bool gemm_fast = (C == 3 && K == 3 && groups == 1 && stride == 1 &&
                            padding == 0 && dilation == 1 && D >= 3 && H >= 3 && W >= 3);
    if (gemm_fast) {
        const long long S = (long long)OD * OH * OW;
        const long long M = (long long)N * S;
        const long long gx_ll = (M + 127) / 128;
        const long long gy_ll = (OC + 63) / 64;
        TORCH_CHECK(gx_ll <= 2147483647LL, "too many row tiles");
        TORCH_CHECK(gy_ll <= 65535LL, "too many channel tiles");
        dim3 block(16, 8);
        dim3 grid((unsigned)gx_ll, (unsigned)gy_ll);
        conv3d_im2col_gemm_c3k3_kernel<<<grid, block, 0, at::cuda::getCurrentCUDAStream()>>>(
            x.data_ptr<float>(),
            weight.data_ptr<float>(),
            has_bias ? bias.data_ptr<float>() : nullptr,
            y.data_ptr<float>(),
            (int)N, (int)C, (int)D, (int)H, (int)W,
            (int)OC, (int)OD, (int)OH, (int)OW,
            (int)K, (int)stride, (int)padding, (int)dilation,
            (int)groups, has_bias ? 1 : 0
        );
    } else {
        const int threads = 256;
        const long long blocks_ll = (total + threads - 1) / threads;
        TORCH_CHECK(blocks_ll <= 2147483647LL, "too many blocks");
        const int blocks = (int)blocks_ll;
        conv3d_forward_kernel<<<blocks, threads, 0, at::cuda::getCurrentCUDAStream()>>>(
            x.data_ptr<float>(),
            weight.data_ptr<float>(),
            has_bias ? bias.data_ptr<float>() : nullptr,
            y.data_ptr<float>(),
            (int)N, (int)C, (int)D, (int)H, (int)W,
            (int)OC, (int)OD, (int)OH, (int)OW,
            (int)K, (int)stride, (int)padding, (int)dilation,
            (int)groups, has_bias ? 1 : 0
        );
    }
    C10_CUDA_KERNEL_LAUNCH_CHECK();
    return y;
}
"""

_conv3d_ext = load_inline(
    name="custom_conv3d_direct_ext",
    cpp_sources=_cpp_src,
    cuda_sources=_cuda_src,
    functions=["conv3d_forward"],
    extra_cuda_cflags=["-O3"],
