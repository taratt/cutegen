    const unsigned gx = (unsigned)((N + 63) / 64);
    const unsigned gy = (unsigned)(B < 65535 ? B : 65535);
    const dim3 grid(gx, gy);
    auto stream = at::cuda::getCurrentCUDAStream();
    min_dim1_kernel<<<grid, block, 0, stream>>>(
