import torch.nn as nn
from torch.utils.cpp_extension import load_inline
cuda_src = r"""
#include <torch/extension.h>
#include <ATen/cuda/CUDAContext.h>
#include <c10/cuda/CUDAException.h>
#include <cuda_runtime.h>
#include <cstdint>
__device__ __forceinline__ float sigmoid_f(float x) {
    return 1.0f / (1.0f + __expf(-x));
}
__device__ __forceinline__ float4 sigmoid4_f(float4 v) {
    v.x = sigmoid_f(v.x);
    v.y = sigmoid_f(v.y);
    v.z = sigmoid_f(v.z);
    v.w = sigmoid_f(v.w);
    return v;
}
// Elementwise sigmoid: memory-bandwidth bound streaming kernel.
// Optimization: improve global-memory coalescing in the two-float4-per-
// thread scheme by placing the second float4 one full grid-stride away
// from the first (instead of adjacent to it). Within each load/store
// pair, adjacent threads now touch adjacent 16B segments with no gaps,
// which maximizes sector utilization and sustained bandwidth on very
// large contiguous tensors. The scalar fallback still handles
// unaligned/tail inputs safely.
__global__ void sigmoid_kernel(const float* __restrict__ x,
                               float* __restrict__ y,
                               const long long n,
                               const bool use_vec) {
    const long long tid = (long long)blockIdx.x * blockDim.x + threadIdx.x;
    const long long stride = (long long)gridDim.x * blockDim.x;
    if (use_vec) {
        const long long n4 = n >> 2;
        const float4* __restrict__ x4 = reinterpret_cast<const float4*>(x);
        float4* __restrict__ y4 = reinterpret_cast<float4*>(y);
        // One 16B vector per thread per iteration: a device-filling grid
        // keeps every thread issuing an independent 16B load + 16B store,
        // which maximizes memory-level parallelism and sustained DRAM
        // bandwidth for this bandwidth-bound streaming kernel. The
        // grid-stride loop is retained only as a correctness safety net
        // for arbitrarily large n.
        for (long long i = tid; i < n4; i += stride) {
            float4 a = __ldcs(&x4[i]);
            __stcs(&y4[i], sigmoid4_f(a));
        }
    } else {
        for (long long i = tid; i < n; i += stride) {
            __stcs(&y[i], sigmoid_f(__ldcs(&x[i])));
        }
    }
}
at::Tensor sigmoid_cuda(const at::Tensor& x) {
    TORCH_CHECK(x.is_cuda(), "sigmoid_cuda: input must be a CUDA tensor");
    TORCH_CHECK(x.scalar_type() == at::kFloat, "sigmoid_cuda: only float32 is supported");
    at::Tensor xc = x.contiguous();
    at::Tensor y = at::empty_like(xc);
    const long long n = (long long)xc.numel();
    if (n == 0) {
        return y;
    }
    const float* x_ptr = xc.data_ptr<float>();
    float* y_ptr = y.data_ptr<float>();
    const bool use_vec =
        ((n & 3LL) == 0LL) &&
        ((reinterpret_cast<std::uintptr_t>(x_ptr) & 15) == 0) &&
        ((reinterpret_cast<std::uintptr_t>(y_ptr) & 15) == 0);
    // Fill the device: launch enough blocks so that, in the common aligned
    // case, each thread owns exactly one float4 (no inner loop), maximizing
    // the number of in-flight memory transactions. The grid-stride loop is
    // kept as a safety net, and the grid is clamped below the 2^31-1
    // gridDim.x launch limit.
    constexpr int threads = 512;
    const long long work = use_vec ? (n >> 2) : n;
    long long blocks = (work + threads - 1) / threads;
    const long long max_blocks = 2147483647LL / threads;
    if (blocks > max_blocks) blocks = max_blocks;
    if (blocks < 1LL) blocks = 1LL;
