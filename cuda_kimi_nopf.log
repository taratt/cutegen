import torch.nn as nn
from torch.utils.cpp_extension import load_inline

cuda_source = r"""
#include <torch/extension.h>
#include <cuda_runtime.h>

// Single fused element-wise tanh kernel.
// Vectorized path: each thread processes 4 floats via float4 when possible,
// with a scalar tail loop for any remaining elements.
// Fast tanh approximation using fast-math intrinsics.
// tanh(x) = sign(x) * (1 - e^{-2|x|}) / (1 + e^{-2|x|}), computed with
// __expf and __fdividef. Stable for all inputs (exponent arg is always <= 0).
__device__ __forceinline__ float fast_tanhf(float x) {
    float e = __expf(-2.0f * fabsf(x));
    float t = __fdividef(1.0f - e, 1.0f + e);
    return copysignf(t, x);
}
__global__ void __launch_bounds__(512, 2) tanh_kernel(const float* __restrict__ x,
                            float* __restrict__ out,
                            long long n) {
    // Improved bounds/alignment handling (elementwise optimization #5):
    // float4 loads/stores require 16-byte alignment. If either pointer is
    // misaligned (e.g., a contiguous but offset view of a larger buffer),
    // fall back to a fully scalar grid-stride path to avoid misaligned
    // vector accesses. The aligned fast path is unchanged.
    const bool aligned =
        ((reinterpret_cast<unsigned long long>(x) |
          reinterpret_cast<unsigned long long>(out)) & 15ULL) == 0ULL;
    const long long stride = (long long)blockDim.x * gridDim.x;
    const long long tid = (long long)blockIdx.x * blockDim.x + threadIdx.x;
    if (aligned) {
        const long long vec_n = n >> 2;  // number of full float4 groups
        const float4* x4 = reinterpret_cast<const float4*>(x);
        float4* out4 = reinterpret_cast<float4*>(out);
        // Keep only one live float4 per thread to minimize register pressure.
        for (long long i = tid; i < vec_n; i += stride) {
            float4 v = x4[i];
            v.x = fast_tanhf(v.x);
            v.y = fast_tanhf(v.y);
            v.z = fast_tanhf(v.z);
            v.w = fast_tanhf(v.w);
            out4[i] = v;
        }
        // Improved tail handling: at most 3 leftover elements, handled only
        // by the first (n & 3) threads of block 0, instead of a grid-stride
        // loop that every thread in the grid had to evaluate. When n % 4 == 0
        // the guard makes this a compile-time-cheap no-op, and threads can
        // never access memory out of bounds.
        const long long tail_start = vec_n << 2;
        const long long tail_len = n - tail_start;
        if (blockIdx.x == 0 && (long long)threadIdx.x < tail_len) {
            const long long j = tail_start + threadIdx.x;
            out[j] = fast_tanhf(x[j]);
        }
    } else {
        // Scalar fallback for misaligned tensors; accesses stay coalesced
        // and every element is covered exactly once for any numel.
        for (long long j = tid; j < n; j += stride) {
            out[j] = fast_tanhf(x[j]);
        }
    }
}

torch::Tensor tanh_forward(torch::Tensor x) {
    TORCH_CHECK(x.is_cuda(), "Input must be a CUDA tensor");
    TORCH_CHECK(x.scalar_type() == torch::kFloat32, "Input must be float32");

    auto x_contig = x.contiguous();
    auto out = torch::empty_like(x_contig);

    long long n = x_contig.numel();
    if (n == 0) {
        return out;
    }

    // Occupancy tuning: use 512 threads per block for this bandwidth-bound
    // elementwise kernel. At the target shape the kernel is purely
    // memory-bound; 512 threads/block puts more warps in flight per
    // resident block and improves global-load latency hiding without
    // changing semantics. The grid-stride loop still covers any numel,
    // alignment is unchanged, and the block cap still applies.
    const int threads = 512;
    long long vec_n = (n + 3) >> 2;
    long long blocks_needed = (vec_n + threads - 1) / threads;
    int blocks = (int)std::min<long long>(blocks_needed, 65535L * 32L);

    tanh_kernel<<<blocks, threads>>>(
        x_contig.data_ptr<float>(),
        out.data_ptr<float>(),
        n);

    return out;
}
"""

cpp_source = "torch::Tensor tanh_forward(torch::Tensor x);"

tanh_module = load_inline(
    name="tanh_cuda_ext",
    cpp_sources=cpp_source,
    cuda_sources=cuda_source,
    functions=["tanh_forward"],
    verbose=False,
)


class ModelNew(nn.Module):
    """
    Model that applies Tanh activation using a custom CUDA kernel.
    """
    def __init__(self):
        super(ModelNew, self).__init__()

    def forward(self, x: torch.Tensor) -> torch.Tensor:
        return tanh_module.tanh_forward(x)
