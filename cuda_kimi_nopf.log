    for (int o = 0; o < OC_TILE; o++) {
        sum[o][0] = 0.0f;
        sum[o][1] = 0.0f;
        sum[o][2] = 0.0f;
        sum[o][3] = 0.0f;
    }
    int stage = 0;
    const int first_icn = min(IC_CHUNK, in_ch);
    stage_conv_chunk(
        in_base, weight,
        s_input, s_weight,
        oc0, 0, first_icn,
        in_ch, out_ch, H, W,
        h0, w0, halo_h, halo_w, wchunk);
    for (int ic0 = 0; ic0 < in_ch; ic0 += IC_CHUNK) {
