accumulator, 16, 16, 16, float> acc[NJ];\n    #pragma unroll\n    for (int u = 0; u < NJ; ++u) wmma::fill_fragment(acc[u], 0.0f);\n    for (int d0 = 0; d0 < D; d0 += BK) {\n        {\n            const int W = BK >> 1;\n            const __half2* qg = reinterpret_cast<const __half2*>(q) + (size_t)row0 * (size_t)Dh2 + (d0 >> 1);\n            for (int idx = tid; idx < BR * W; idx += THREADS) {\n                const int rr = idx / W;\n                const int cc = idx - rr * W;\n                reinterpret_cast<__half2*>(sQ)[rr * (LDK >> 1) + cc] = qg[(size_t)rr * (size_t)Dh2 + cc];\n            }\n        }\n        {\n            const int W = BK >> 1;\n            const __half2* kg = reinterpret_cast<const __half2*>(k) + (d0 >> 1);\n            for (int idx = tid; idx < S * W; idx += THREADS) {\n                const int rr = idx / W;\n                const int cc = idx - rr * W;\n                reinterpret_cast<__half2*>(sK)[rr * (LDK >> 1) + cc] = kg[(size_t)rr * (size_t)Dh2 + cc];\n            }\n        }\n        __syncthreads();\n        #pragma unroll\n        for (int kk = 0; kk < BK; kk += 16) {\n            wmma::fragment<wmma::matrix_a, 16, 16, 16, __half, wmma::row_major> a;\n            wmma::load_matrix_sync(a, sQ + wr * 16 * LDK + kk, LDK);\n            #pragma unroll\n            for (int j = 0; j < NJ; ++j) {\n                wmma::fragment<wmma::matrix_b, 16, 16, 16, __half, wmma::col_major> b;\n                wmma::load_matrix_sync(b, sK + (wc * WCOLS + j * 16) * LDK + kk, LDK);\n                wmma::mma_sync(acc[j], a, b, acc[j]);\n            }\n        }\n        __syncthreads();\n    }\n    // Scale and stage scores (fp16) in shared memory.\n    #pragma unroll\n    for (int j = 0; j < NJ; ++j) {\n        wmma::fragment<wmma::accumulator, 16, 16, 16, __half> h;\n        #pragma unroll\n        for (int e = 0; e < h.num_elements; ++e) h.x[e] = __float2half_rn(acc[j].x[e] * scale);\n        wmma::store_matrix_sync(sS + wr * 16 * S + wc * WCO