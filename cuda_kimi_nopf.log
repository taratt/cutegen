Src: import torch
import torch.nn as nn
from torch.utils.cpp_extension import load_inline

cuda_src = r"""
#include <torch/extension.h>
#include <ATen/cuda/CUDAContext.h>
#include <c10/cuda/CUDAException.h>
#include <cuda_runtime.h>
#include <cstdint>

__device__ __forceinline__ float sigmoid_f(float x) {
    return 1.0f / (1.0f + __expf(-x));
}

__device__ __forceinline__ float4 sigmoid4_f(float4 v) {
    v.x = sigmoid_f(v.x);
    v.y = sigmoid_f(v.y);
    v.z = sigmoid_f(v.z);
    v.w = sigmoid_f(v.w);
    return v;
}
__global__ void sigmoid_kernel(const float* __restrict__ x,
                               float* __restrict__ y,
                               const long long n,
                               const bool use_vec) {
    const long long tid = (long long)blockIdx.x * blockDim.x + threadIdx.x;
    const long long stride = (long long)gridDim.x * blockDim.x;
    if (use_vec) {
        const long long n4 = n >> 2;
        const float4* __restrict__ x4 = reinterpret_cast<const float4*>(x);
        float4* __restrict__ y4 = reinterpret_cast<float4*>(y);
        // Unrolled grid-stride loop: each thread issues 4 independent
        // float4 loads per iteration (16 floats) to increase memory-level
        // parallelism and hide global memory latency. Accesses remain
        // fully coalesced because consecutive threads read consecutive
        // float4 elements at each unrolled offset.
        const long long ustride = stride * 4LL;
        long long i = tid;
        for (; i + 3LL * stride < n4; i += ustride) {
            float4 v0 = __ldcs(&x4[i]);
            float4 v1 = __ldcs(&x4[i + stride]);
            float4 v2 = __ldcs(&x4[i + 2LL * stride]);
            float4 v3 = __ldcs(&x4[i + 3LL * stride]);
            v0 = sigmoid4_f(v0);
            v1 = sigmoid4_f(v1);
            v2 = sigmoid4_f(v2);
            v3 = sigmoid4_f(v3);
            __stcs(&y4[i], v0);
            __stcs(&y4[i + stride], v1);
            __stcs(&y4[i + 2LL * stride], v2);
            __stcs(&y4[i + 3LL * stride], v3);
        }
        for (; i < n4; i += stride) {
            __stcs(&y4[i], sigmoid4_f(__ldcs(&x4[i])));
        }
    } else {
        for (long long i = tid; i < n; i += stride) {
            __stcs(&y[i], sigmoid_f(__ldcs(&x[i])));
        }
    }
}

at::Tensor sigmoid_cuda(const at::Tensor& x) {
    TORCH_CHECK(x.is_cuda(), "sigmoid_cuda: input must be a CUDA tensor");
    TORCH_CHECK(x.scalar_type() == at::kFloat, "sigmoid_cuda: only float32 is supported");

    at::Tensor xc = x.contiguous();
    at::Tensor y = at::empty_like(xc);

    const long long n = (long long)xc.numel();
    if (n == 0) {
        return y;
    }

    const float* x_ptr = xc.data_ptr<float>();
    float* y_ptr = y.data_ptr<float>();

    const bool use_vec =
        ((n & 3LL) == 0LL) &&
        ((reinterpret_cast<std::uintptr_t>(x_ptr) & 15) == 0) &&
        ((reinterpret_cast<std::uintptr_t>(y_ptr) & 15) == 0);

    constexpr int threads = 256;
    const long long work = use_vec ? (n >> 2) : n;
    long long blocks = (work + threads - 1) / threads;
    if (blocks > 8192LL) blocks = 8192LL;
    if (blocks < 1LL) blocks = 1LL;

    cudaStream_t stream = at::cuda::getCurrentCUDAStream();
    sigmoid_kernel<<<(unsigned int)blocks, threads, 0, stream>>>(
        x_ptr, y_ptr, n, use_vec
    );
    C10_CUDA_KERNEL_LAUNCH_CHECK();

    return y;
}
"""

cpp_src = "at::Tensor sigmoid_cuda(const at::Tensor& x);"

_ext = load_inline(
    name="pure_cuda_sigmoid_ext",
    cpp_sources=cpp_src,
    cuda_sources=cuda_src,
    functions=["sigmoid_cuda"],
    extra_cuda_cflags=["-O3"],
    verbose=False,
)

class ModelNew(nn.Module):
    def __init__(self):
        super(ModelNew, self).__init__()

    def forward(self, x: torch.Tensor) -> torch.Tensor:
        return _ext.sigmoid_cuda(x)
