    if ((halo_w & 3) == 0) {
        const int row_quads = halo_w >> 2;
        const int quad_elems = tile_elems >> 2;
        for (int q = threadIdx.x; q < quad_elems; q += blockDim.x) {
            const int c  = q / (halo_h * row_quads);
            const int r  = (q / row_quads) % halo_h;
            const int qq = q % row_quads;
            const int cc = qq << 2;
            const int h_in = h0 + r;
            const int w_in = w0 + cc;
            float* dst = s_input_stage + (q << 2);
