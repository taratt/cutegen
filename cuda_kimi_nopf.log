             output[((n * C_out + oc) * H_out + oh) * W_out + ow] = acc[ocb];\n            }\n        }\n    }\n}\ntorch::Tensor conv2d_forward(torch::Tensor input, torch::Tensor weight, torch::Tensor bias)\n{\n    TORCH_CHECK(input.is_cuda() && weight.is_cuda() && bias.is_cuda(),\n                "All tensors must be on CUDA");\n    TORCH_CHECK(input.dim() == 4, "input must be NCHW");\n    TORCH_CHECK(input.size(1) == 3, "kernel expects in_channels == 3");\n    TORCH_CHECK(weight.size(1) == 3 && weight.size(2) == KSIZE && weight.size(3) == KSIZE,\n                "weight must be (C_out, 3, 11, 11)");\n    auto input_c  = input.contiguous();\n    auto weight_c = weight.contiguous();\n    auto bias_c   = bias.contiguous();\n    const int N     = input_c.size(0);\n    const int C_in  = input_c.size(1);\n    const int H     = input_c.size(2);\n    const int W     = input_c.size(3);\n    const int C_out = weight_c.size(0);\n    const int H_out = (H + 2 * PAD - KSIZE) / STRIDE + 1;\n    const int W_out = (W + 2 * PAD - KSIZE) / STRIDE + 1;\n    auto output = torch::empty({N, C_out, H_out, W_out}, input_c.options());\n    const int tiles_h = (H_out + TILE - 1) / TILE;\n    const int tiles_w = (W_out + TILE - 1) / TILE;\n    const int oc_groups = (C_out + OC_BLOCK - 1) / OC_BLOCK;\n    dim3 block(TILE, TILE);\n    dim3 grid(tiles_h * tiles_w, oc_groups, N);\n    constexpr int SMEM_BYTES = (3 * PATCH * PATCH + OC_BLOCK * 3 * KSIZE * KSIZE + OC_BLOCK) * sizeof(float);\n    static bool smem_configured = false;\n    if (!smem_configured) {\n        cudaError_t attr_err = cudaFuncSetAttribute(\n            conv2d_kernel, cudaFuncAttributeMaxDynamicSharedMemorySize, SMEM_BYTES);\n        TORCH_CHECK(attr_err == cudaSuccess,\n                    "cudaFuncSetAttribute failed: ", cudaGetErrorString(attr_err));\n        smem_configured = true;\n    }\n    conv2d_kernel<<<grid, block, SMEM_BYTES>>>(\n        input_c.data_ptr<float>(),\n        weight_c.data_ptr<float>(),\n        bias_c.data_ptr<float>(),\n        output.data_ptr<float>(),\n        C_in, H, W, C_out, H_out, W_out);\n    return output;\n}\n"""\n_conv_ext = load_inline(\n    name="custom_conv2d_ext",\n    cpp_sources=_cpp_src,\n    cuda_sources=_cuda_src,\n    functions=["conv2d_forward"],\n    extra_cuda_cflags=["-O3"],\n    verbose=False,\n)\nclass ModelNew(nn.Module):\n    def __init__(self, num_classes=1000):\n        super(ModelNew, self).__init__()\n        self.num_classes = num_classes\n        # Parameters matching nn.Conv2d(3, 96, kernel_size=11, stride=4, padding=2)\n        self.weight = nn.Parameter(torch.empty(96, 3, 11, 11))\n        self.bias = nn.Parameter(torch.empty(96))\n        # Same default initialization as nn.Conv2d\n        nn.init.kaiming_uniform_(self.weight, a=math.sqrt(5))\n        fan_in = 3 * 11 * 11\n        bound = 1.0 / math.sqrt(fan_in)\n        nn.init.uniform_(self.bias, -bound, bound)\n    def forward(self, x):\n        return _conv_ext.conv2d_forward(x, self.weight, self.bias)', 'best_passed_depth': 3, 'best_passed_time': {'mean': 1.39, 'std': 0.00409, 'min': 1.39, 'max': 1.41, 'num_trials': 100}, 'best_passed_nsight_metrics': {}, 'kernel_backend': 'cuda', 'compile': '', 'correct': ''}
