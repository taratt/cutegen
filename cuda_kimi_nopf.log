import torch.nn as nn
from torch.utils.cpp_extension import load_inline

cuda_source = r"""
#include <torch/extension.h>
#include <cuda_runtime.h>

// Single fused element-wise tanh kernel.
// Vectorized path: each thread processes 4 floats via float4 when possible,
// with a scalar tail loop for any remaining elements.
// Fast tanh approximation using fast-math intrinsics.
// tanh(x) = sign(x) * (1 - e^{-2|x|}) / (1 + e^{-2|x|}), computed with
// __expf and __fdividef. Stable for all inputs (exponent arg is always <= 0).
__device__ __forceinline__ float fast_tanhf(float x) {
    float e = __expf(-2.0f * fabsf(x));
    float t = __fdividef(1.0f - e, 1.0f + e);
    return copysignf(t, x);
}
__global__ void tanh_kernel(const float* __restrict__ x,
                            float* __restrict__ out,
                            long long n) {
    long long vec_n = n >> 2;  // number of float4 groups
    long long stride = (long long)blockDim.x * gridDim.x;
    const float4* x4 = reinterpret_cast<const float4*>(x);
    float4* out4 = reinterpret_cast<float4*>(out);
    // Unrolled main path: each thread processes 4 float4 groups (16 floats)
    // per iteration. The four independent loads/stores increase
    // memory-level parallelism and reduce loop overhead for this
    // bandwidth-bound elementwise kernel.
    long long i = (long long)blockIdx.x * blockDim.x + threadIdx.x;
    for (; i + 3 * stride < vec_n; i += 4 * stride) {
        float4 v0 = x4[i];
        float4 v1 = x4[i + stride];
        float4 v2 = x4[i + 2 * stride];
        float4 v3 = x4[i + 3 * stride];
        v0.x = fast_tanhf(v0.x);
        v0.y = fast_tanhf(v0.y);
        v0.z = fast_tanhf(v0.z);
        v0.w = fast_tanhf(v0.w);
        v1.x = fast_tanhf(v1.x);
        v1.y = fast_tanhf(v1.y);
        v1.z = fast_tanhf(v1.z);
        v1.w = fast_tanhf(v1.w);
        v2.x = fast_tanhf(v2.x);
        v2.y = fast_tanhf(v2.y);
        v2.z = fast_tanhf(v2.z);
        v2.w = fast_tanhf(v2.w);
        v3.x = fast_tanhf(v3.x);
        v3.y = fast_tanhf(v3.y);
        v3.z = fast_tanhf(v3.z);
        v3.w = fast_tanhf(v3.w);
        out4[i] = v0;
        out4[i + stride] = v1;
        out4[i + 2 * stride] = v2;
        out4[i + 3 * stride] = v3;
    }
    // Remaining full float4 groups
    for (; i < vec_n; i += stride) {
        float4 v = x4[i];
        v.x = fast_tanhf(v.x);
        v.y = fast_tanhf(v.y);
        v.z = fast_tanhf(v.z);
        v.w = fast_tanhf(v.w);
        out4[i] = v;
    }
    // Handle tail elements (n not divisible by 4)
    long long tail_start = vec_n << 2;
    long long idx = tail_start + (long long)blockIdx.x * blockDim.x + threadIdx.x;
    for (long long j = idx; j < n; j += stride) {
        out[j] = fast_tanhf(x[j]);
    }
}

torch::Tensor tanh_forward(torch::Tensor x) {
    TORCH_CHECK(x.is_cuda(), "Input must be a CUDA tensor");
    TORCH_CHECK(x.scalar_type() == torch::kFloat32, "Input must be float32");

    auto x_contig = x.contiguous();
    auto out = torch::empty_like(x_contig);

    long long n = x_contig.numel();
    if (n == 0) {
        return out;
    }

    // Occupancy tuning: use 512 threads per block for this bandwidth-bound
    // elementwise kernel. Larger blocks reduce the total number of blocks
    // (lowering launch/scheduling overhead over 134M float4 groups) while
    // still providing enough warps to hide memory latency. Semantics are
    // unchanged; the grid-stride loop covers any numel regardless of the
    // block size, and the block cap still applies.
    const int threads = 512;
    long long vec_n = (n + 3) >> 2;
    long long blocks_needed = (vec_n + threads - 1) / threads;
    int blocks = (int)std::min<long long>(blocks_needed, 65535L * 32L);

    tanh_kernel<<<blocks, threads>>>(
        x_contig.data_ptr<float>(),
        out.data_ptr<float>(),
        n);

    return out;
}
"""

cpp_source = "torch::Tensor tanh_forward(torch::Tensor x);"

tanh_module = load_inline(
    name="tanh_cuda_ext",
    cpp_sources=cpp_source,
    cuda_sources=cuda_source,
    functions=["tanh_forward"],
    verbose=False,
)


class ModelNew(nn.Module):
    """
    Model that applies Tanh activation using a custom CUDA kernel.
    """
    def __init__(self):
        super(ModelNew, self).__init__()

    def forward(self, x: torch.Tensor) -> torch.Tensor:
        return tanh_module.tanh_forward(x)
