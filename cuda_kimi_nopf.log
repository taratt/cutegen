import torch
import torch.nn as nn
from torch.utils.cpp_extension import load_inline
_cpp_src = "torch::Tensor conv2d_forward(torch::Tensor input, torch::Tensor weight, torch::Tensor bias);"
_cuda_src = r"""
#include <torch/extension.h>
#include <cuda_runtime.h>
#define TILE 16
#define KSIZE 11
#define STRIDE 4
#define PAD 2
#define OC_BLOCK 12
#define PATCH ((TILE - 1) * STRIDE + KSIZE)
// Direct convolution kernel specialized for: in_channels=3, kernel=11x11,
// stride=4, padding=2. Each block computes a 16x16 tile of the output for one
// batch and a group of OC_BLOCK output channels. The input patch is staged once
// per block and reused across the output-channel group, while each thread computes
// two vertically adjacent outputs with 2*OC_BLOCK register accumulators so every
// staged filter value feeds two FMAs (register blocking over output rows).
__global__ void conv2d_kernel(const float* __restrict__ input,
                              const float* __restrict__ weight,
                              const float* __restrict__ bias,
                              float* __restrict__ output,
                              int C_in, int H, int W,
                              int C_out, int H_out, int W_out)
{
    extern __shared__ float smem[];
    float* s_in_base = smem;
    float* s_w_base = s_in_base + PATCH * PATCH;
    float* s_bias_base = s_w_base + OC_BLOCK * 3 * KSIZE * KSIZE;
    #define S_IN(r, col) s_in_base[(r) * PATCH + (col)]
    #define S_W(ocb, c, ky, kx) s_w_base[((((ocb) * 3 + (c)) * KSIZE + (ky)) * KSIZE + (kx))]
    #define S_BIAS(ocb) s_bias_base[(ocb)]
    const int n  = blockIdx.z;
    const int oc0 = blockIdx.y * OC_BLOCK;
    const int tiles_w = (W_out + TILE - 1) / TILE;
    const int ty0 = (blockIdx.x / tiles_w) * TILE;
    const int tx0 = (blockIdx.x % tiles_w) * TILE;
    const int tid = threadIdx.y * blockDim.x + threadIdx.x;
    const int nthreads = blockDim.x * blockDim.y;
    const int in_y0 = ty0 * STRIDE - PAD;
    const int in_x0 = tx0 * STRIDE - PAD;
    for (int idx = tid; idx < OC_BLOCK * 3 * KSIZE * KSIZE; idx += nthreads) {
        const int ocb  = idx / (3 * KSIZE * KSIZE);
        const int rem  = idx % (3 * KSIZE * KSIZE);
        const int c    = rem / (KSIZE * KSIZE);
        const int rem2 = rem % (KSIZE * KSIZE);
        const int ky   = rem2 / KSIZE;
        const int kx   = rem2 % KSIZE;
        const int oc   = oc0 + ocb;
        float v = 0.0f;
        if (oc < C_out)
            v = weight[((oc * 3 + c) * KSIZE + ky) * KSIZE + kx];
        S_W(ocb, c, ky, kx) = v;
    }
    if (tid < OC_BLOCK) {
        const int oc = oc0 + tid;
        S_BIAS(tid) = (oc < C_out) ? bias[oc] : 0.0f;
    }
    __syncthreads();
    const int oh0 = ty0 + threadIdx.y;
    const int oh1 = oh0 + TILE / 2;
    const int ow  = tx0 + threadIdx.x;
    const bool valid0 = (oh0 < H_out) && (ow < W_out);
    const bool valid1 = (oh1 < H_out) && (ow < W_out);
    if (valid0 || valid1) {
        float acc0[OC_BLOCK];
        float acc1[OC_BLOCK];
        #pragma unroll
        for (int ocb = 0; ocb < OC_BLOCK; ++ocb) {
            acc0[ocb] = S_BIAS(ocb);
            acc1[ocb] = S_BIAS(ocb);
        }
        const int by0 = threadIdx.y * STRIDE;
        const int by1 = by0 + (TILE / 2) * STRIDE;
        const int bx  = threadIdx.x * STRIDE;
        for (int c = 0; c < 3; ++c) {
            for (int idx = tid; idx < PATCH * PATCH; idx += nthreads) {
                const int r   = idx / PATCH;
                const int col = idx % PATCH;
                const int iy = in_y0 + r;
                const int ix = in_x0 + col;
                float v = 0.0f;
                if (iy >= 0 && iy < H && ix >= 0 && ix < W)
                    v = input[((n * C_in + c) * H + iy) * W + ix];
                S_IN(r, col) = v;
            }
            __syncthreads();
            #pragma unroll
            for (int ky = 0; ky < KSIZE; ++ky) {
                #pragma unroll
                for (int kx = 0; kx < KSIZE; ++kx) {
                    const float iv0 = S_IN(by0 + ky, bx + kx);
                    const float iv1 = S_IN(by1 + ky, bx + kx);
                    #pragma unroll
                    for (int ocb = 0; ocb < OC_BLOCK; ++ocb) {
                        const float w = S_W(ocb, c, ky, kx);
                        acc0[ocb] += iv0 * w;
                        acc1[ocb] += iv1 * w;
                    }
                }
            }
            __syncthreads();
        }
        #pragma unroll
        for (int ocb = 0; ocb < OC_BLOCK; ++ocb) {
            const int oc = oc0 + ocb;
            if (oc < C_out) {
                if (valid0)
                    output[((n * C_out + oc) * H_out + oh0) * W_out + ow] = acc0[ocb];
                if (valid1)
                    output[((n * C_out + oc) * H_out + oh1) * W_out + ow] = acc1[ocb];
            }
        }
    }
}
torch::Tensor conv2d_forward(torch::Tensor input, torch::Tensor weight, torch::Tensor bias)
{
    TORCH_CHECK(input.is_cuda() && weight.is_cuda() && bias.is_cuda(),
                "All tensors must be on CUDA");
    TORCH_CHECK(input.dim() == 4, "input must be NCHW");
    TORCH_CHECK(input.size(1) == 3, "kernel expects in_channels == 3");
    TORCH_CHECK(weight.size(1) == 3 && weight.size(2) == KSIZE && weight.size(3) == KSIZE,
                "weight must be (C_out, 3, 11, 11)");
    auto input_c  = input.contiguous();
    auto weight_c = weight.contiguous();
    auto bias_c   = bias.contiguous();
    const int N     = input_c.size(0);
    const int C_in  = input_c.size(1);
    const int H     = input_c.size(2);
    const int W     = input_c.size(3);
    const int C_out = weight_c.size(0);
    const int H_out = (H + 2 * PAD - KSIZE) / STRIDE + 1;
    const int W_out = (W + 2 * PAD - KSIZE) / STRIDE + 1;
    auto output = torch::empty({N, C_out, H_out, W_out}, input_c.options());
    const int tiles_h = (H_out + TILE - 1) / TILE;
    const int tiles_w = (W_out + TILE - 1) / TILE;
    const int oc_groups = (C_out + OC_BLOCK - 1) / OC_BLOCK;
    dim3 block(TILE, TILE / 2);
    dim3 grid(tiles_h * tiles_w, oc_groups, N);
    constexpr int SMEM_BYTES = (PATCH * PATCH + OC_BLOCK * 3 * KSIZE * KSIZE + OC_BLOCK) * sizeof(float);
    conv2d_kernel<<<grid, block, SMEM_BYTES>>>(
        input_c.data_ptr<float>(),
        weight_c.data_ptr<float>(),
        bias_c.data_ptr<float>(),
        output.data_ptr<float>(),
        C_in, H, W, C_out, H_out, W_out);
    return output;
}
"""
_conv_ext = load_inline(
    name="custom_conv2d_ext",
    cpp_sources=_cpp_src,
    cuda_sources=_cuda_src,
    functions=["conv2d_forward"],
    extra_cuda_cflags=["-O3"],
    verbose=False,
)
class ModelNew(nn.Module):
    def __init__(self, num_classes=1000):
        super(ModelNew, self).__init__()
        self.num_classes = num_classes
        # Parameters matching nn.Conv2d(3, 96, kernel_size=11, stride=4, padding=2)
        self.weight = nn.Parameter(torch.empty(96, 3, 11, 11))
        self.bias = nn.Parameter(torch.empty(96))
        # Same default initialization as nn.Conv2d
        nn.init.kaiming_uniform_(self.weight, a=math.sqrt(5))
        fan_in = 3 * 11 * 11
        bound = 1.0 / math.sqrt(fan_in)
        nn.init.uniform_(self.bias, -bound, bound)
    def forward(self, x):
        return _conv_ext.conv2d_forward(x, self.weight, self.bias)
