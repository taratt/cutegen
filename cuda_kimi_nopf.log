constexpr int TILE_A = 16;
constexpr int TILE_B = 16;
constexpr int TILE_L = 5;
constexpr int TILE_C = 3;
constexpr int TILE_CO = 8;
constexpr int TILE_THREADS = 256;
constexpr int OUTPUTS_PER_THREAD =
    (TILE_A * TILE_B * TILE_L + TILE_THREADS - 1) / TILE_THREADS;
extern "C" __global__ void conv3d_k331_s1_p0_d1_g1_kernel(
    const float* __restrict__ x,
    const float* __restrict__ w,
    const float* __restrict__ b,
    float* __restrict__ y,
    const int N,
    const int Cin,
    const int A,
    const int B,
    const int L,
    const int Cout,
    const int Aout,
    const int Bout,
    const bool has_bias
) {
    const long long tiles_a = (Aout + TILE_A - 1) / TILE_A;
    const long long tiles_b = (Bout + TILE_B - 1) / TILE_B;
    const long long tiles_l = (L + TILE_L - 1) / TILE_L;
    const long long tiles_co = (Cout + TILE_CO - 1) / TILE_CO;
