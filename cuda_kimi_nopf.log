_cuda_src = r"""
#include <torch/extension.h>
#include <cuda_runtime.h>
#define TILE 16
#define KSIZE 11
#define STRIDE 4
#define PAD 2
#define OC_BLOCK 12
#define PATCH ((TILE - 1) * STRIDE + KSIZE)
