s[(ocb)]\n    const int n  = blockIdx.z;\n    const int oc0 = blockIdx.y * OC_BLOCK;\n    const int tiles_w = (W_out + TILE_W - 1) / TILE_W;\n    const int ty0 = (blockIdx.x / tiles_w) * TILE_H;\n    const int tx0 = (blockIdx.x % tiles_w) * TILE_W;\n    const int tid = threadIdx.y * blockDim.x + threadIdx.x;\n    const int nthreads = blockDim.x * blockDim.y;\n    const int in_y0 = ty0 * STRIDE - PAD;\n    const int in_x0 = tx0 * STRIDE - PAD;\n    for (int idx = tid; idx < OC_BLOCK * 3 * KSIZE * KSIZE; idx += nthreads) {\n        const int ocb  = idx / (3 * KSIZE * KSIZE);\n        const int rem  = idx % (3 * KSIZE * KSIZE);\n        const int c    = rem / (KSIZE * KSIZE);\n        const int rem2 = rem % (KSIZE * KSIZE);\n        const int ky   = rem2 / KSIZE;\n        const int kx   = rem2 % KSIZE;\n        const int oc   = oc0 + ocb;\n        float v = 0.0f;\n        if (oc < C_out)\n            v = weight[((oc * 3 + c) * KSIZE + ky) * KSIZE + kx];\n        S_W(ocb, c, ky, kx) = v;\n    }\n    if (tid < OC_BLOCK) {\n        const int oc = oc0 + tid;\n        S_BIAS(tid) = (oc < C_out) ? bias[oc] : 0.0f;\n    }\n    const int oh0 = ty0 + threadIdx.y;\n    const int oh1 = oh0 + TILE_H / 2;\n    const int ow0 = tx0 + threadIdx.x;\n    const int ow1 = ow0 + TILE_W / 2;\n    const bool valid00 = (oh0 < H_out) && (ow0 < W_out);\n    const bool valid01 = (oh0 < H_out) && (ow1 < W_out);\n    const bool valid10 = (oh1 < H_out) && (ow0 < W_out);\n    const bool valid11 = (oh1 < H_out) && (ow1 < W_out);\n    float acc00[OC_BLOCK];\n    float acc01[OC_BLOCK];\n    float acc10[OC_BLOCK];\n    float acc11[OC_BLOCK];\n    #pragma unroll\n    for (int ocb = 0; ocb < OC_BLOCK; ++ocb) {\n        acc00[ocb] = 0.0f;\n        acc01[ocb] = 0.0f;\n        acc10[ocb] = 0.0f;\n        acc11[ocb] = 0.0f;\n    }\n    const int by0 = threadIdx.y * STRIDE;\n    const int by1 = by0 + (TILE_H / 2) * STRIDE;\n    const int bx0 = threadIdx.x * STRIDE;\n    const int bx1 = bx0 + (TILE_W / 2) * STRIDE;\n    for (int c = 0; c < 3; ++c) {\n        for (int idx = tid; idx < PATCH_H * PATCH_W; idx += nthreads) {\n            const int r   = idx / PATCH_W;\n            const int col = idx % PATCH_W;\n            const int iy = in_y0 + r;\n            const int ix = in_x0 + col;\n            float v = 0.0f;\n            if (iy >= 0 && iy < H && ix >= 0 && ix < W)\n                v = input[((n * C_in + c) * H + iy) * W + ix];\n            s_in[r * PATCH_W + col] = v;\n        }\n        __syncthreads();\n        if (valid00 || valid01 || valid10 || valid11) {\n            #pragma unroll\n            for (int ky = 0; ky < KSIZE; ++ky) {\n                #pragma unroll\n                for (int kx = 0; kx < KSIZE; ++kx) {\n                    const float iv00 = s_in[(by0 + ky) * PATCH_W + (bx0 + kx)];\n                    const float iv01 = s_in[(by0 + ky) * PATCH_W + (bx1 + kx)];\n                    const float iv10 = s_in[(by1 + ky) * PATCH_W + (bx0 + kx)];\n                    const float iv11 = s_in[(by1 + ky) * PATCH_W + (bx1 + kx)];\n                    #pragma unroll\n                    for (int ocb = 0; ocb < OC_BLOCK; ++ocb) {\n                        const float w = S_W(ocb, c, ky, kx);\n                        acc00[ocb] += iv00 * w;\n                        acc01[ocb] += iv01 * w;\n                        acc10[ocb] += iv10 * w;\n                        acc11[ocb] += iv11 * w;\n                    }\n                }\n            }\n        }\n        __syncthreads();\n    }\n    #pragma unroll\n    for (int ocb = 0; ocb < OC_BLOCK; ++ocb) {\n        const int oc = oc0 + ocb;\n        if (oc < C_out) {\n            const float b = S_BIAS(ocb);\n            if (valid00)\n                output[((n * C_out + oc) * H_out + oh0) * W_out + ow0] = acc00[ocb] + b;\n            if (valid01)\n                output[((n * C_out + oc) * H_out + oh0) * W_out + ow1] = acc01[ocb] + b;\n            if (valid10)\n                output[((n * C_out + oc) * H_out + oh1)