#include <torch/extension.h>
#include <ATen/cuda/CUDAContext.h>
#include <cuda_runtime.h>
#include <cstdint>
// Implicit GEMM restructuring: view the convolution as C[M, C_out] = A[M, Kk] * W[C_out, Kk]^T,
// where M flattens (batch, out_h, out_w) and Kk flattens (in_c, kh, kw). Each CTA keeps the
// small C_out dimension inside the block and tiles the large M dimension, staging on-the-fly
// im2col A tiles and weight B tiles in shared memory with register-blocked accumulation.
// Optimization: software-pipelined double buffering -- while the current K tile is consumed
// from shared memory, the next K tile is prefetched from global memory into registers and
// committed to the alternate shared buffer, hiding global-load latency behind the FMA work.
// The staged B tile is padded by one column to keep the shared stores bank-conflict free.
constexpr int BM = 64;
constexpr int BN = 128;
constexpr int BK = 16;
constexpr int TM = 4;
constexpr int TN = 8;
constexpr int THREADS = 256;
constexpr int A_ELEMS = (BM * BK) / THREADS;
constexpr int B_ELEMS = (BK * BN) / THREADS;
constexpr int ROWS_PER_PASS = THREADS / BK;
__global__ void conv2d_forward_kernel(
    const float* __restrict__ input,
    const float* __restrict__ weight,
    const float* __restrict__ bias,
    float* __restrict__ output,
    int N, int C_in, int H, int W,
    int C_out, int H_out, int W_out,
    int K, int stride, int pad, int dil)
{
    const int m0  = blockIdx.x * BM;
    const int oc0 = blockIdx.y * BN;
    const int tid = threadIdx.y * blockDim.x + threadIdx.x;
    const int tx  = threadIdx.x;
    const int ty  = threadIdx.y;
    const int64_t M_total = (int64_t)N * H_out * W_out;
    const int Kk = C_in * K * K;
    const int kk_sq = K * K;
    __shared__ float sA[2][BM][BK];
    __shared__ float sB[2][BK][BN + 1];
    // Per-row metadata for the 64 flattened output positions owned by this CTA.
    __shared__ int64_t s_row_base[BM];
    __shared__ int s_ih0[BM];
    __shared__ int s_iw0[BM];
    __shared__ unsigned char s_row_valid[BM];
    __shared__ int64_t s_row_out[BM];
    if (tid < BM) {
        const int64_t m = (int64_t)m0 + tid;
        unsigned char valid = 0;
        int64_t base = 0, out_off = 0;
        int ih0 = 0, iw0 = 0;
        if (m < M_total) {
            const int ow = (int)(m % W_out);
            const int64_t t = m / W_out;
            const int oh = (int)(t % H_out);
            const int n  = (int)(t / H_out);
            ih0 = oh * stride - pad;
            iw0 = ow * stride - pad;
            base = (int64_t)n * C_in * H * W + (int64_t)ih0 * W + iw0;
            out_off = (int64_t)n * C_out * H_out * W_out + (int64_t)oh * W_out + ow;
            valid = 1;
        }
        s_row_base[tid] = base;
        s_row_out[tid] = out_off;
        s_ih0[tid] = ih0;
        s_iw0[tid] = iw0;
        s_row_valid[tid] = valid;
    }
    __syncthreads();
    float acc[TM][TN];
    #pragma unroll
    for (int i = 0; i < TM; ++i)
        #pragma unroll
        for (int j = 0; j < TN; ++j)
            acc[i][j] = 0.0f;
    const int ktiles = (Kk + BK - 1) / BK;
    // During staging each thread always owns the same k-column (kk_st) and a fixed set
    // of rows/columns, so its (ic, kh, kw) decomposition is computed once per K tile.
    const int kk_st = tid % BK;
    const int rc_st = tid / BK;
    // Prologue: stage K tile 0 into buffer 0.
    {
        const int k = kk_st;
        int64_t add = 0;
        int khd = 0, kwd = 0;
        if (k < Kk) {
            const int ic  = k / kk_sq;
            const int rem = k - ic * kk_sq;
            const int kh  = rem / K;
            const int kw  = rem - kh * K;
            khd = kh * dil;
            kwd = kw * dil;
            add = (int64_t)ic * H * W + (int64_t)khd * W + kwd;
        }
        #pragma unroll
        for (int l = 0; l < A_ELEMS; ++l) {
            const int mm = rc_st + l * ROWS_PER_PASS;
            float v = 0.0f;
            if (s_row_valid[mm] && k < Kk) {
                const int ih = s_ih0[mm] + khd;
                const int iw = s_iw0[mm] + kwd;
                if (ih >= 0 && ih < H && iw >= 0 && iw < W)
                    v = input[s_row_base[mm] + add];
            }
            sA[0][mm][kk_st] = v;
        }
        #pragma unroll
        for (int l = 0; l < B_ELEMS; ++l) {
            const int nn = rc_st + l * ROWS_PER_PASS;
            const int oc = oc0 + nn;
            float v = 0.0f;
            if (oc < C_out && k < Kk)
                v = weight[(int64_t)oc * Kk + k];
            sB[0][kk_st][nn] = v;
        }
    }
    __syncthreads();
    for (int kt = 0; kt < ktiles; ++kt) {
        const int cur = kt & 1;
        const bool has_next = (kt + 1) < ktiles;
        float a_pre[A_ELEMS];
        float b_pre[B_ELEMS];
        // Prefetch the next K tile from global memory into registers while the FMA
        // work below consumes the current tile from shared memory.
        if (has_next) {
            const int k = (kt + 1) * BK + kk_st;
            int64_t add = 0;
            int khd = 0, kwd = 0;
            if (k < Kk) {
                const int ic  = k / kk_sq;
                const int rem = k - ic * kk_sq;
                const int kh  = rem / K;
                const int kw  = rem - kh * K;
                khd = kh * dil;
                kwd = kw * dil;
                add = (int64_t)ic * H * W + (int64_t)khd * W + kwd;
            }
            #pragma unroll
            for (int l = 0; l < A_ELEMS; ++l) {
                const int mm = rc_st + l * ROWS_PER_PASS;
                float v = 0.0f;
                if (s_row_valid[mm] && k < Kk) {
                    const int ih = s_ih0[mm] + khd;
                    const int iw = s_iw0[mm] + kwd;
                    if (ih >= 0 && ih < H && iw >= 0 && iw < W)
                        v = input[s_row_base[mm] + add];
                }
                a_pre[l] = v;
            }
            #pragma unroll
            for (int l = 0; l < B_ELEMS; ++l) {
                const int nn = rc_st + l * ROWS_PER_PASS;
                const int oc = oc0 + nn;
                float v = 0.0f;
                if (oc < C_out && k < Kk)
                    v = weight[(int64_t)oc * Kk + k];
                b_pre[l] = v;
            }
        }
        #pragma unroll
        for (int kk = 0; kk < BK; ++kk) {
            float av[TM];
            float bv[TN];
            #pragma unroll
            for (int i = 0; i < TM; ++i)
                av[i] = sA[cur][ty + i * 16][kk];
            #pragma unroll
            for (int j = 0; j < TN; ++j)
                bv[j] = sB[cur][kk][tx + j * 16];
            #pragma unroll
            for (int i = 0; i < TM; ++i)
                #pragma unroll
                for (int j = 0; j < TN; ++j)
                    acc[i][j] += av[i] * bv[j];
        }
        // Commit the prefetched tile to the alternate buffer; a single barrier per
        // iteration is sufficient because the two buffers are read/written in
        // alternating phases.
        if (has_next) {
            const int nxt = cur ^ 1;
            #pragma unroll
            for (int l = 0; l < A_ELEMS; ++l)
                sA[nxt][rc_st + l * ROWS_PER_PASS][kk_st] = a_pre[l];
            #pragma unroll
            for (int l = 0; l < B_ELEMS; ++l)
                sB[nxt][kk_st][rc_st + l * ROWS_PER_PASS] = b_pre[l];
        }
        __syncthreads();
    }
    #pragma unroll
    for (int i = 0; i < TM; ++i) {
        const int m_local = ty + i * 16;
        const int64_t row = (int64_t)m0 + m_local;
        #pragma unroll
        for (int j = 0; j < TN; ++j) {
            const int col = oc0 + tx + j * 16;
            if (row < M_total && col < C_out) {
                const float b = (bias != nullptr) ? bias[col] : 0.0f;
                output[s_row_out[m_local] + (int64_t)col * H_out * W_out] = acc[i][j] + b;
            }
        }
    }
}
torch::Tensor conv2d_forward(
    torch::Tensor input,
    torch::Tensor weight,
    c10::optional<torch::Tensor> bias,
    int64_t stride, int64_t pad, int64_t dil)
{
    TORCH_CHECK(input.is_cuda() && weight.is_cuda(), "input and weight must be CUDA tensors");
    TORCH_CHECK(input.scalar_type() == torch::kFloat32, "only float32 supported");
    auto input_c  = input.contiguous();
    auto weight_c = weight.contiguous();
    const int N     = input_c.size(0);
    const int C_in  = input_c.size(1);
    const int H     = input_c.size(2);
    const int W     = input_c.size(3);
    const int C_out = weight_c.size(0);
    const int K     = weight_c.size(2);
    const int H_out = (H + 2 * (int)pad - (int)dil * (K - 1) - 1) / (int)stride + 1;
    const int W_out = (W + 2 * (int)pad - (int)dil * (K - 1) - 1) / (int)stride + 1;
    auto output = torch::empty({N, C_out, H_out, W_out}, input_c.options());
    const int64_t M_total = (int64_t)N * H_out * W_out;
    if (M_total == 0 || C_out == 0)
        return output;
    dim3 block(16, 16);
    dim3 grid((unsigned int)((M_total + BM - 1) / BM),
              (unsigned int)((C_out + BN - 1) / BN), 1);
    torch::Tensor bias_c;
    const float* bias_ptr = nullptr;
    if (bias.has_value() && bias->defined()) {
        bias_c = bias->contiguous();
        bias_ptr = bias_c.data_ptr<float>();
    }
    conv2d_forward_kernel<<<grid, block, 0, at::cuda::getCurrentCUDAStream()>>>(
        input_c.data_ptr<float>(),
        weight_c.data_ptr<float>(),
        bias_ptr,
        output.data_ptr<float>(),
        N, C_in, H, W,
        C_out, H_out, W_out,
        K, (int)stride, (int)pad, (int)dil);
    C10_CUDA_KERNEL_LAUNCH_CHECK();
    return output;
}
