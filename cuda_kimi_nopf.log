put = torch::empty({N, C_out, H_out, W_out}, input_c.options());\n\n    const int tiles_h = (H_out + TILE - 1) / TILE;\n    const int tiles_w = (W_out + TILE - 1) / TILE;\n\n    dim3 block(TILE, TILE);\n    dim3 grid(tiles_h * tiles_w, C_out, N);\n\n    conv2d_kernel<<<grid, block>>>(\n        input_c.data_ptr<float>(),\n        weight_c.data_ptr<float>(),\n        bias_c.data_ptr<float>(),\n        output.data_ptr<float>(),\n        C_in, H, W, C_out, H_out, W_out);\n\n    return output;\n}\n"""\n\n_conv_ext = load_inline(\n    name="custom_conv2d_ext",\n    cpp_sources=_cpp_src,\n    cuda_sources=_cuda_src,\n    functions=["conv2d_forward"],\n    extra_cuda_cflags=["-O3"],\n    verbose=False,\n)\n\n\nclass ModelNew(nn.Module):\n    def __init__(self, num_classes=1000):\n        super(ModelNew, self).__init__()\n        self.num_classes = num_classes\n        # Parameters matching nn.Conv2d(3, 96, kernel_size=11, stride=4, padding=2)\n        self.weight = nn.Parameter(torch.empty(96, 3, 11, 11))\n        self.bias = nn.Parameter(torch.empty(96))\n        # Same default initialization as nn.Conv2d\n        nn.init.kaiming_uniform_(self.weight, a=math.sqrt(5))\n        fan_in = 3 * 11 * 11\n        bound = 1.0 / math.sqrt(fan_in)\n        nn.init.uniform_(self.bias, -bound, bound)\n\n    def forward(self, x):\n        return _conv_ext.conv2d_forward(x, self.weight, self.bias)', 'best_passed_depth': 0, 'best_passed_time': {'mean': 5.54, 'std': 0.138, 'min': 5.4, 'max': 5.72, 'num_trials': 100}, 'best_passed_nsight_metrics': {}, 'kernel_backend': 'cuda', 'compile': '', 'correct': ''}
